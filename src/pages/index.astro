  --navy-800:#00125C;
  --navy-700:#0A1E75;
  --navy-600:#1E2F8C;
  --bg:#FFFFFF;
  --bg-soft:#F6F8FC;
  --bg-blue:#EEF3FF;
  --text:#111827;
  --text-muted:#5F6675;
  --text-faint:#8A93A5;
  --border:#E3E8F2;
  --border-soft:#EEF1F7;
  --cyan:#18B7D6;
  --cyan-soft:#E8FAFD;
  --steel:#8B95A5;
  --slate:#334155;
  --primary:var(--navy-800);
  --accent:var(--cyan);
  --radius-sm:8px;
  --radius:14px;
  --radius-lg:22px;
  --shadow-sm:0 1px 2px rgba(0,18,92,.04), 0 1px 1px rgba(0,18,92,.03);
  --shadow:0 8px 28px -12px rgba(0,18,92,.18), 0 2px 6px rgba(0,18,92,.05);
  --shadow-lg:0 30px 60px -25px rgba(0,18,92,.28), 0 8px 20px -8px rgba(0,18,92,.12);
  --section-y:120px;
  --container:1240px;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0}
body{
  font-family:"Inter",system-ui,-apple-system,Segoe UI,sans-serif;
  color:var(--text);
  background:var(--bg);
  -webkit-font-smoothing:antialiased;
  font-feature-settings:"cv11","ss01","ss03";
  line-height:1.55;
}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}
.container{max-width:var(--container);margin:0 auto;padding:0 32px}
.eyebrow{
  font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;
  color:var(--primary);display:inline-flex;align-items:center;gap:10px;
}
.eyebrow::before{
  content:"";width:24px;height:1px;background:var(--accent);
}
h1,h2,h3,h4{font-family:inherit;color:var(--navy-800);margin:0;letter-spacing:-.02em;line-height:1.1;text-wrap:balance}
h1{font-size:clamp(40px,5vw,68px);font-weight:700}
h2{font-size:clamp(32px,3.4vw,48px);font-weight:700;letter-spacing:-.025em}
h3{font-size:22px;font-weight:600;letter-spacing:-.01em}
h4{font-size:16px;font-weight:600}
p{margin:0;color:var(--text-muted);text-wrap:pretty}

/* ----------- Header ----------- */
.site-header{
  position:sticky;top:0;z-index:50;
  background:rgba(255,255,255,.78);
  backdrop-filter:saturate(180%) blur(14px);
  -webkit-backdrop-filter:saturate(180%) blur(14px);
  border-bottom:1px solid var(--border-soft);
}
.nav{
  display:flex;align-items:center;justify-content:space-between;
  height:76px;
}
.logo{display:flex;align-items:center;gap:12px}
.logo img{height:32px;width:auto}
.nav-links{display:flex;align-items:center;gap:36px}
.nav-links a{font-size:14.5px;color:var(--text);font-weight:500;transition:color .2s}
.nav-links a:hover{color:var(--primary)}
.btn{
  display:inline-flex;align-items:center;justify-content:center;gap:8px;
  padding:12px 22px;font-weight:600;font-size:14.5px;border-radius:10px;
  transition:transform .2s,box-shadow .2s,background .2s,color .2s;
  white-space:nowrap;
}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 6px 20px -10px rgba(0,18,92,.6)}
.btn-primary:hover{transform:translateY(-1px);box-shadow:0 12px 28px -10px rgba(0,18,92,.55)}
.btn-secondary{background:transparent;color:var(--primary);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--bg-soft);border-color:#cbd4e8}
.btn-ghost{background:transparent;color:var(--text);padding:8px 14px}
.btn-ghost:hover{background:var(--bg-soft)}
.btn-lg{padding:16px 28px;font-size:15.5px;border-radius:12px}

/* ----------- Hero ----------- */
.hero{
  position:relative;padding:80px 0 110px;overflow:hidden;
  background:
    radial-gradient(1100px 600px at 80% -200px, rgba(24,183,214,.10), transparent 60%),
    radial-gradient(900px 500px at 10% 100%, rgba(0,18,92,.06), transparent 70%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid{
  position:absolute;inset:0;pointer-events:none;opacity:.5;
  background-image:
    linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{
  position:relative;
  display:grid;grid-template-columns:1.05fr 1fr;gap:80px;align-items:center;
}
.hero-badge{
  display:inline-flex;align-items:center;gap:10px;
  padding:7px 14px 7px 8px;border-radius:6px;
  background:#fff;border:1px solid var(--border);
  font-size:12.5px;font-weight:600;color:var(--slate);
  box-shadow:var(--shadow-sm);
}
.hero-badge .pill{
  background:var(--primary);color:#fff;font-size:11px;letter-spacing:.08em;
  padding:3px 9px;border-radius:6px;text-transform:uppercase;
}
.hero h1{margin-top:24px}
.hero-sub{font-size:19px;line-height:1.55;color:var(--text-muted);max-width:540px;margin-top:24px}
.hero-cta{display:flex;gap:12px;margin-top:36px;flex-wrap:wrap}
.hero-trust{
  display:flex;align-items:center;gap:14px;margin-top:32px;color:var(--text-muted);font-size:13.5px;
  padding-top:28px;border-top:1px solid var(--border-soft);max-width:540px;
}
.hero-trust .dot{width:6px;height:6px;border-radius:50%;background:var(--cyan)}

/* Focus strip */
.focus-strip{
  position:relative;
  padding:0 0 34px;
  margin-top:-54px;
  background:linear-gradient(180deg,rgba(250,251,254,0),#fff 72%);
}
.focus-grid{
  position:relative;
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:1px;
  background:var(--border);
  border:1px solid var(--border);
  border-radius:var(--radius-lg);
  overflow:hidden;
  box-shadow:var(--shadow);
}
.focus-item{
  background:rgba(255,255,255,.96);
  padding:28px 30px 30px;
}
.focus-kicker{
  font-family:"JetBrains Mono",monospace;
  font-size:11px;
  letter-spacing:.08em;
  color:var(--cyan);
  font-weight:700;
  margin-bottom:18px;
}
.focus-item h2{
  font-size:20px;
  line-height:1.2;
  margin:0;
  color:var(--navy-800);
}
.focus-item p{
  margin-top:12px;
  font-size:14px;
  line-height:1.6;
  color:var(--text-muted);
}

/* Hero visual */
.hero-visual{
  position:relative;height:560px;
}
.dash-card{
  position:absolute;background:#fff;border-radius:var(--radius-lg);
  border:1px solid var(--border);box-shadow:var(--shadow-lg);
  overflow:hidden;
}
.dash-main{
  inset:24px 0 24px 24px;width:calc(100% - 24px);
  display:grid;grid-template-rows:auto 1fr;
}
.dash-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:18px 22px;border-bottom:1px solid var(--border-soft);
}
.dash-tabs{display:flex;gap:6px}
.dash-tab{
  padding:6px 12px;border-radius:8px;font-size:12px;font-weight:600;color:var(--text-muted);
}
.dash-tab.active{background:var(--bg-blue);color:var(--primary)}
.dash-body{
  padding:22px;display:grid;grid-template-columns:1.4fr 1fr;gap:18px;
}
.kpi-row{display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;margin-bottom:14px}
.kpi{
  border:1px solid var(--border-soft);border-radius:12px;padding:12px;background:#FCFCFE;
}
.kpi .lbl{font-size:10.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.kpi .val{font-size:20px;font-weight:700;color:var(--navy-800);margin-top:4px}
.kpi .delta{font-size:11px;color:#15a06b;font-weight:600;margin-top:2px}
.kpi .delta.warn{color:#c47700}
.chart{
  height:160px;border:1px solid var(--border-soft);border-radius:12px;padding:12px 8px 6px;
  background:linear-gradient(180deg,#FCFCFE,#fff);position:relative;
}
.chart-title{font-size:11px;color:var(--text-muted);font-weight:600;padding:0 6px;display:flex;justify-content:space-between}
.list-card{
  border:1px solid var(--border-soft);border-radius:12px;padding:14px;background:#fff;
}
.list-card h5{margin:0 0 12px;font-size:12px;color:var(--text-muted);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.list-item{display:flex;align-items:center;gap:10px;padding:8px 0;border-bottom:1px dashed var(--border-soft);font-size:12.5px}
.list-item:last-child{border-bottom:none}
.list-item .tag{font-size:10px;background:var(--cyan-soft);color:#0c7d94;padding:2px 7px;border-radius:6px;font-weight:600;font-family:"JetBrains Mono",monospace}
.list-item .tag.warn{background:#FFF4E0;color:#8a5500}
.list-item .tag.ok{background:#E6F7EE;color:#0c6b3f}
.list-item .name{flex:1;color:var(--slate);font-weight:500}
.dot-pulse{width:8px;height:8px;border-radius:50%;background:var(--cyan);box-shadow:0 0 0 0 rgba(24,183,214,.6);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(24,183,214,.6)}70%{box-shadow:0 0 0 10px rgba(24,183,214,0)}100%{box-shadow:0 0 0 0 rgba(24,183,214,0)}}

.hero-side{
  position:absolute;right:0;top:80px;width:240px;
  display:flex;flex-direction:column;gap:14px;
}
.side-card{
  background:#fff;border:1px solid var(--border);border-radius:14px;padding:14px 16px;
  box-shadow:var(--shadow);display:flex;align-items:center;gap:12px;
  animation:float 6s ease-in-out infinite;
}
.side-card:nth-child(2){animation-delay:-2s}
.side-card:nth-child(3){animation-delay:-4s}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-6px)}}
.side-icon{
  width:36px;height:36px;border-radius:10px;background:var(--bg-blue);
  display:flex;align-items:center;justify-content:center;color:var(--primary);flex-shrink:0;
}
.side-card .meta{font-size:11px;color:var(--text-faint);font-weight:500}
.side-card .val{font-size:13px;color:var(--text);font-weight:600;margin-top:1px}

/* ----------- Sections ----------- */
section{padding:var(--section-y) 0}
.section-head{max-width:780px;margin:0 auto 64px;text-align:center}
.section-head.left{margin-left:0;text-align:left}
.section-head h2{margin-top:18px}
.section-head p{font-size:18px;margin-top:18px}

/* Problem grid */
.problem{background:var(--bg-soft)}
.card-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.problem-card{
  background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);
  padding:32px 28px;transition:transform .25s,box-shadow .25s,border-color .25s;
}
.problem-card:hover{transform:translateY(-4px);box-shadow:var(--shadow);border-color:var(--border)}
.problem-card .icon-box{
  width:48px;height:48px;border-radius:12px;background:var(--bg-blue);
  display:flex;align-items:center;justify-content:center;color:var(--primary);margin-bottom:22px;
}
.problem-card h3{font-size:18px;margin-bottom:10px}
.problem-card p{font-size:14.5px;line-height:1.6}

/* Approach timeline */
.approach-grid{
  display:grid;grid-template-columns:repeat(4,1fr);gap:0;position:relative;
}
.approach-line{
  position:absolute;left:6%;right:6%;top:48px;height:2px;
  background:linear-gradient(90deg,transparent,var(--cyan),var(--cyan),transparent);
  opacity:.5;
}
.step{padding:0 24px;text-align:center;position:relative}
.step:first-child{padding-left:0}
.step:last-child{padding-right:0}
.step-num{
  width:96px;height:96px;border-radius:50%;background:#fff;border:2px solid var(--bg-blue);
  display:flex;align-items:center;justify-content:center;margin:0 auto 24px;
  font-size:34px;font-weight:700;color:var(--primary);
  font-family:"JetBrains Mono",monospace;position:relative;z-index:2;
  box-shadow:var(--shadow-sm);
}
.step h3{margin-bottom:10px}
.step p{font-size:14.5px}

/* Platforms */
.platforms{background:linear-gradient(180deg,#fff 0%,#FAFBFE 100%)}
.platform-grid{display:grid;grid-template-columns:1fr 1fr;gap:28px}
.platform-card{
  position:relative;background:#fff;border:1px solid var(--border);
  border-radius:24px;padding:40px;overflow:hidden;
  box-shadow:var(--shadow);
  transition:transform .3s,box-shadow .3s;
  display:flex;flex-direction:column;
}
.platform-card:hover{transform:translateY(-3px);box-shadow:var(--shadow-lg)}
.platform-card.tag::before{
  content:"";position:absolute;top:0;left:0;right:0;height:5px;
  background:linear-gradient(90deg,var(--primary),var(--navy-700));
}
.platform-card.pred::before{
  content:"";position:absolute;top:0;left:0;right:0;height:5px;
  background:linear-gradient(90deg,#1A5DC8,var(--cyan));
}
.platform-card.ptl::before{
  content:"";position:absolute;top:0;left:0;right:0;height:5px;
  background:linear-gradient(90deg,#B8800F,#E8A317);
}
.platform-tag{
  display:inline-block;font-size:11.5px;font-weight:600;letter-spacing:.08em;
  text-transform:uppercase;color:var(--primary);
  padding:6px 12px;background:var(--bg-blue);border-radius:6px;margin-bottom:20px;
}
.platform-card.pred .platform-tag{background:var(--cyan-soft);color:#0c7d94}
.platform-card h2{font-size:42px;margin-bottom:12px;font-weight:800}
.platform-tagline{font-size:17px;color:var(--text);margin-bottom:18px;font-weight:500}
.platform-card .desc{font-size:14.5px;margin-bottom:24px;line-height:1.65}
.feature-list{list-style:none;padding:0;margin:0 0 28px;display:grid;gap:12px}
.feature-list li{display:flex;align-items:flex-start;gap:10px;font-size:14.5px;color:var(--slate)}
.feature-list svg{flex-shrink:0;margin-top:3px;color:var(--accent)}
.platform-mock{
  margin-top:auto;border:1px solid var(--border-soft);border-radius:14px;
  padding:18px;background:linear-gradient(180deg,#FCFDFF,#F6F8FC);
}

/* Comparison */
.compare{background:var(--bg-soft)}
.compare-table{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  overflow:hidden;box-shadow:var(--shadow-sm);
}
.compare-row{
  display:grid;grid-template-columns:1.5fr 1fr 1fr;align-items:center;
  border-bottom:1px solid var(--border-soft);
}
.compare-row:last-child{border-bottom:none}
.compare-row > div{padding:20px 28px;font-size:14.5px}
.compare-row .need{font-weight:500;color:var(--text)}
.compare-row.head{background:var(--navy-800);color:#fff}
.compare-row.head > div{padding:22px 28px;font-weight:700;font-size:15px}
.compare-row.head .col-tag{color:#fff}
.compare-row.head .col-pred{color:#fff}
.compare-row .col{display:flex;align-items:center;gap:10px;font-size:14px}
.compare-row .yes{color:var(--primary);font-weight:600}
.compare-row .partial{color:var(--text-muted)}
.compare-row .focus{color:#0c7d94;font-weight:600}
.check{
  width:18px;height:18px;border-radius:50%;background:var(--bg-blue);
  display:inline-flex;align-items:center;justify-content:center;color:var(--primary);
  font-size:11px;font-weight:700;flex-shrink:0;
}
.check.solid{background:var(--primary);color:#fff}
.check.cyan{background:var(--cyan);color:#fff}
.check.muted{background:var(--border);color:var(--text-faint)}

/* Detail sections */
.detail{padding:var(--section-y) 0}
.detail-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.detail-grid.flip{grid-template-columns:1fr 1fr}
.detail-features{display:grid;gap:24px;margin-top:36px}
.detail-feat{display:flex;gap:18px;align-items:flex-start}
.feat-icon{
  width:44px;height:44px;border-radius:11px;background:var(--bg-blue);
  display:flex;align-items:center;justify-content:center;color:var(--primary);flex-shrink:0;
}
.detail.pred .feat-icon{background:var(--cyan-soft);color:#0c7d94}
.detail-feat h4{font-size:16px;color:var(--navy-800);margin-bottom:6px}
.detail-feat p{font-size:14.5px;line-height:1.6}

/* Diagram */
.diagram{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  padding:36px;box-shadow:var(--shadow);position:relative;overflow:hidden;
}
.diagram-flow{
  display:grid;grid-template-columns:1fr auto 1fr;gap:32px;align-items:center;
}
.diagram-col{display:flex;flex-direction:column;gap:10px}
.diagram-col .lbl{
  font-size:10.5px;color:var(--text-faint);text-transform:uppercase;
  letter-spacing:.1em;font-weight:600;margin-bottom:6px;text-align:center;
}
.node{
  display:flex;align-items:center;gap:10px;padding:12px 14px;
  background:#fff;border:1px solid var(--border-soft);border-radius:10px;
  font-size:13px;font-weight:500;color:var(--slate);
}
.node svg{color:var(--primary);flex-shrink:0}
.diagram-center{
  background:var(--navy-800);color:#fff;border-radius:14px;padding:22px;
  text-align:center;min-width:160px;position:relative;
}
.diagram-center .nm{font-size:18px;font-weight:700;letter-spacing:-.01em}
.diagram-center .sm{font-size:11px;opacity:.7;margin-top:4px}
.arrow{
  width:60px;height:1px;background:linear-gradient(90deg,transparent,var(--cyan),transparent);
  position:relative;
}
.arrow::after{
  content:"";position:absolute;right:0;top:-3px;width:0;height:0;
  border-left:6px solid var(--cyan);border-top:3px solid transparent;border-bottom:3px solid transparent;
}

/* Predictivo dashboard */
.pred-dash{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  padding:24px;box-shadow:var(--shadow);
}
.pred-dash-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}
.pred-dash-head .ttl{font-weight:700;color:var(--navy-800);font-size:15px}
.pred-dash-head .live{display:flex;align-items:center;gap:6px;font-size:11px;color:#15a06b;font-weight:600}
.pred-dash-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px}
.pd-kpi{
  border:1px solid var(--border-soft);border-radius:12px;padding:14px;background:#FCFDFF;
}
.pd-kpi .lbl{font-size:10.5px;color:var(--text-faint);font-weight:600;text-transform:uppercase;letter-spacing:.08em}
.pd-kpi .val{font-size:26px;font-weight:700;color:var(--navy-800);margin-top:6px;font-family:"JetBrains Mono",monospace}
.pd-kpi .meta{font-size:11px;color:var(--text-muted);margin-top:4px}
.pd-chart{
  grid-column:span 2;border:1px solid var(--border-soft);border-radius:12px;padding:16px;background:#fff;
}
.pd-alarm{
  grid-column:span 2;border:1px solid #FFE4D6;background:#FFF7F0;border-radius:12px;
  padding:12px 14px;display:flex;align-items:center;gap:12px;font-size:13px;
}
.pd-alarm .pill{font-size:10px;background:#FFB377;color:#7d3a00;padding:3px 8px;border-radius:5px;font-weight:700;text-transform:uppercase;letter-spacing:.05em}
.pd-alarm .txt{flex:1;color:var(--slate);font-weight:500}

/* Use cases */
.usecases{background:var(--bg-soft)}
.use-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.use-card{
  background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius);
  padding:26px;transition:transform .25s,box-shadow .25s,border-color .25s;display:flex;flex-direction:column;gap:14px;
}
.use-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--border)}
.use-card .ic{
  width:42px;height:42px;border-radius:10px;background:var(--bg-blue);color:var(--primary);
  display:flex;align-items:center;justify-content:center;
}
.use-card h3{font-size:16.5px}
.use-card p{font-size:13.5px;line-height:1.55}
.use-tags{display:flex;gap:6px;flex-wrap:wrap;margin-top:auto;padding-top:4px}
.use-tag{
  font-size:10.5px;font-weight:600;letter-spacing:.05em;text-transform:uppercase;
  padding:4px 8px;border-radius:5px;
}
.use-tag.tt{background:var(--bg-blue);color:var(--primary)}
.use-tag.pr{background:var(--cyan-soft);color:#0c7d94}

/* Industries */
.industries{background:#fff}
.ind-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.ind-card{
  border:1px solid var(--border-soft);border-radius:var(--radius);
  padding:24px;transition:all .25s;background:#fff;
}
.ind-card:hover{border-color:var(--primary);background:linear-gradient(180deg,#fff,#FAFBFE)}
.ind-card .ic{
  width:36px;height:36px;border-radius:9px;background:var(--bg-soft);color:var(--primary);
  display:flex;align-items:center;justify-content:center;margin-bottom:18px;
}
.ind-card h4{font-size:16px;margin-bottom:8px}
.ind-card p{font-size:13.5px}

/* Tech architecture */
.tech{background:var(--navy-800);color:#fff;position:relative;overflow:hidden}
.tech::before{
  content:"";position:absolute;inset:0;
