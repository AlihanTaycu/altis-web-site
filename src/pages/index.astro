---
import Base from '../layouts/Base.astro';
import SectionHead from '../components/sections/SectionHead.astro';
import LogoMarquee from '../components/sections/LogoMarquee.astro';
import { partnerLogos } from '../data/partner-logos';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": "Altis Teknoloji ve Yazılım",
    "alternateName": "Altis Teknoloji",
    "url": "https://www.altis.com.tr",
    "logo": "https://www.altis.com.tr/assets/altis-logo.png",
    "foundingDate": "2003",
    "description": "Altis Teknoloji; RFID, Auto-ID, IoT, RTLS ve endüstriyel otomasyon çözümleriyle saha operasyonlarını dijitalleştiren teknoloji ve proje firmasıdır.",
    "telephone": "+90-216-415-82-55",
    "email": "info@altis.com.tr",
    "address": {
      "@type": "PostalAddress",
      "streetAddress": "Natoyolu Cad. İlkyaz Sok. Kartal Plaza No:24-28 Kat:1 D:1",
      "addressLocality": "Ümraniye",
      "addressRegion": "İstanbul",
      "postalCode": "34776",
      "addressCountry": "TR"
    },
    "geo": {
      "@type": "GeoCoordinates",
      "latitude": "41.0158",
      "longitude": "29.1155"
    },
    "sameAs": [
      "https://linkedin.com/company/altis-technologies",
      "https://twitter.com/altisteknoloji",
      "https://www.facebook.com/altisteknoloji",
      "https://www.instagram.com/altisteknoloji",
      "https://www.youtube.com/user/AltisTeknoloji"
    ]
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": "Altis Teknoloji",
    "url": "https://www.altis.com.tr",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "https://www.altis.com.tr/blog/?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
];

---

<Base
  title="Altis Teknoloji - Saha Verisini Kurumsal Karar Sistemlerine Bağlıyoruz"
  description="Altis Teknoloji; RFID, IoT ve endüstriyel yazılımı tek projede birleştirerek saha cihazlarını, verileri ve iş akışlarını güvenilir operasyon sistemlerine dönüştürür."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/"
>
<!-- ============== Hero ============== -->
<section class="hero">
  <div class="hero-grid" id="hero-grid"></div>
  <div class="container hero-inner">
    <div>
      <div class="hero-badge">
        <span class="pill">Industrial</span>
        <span>RFID · IoT · RTLS · Automation · Software</span>
      </div>
      <h1>Saha verisini kurumsal karar sistemlerine bağlayan teknoloji ekibi.</h1>
      <p class="hero-sub">
        RFID, IoT ve endüstriyel yazılımı tek projede birleştirerek cihazları, verileri ve iş akışlarını güvenilir operasyon sistemlerine dönüştürüyoruz.
      </p>
      <div class="hero-cta">
        <a href="/iletisim/" class="btn btn-primary btn-lg">Demo Talep Et
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
        <a href="/platformlar/tag-trace/" class="btn btn-secondary btn-lg">Platformları İncele</a>
      </div>
      <div class="hero-trust">
        <span class="dot"></span>
        Donanım, yazılım ve saha entegrasyonunu tek çatı altında sunan deneyimli teknoloji ekibi.
      </div>
    </div>

    <!-- Hero visual: dashboard mockup -->
    <div class="hero-visual">
      <div class="dash-card dash-main">
        <div class="dash-head">
          <div class="dash-tabs">
            <span class="dash-tab active">Tag&amp;Trace</span>
            <span class="dash-tab">Predictivo</span>
          </div>
          <div class="dash-live">
            <span class="dot-pulse"></span> Canlı
          </div>
        </div>
        <div class="dash-body">
          <div>
            <div class="kpi-row">
              <div class="kpi"><div class="lbl">Aktif Cihaz</div><div class="val">182</div><div class="delta">▲ 12 bugün</div></div>
              <div class="kpi"><div class="lbl">Okuma / dk</div><div class="val">4.2K</div><div class="delta">▲ 8%</div></div>
              <div class="kpi"><div class="lbl">Alarm</div><div class="val">3</div><div class="delta warn">▲ 2 saat</div></div>
            </div>
            <div class="chart">
              <div class="chart-title"><span>Okuma yoğunluğu · 24s</span><span class="mono">UTC+3</span></div>
              <svg viewBox="0 0 320 120" width="100%" height="118" preserveAspectRatio="none" class="chart-svg">
                <defs>
                  <linearGradient id="g1" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0" stop-color="#18B7D6" stop-opacity=".35"/>
                    <stop offset="1" stop-color="#18B7D6" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <path d="M0,90 L20,72 L40,80 L60,55 L80,62 L100,40 L120,52 L140,30 L160,42 L180,28 L200,48 L220,32 L240,50 L260,38 L280,58 L300,44 L320,52 L320,120 L0,120 Z" fill="url(#g1)"/>
                <path d="M0,90 L20,72 L40,80 L60,55 L80,62 L100,40 L120,52 L140,30 L160,42 L180,28 L200,48 L220,32 L240,50 L260,38 L280,58 L300,44 L320,52" stroke="#18B7D6" stroke-width="2" fill="none" stroke-linecap="round"/>
                <g fill="#00125C">
                  <circle cx="180" cy="28" r="3.5"/>
                </g>
              </svg>
            </div>
          </div>
          <div class="list-card">
            <h5>Son olaylar</h5>
            <div class="list-item">
              <span class="tag">RDR-01</span>
              <span class="name">Sevkiyat doğrulandı</span>
              <span class="tag ok">OK</span>
            </div>
            <div class="list-item">
              <span class="tag">PRN-03</span>
              <span class="name">142 etiket basıldı</span>
              <span class="tag ok">OK</span>
            </div>
            <div class="list-item">
              <span class="tag">SNS-12</span>
              <span class="name">Sıcaklık eşiği</span>
              <span class="tag warn">!</span>
            </div>
            <div class="list-item">
              <span class="tag">RDR-07</span>
              <span class="name">Anten gücü güncellendi</span>
              <span class="tag ok">OK</span>
            </div>
            <div class="list-item">
              <span class="tag">ERP</span>
              <span class="name">SAP sync tamamlandı</span>
              <span class="tag ok">OK</span>
            </div>
          </div>
        </div>
      </div>

      <div class="hero-side">
        <div class="side-card">
          <div class="side-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg>
          </div>
          <div>
            <div class="meta">RFID okuma</div>
            <div class="val">4 247 / dk</div>
          </div>
        </div>
        <div class="side-card">
          <div class="side-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 18v3M17 18v3M7 6V3M17 6V3"/></svg>
          </div>
          <div>
            <div class="meta">Aktif IoT cihazı</div>
            <div class="val">1 832 nokta</div>
          </div>
        </div>
        <div class="side-card">
          <div class="side-icon">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
          </div>
          <div>
            <div class="meta">Veri akışı</div>
            <div class="val">99.97% uptime</div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ============== Focus ============== -->
<section class="focus-strip" aria-label="Altis odak alanları">
  <div class="container">
    <div class="focus-grid" data-reveal data-reveal-delay="80">
      <article class="focus-item">
        <div class="focus-kicker">01</div>
        <h2>İzlenebilirlik</h2>
        <p>RFID, barkod ve Auto-ID verisini üretim, depo ve sevkiyat süreçlerinde güvenilir kayıt akışına çeviririz.</p>
      </article>
      <article class="focus-item">
        <div class="focus-kicker">02</div>
        <h2>Operasyonel zekâ</h2>
        <p>Makine, sensör, enerji ve saha verisini dashboard, alarm ve karar destek katmanında anlamlı hale getiririz.</p>
      </article>
      <article class="focus-item">
        <div class="focus-kicker">03</div>
        <h2>Saha entegrasyonu</h2>
        <p>Donanım seçimi, yazılım geliştirme ve ERP entegrasyonunu tek sorumlu ekip altında sahaya alırız.</p>
      </article>
    </div>
  </div>
</section>

<!-- ============== Problem ============== -->
<section class="problem">
  <div class="container">
    <SectionHead
      eyebrow="Operasyonel Gerçek"
      heading="Sahadaki veriler hâlâ dağınık, gecikmeli ve yönetilemez mi?"
      description="Modern operasyonlarda cihazlar, sensörler, makineler, yazıcılar, okuyucular ve kurumsal sistemler çoğu zaman birbirinden kopuk çalışır. Bu durum görünmeyen risklere, hatalı stoklara, manuel iş yüküne ve verimsiz operasyonlara yol açar."
    />
    <div class="card-grid" data-reveal data-reveal-delay="100">
      <div class="problem-card">
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
        </div>
        <h3>Dağınık Cihazlar</h3>
        <p>RFID okuyucular, yazıcılar, barkod sistemleri, sensörler ve PLC'ler farklı protokollerle çalışır; her marka kendi arayüzünü dayatır.</p>
      </div>
      <div class="problem-card">
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 7h12M8 12h12M8 17h12"/><circle cx="4" cy="7" r="1.5"/><circle cx="4" cy="12" r="1.5"/><circle cx="4" cy="17" r="1.5"/></svg>
        </div>
        <h3>Kopuk Sistemler</h3>
        <p>ERP, WMS, SAP, SCADA ve saha cihazları arasında gerçek zamanlı ve güvenilir veri akışı kurulamaz; entegrasyon çoğu zaman zayıf kalır.</p>
      </div>
      <div class="problem-card">
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3.5-7 10-7 10 7 10 7-3.5 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="2.5"/></svg>
        </div>
        <h3>Görünmeyen Operasyonlar</h3>
        <p>Stok, varlık, makine, enerji, lokasyon ve süreç verileri anlık izlenemez; problemler ancak rapor saatinde fark edilir.</p>
      </div>
      <div class="problem-card">
        <div class="icon-box">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/></svg>
        </div>
        <h3>Manuel İş Yükü</h3>
        <p>Raporlama, veri kontrolü, etiketleme, sayım ve operasyon takibi insan hatasına açık şekilde yürür; ölçekleme zorlaşır.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============== Approach ============== -->
<section>
  <div class="container">
    <SectionHead
      eyebrow="Altis Yaklaşımı"
      heading="Teknolojiyi değil, çalışan operasyon sistemleri kuruyoruz."
      description="Saha ihtiyaçlarını analiz eder, doğru donanımı seçer, yazılımı geliştirir, sistemleri entegre eder ve operasyonun sürdürülebilir şekilde çalışmasını sağlarız. Yalnızca bir ürün tedarikçisi değil; analizden devreye almaya kadar yer alan bir proje ve teknoloji ortağıyız."
    />
    <div class="approach-grid" data-reveal data-reveal-delay="100">
      <div class="approach-line"></div>
      <div class="step">
        <div class="step-num">01</div>
        <h3>Analiz</h3>
        <p>Operasyon, saha koşulları, cihazlar, kullanıcı rolleri, veri akışı ve entegrasyon ihtiyacı incelenir.</p>
      </div>
      <div class="step">
        <div class="step-num">02</div>
        <h3>Tasarım</h3>
        <p>RFID, IoT, RTLS, yazılım, edge mimari, veri modeli ve iş akışları projeye özel tasarlanır.</p>
      </div>
      <div class="step">
        <div class="step-num">03</div>
        <h3>Entegrasyon</h3>
        <p>ERP, WMS, SAP, SCADA, PLC, sensör, okuyucu, yazıcı ve mobil cihazlar tek yapı içinde konuşturulur.</p>
      </div>
      <div class="step">
        <div class="step-num">04</div>
        <h3>Operasyon</h3>
        <p>Dashboard, alarm, rapor, rule engine ve kullanıcı yönetimiyle sistem sürdürülebilir hale getirilir.</p>
      </div>
    </div>
  </div>
</section>

<!-- ============== Platforms ============== -->
<section class="platforms" id="platforms">
  <div class="container">
    <SectionHead
      eyebrow="İki Amiral Gemisi Platform"
      heading="İki güçlü platform, tek hedef: görünür, izlenebilir, yönetilebilir operasyonlar"
      description="Tag&amp;Trace ve Predictivo, Altis Teknoloji'nin saha verisini yöneten iki ana platformudur. Biri Auto-ID ve RFID operasyonlarını, diğeri IoT ve operasyonel verileri merkezileştirir."
    />

    <div class="platform-grid" data-reveal data-reveal-delay="100">
      <!-- Tag&Trace -->
      <article class="platform-card tag">
        <div class="platform-tag">RFID &amp; Auto-ID Orchestration</div>
        <h2>Tag&amp;Trace</h2>
        <div class="platform-tagline">RFID ve Auto-ID operasyonlarınızı tek merkezden yönetin.</div>
        <p class="desc">RFID okuyucular, RFID yazıcılar, barkod sistemleri, PLC'ler, sensörler ve kurumsal sistemler arasında çalışan güçlü bir orkestrasyon ve edge framework platformu.</p>
        <ul class="feature-list">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Merkezi cihaz yönetimi · marka bağımsız</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Görsel kural motoru ve etiket şablonlama</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>REST API · MQTT · TCP Socket · OPC UA · HTTP/S</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Edge processing · lokal veri işleme</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>ERP / WMS / SAP entegrasyonu</li>
        </ul>
        <div class="platform-mock">
          <div class="mock-header">
            <span>Cihaz havuzu</span><span class="mono">182 / 200</span>
          </div>
          <div class="device-grid">
            <span class="dev-bar dev-bar--primary"></span>
            <span class="dev-bar dev-bar--primary"></span>
            <span class="dev-bar dev-bar--primary"></span>
            <span class="dev-bar dev-bar--navy"></span>
            <span class="dev-bar dev-bar--navy"></span>
            <span class="dev-bar dev-bar--navy"></span>
            <span class="dev-bar dev-bar--cyan"></span>
            <span class="dev-bar dev-bar--cyan"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
            <span class="dev-bar dev-bar--muted"></span>
          </div>
          <div class="mock-legend">
            <span class="legend-item"><span class="legend-dot legend-dot--primary"></span>Reader</span>
            <span class="legend-item"><span class="legend-dot legend-dot--navy"></span>Printer</span>
            <span class="legend-item"><span class="legend-dot legend-dot--cyan"></span>Sensor</span>
          </div>
        </div>
        <a href="/platformlar/tag-trace/" class="btn btn-primary platform-cta">Tag&amp;Trace'i İncele
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </article>

      <!-- Predictivo -->
      <article class="platform-card pred">
        <div class="platform-tag">Industrial IoT &amp; Operational Intelligence</div>
        <h2>Predictivo</h2>
        <div class="platform-tagline">IoT ve operasyon verilerinizi karar destek sistemine dönüştürün.</div>
        <p class="desc">Sensör, makine, sayaç, beacon, SCADA ve operasyon verilerini tek merkezde toplayan; dashboard, alarm, rapor ve kural motoru ile aksiyona dönüştüren endüstriyel IoT platformu.</p>
        <ul class="feature-list">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>IoT veri toplama · MQTT · LoRaWAN · NB-IoT</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Canlı dashboard ve görsel rule engine</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Alarm, bildirim ve eşik yönetimi</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Periyodik PDF rapor üretimi</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Enerji · bakım · RTLS · operasyon analitiği</li>
        </ul>
        <div class="platform-mock">
          <div class="mock-header">
            <span>Enerji tüketimi · son 12 saat</span><span class="mock-header-pos">▼ 7%</span>
          </div>
          <svg viewBox="0 0 320 90" width="100%" height="80" preserveAspectRatio="none" class="pred-svg">
            <defs>
              <linearGradient id="g2" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#1A5DC8" stop-opacity=".25"/>
                <stop offset="1" stop-color="#1A5DC8" stop-opacity="0"/>
              </linearGradient>
            </defs>
            <g stroke="#EEF1F7" stroke-width="1">
              <line x1="0" y1="22" x2="320" y2="22"/>
              <line x1="0" y1="45" x2="320" y2="45"/>
              <line x1="0" y1="68" x2="320" y2="68"/>
            </g>
            <path d="M0,60 L26,52 L52,55 L78,40 L104,48 L130,30 L156,38 L182,22 L208,32 L234,18 L260,30 L286,24 L320,32 L320,90 L0,90 Z" fill="url(#g2)"/>
            <path d="M0,60 L26,52 L52,55 L78,40 L104,48 L130,30 L156,38 L182,22 L208,32 L234,18 L260,30 L286,24 L320,32" stroke="#1A5DC8" stroke-width="2" fill="none" stroke-linecap="round"/>
            <path d="M0,72 L26,68 L52,70 L78,62 L104,66 L130,58 L156,64 L182,52 L208,58 L234,48 L260,56 L286,52 L320,58" stroke="#18B7D6" stroke-width="1.5" fill="none" stroke-dasharray="3 3"/>
          </svg>
          <div class="mock-legend">
            <span class="legend-item"><span class="legend-line legend-line--blue"></span>kWh aktüel</span>
            <span class="legend-item"><span class="legend-line legend-line--dash"></span>tahmin</span>
          </div>
        </div>
        <a href="/platformlar/predictivo/" class="btn btn-primary platform-cta platform-cta--pred">Predictivo'yu İncele
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
        </a>
      </article>

    </div>

    <div class="flow-strip">
      <span class="ln"></span>
      <span>Saha</span>
      <span class="ln ln--short"></span>
      <span class="flow-accent">Veri</span>
      <span class="ln ln--short"></span>
      <span>Aksiyon</span>
