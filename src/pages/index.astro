<style>
.rox-section{position:relative;padding:var(--section-y) 0;overflow:hidden;background:linear-gradient(180deg,#FAFBFE 0%,#F1EEFA 100%)}
.rox-section::before{
  content:"";position:absolute;inset:0;pointer-events:none;
  background:radial-gradient(800px 500px at 15% 30%, rgba(124,58,237,.10), transparent 60%);
}
.rox-section .container{position:relative}
.rox-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}
.rox-section .eyebrow{color:#7C3AED}
.rox-section .eyebrow::before{background:#A78BFA}
.rox-name{
  font-size:clamp(48px,5.5vw,76px);font-weight:800;letter-spacing:-.035em;line-height:1;
  background:linear-gradient(135deg,#00125C 0%,#5B21B6 55%,#A78BFA 130%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin:20px 0 14px;padding-bottom:0.12em;
}
.rox-section h3.rox-tagline{font-size:clamp(20px,2vw,28px);font-weight:700;line-height:1.25;color:var(--navy-800);margin:0 0 22px;letter-spacing:-.01em}
.rox-section .rox-grid > div > p{font-size:16.5px;line-height:1.65;max-width:520px}
.rox-feat-row{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:28px}
.rox-feat{display:flex;gap:10px;align-items:flex-start;font-size:14px;color:var(--slate)}
.rox-feat svg{color:#7C3AED;flex-shrink:0;margin-top:3px}
.rox-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.btn-violet{background:linear-gradient(135deg,#5B21B6,#7C3AED);color:#fff;box-shadow:0 6px 20px -10px rgba(124,58,237,.5)}
.btn-violet:hover{transform:translateY(-1px);box-shadow:0 10px 26px -10px rgba(124,58,237,.6)}

/* Rox visual: phone + NFC tap */
.rox-visual{position:relative;display:flex;align-items:center;justify-content:center;min-height:480px}
.rox-phone{
  position:relative;width:240px;height:480px;background:linear-gradient(180deg,#0A0F2A,#000);
  border-radius:38px;padding:10px;box-shadow:0 30px 60px -25px rgba(0,18,92,.4),0 0 50px rgba(124,58,237,.18);
}
.rox-phone::before{
  content:"";position:absolute;top:18px;left:50%;transform:translateX(-50%);
  width:80px;height:22px;background:#000;border-radius:14px;z-index:3;
}
.rox-screen{
  position:relative;width:100%;height:100%;background:linear-gradient(160deg,#1a1146,#0A0F2A);
  border-radius:30px;overflow:hidden;display:flex;flex-direction:column;align-items:center;padding:60px 22px 22px;
}
.rox-screen::after{
  content:"";position:absolute;inset:0;
  background:radial-gradient(400px 200px at 50% 0%, rgba(167,139,250,.25), transparent 60%);
  pointer-events:none;
}
.rox-avatar{
  width:78px;height:78px;border-radius:50%;background:linear-gradient(135deg,#7C3AED,#A78BFA);
  display:flex;align-items:center;justify-content:center;font-family:"JetBrains Mono",monospace;font-size:30px;
  font-weight:700;color:#fff;letter-spacing:-.02em;position:relative;z-index:2;
  box-shadow:0 8px 16px rgba(124,58,237,.4);
}
.rox-name-line{position:relative;z-index:2;color:#fff;font-weight:700;font-size:18px;margin-top:18px;letter-spacing:-.01em}
.rox-title-line{position:relative;z-index:2;color:rgba(255,255,255,.6);font-size:11.5px;margin-top:2px;font-weight:500}
.rox-co{position:relative;z-index:2;color:#A78BFA;font-size:11px;margin-top:4px;font-family:"JetBrains Mono",monospace;font-weight:600;letter-spacing:.05em}
.rox-actions{position:relative;z-index:2;display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:24px;width:100%}
.rox-action{
  background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.1);border-radius:10px;
  padding:10px;text-align:center;color:#fff;font-size:11px;font-weight:600;
}
.rox-action svg{display:block;margin:0 auto 4px;color:#A78BFA;width:16px;height:16px}
.rox-save{
  position:relative;z-index:2;margin-top:auto;width:100%;background:#7C3AED;color:#fff;
  padding:12px;border-radius:12px;font-size:13px;font-weight:700;text-align:center;letter-spacing:-.01em;
  box-shadow:0 4px 12px rgba(124,58,237,.4);
}

/* NFC tap indicator on the side of the phone */
.nfc-tap{
  position:absolute;top:50%;right:-8px;transform:translateY(-50%);
  width:80px;height:80px;border-radius:50%;border:2px solid #A78BFA;
  display:flex;align-items:center;justify-content:center;
  animation:nfc-pulse 2s ease-out infinite;
}
.nfc-tap::after{
  content:"";position:absolute;inset:14px;border-radius:50%;border:2px solid rgba(167,139,250,.5);
  animation:nfc-pulse 2s ease-out infinite .5s;
}
.nfc-tap .nfc-icon{
  width:24px;height:24px;display:flex;align-items:center;justify-content:center;color:#A78BFA;
}
@keyframes nfc-pulse{
  0%{box-shadow:0 0 0 0 rgba(167,139,250,.6);opacity:1}
  100%{box-shadow:0 0 0 16px rgba(167,139,250,0);opacity:.4}
}

/* QR floating */
.rox-qr{
  position:absolute;left:0;bottom:40px;background:#fff;border-radius:14px;padding:14px;
  box-shadow:0 20px 40px -15px rgba(0,18,92,.3),0 0 30px rgba(124,58,237,.15);
  display:flex;flex-direction:column;align-items:center;gap:8px;border:1px solid rgba(124,58,237,.15);
}
.rox-qr-grid{
  width:64px;height:64px;background:#000;
  display:grid;grid-template-columns:repeat(7,1fr);gap:1px;padding:3px;
}
.rox-qr-grid span{background:#fff}
.rox-qr-grid span:nth-child(2n){background:#000}
.rox-qr-grid span:nth-child(7){background:#fff}
.rox-qr-grid span:nth-child(13){background:#fff}
.rox-qr-grid span:nth-child(20){background:#000}
.rox-qr-grid span:nth-child(26){background:#fff}
.rox-qr-grid span:nth-child(33){background:#000}
.rox-qr label{font-size:9px;font-family:"JetBrains Mono",monospace;color:var(--text-faint);font-weight:600;letter-spacing:.04em}

/* Stats */
.rox-stats{display:grid;grid-template-columns:repeat(3,auto);gap:36px;margin-top:36px;padding-top:28px;border-top:1px solid var(--border-soft);max-width:520px}
.rox-stat .v{font-family:"JetBrains Mono",monospace;font-size:22px;font-weight:700;color:var(--navy-800)}
.rox-stat .l{font-size:11.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-top:4px}

@media (max-width:1100px){
  .rox-grid{grid-template-columns:1fr;gap:48px}
  .rox-section{padding:var(--section-y) 0}
}
@media (max-width:720px){
  .rox-feat-row{grid-template-columns:1fr}
  .rox-stats{grid-template-columns:repeat(2,auto);gap:24px}
  .rox-phone{width:220px;height:440px}
}
