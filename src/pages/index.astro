.legend-dot{width:8px;height:8px;border-radius:2px}
.legend-dot--primary{background:var(--primary)}
.legend-dot--navy{background:var(--navy-700)}
.legend-dot--cyan{background:var(--cyan)}
.legend-line{width:10px;height:2px}
.legend-line--blue{background:#1A5DC8}
