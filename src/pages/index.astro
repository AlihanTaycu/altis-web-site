}
.foot-social a:hover{background:var(--cyan);color:var(--navy-800)}

/* Section connector lines (Saha → Veri → Aksiyon) */
.flow-strip{
  display:flex;align-items:center;justify-content:center;gap:14px;margin:48px 0 0;
  font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.18em;font-weight:600;
}
.flow-strip .ln{width:60px;height:1px;background:var(--border)}

/* Responsive */
@media (max-width:1100px){
