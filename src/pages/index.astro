  .form-grid{grid-template-columns:1fr}
  .field.full{grid-column:span 1}
  .compare-row{grid-template-columns:1fr;gap:0}
  .compare-row > div{padding:12px 18px}
  .foot-grid{grid-template-columns:1fr}
}

