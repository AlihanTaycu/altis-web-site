---
import Base from '../../../../layouts/Base.astro';
import { rfidTagsEn as rfidTags } from '../../../../data/rfid-etiketler';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => rfidTags.map(tag => ({
  params: { slug: tag.slug },
  props: { tag },
}));

const { tag } = Astro.props;
const contactHref = `/en/contact/?product=${encodeURIComponent(tag.title)}`;
const gallery = tag.gallery && tag.gallery.length > 0 ? tag.gallery : [tag.image].filter(Boolean);
const datasheetHref = tag.datasheet?.startsWith('/assets/products/')
  ? tag.datasheet.replace(/\.pdf$/, '-en.pdf')
  : tag.datasheet;
const related = rfidTags
  .filter(item => item.slug !== tag.slug && item.title && item.image && (item.brand === tag.brand || item.onMetal === tag.onMetal))
  .slice(0, 4);
const description = tag.shortDesc || `${tag.title} RFID tag supplied by Altis Technology.`;
const specs = [
  ['Model', tag.model],
  ['SKU', tag.sku],
  ['Frequency', tag.frequencyBand || tag.frequency],
  ['Protocol', tag.protocol],
  ['Chip', tag.chip],
  ['Surface', tag.onMetal ? 'On Metal' : 'Non Metal'],
  ['Form Factor', tag.formFactor],
  ['Size', tag.sizeText],
  ['Material', tag.material],
  ['Fixed Read Range', tag.fixedReadRange],
  ['Handheld Read Range', tag.handheldReadRange],
  ['Operating Temperature', tag.operatingTemp],
  ['IP Rating', tag.ipRating],
].filter(([, value]) => value);

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: tag.title,
  description,
  brand: { '@type': 'Brand', name: tag.brand },
  image: tag.image,
};
---

<Base title={`${tag.title} - Altis Technology`} {description} {schema} lang="en" alternateUrl={`https://www.altis.com.tr/urunler/etiketler/${tag.slug}/`}>
  <nav class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/en/products/">Products</a>
      <span>&rsaquo;</span>
      <a href="/en/products/rfid-tags/">RFID Tags</a>
      <span>&rsaquo;</span>
      <span>{tag.title}</span>
    </div>
  </nav>

  <section class="product-hero container">
    <div class="product-image-col">
      <div class="product-image-wrap" id="product-image-wrap">
        <img id="main-img" src={gallery[0]} alt={tag.title} width="560" height="420" loading="eager" data-index="0" />
        <span class:list={['surface-badge', { metal: tag.onMetal }]}>{tag.onMetal ? 'On Metal' : 'Non Metal'}</span>
        <button class="zoom-hint" type="button" aria-label="Enlarge product image">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          <span>Enlarge</span>
        </button>
      </div>
      {gallery.length > 1 && (
        <div class="gallery-thumbs" id="gallery-thumbs">
          {gallery.map((src, i) => (
            <button class:list={['thumb-btn', { active: i === 0 }]} type="button" data-index={i} aria-label={`Show image ${i + 1}`}>
              <img src={src} alt={`${tag.title} image ${i + 1}`} loading="lazy" />
            </button>
          ))}
        </div>
      )}
      {datasheetHref && (
        <a href={datasheetHref} class="datasheet-card" target="_blank" rel="noopener">
          <span class="datasheet-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6 2h8l4 4v16H6V2Z" fill="currentColor" opacity=".14"/><path d="M14 2v5h5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 2h8l5 5v15H6V2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.4 15.8h7.2M8.4 18.2h5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M8.5 9.5h2.8c1 0 1.7.6 1.7 1.5s-.7 1.5-1.7 1.5H9.8v1.7H8.5V9.5Zm5.4 0h1.9c1.5 0 2.6 1 2.6 2.35 0 1.35-1.1 2.35-2.6 2.35h-1.9V9.5Z" fill="currentColor"/></svg>
          </span>
          <span class="datasheet-copy">
            <span class="datasheet-eyebrow">PDF Documentation</span>
            <span class="datasheet-title">{tag.title} Technical Datasheet</span>
          </span>
          <span class="datasheet-action">Open PDF</span>
        </a>
      )}
    </div>

    <div class="info-col">
      <span class="brand-badge">{tag.brand}</span>
      <h1>{tag.title}</h1>
      <p class="description">{tag.description || description}</p>
      <div class="tag-row">
        {tag.tags.slice(0, 6).map(item => <span>{item}</span>)}
      </div>
      <div class="cta-group">
        <a href={contactHref} class="btn btn-primary btn-lg">Request Quote</a>
        <a href="/en/contact/" class="btn btn-outline btn-lg">Talk to an Expert</a>
      </div>
    </div>
  </section>

  <section class="details-section container">
    <div class="detail-card full">
      <h2>Technical Specifications</h2>
      <div class="spec-grid">
        {specs.map(([label, value]) => (
          <div class="spec-item">
            <span>{label}</span>
            <strong>{value}</strong>
          </div>
        ))}
      </div>
    </div>
    {tag.sections?.map(section => (
      <div class="detail-card full">
        <h2>{section.name}</h2>
        <div class="spec-grid">
          {Object.entries(section.items).map(([label, value]) => (
            <div class="spec-item">
              <span>{label}</span>
              <strong>{value}</strong>
            </div>
          ))}
        </div>
      </div>
    ))}
    {tag.applications.length > 0 && (
      <div class="detail-card full">
        <h2>Applications</h2>
        <div class="app-list">
          {tag.applications.map(item => <span>{item}</span>)}
        </div>
      </div>
    )}
  </section>

  {related.length > 0 && (
    <section class="related-section container">
      <h2>Related Tags</h2>
      <div class="related-grid">
        {related.map(item => (
          <a href={`/en/products/rfid-tags/${item.slug}/`} class="related-card">
            <img src={item.image} alt={item.title} loading="lazy" width="200" height="150" />
            <span>{item.brand}</span>
            <strong>{item.title}</strong>
          </a>
        ))}
      </div>
    </section>
  )}

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Product image viewer" hidden>
    <button class="lb-close" id="lb-close" type="button" aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <div class="lb-stage" id="lb-stage">
      <img class="lb-image" id="lb-image" src="" alt="" />
    </div>
    <div class="lb-toolbar">
      <button class="lb-tool" id="lb-zoom-out" type="button" aria-label="Zoom out">-</button>
      <span class="lb-counter" id="lb-counter">1 / 1</span>
      <button class="lb-tool" id="lb-zoom-in" type="button" aria-label="Zoom in">+</button>
    </div>
  </div>

  <script is:inline define:vars={{ gallery, title: tag.title }}>
    (function () {
      const mainImg = document.getElementById('main-img');
      const wrap = document.getElementById('product-image-wrap');
      const thumbs = document.querySelectorAll('#gallery-thumbs .thumb-btn');
      const lightbox = document.getElementById('lightbox');
      const lbImage = document.getElementById('lb-image');
      const lbCounter = document.getElementById('lb-counter');
      const lbClose = document.getElementById('lb-close');
      const lbStage = document.getElementById('lb-stage');
      const lbZoomIn = document.getElementById('lb-zoom-in');
      const lbZoomOut = document.getElementById('lb-zoom-out');
      if (!mainImg || !wrap || !lightbox || !lbImage || !lbCounter || !lbClose || !lbStage || !lbZoomIn || !lbZoomOut) return;

      let zoom = 1;
      let panX = 0;
      let panY = 0;
      let dragging = false;
      let startX = 0;
      let startY = 0;
      let currentIndex = 0;

      function applyTransform() {
        lbImage.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + zoom + ')';
        lbImage.style.cursor = zoom > 1 ? (dragging ? 'grabbing' : 'grab') : 'zoom-in';
      }

      function setZoom(nextZoom) {
        zoom = Math.max(1, Math.min(4, nextZoom));
        if (zoom === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      function setMainImage(index) {
        currentIndex = (index + gallery.length) % gallery.length;
        mainImg.src = gallery[currentIndex];
        mainImg.dataset.index = String(currentIndex);
        thumbs.forEach((thumb, i) => thumb.classList.toggle('active', i === currentIndex));
      }

      function updateLightbox() {
        lbImage.src = gallery[currentIndex];
        lbImage.alt = title + ' image';
        lbCounter.textContent = (currentIndex + 1) + ' / ' + gallery.length;
        setZoom(1);
      }

      function openLightbox(index) {
        if (typeof index === 'number') setMainImage(index);
        updateLightbox();
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => lightbox.classList.add('open'));
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        setTimeout(() => {
          lightbox.hidden = true;
        }, 220);
      }

      wrap.addEventListener('click', (event) => {
        if (event.target.closest('.zoom-hint') || event.target === mainImg || event.target === wrap) openLightbox();
      });
      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => setMainImage(Number(thumb.dataset.index || 0)));
      });
      lbClose.addEventListener('click', closeLightbox);
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox || event.target === lbStage) closeLightbox();
      });
      document.addEventListener('keydown', (event) => {
        if (lightbox.hidden) return;
        if (event.key === 'Escape') closeLightbox();
        else if (event.key === 'ArrowLeft') { setMainImage(currentIndex - 1); updateLightbox(); }
        else if (event.key === 'ArrowRight') { setMainImage(currentIndex + 1); updateLightbox(); }
        else if (event.key === '+' || event.key === '=') setZoom(zoom + 0.5);
        else if (event.key === '-') setZoom(zoom - 0.5);
      });
      lbZoomIn.addEventListener('click', () => setZoom(zoom + 0.5));
      lbZoomOut.addEventListener('click', () => setZoom(zoom - 0.5));
      lbImage.addEventListener('click', (event) => {
        event.stopPropagation();
        setZoom(zoom === 1 ? 2 : 1);
      });
      lbImage.addEventListener('wheel', (event) => {
        event.preventDefault();
        setZoom(zoom + (event.deltaY < 0 ? 0.25 : -0.25));
      }, { passive: false });
      lbImage.addEventListener('mousedown', (event) => {
        if (zoom <= 1) return;
        dragging = true;
        startX = event.clientX - panX;
        startY = event.clientY - panY;
        applyTransform();
      });
      window.addEventListener('mousemove', (event) => {
        if (!dragging) return;
        panX = event.clientX - startX;
        panY = event.clientY - startY;
        applyTransform();
      });
      window.addEventListener('mouseup', () => {
        dragging = false;
        applyTransform();
      });
    })();
  </script>
</Base>

<style>
.breadcrumb-bar { border-bottom: 1px solid var(--border-soft); background: #fff; }
.breadcrumb-inner { display: flex; align-items: center; gap: 8px; padding: 14px 0; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; }
.breadcrumb-inner a { color: var(--text-muted); transition: color .2s; }
.breadcrumb-inner a:hover, .breadcrumb-inner span:last-child { color: var(--primary); font-weight: 600; }
.product-hero { display: grid; grid-template-columns: .85fr 1fr; gap: 58px; padding-top: 56px; padding-bottom: 56px; align-items: start; }
.product-image-col { display: flex; flex-direction: column; gap: 18px; }
.product-image-wrap { background: #f8f9fb; border: 1px solid var(--border); border-radius: 16px; padding: 32px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; cursor: zoom-in; transition: border-color .2s, box-shadow .2s; }
.product-image-wrap:hover { border-color: rgba(24,183,214,.5); box-shadow: 0 6px 22px rgba(0,18,92,.08); }
.product-image-wrap:hover .zoom-hint { opacity: 1; transform: translateY(0); }
.product-image-wrap img { width: 100%; height: 100%; object-fit: contain; transition: transform .35s ease; }
.product-image-wrap:hover img { transform: scale(1.02); }
.gallery-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
.thumb-btn { width: 72px; height: 58px; border: 1px solid var(--border); border-radius: 8px; background: #fff; padding: 5px; cursor: pointer; transition: border-color .2s, box-shadow .2s, transform .2s; }
.thumb-btn:hover, .thumb-btn.active { border-color: var(--cyan); box-shadow: 0 6px 18px rgba(0,18,92,.08); transform: translateY(-1px); }
.thumb-btn img { width: 100%; height: 100%; object-fit: contain; display: block; }
.zoom-hint { position: absolute; right: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 6px; background: rgba(0,18,92,.85); color: #fff; font-size: 12px; font-weight: 700; padding: 7px 12px; border: none; border-radius: 6px; cursor: zoom-in; opacity: 0; transform: translateY(6px); transition: opacity .2s, transform .2s; backdrop-filter: blur(6px); }
.zoom-hint svg { color: var(--cyan); }
.surface-badge { position: absolute; top: 16px; right: 16px; background: #eef3ff; color: var(--primary); border: 1px solid rgba(0,18,92,.12); font-size: 11px; font-weight: 800; padding: 6px 11px; border-radius: 999px; }
.surface-badge.metal { background: #fff4f3; color: #c62828; border-color: #ffd7d3; }
.datasheet-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; color: var(--text); background: linear-gradient(180deg,#fff,#f8fbff); border: 1px solid #d9e3f3; border-radius: 12px; padding: 16px; min-height: 86px; box-shadow: 0 10px 26px rgba(0,18,92,.06); transition: border-color .2s, box-shadow .2s, transform .2s; }
.datasheet-card:hover { border-color: rgba(24,183,214,.45); box-shadow: 0 10px 28px rgba(0,18,92,.08); transform: translateY(-1px); }
.datasheet-icon { width: 52px; height: 52px; border-radius: 10px; color: #e53935; background: #fff4f3; border: 1px solid #ffd7d3; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.datasheet-copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.datasheet-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--cyan); }
.datasheet-title { font-size: 14px; font-weight: 700; color: var(--primary); line-height: 1.35; }
.datasheet-action { font-size: 12.5px; font-weight: 800; color: #fff; background: #1479d4; border-radius: 6px; padding: 10px 18px; white-space: nowrap; }
.brand-badge { display: inline-flex; color: #fff; background: var(--cyan); border-radius: 20px; padding: 5px 13px; font-size: 11px; font-weight: 800; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 16px; }
.info-col h1 { font-size: clamp(1.5rem,3vw,2.1rem); font-weight: 800; color: var(--primary); line-height: 1.18; margin-bottom: 18px; }
.description { color: var(--text-muted); font-size: 14.5px; line-height: 1.75; margin-bottom: 22px; }
.tag-row, .app-list { display: flex; flex-wrap: wrap; gap: 7px; }
.tag-row span, .app-list span { font-size: 11.5px; font-weight: 700; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); padding: 5px 10px; border-radius: 5px; }
.cta-group { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
.btn-lg { padding: 14px 28px; font-size: 15px; }
.btn-outline { background: transparent; border: 1.5px solid var(--primary); color: var(--primary); }
.details-section { display: grid; gap: 20px; padding-bottom: 60px; }
.detail-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 28px; }
.detail-card h2, .related-section h2 { color: var(--primary); font-size: 1.15rem; font-weight: 800; margin-bottom: 18px; }
.spec-grid { display: grid; grid-template-columns: repeat(auto-fit,minmax(220px,1fr)); gap: 12px; }
.spec-item { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 8px; padding: 12px 14px; }
.spec-item span { display: block; color: var(--text-muted); font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 5px; }
.spec-item strong { color: var(--primary); font-size: 13px; line-height: 1.4; }
.related-section { padding-bottom: 70px; }
.related-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(210px,1fr)); gap: 16px; }
.related-card { background: #fff; border: 1px solid var(--border); border-radius: 10px; padding: 14px; display: flex; flex-direction: column; gap: 7px; }
.related-card img { width: 100%; aspect-ratio: 4/3; object-fit: contain; background: #f8f9fb; border-radius: 8px; padding: 10px; }
.related-card span { color: var(--cyan); font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; }
.related-card strong { color: var(--primary); font-size: 13px; line-height: 1.35; }
.lightbox { position: fixed; inset: 0; background: rgba(6,12,32,.88); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; opacity: 0; transition: opacity .22s ease; }
.lightbox.open { opacity: 1; }
.lightbox[hidden] { display: none; }
.lb-stage { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 56px 80px; box-sizing: border-box; }
.lb-image { max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-in; transition: transform .25s ease; user-select: none; -webkit-user-drag: none; transform-origin: center center; }
.lb-close, .lb-tool { background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.18); border-radius: 6px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .15s, transform .15s; backdrop-filter: blur(8px); }
.lb-close:hover, .lb-tool:hover { background: rgba(255,255,255,.22); transform: scale(1.06); }
.lb-close { position: absolute; top: 22px; right: 22px; z-index: 2; }
.lb-toolbar { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 10px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); border-radius: 6px; padding: 6px 8px; backdrop-filter: blur(8px); z-index: 2; }
.lb-tool { width: 32px; height: 32px; font-size: 18px; font-weight: 700; border: none; background: transparent; }
.lb-counter { color: #fff; font-size: 13px; font-weight: 600; padding: 0 8px; letter-spacing: .04em; }
@media (max-width: 768px) {
  .product-hero { grid-template-columns: 1fr; gap: 32px; }
  .datasheet-card { grid-template-columns: auto 1fr; }
  .datasheet-action { grid-column: 1 / -1; text-align: center; }
  .lb-stage { padding: 60px 16px 80px; }
}
</style>
