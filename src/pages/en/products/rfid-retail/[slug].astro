---
import Base from '../../../../layouts/Base.astro';
import { retailProducts } from '../../../../data/rfid-perakende';
import type { RetailProduct } from '../../../../data/rfid-perakende';
import type { GetStaticPaths } from 'astro';
import { withEnglishRetailCopy } from '../../../../data/english-product-copy';

export const getStaticPaths: GetStaticPaths = () => {
  const englishRetailProducts = retailProducts.map(withEnglishRetailCopy);
  return englishRetailProducts.map(product => ({
    params: { slug: product.slug },
    props: { product },
  }));
};

const props = Astro.props as { product?: RetailProduct; item?: RetailProduct };
const slug = Astro.params.slug;
const product = props.product ?? props.item ?? retailProducts.find(item => item.slug === slug);

if (!product) {
  throw new Error(`RFID retail product not found: ${slug}`);
}

const displayProduct = withEnglishRetailCopy(product);

const gallery = displayProduct.gallery && displayProduct.gallery.length > 0 ? displayProduct.gallery : [displayProduct.image];
const related = retailProducts
  .map(withEnglishRetailCopy)
  .filter(item => item.slug !== product.slug)
  .slice(0, 3);
const contactHref = `/en/contact/?product=${encodeURIComponent(displayProduct.title)}`;
const datasheetHref = displayProduct.datasheet?.replace(/\.pdf$/, '-en.pdf');

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: displayProduct.title,
  description: displayProduct.shortDesc,
  brand: { '@type': 'Brand', name: displayProduct.brand },
  image: displayProduct.image,
  offers: {
    '@type': 'Offer',
    availability: 'https://schema.org/InStock',
    seller: { '@type': 'Organization', name: 'Altis Technology' },
  },
};
---

<Base
  title={`${displayProduct.title} - Altis Technology`}
  description={displayProduct.shortDesc}
  {schema}
  lang="en"
  alternateUrl={`https://www.altis.com.tr/urunler/perakende/${product.slug}/`}
>
  <nav class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/en/products/">Products</a>
      <span>&rsaquo;</span>
      <a href="/en/products/rfid-retail/">RFID Retail Products</a>
      <span>&rsaquo;</span>
      <span>{displayProduct.title}</span>
    </div>
  </nav>

  <section class="product-hero container">
    <div class="product-image-col">
      {displayProduct.isAltisOwn && <div class="own-banner">Altis Technology Own Product</div>}
      <div class="product-image-wrap" id="product-image-wrap">
        <img id="main-img" src={gallery[0]} alt={displayProduct.title} width="560" height="420" loading="eager" data-index="0" />
        <button class="zoom-hint" type="button" aria-label="Enlarge product image">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          <span>Enlarge</span>
        </button>
      </div>
      {gallery.length > 1 && (
        <div class="gallery-thumbs" id="gallery-thumbs">
          {gallery.map((src, i) => (
            <button class:list={['thumb-btn', { active: i === 0 }]} data-index={i} data-src={src} type="button">
              <img src={src} alt={`${displayProduct.title} image ${i + 1}`} width="80" height="60" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="product-info">
      <div class="badges">
        <span class:list={['brand-badge', { 'brand-badge--own': displayProduct.isAltisOwn }]}>{displayProduct.brand}</span>
        <span class="category-badge">{displayProduct.category}</span>
      </div>
      <h1>{displayProduct.title}</h1>

      <div class="connectivity-row">
        <span class="conn-label">Connectivity:</span>
        {displayProduct.connectivity.map(item => <span class="conn-chip">{item}</span>)}
      </div>

      <div class="tags-row">
        {displayProduct.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>

      <p class="description">{displayProduct.shortDesc}</p>

      <div class="cta-group">
        <a href={contactHref} class="btn btn-primary">Request Quote</a>
        <a href="/en/contact/" class="btn btn-outline">Talk to an Expert</a>
      </div>

      <div class="trust-row">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>{displayProduct.isAltisOwn ? 'Altis Product' : 'Official Distributor'}</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Fast Delivery</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <span>Technical Support</span>
        </div>
      </div>

      {datasheetHref && (
        <a href={datasheetHref} class="datasheet-card" target="_blank" rel="noopener">
          <span class="datasheet-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6 2h8l4 4v16H6V2Z" fill="currentColor" opacity=".14"/><path d="M14 2v5h5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 2h8l5 5v15H6V2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.4 15.8h7.2M8.4 18.2h5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M8.5 9.5h2.8c1 0 1.7.6 1.7 1.5s-.7 1.5-1.7 1.5H9.8v1.7H8.5V9.5Zm5.4 0h1.9c1.5 0 2.6 1 2.6 2.35 0 1.35-1.1 2.35-2.6 2.35h-1.9V9.5Z" fill="currentColor"/></svg>
          </span>
          <span class="datasheet-copy">
            <span class="datasheet-eyebrow">PDF Documentation</span>
            <span class="datasheet-title">{displayProduct.title} Technical Datasheet</span>
          </span>
          <span class="datasheet-action">Open PDF</span>
        </a>
      )}
    </div>
  </section>

  <section class="overview-section container" data-reveal>
    <h2 class="section-title">Product Overview</h2>
    <p class="overview-text">
      {displayProduct.title} is positioned for RFID-based product tracking, EAS alarm management, and retail operation
      integration across store entrances, sales areas, checkout points, and warehouse flows. Its UHF RFID architecture,
      fast tag reading performance, and multiple connectivity options help combine inventory visibility, loss prevention,
      and operational verification in a single device.
    </p>
  </section>

  <section class="features-section container" data-reveal>
    <h2 class="section-title">Key Features</h2>
    <ul class="features-list">
      {displayProduct.featureHighlights.map(feature => (
        <li>
          <span class="check-icon" aria-hidden="true">&#10003;</span>
          {feature}
        </li>
      ))}
    </ul>
  </section>

  <section class="specs-section container" data-reveal>
    <h2 class="section-title">Technical Specifications</h2>
    {displayProduct.sections.map(section => (
      <div class="spec-block">
        <h3 class="spec-group-title">{section.name}</h3>
        <table class="spec-table">
          <tbody>
            {Object.entries(section.items).map(([key, value]) => (
              <tr>
                <th>{key}</th>
                <td>{value}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  {related.length > 0 && (
    <section class="related-section container" data-reveal>
      <h2 class="section-title">Related Products</h2>
      <div class="related-grid">
        {related.map(item => (
          <a href={`/en/products/rfid-retail/${item.slug}/`} class="related-card">
            <img src={item.image} alt={item.title} width="200" height="150" loading="lazy" />
            <div class="related-info">
              <span class="related-brand">{item.brand}</span>
              <span class="related-title">{item.title}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cta-strip">
    <div class="container">
      <p>Need more information about this product?</p>
      <a href={contactHref} class="btn btn-primary">Request Quote</a>
    </div>
  </section>

  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Product image viewer" hidden>
    <button class="lb-close" id="lb-close" type="button" aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lb-nav lb-prev" id="lb-prev" type="button" aria-label="Previous image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lb-nav lb-next" id="lb-next" type="button" aria-label="Next image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lb-stage" id="lb-stage">
      <img class="lb-image" id="lb-image" src="" alt="" />
    </div>
    <div class="lb-toolbar">
      <button class="lb-tool" id="lb-zoom-out" type="button" aria-label="Zoom out">-</button>
      <span class="lb-counter" id="lb-counter">1 / 1</span>
      <button class="lb-tool" id="lb-zoom-in" type="button" aria-label="Zoom in">+</button>
    </div>
  </div>

  <script is:inline define:vars={{ gallery, title: displayProduct.title }}>
    (function () {
      const mainImg = document.getElementById('main-img');
      const thumbs = document.querySelectorAll('#gallery-thumbs .thumb-btn');
      const wrap = document.getElementById('product-image-wrap');
      const lightbox = document.getElementById('lightbox');
      const lbImage = document.getElementById('lb-image');
      const lbCounter = document.getElementById('lb-counter');
      const lbClose = document.getElementById('lb-close');
      const lbPrev = document.getElementById('lb-prev');
      const lbNext = document.getElementById('lb-next');
      const lbStage = document.getElementById('lb-stage');
      const lbZoomIn = document.getElementById('lb-zoom-in');
      const lbZoomOut = document.getElementById('lb-zoom-out');
      let currentIndex = 0;
      let zoom = 1;
      let panX = 0;
      let panY = 0;
      let dragging = false;
      let startX = 0;
      let startY = 0;

      function setMain(i) {
        currentIndex = (i + gallery.length) % gallery.length;
        mainImg.src = gallery[currentIndex];
        mainImg.dataset.index = currentIndex;
        thumbs.forEach((thumb, thumbIndex) => thumb.classList.toggle('active', thumbIndex === currentIndex));
      }

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => setMain(parseInt(thumb.dataset.index, 10)));
      });

      function applyTransform() {
        lbImage.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + zoom + ')';
        lbImage.style.cursor = zoom > 1 ? (dragging ? 'grabbing' : 'grab') : 'zoom-in';
      }

      function setZoom(nextZoom) {
        zoom = Math.max(1, Math.min(4, nextZoom));
        if (zoom === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      function updateLightbox() {
        lbImage.src = gallery[currentIndex];
        lbImage.alt = title + ' image ' + (currentIndex + 1);
        lbCounter.textContent = (currentIndex + 1) + ' / ' + gallery.length;
        setZoom(1);
      }

      function openLightbox(index) {
        currentIndex = index;
        updateLightbox();
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => lightbox.classList.add('open'));
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        setTimeout(() => { lightbox.hidden = true; }, 220);
      }

      wrap.addEventListener('click', (event) => {
        if (event.target.closest('.zoom-hint') || event.target === mainImg || event.target === wrap) {
          openLightbox(parseInt(mainImg.dataset.index || '0', 10));
        }
      });

      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + gallery.length) % gallery.length;
        updateLightbox();
      });
      lbNext.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % gallery.length;
        updateLightbox();
      });

      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox || event.target === lbStage) closeLightbox();
      });

      document.addEventListener('keydown', (event) => {
        if (lightbox.hidden) return;
        if (event.key === 'Escape') closeLightbox();
        else if (event.key === 'ArrowLeft') lbPrev.click();
        else if (event.key === 'ArrowRight') lbNext.click();
        else if (event.key === '+' || event.key === '=') setZoom(zoom + 0.5);
        else if (event.key === '-') setZoom(zoom - 0.5);
      });

      lbZoomIn.addEventListener('click', () => setZoom(zoom + 0.5));
      lbZoomOut.addEventListener('click', () => setZoom(zoom - 0.5));

      lbImage.addEventListener('click', (event) => {
        event.stopPropagation();
        if (zoom === 1) setZoom(2);
        else setZoom(1);
      });

      lbImage.addEventListener('wheel', (event) => {
        event.preventDefault();
        setZoom(zoom + (event.deltaY < 0 ? 0.25 : -0.25));
      }, { passive: false });

      lbImage.addEventListener('mousedown', (event) => {
        if (zoom <= 1) return;
        dragging = true;
        startX = event.clientX - panX;
        startY = event.clientY - panY;
        applyTransform();
      });
      window.addEventListener('mousemove', (event) => {
        if (!dragging) return;
        panX = event.clientX - startX;
        panY = event.clientY - startY;
        applyTransform();
      });
      window.addEventListener('mouseup', () => {
        dragging = false;
        applyTransform();
      });

      let touchStartX = null;
      lbStage.addEventListener('touchstart', (event) => {
        if (event.touches.length === 1) touchStartX = event.touches[0].clientX;
      });
      lbStage.addEventListener('touchend', (event) => {
        if (touchStartX === null) return;
        const dx = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50 && zoom === 1) {
          if (dx < 0) lbNext.click();
          else lbPrev.click();
        }
        touchStartX = null;
      });
    })();
  </script>

  <script is:inline>
    (function () {
      const items = document.querySelectorAll('[data-reveal]');
      if (!items.length) return;
      if (!('IntersectionObserver' in window) || window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        items.forEach((el) => el.classList.add('is-visible'));
        return;
      }
      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.add('is-visible');
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.12, rootMargin: '0px 0px -40px 0px' });
      items.forEach((el) => observer.observe(el));
    })();
  </script>
</Base>

<style>
.breadcrumb-bar { background: var(--bg-soft); border-bottom: 1px solid var(--border); padding: 10px 0; }
.breadcrumb-inner { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; }
.breadcrumb-inner a { color: var(--primary); font-weight: 500; transition: color .2s; }
.breadcrumb-inner a:hover { color: var(--cyan); }
.product-hero {
  display: grid;
  grid-template-columns: 0.8fr 1fr;
  gap: 60px;
  padding-top: 56px;
  padding-bottom: 56px;
  align-items: start;
}
.product-image-col { display: flex; flex-direction: column; gap: 12px; }
.product-image-wrap {
  background: #f8f9fb;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320px;
  position: relative;
  cursor: zoom-in;
  transition: border-color .2s, box-shadow .2s;
}
.product-image-wrap:hover { border-color: rgba(24,183,214,.5); box-shadow: 0 6px 22px rgba(0,18,92,.08); }
.product-image-wrap:hover .zoom-hint { opacity: 1; transform: translateY(0); }
.product-image-wrap img { max-width: 100%; max-height: 460px; width: auto; height: auto; object-fit: contain; display: block; transition: transform .35s ease; }
.product-image-wrap:hover img { transform: scale(1.02); }
.zoom-hint {
  position: absolute;
  bottom: 14px;
  right: 14px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(0,18,92,.85);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  padding: 7px 12px;
  border: none;
  border-radius: 6px;
  cursor: zoom-in;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity .2s, transform .2s;
  backdrop-filter: blur(6px);
}
.zoom-hint svg { color: var(--cyan); }
.own-banner {
  align-self: flex-start;
  background: var(--cyan);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-align: center;
  padding: 8px 14px;
  border-radius: 6px;
}
.gallery-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
.thumb-btn {
  padding: 4px;
  border: 2px solid var(--border);
  border-radius: 8px;
  background: #f8f9fb;
  cursor: pointer;
  transition: border-color .2s;
  overflow: hidden;
}
.thumb-btn img { width: 72px; height: 54px; object-fit: contain; display: block; }
.thumb-btn:hover { border-color: var(--primary); }
.thumb-btn.active { border-color: var(--cyan); }
.product-info { display: flex; flex-direction: column; gap: 16px; }
.badges { display: flex; gap: 8px; flex-wrap: wrap; }
.brand-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--primary);
  background: rgba(0,18,92,.07);
  border: 1px solid rgba(0,18,92,.15);
  padding: 4px 12px;
  border-radius: 20px;
}
.brand-badge--own { background: var(--cyan); color: #fff; border-color: var(--cyan); }
.category-badge {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  padding: 4px 12px;
  border-radius: 20px;
}
.product-info h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--primary); line-height: 1.15; margin: 0; }
.connectivity-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.conn-label { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }
.conn-chip { font-size: 12px; font-weight: 600; color: var(--primary); background: rgba(0,18,92,.07); border: 1px solid rgba(0,18,92,.15); padding: 3px 10px; border-radius: 4px; }
.tags-row { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { font-size: 11.5px; font-weight: 600; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); padding: 4px 10px; border-radius: 20px; }
.description { font-size: 0.95rem; color: var(--text-muted); line-height: 1.75; margin: 0; }
.cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
.btn-outline { background: transparent; border: 1.5px solid var(--primary); color: var(--primary); }
.btn-outline:hover { background: var(--primary); color: #fff; }
.trust-row { order: 2; display: flex; gap: 18px; flex-wrap: wrap; padding-top: 4px; }
.trust-item { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-muted); }
.trust-item svg { color: var(--cyan); flex-shrink: 0; }
.datasheet-card {
  order: 3;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin-top: 18px;
  color: var(--text);
  background: linear-gradient(180deg,#fff,#f8fbff);
  border: 1px solid #d9e3f3;
  border-radius: 12px;
  padding: 16px;
  min-height: 86px;
  box-shadow: 0 10px 26px rgba(0,18,92,.06);
  transition: border-color .2s, box-shadow .2s, transform .2s;
}
.datasheet-card:hover { border-color: rgba(24,183,214,.45); box-shadow: 0 10px 28px rgba(0,18,92,.08); transform: translateY(-1px); }
.datasheet-icon {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  color: #e53935;
  background: #fff4f3;
  border: 1px solid #ffd7d3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.datasheet-copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.datasheet-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--cyan); }
.datasheet-title { font-size: 14px; font-weight: 700; color: var(--primary); line-height: 1.35; }
.datasheet-action { font-size: 12.5px; font-weight: 800; color: #fff; background: #1479d4; border-radius: 6px; padding: 10px 18px; white-space: nowrap; }
.section-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 24px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border-soft);
}
.overview-section { padding-top: 48px; }
.overview-text { font-size: 0.94rem; line-height: 1.8; color: var(--text-muted); margin: 0; max-width: 920px; }
.features-section { padding-top: 48px; }
.features-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
.features-list li {
