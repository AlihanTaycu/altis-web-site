---
import Base from '../../../layouts/Base.astro';
import HubHero from '../../../components/sections/HubHero.astro';
import HubCard from '../../../components/sections/HubCard.astro';
import CTABanner from '../../../components/sections/CTABanner.astro';
import { Glasses, Tag, Radio, Smartphone, Printer, Store } from '@lucide/astro';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'RFID Products - Altis Technology',
  description: 'Altis Technology RFID product portfolio: tags, readers, handheld terminals, printers, retail systems, and smart glasses.',
  url: 'https://www.altis.com.tr/en/products/',
};
---

<Base
  title="RFID Products - Altis Technology"
  description="Altis Technology RFID product portfolio: tags, readers, handheld terminals, printers, retail systems, and smart glasses."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/urunler/"
>
  <HubHero
    eyebrow="Product Portfolio"
    heading="RFID hardware and hands-free field devices."
    description="Choose the right RFID hardware and smart glasses for your project. Altis Technology works with leading brands and provides product selection, configuration, and integration support."
  />

  <section class="hub-list">
    <div class="container">
      <div class="featured-row" data-reveal>
        <HubCard
          variant="big"
          href="/en/products/smart-glasses/"
          Icon={Glasses}
          tag="Smart Glasses"
          title="Vuzix Smart Glasses"
          desc="Vuzix M400, M4000, and LX1 smart glasses for hands-free warehouse, manufacturing, field service, and remote support workflows."
          cta="View Products"
        >
          <img
            slot="visual"
            src="/images/vuzix/vuzix-marketing.png"
            alt="Vuzix M400, M4000, and LX1 smart glasses models"
            width="1844"
            height="844"
            loading="lazy"
            decoding="async"
          />
        </HubCard>

        <div class="featured-small-stack">
          <HubCard
            href="/en/products/rfid-tags/"
            Icon={Tag}
            tag="Tags"
            title="RFID Tags"
            desc="UHF, HF, and specialty RFID tags for textile, metal, cold-chain, outdoor, logistics, and retail applications."
            cta="View Products"
          />
          <HubCard
            href="/en/products/rfid-readers/"
            Icon={Radio}
            tag="Readers"
            title="RFID Readers"
            desc="Fixed, portable, and integrated RFID readers for high-speed reads and wide-area coverage."
            cta="View Products"
          />
        </div>
      </div>

      <div class="row-three" data-reveal data-reveal-delay="120">
        <HubCard
          href="/en/products/rfid-handhelds/"
          Icon={Smartphone}
          tag="Handhelds"
          title="RFID Handheld Terminals"
          desc="Mobile RFID terminals for inventory, store, warehouse, and field operations."
          cta="View Products"
        />
        <HubCard
          href="/en/products/rfid-printers/"
          Icon={Printer}
          tag="Printers"
          title="RFID Printers"
          desc="RFID label printing and encoding devices from desktop workflows to industrial operations."
          cta="View Products"
        />
        <HubCard
          variant="dark"
          href="/en/products/rfid-retail/"
          Icon={Store}
          tag="Retail"
          title="RFID Retail"
          desc="Retail RFID systems for EAS, inventory counting, customer experience, and shipment verification."
          cta="View Products"
        />
      </div>
    </div>
  </section>

  <CTABanner
    heading="Need help choosing the right product?"
    description="Our specialists can analyze your scenario and recommend the right RFID hardware or smart glasses setup."
    primaryLabel="Talk to an Expert"
    primaryHref="/en/contact/"
  />
</Base>

<style>
  .hub-list { padding: 40px 0 80px; }

  .featured-row {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .featured-small-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 20px;
  }
  .row-three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 1000px) {
    .featured-row { grid-template-columns: 1fr; }
    .featured-small-stack { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; }
    .row-three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .featured-small-stack { grid-template-columns: 1fr; grid-template-rows: auto auto; }
    .row-three { grid-template-columns: 1fr; }
  }
</style>
