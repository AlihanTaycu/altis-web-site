---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/sections/SectionHead.astro';
import { partnerLogos } from '../../../data/partner-logos';

const heroTrustLogos = partnerLogos.filter(l => ['Zebra','Honeywell','Datalogic','SATO','Nordic ID'].includes(l.name));

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "TrueScan",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "An image-processing solution that turns standard industrial cameras smart with an AI-based reading engine, targeting up to 99.5% 2D/QR/barcode reading performance under pilot conditions.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" },
  "provider": { "@type": "Organization", "name": "Altis Technology" }
};
---

<Base
  title="TrueScan – Industrial Image Processing | Altis Technology"
  description="TrueScan targets up to 99.5% reading performance with AI under pilot conditions, where standard readers struggle in tough field conditions like metal glare, dirty labels, and low contrast."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/cozumler/goruntu-isleme/"
>

<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/solutions/">Solutions</a>
      <span class="sep">/</span>
      <span style="color:var(--primary);font-weight:600">TrueScan</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="solution-pill">
          <span class="pill-tag">Solution</span>
          <span>Image Processing · Artificial Intelligence · Barcode / 2D / QR</span>
        </div>
        <div class="product-name" style="margin: 24px 0 14px">TrueScan</div>
        <h1 class="product-tag">Software reads what hardware can't.</h1>
        <p class="hero-sub">Metal glare, dirty labels, low contrast, perspective distortion — where standard readers struggle, TrueScan makes your existing cameras smart with AI and measurably improves reading performance.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/en/contact/">Request Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#nasil-calisar">How It Works</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v" data-count>99.5%</div><div class="l">pilot target accuracy</div></div>
          <div class="hero-stat"><div class="v">2D · QR</div><div class="l">supported code types</div></div>
          <div class="hero-stat"><div class="v">Existing</div><div class="l">camera infrastructure</div></div>
        </div>
        <p class="hero-note">Pilot results may vary depending on camera, lighting, label, line, and field conditions.</p>
        <div class="hero-trust">
          <span class="hero-trust-label">Our hardware solution partners</span>
          <div class="hero-trust-logos">
            {heroTrustLogos.map(logo => (
              <img src={logo.src} alt={`${logo.name} logo`} width="100" height="32" loading="lazy" />
            ))}
          </div>
        </div>
      </div>

      <!-- Comparison mockup -->
      <div class="compare-card">
        <div class="compare-head">
          <span class="ttl">True Scan</span>
        </div>
        <div class="compare-body">
          <div class="scan-anim" aria-label="TrueScan demo">
            <svg class="scan-base" viewBox="0 0 360 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="metal" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#D5DEF0" />
                  <stop offset=".5" stop-color="#EEF1F7" />
                  <stop offset="1" stop-color="#C5CFE3" />
                </linearGradient>
                <linearGradient id="glare-static" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#fff" stop-opacity="0" />
                  <stop offset=".42" stop-color="#fff" stop-opacity=".7" />
                  <stop offset=".58" stop-color="#fff" stop-opacity=".7" />
                  <stop offset="1" stop-color="#fff" stop-opacity="0" />
                </linearGradient>
                <pattern id="noise" patternUnits="userSpaceOnUse" width="3" height="3">
                  <rect width="3" height="3" fill="rgba(0,0,0,0)" />
                  <circle cx="1" cy="1" r=".4" fill="rgba(0,0,0,.08)" />
                </pattern>
              </defs>
              <rect x="0" y="0" width="360" height="140" fill="url(#metal)" />
              <rect x="0" y="0" width="360" height="140" fill="url(#noise)" />
              {/* Dirty / damaged barcode — deterministic pattern */}
              <g transform="translate(46, 28)" opacity=".88">
                {[2,4,2,3,5,2,4,3,2,5,3,2,4,3,5,2,3,4,2,5,3,2,4,3,5,2,3,5,2,4,3,2,5,3,4,2,5,3].map((w, i, arr) => {
                  const x = arr.slice(0, i).reduce((a, b) => a + b, 0) * 1.85;
                  const dim = (i === 5 || i === 12 || i === 19 || i === 27) ? .25 : (i % 3 === 0 ? .55 : .85);
                  return <rect x={x} y={i % 4 === 0 ? 2 : 0} width={w * .9} height={i % 4 === 0 ? 64 : 66} fill="#0a1f3a" opacity={dim} />;
                })}
              </g>
              <rect x="40" y="20" width="280" height="80" fill="url(#glare-static)" opacity=".6" />
              {/* Dirt smudge */}
              <ellipse cx="240" cy="58" rx="22" ry="14" fill="#5F6675" opacity=".18" />
              <ellipse cx="120" cy="68" rx="18" ry="9" fill="#5F6675" opacity=".14" />
              <text x="50" y="120" font-family="JetBrains Mono, monospace" font-size="8" fill="#475569" opacity=".5">1234 5••• ••12 ••56</text>
            </svg>

            {/* Phase 1 — red standard scan */}
            <div class="scan-line scan-line-red" aria-hidden="true"></div>
            <div class="scan-badge scan-badge-1">STANDARD · SCANNING</div>
            <div class="scan-fail" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
              <span>READ FAILED</span>
            </div>

            {/* Phase 2 — AI corners + cyan scan */}
            <div class="scan-corners" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="scan-line scan-line-cyan" aria-hidden="true"></div>
            <div class="scan-badge scan-badge-2">AI · TRUESCAN STARTED</div>

            {/* Phase 3 — success + extracted data */}
            <div class="scan-success" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>
              <span>99.5% PILOT TARGET</span>
            </div>
            <div class="scan-extracted" aria-hidden="true">
              <span class="se-label">EPC ⟶</span>
              <span class="se-data">3034 ABF1 02C8 6E91</span>
            </div>
          </div>
          <div class="scan-cap">FIELD · METAL SURFACE · HIGH GLARE · DIRTY LABEL</div>

          <div class="compare-row fail">
            <div class="compare-label">
              <div class="dot dot-fail"></div>
              <span>Standard Hardware</span>
            </div>
            <div class="compare-result">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
              <span>Read failed</span>
            </div>
          </div>
          <div class="compare-row pass">
            <div class="compare-label">
              <div class="dot dot-pass"></div>
              <span>TrueScan</span>
            </div>
            <div class="compare-result">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2.5 4-5"></path></svg>
              <span>99.5% in pilot measurement</span>
            </div>
          </div>
          <div class="extracted">
            <span class="ext-label">extracted data</span>
            <code>EPC <strong>3034 ABF1 02C8 6E91</strong> · LOT <strong>YL-2025-08-A4</strong></code>
          </div>
          <div class="condition-tags">
            <span class="ctag">Metal glare</span>
            <span class="ctag">Dirty label</span>
            <span class="ctag">Low contrast</span>
            <span class="ctag">Perspective distortion</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Problem -->
<section class="problem">
  <div class="container">
    <SectionHead
      eyebrow="Problem"
      heading="Barcode reading looks easy in theory, but becomes a bottleneck in the field"
      description="Standard industrial readers are designed for ideal conditions. The real production floor, however, is not ideal."
    />
    <div class="problem-grid" data-reveal data-reveal-delay="100">
      <div class="problem-group">
        <div class="problem-group-label">Field Conditions</div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
          <div>
            <strong>Metal Glare</strong>
            <p>Surface reflections blind the view of standard sensors.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <div>
            <strong>Variable Lighting</strong>
            <p>Low contrast and insufficient lighting trigger read errors.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3-9 4 18 3-9h4"></path></svg>
          <div>
            <strong>Dynamic Environment</strong>
            <p>Moving lines and vibration create focusing problems.</p>
          </div>
        </div>
      </div>
      <div class="problem-group">
        <div class="problem-group-label">Label Condition</div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 3 18 18M9 9c-.9.9-1.5 2.2-1.5 3.5 0 2.8 2.2 5 5 5 1.3 0 2.6-.5 3.5-1.5"></path><path d="M14.5 9.5A3.5 3.5 0 0 0 9.5 14.5"></path><path d="m21 3-9 9"></path></svg>
          <div>
            <strong>Dirty and Damaged</strong>
            <p>Oil, dirt, and physical scratches break barcode integrity.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 2 20 20M7 7H4l-1 5h14M7 7V4h10v3M7 7h10M12 7v4"></path></svg>
          <div>
            <strong>Perspective Loss</strong>
            <p>Tilted angles and deformation lead to geometric distortion.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="9" rx="2"></rect><path d="M6 9V5h12v4"></path></svg>
          <div>
            <strong>Poor Printing</strong>
            <p>Faded and low-resolution prints stop standard readers.</p>
          </div>
        </div>
      </div>
      <div class="problem-impact">
        <div class="impact-label">Critical Losses</div>
        <div class="impact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
          <span>Operational slowdown</span>
        </div>
        <div class="impact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
          <span>Increased manual intervention</span>
        </div>
        <div class="impact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
          <span>High hardware cost</span>
        </div>
        <blockquote>"Barcode reading that looks easy in theory becomes a bottleneck in the field."</blockquote>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="approach" id="nasil-calisar">
  <div class="container">
    <SectionHead
      eyebrow="Approach"
      heading="Software wins, not hardware"
      description="Instead of expensive, specialized hardware, we make existing standard industrial cameras smart with an AI-based reading engine. Investment is protected, capacity is increased."
    />
    <div class="approach-grid" data-reveal data-reveal-delay="100">
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M9 9h6M9 12h6M9 15h4"></path></svg>
        </div>
        <h3>Software-First Architecture</h3>
        <p>A flexible reading engine integrated onto existing standard cameras. Works independently of the hardware brand.</p>
      </div>
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10"></path><path d="M12 6v6l4 2"></path><circle cx="18" cy="6" r="4" fill="currentColor" opacity=".2" stroke="currentColor"></circle><path d="m16 6 2 2 4-4"></path></svg>
        </div>
        <h3>AI-Based Analysis</h3>
        <p>Instead of merely scanning the image, reading is done with deep learning models that interpret every pixel.</p>
      </div>
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <h3>Cost Efficiency</h3>
        <p>Make existing infrastructure smart without needing expensive AI-integrated cameras. Investment is protected.</p>
      </div>
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        </div>
        <h3>Flexible Integration</h3>
        <p>Independent of the hardware brand, fast adaptation to any production line and enterprise system.</p>
      </div>
    </div>
  </div>
</section>

<!-- TrueScan capabilities -->
<section class="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="TrueScan Technology"
      heading="Four algorithms to make sense of the image"
      description="Every field condition creates a different problem. TrueScan solves these four critical problems with separate algorithms."
    />
    <div class="cap-grid" data-reveal data-reveal-delay="100">
      <div class="cap-card">
        <div class="cap-num">01</div>
        <h3>Perspective Correction</h3>
        <p>Corrects images coming from tilted angles in real time. By removing geometric distortion, it brings the barcode to the ideal reading angle.</p>
        <div class="cap-tag">Real-time</div>
      </div>
      <div class="cap-card">
        <div class="cap-num">02</div>
        <h3>Glare Tolerance</h3>
        <p>Filters out light bursts on metal surfaces. With dynamic thresholding algorithms, it recovers the data beneath the glare.</p>
        <div class="cap-tag">Dynamic thresholding</div>
      </div>
      <div class="cap-card">
        <div class="cap-num">03</div>
        <h3>Low-Contrast Reading</h3>
        <p>Analyzes faded prints and labels under insufficient light. It enables reading with pixel-level enhancement using AI.</p>
        <div class="cap-tag">Pixel-level AI</div>
      </div>
      <div class="cap-card">
        <div class="cap-num">04</div>
        <h3>Damage Analysis</h3>
        <p>Completes missing data on dirty, scratched, or torn labels with error-correction codes and pattern recognition.</p>
        <div class="cap-tag">Pattern recognition</div>
      </div>
    </div>
  </div>
</section>

<!-- Case study: Yeşilyurt -->
<section class="casestudy">
  <div class="container">
    <div class="cs-grid" data-reveal>
      <div class="cs-copy">
        <div class="eyebrow">Reference Project</div>
        <h2 style="margin-top:18px">Yeşilyurt Demir Çelik</h2>
        <p style="font-size:17px;margin-top:16px;line-height:1.65">At the production site of Yeşilyurt Demir Çelik, one of Turkey's largest industrial enterprises, faded, low-contrast, and deformed barcodes made it hard for standard industrial readers to produce stable reads. This increased the need for manual checks and re-scanning.</p>
        <p style="font-size:17px;margin-top:14px;line-height:1.65">In the TrueScan pilot, images were enhanced at the software layer, and readable data was transferred to the system more reliably.</p>
        <div class="cs-metrics">
          <div class="cs-metric">
            <div class="cs-v">99.5%</div>
            <div class="cs-l">Pilot accuracy</div>
          </div>
          <div class="cs-metric">
            <div class="cs-v">Reduced</div>
            <div class="cs-l">Manual checks</div>
          </div>
          <div class="cs-metric">
            <div class="cs-v">ISO 500</div>
            <div class="cs-l">Top 100 / 750+ employees</div>
          </div>
        </div>
      </div>
      <div class="cs-results">
        <div class="cs-result-head">Project Gains</div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Stable Reading</strong>
            <span>Reading stability was improved on problematic barcode samples.</span>
          </div>
        </div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Minimal Intervention</strong>
            <span>The need for manual checks and re-scanning was reduced, supporting staff productivity.</span>
          </div>
        </div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>High Confidence</strong>
            <span>Error rates were measurably reduced and data integrity was strengthened.</span>
          </div>
        </div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Faster Flow</strong>
            <span>Reducing read-related stoppages was targeted, and cycle times became trackable.</span>
          </div>
        </div>
        <div class="cs-quote">"Before buying specialized hardware, evaluating existing image data with software is the more accurate first step on most sites."</div>
      </div>
    </div>
  </div>
</section>

<!-- Process -->
<section class="process">
  <div class="container">
    <SectionHead
      eyebrow="How do we start?"
      heading="Go live in three steps"
      description="We start with a single-line pilot and roll out once the measured result is satisfactory."
    />
    <div class="process-grid" data-reveal data-reveal-delay="100">
      <div class="process-card">
        <div class="process-num">01</div>
        <div class="process-time">15–30 min</div>
        <h3>Online discovery</h3>
        <p>We review your existing camera infrastructure, label type, and field conditions via screen sharing. Same-day response.</p>
        <ul class="process-list">
          <li>Existing hardware inventory</li>
          <li>Read-failure samples</li>
          <li>Expected success rate</li>
        </ul>
      </div>
      <div class="process-card process-card-mid">
        <div class="process-num">02</div>
        <div class="process-time">2–4 weeks</div>
        <h3>Field pilot</h3>
        <p>The TrueScan engine is installed on a single line. Existing cameras work unchanged, and the result is measured on site.</p>
        <ul class="process-list">
          <li>Existing camera infrastructure preserved</li>
          <li>Live accuracy report</li>
          <li>Integrated with existing software</li>
        </ul>
      </div>
      <div class="process-card">
        <div class="process-num">03</div>
        <div class="process-time">Phase plan</div>
        <h3>Rollout</h3>
        <p>If pilot results are approved, gradual rollout to other lines and facilities. Operations continue uninterrupted.</p>
        <ul class="process-list">
          <li>Line-based phase plan</li>
          <li>Remote monitoring</li>
          <li>SLA support</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- CTA -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="eyebrow">Demo &amp; Discovery</div>
    <h2>Let's see TrueScan on your own production line</h2>
    <p>Share the environment where you have reading problems and your existing camera infrastructure. Our team will get back to you the same day with an actionable roadmap.</p>
    <div class="hero-cta">
      <a class="btn btn-primary btn-lg" href="/en/contact/">Request Demo
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
      </a>
      <a class="btn btn-secondary btn-lg" href="/en/solutions/">Other Solutions</a>
    </div>
    <div class="cta-channels">
      <a href="tel:+902164158255" class="ch-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span><strong>Phone</strong>+90 216 415 82 55</span>
      </a>
      <a href="mailto:info@altis.com.tr" class="ch-link">
