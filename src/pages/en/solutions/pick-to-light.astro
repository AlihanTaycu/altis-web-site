---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/sections/SectionHead.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Pick-to-Light",
    "brand": { "@type": "Brand", "name": "Altis Technology" },
    "description": "A P2Cloud-based field solution for light-guided picking, put-to-light, and cluster picking operations"
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pick-to-Light System Installation",
    "provider": { "@type": "Organization", "name": "Altis Technology" },
    "serviceType": "Warehouse automation",
    "description": "Pick-to-Light hardware, software, and integration service for warehouse picking operations"
  }
];
---

<Base
  title="Pick-to-Light - Light-Guided Picking Systems | Altis Technology"
  description="Pick-to-Light is the Altis solution that increases warehouse picking speed and accuracy with light modules, the P2Cloud Framework, and WMS/ERP integration."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/cozumler/pick-to-light/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/solutions/pick-to-light/">Products</a>
      <span class="sep">/</span>
      <span style="color:var(--ptl-deep);font-weight:600">Pick-to-Light</span>
    </div>
    <div class="hero-inner">
      <div>
        <div class="platform-pill">
          <span class="pill-tag">Product</span>
          <span>P2Cloud Framework · ThePickToLight.com</span>
        </div>
        <div class="product-name">Pick-to-Light</div>
        <h1 class="product-tag">The light turns on — the operator reaches the right shelf and the right quantity in seconds.</h1>
        <p class="hero-sub">The light-guided picking solution we offer under Altis Technology's in-house <strong style="color:var(--text);font-weight:600">P2Cloud Framework</strong> and registered <strong style="color:var(--text);font-weight:600">ThePickToLight.com</strong> brand directs order-based picking operations with modules placed on the shelves. The operator's hands aren't on paper or a screen; their eyes are only on the lit display, their hands only in the correct bin. It radically increases picking speed and accuracy in e-commerce, retail distribution, pharmaceutical, and spare-parts warehouses.</p>
        <div class="hero-cta">
          <a class="btn btn-ptl btn-lg" href="/en/contact/">Pick-to-Light Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#how">How It Works?</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v">×2-3</div><div class="l">picking speed</div></div>
          <div class="hero-stat"><div class="v">99.9%</div><div class="l">picking accuracy</div></div>
          <div class="hero-stat"><div class="v">~3h</div><div class="l">training time</div></div>
        </div>
      </div>

      <!-- Hero visual: rack with active picking lights -->
      <div class="rack-scene">
        <div class="rack-head">
          <div class="ttl">Active Order · ORDER-78912</div>
          <div class="meta">
            <span>4/12 items</span>
            <span class="live">live</span>
          </div>
        </div>
        <div class="rack" data-reveal>
          <!-- Shelf 1 -->
          <div class="rack-shelf">
            <div class="bin">
              <span class="code">A1-01</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin done">
              <span class="code">A1-02</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A1-03</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin active">
              <span class="code">A1-04</span>
              <div class="lmod"><span class="led"></span><span class="lcd">×3</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A1-05</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A1-06</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
          </div>
          <!-- Shelf 2 -->
          <div class="rack-shelf">
            <div class="bin done">
              <span class="code">A2-01</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A2-02</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin active">
              <span class="code">A2-03</span>
              <div class="lmod"><span class="led"></span><span class="lcd">×1</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A2-04</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A2-05</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin done">
              <span class="code">A2-06</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
          </div>
          <!-- Shelf 3 -->
          <div class="rack-shelf">
            <div class="bin">
              <span class="code">A3-01</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin active">
              <span class="code">A3-02</span>
              <div class="lmod"><span class="led"></span><span class="lcd">×2</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A3-03</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A3-04</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin done">
              <span class="code">A3-05</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A3-06</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
          </div>
        </div>
        <div class="rack-foot">
          <div class="rfoot"><div class="l">Active Bin</div><div class="v amb" data-count>3</div></div>
          <div class="rfoot"><div class="l">Picked</div><div class="v">4 / 12</div></div>
          <div class="rfoot"><div class="l">Time</div><div class="v">02:14</div></div>
          <div class="rfoot"><div class="l">Accuracy</div><div class="v" style="color:#7ED957" data-count>100%</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="howit" id="how">
  <div class="container">
    <SectionHead
      eyebrow="How It Works?"
      heading="The order arrives, the light turns on, the operator picks."
      description="Pick-to-Light simplifies the entire process: paper leaves the operator's pocket, the screen leaves their sight, and their attention focuses only on the shelf and the light."
    />
    <div class="how-grid" data-reveal data-reveal-delay="100">
      <div class="how-step">
        <div class="n">01</div>
        <h3>Order Drops In</h3>
        <p>The order from WMS or ERP is transferred to the <strong style="color:var(--text);font-weight:600">P2Cloud Framework</strong>; the relevant bin addresses and quantities are determined.</p>
        <div class="ex"><span class="lt g"></span>WMS · ORDER-78912 · 12 items</div>
      </div>
      <div class="how-step">
        <div class="n">02</div>
        <h3>Lights Turn On</h3>
        <p>The light modules in the correct bins turn on at the same time; the quantity to pick is shown on each module's digital display.</p>
        <div class="ex"><span class="lt"></span>A1-04 · ×3 · lit yellow</div>
      </div>
      <div class="how-step">
        <div class="n">03</div>
        <h3>Confirm &amp; Finish</h3>
        <p>The operator picks the items and presses the confirm button on the module; the light turns off and the next bin lights up. When picking is complete, the WMS is updated.</p>
        <div class="ex"><span class="lt g"></span>OK · order closed · sent to ERP</div>
      </div>
    </div>
  </div>
</section>

<!-- Hardware showcase -->
<section class="hardware">
  <div class="container">
    <div class="hw-grid" data-reveal data-reveal-delay="100">
      <div class="hw-display">
        <div class="module-big">
          <div class="led-big"></div>
          <div class="lcd-big">×3</div>
          <div class="btn-big">OK</div>
        </div>
        <div class="module-callout tl">
          <div class="dot"></div>
          <div class="ln"></div>
          <span>High-brightness LED</span>
        </div>
        <div class="module-callout tr">
          <span>7-segment digital display</span>
          <div class="ln"></div>
          <div class="dot"></div>
        </div>
        <div class="module-callout bl">
          <div class="dot"></div>
          <div class="ln"></div>
          <span>Confirm button</span>
        </div>
        <div class="module-callout br">
          <span>RS-485 / Ethernet bus</span>
          <div class="ln"></div>
          <div class="dot"></div>
        </div>
      </div>
      <div class="hw-copy">
        <div class="eyebrow">Hardware</div>
        <h2>Simple module, rugged for the field</h2>
        <p style="font-size:17px;margin-top:18px;line-height:1.6">The compact module placed in front of each bin includes a high-brightness LED, a 7-segment digital display, and a confirm button. Modules are chained together via a bus connection and managed from a single controller.</p>
        <div class="hw-features">
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
            <div>
              <h4>Wide-angle, bright LED</h4>
              <p>Visible from a distance even in well-lit warehouses; multiple color options let you distinguish different orders or operators.</p>
            </div>
          </div>
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h2M11 10h2M15 10h2"/></svg></div>
            <div>
              <h4>Digital quantity display</h4>
              <p>3-digit counter; the operator doesn't guess the quantity, they read it from the display. Wrong quantities drop to practically zero.</p>
            </div>
          </div>
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg></div>
            <div>
              <h4>Confirm button</h4>
              <p>Pressed when picking is complete — the record is instantly sent to the WMS. Double-press protection tolerates finger errors.</p>
            </div>
          </div>
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8h12l-2 12H8z"/><path d="M9 8V5a3 3 0 0 1 6 0v3"/></svg></div>
            <div>
              <h4>Industrial durability</h4>
              <p>A housing designed to run 24/7 in dusty, cold, or high-throughput environments; easy field maintenance.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Working modes -->
<section class="modes">
  <div class="container">
    <SectionHead
      eyebrow="Working Modes"
      heading="Pick-to-Light, Put-to-Light, Cluster Picking"
      description="The same hardware can run with different operational logic. Dedicated mode support for each of the picking, distribution, and multi-order scenarios."
    />
    <div class="mode-grid" data-reveal data-reveal-delay="100">
      <div class="mode-card">
        <span class="tag">Mode 01</span>
        <h3>Pick-to-Light</h3>
        <p>The classic mode: the operator comes to the shelf, follows the lights that turn on in sequence for order items, and picks the correct quantity.</p>
        <div class="mode-diagram">
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin lit"><span class="qty">×3</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin lit"><span class="qty">×1</span><div class="mlt"></div></div>
        </div>
        <div class="impact">
          <div><div class="v">×2-3</div><div class="l">picking speed</div></div>
          <div><div class="v">99.9%</div><div class="l">accuracy</div></div>
        </div>
      </div>
      <div class="mode-card">
        <span class="tag">Mode 02</span>
        <h3>Put-to-Light</h3>
        <p>The mode where picked items are placed into the correct order (bin, tote, or bag). Ideal for cross-dock and shipment sortation.</p>
        <div class="mode-diagram">
          <div class="mini-bin green"><span class="qty">↓2</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">↓1</span><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">↓3</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
        </div>
        <div class="impact">
          <div><div class="v">×4</div><div class="l">sortation</div></div>
          <div><div class="v">↓ Errors</div><div class="l">order mix-ups</div></div>
        </div>
      </div>
      <div class="mode-card">
        <span class="tag">Mode 03</span>
        <h3>Cluster Picking</h3>
        <p>Multiple orders are picked at the same time in a single shelf pass. Different colors or bin groups represent different orders.</p>
        <div class="mode-diagram">
          <div class="mini-bin lit"><span class="qty">A×2</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">B×1</span><div class="mlt"></div></div>
          <div class="mini-bin lit"><span class="qty">A×1</span><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">B×2</span><div class="mlt"></div></div>
        </div>
        <div class="impact">
          <div><div class="v">×N</div><div class="l">simultaneous orders</div></div>
          <div><div class="v">↓ 50%</div><div class="l">walking distance</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why pick-to-light -->
<section class="why">
  <div class="container">
    <SectionHead
      eyebrow="Expected Impact"
      heading="Light-guided picking, measurable gains"
      description="Pick-to-Light delivers clear gains especially in high-frequency, multi-item order structures. Typical pilot results:"
    />
    <div class="why-grid" data-reveal data-reveal-delay="100">
      <div class="why-card">
        <div class="b">×2-3<sup></sup></div>
        <div class="lbl">Picking speed</div>
        <div class="meta">2-3x faster picking compared to paper- and mobile-screen-based methods.</div>
      </div>
      <div class="why-card">
        <div class="b">99.9%<sup></sup></div>
        <div class="lbl">Picking accuracy</div>
        <div class="meta">The operator reads the quantity from the display and is guided by light; wrong shelf or wrong quantity is practically eliminated.</div>
      </div>
      <div class="why-card">
        <div class="b">↓ 50<sup>%</sup></div>
        <div class="lbl">Training time</div>
        <div class="meta">A new operator becomes productive within a few hours; a major advantage with seasonal labor.</div>
      </div>
      <div class="why-card">
        <div class="b">↓ 35%<sup></sup></div>
        <div class="lbl">Return &amp; error cost</div>
        <div class="meta">Returns and customer complaints from wrong items or wrong quantities decrease.</div>
      </div>
    </div>
  </div>
</section>

<!-- Architecture -->
<section class="arch">
  <div class="container">
    <SectionHead
      eyebrow="Architecture"
      heading="From WMS / ERP to the shelf, in four blocks"
      description="The path an order takes to reach the Pick-to-Light modules is simple and standard. It integrates with your existing WMS or ERP; a Tag&amp;Trace orchestration layer can be added if desired."
    />
    <div class="arch-diagram">
      <div class="arch-flow">
        <div class="arch-block">
          <div class="lbl">L1 · ENTERPRISE</div>
          <h4>WMS / ERP</h4>
          <p>Order, product, quantity, route information</p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-block core">
          <div class="lbl">L2 · P2CLOUD</div>
          <h4>P2Cloud Framework</h4>
          <p>Cloud-based software framework · order splitting · module management · performance logging</p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-block">
          <div class="lbl">L3 · BUS</div>
          <h4>RS-485 / Ethernet</h4>
          <p>Durable connection between modules</p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-block">
          <div class="lbl">L4 · MODULES</div>
          <h4>Light Modules</h4>
          <p>LED, display, confirm button — in front of every bin</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Use cases -->
<section class="uc">
  <div class="container">
    <SectionHead
      eyebrow="Use Cases"
      heading="Where is Pick-to-Light strongest?"
      description="In high-frequency, multi-item picking operations with high error costs, Pick-to-Light is an indispensable solution."
    />
    <div class="uc-grid" data-reveal data-reveal-delay="100">
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="2"/><circle cx="17" cy="20" r="2"/><path d="M3 4h2l2.4 11.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 7H6"/></svg></div>
        <h3>E-Commerce Warehouses</h3>
        <p>High order volume, short picking time, workload that spikes on campaign days. Pick-to-Light increases capacity 2-3x.</p>
        <div class="typical">typical: 5K+ orders / day</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7v10l8 4 8-4z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg></div>
        <h3>Retail Distribution Centers</h3>
        <p>Order-based shipping to stores. With Put-to-Light mode, different store orders are sorted from the same shelf simultaneously.</p>
        <div class="typical">typical: per store, day/week</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2h4l1 4h-6zM6 6h12l-1 14H7z"/><path d="M9 10v6M15 10v6M12 10v6"/></svg></div>
        <h3>Pharmaceutical &amp; Cosmetics Warehouses</h3>
        <p>High SKU count, small packaging, strict accuracy requirements. A wrong item creates regulatory and brand-loss costs.</p>
        <div class="typical">typical: GMP / GDP compliant</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 6v6l3 3"/></svg></div>
        <h3>Spare Parts Warehouses</h3>
        <p>10,000+ small SKUs, where minutes matter on a service order. Pick-to-Light makes learning the layout unnecessary; every part is found by light.</p>
        <div class="typical">typical: 10K+ SKU inventory</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M3 12h18M3 18h18"/><circle cx="6" cy="6" r="1"/><circle cx="6" cy="12" r="1"/><circle cx="6" cy="18" r="1"/></svg></div>
        <h3>Textile Warehouses</h3>
        <p>Color/size variants and seasonal peaks. With cluster picking, 4-8 orders are completed simultaneously in a single shelf pass.</p>
        <div class="typical">typical: fast fashion · seasonal campaign</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 7h18l-2 12H5z"/><path d="M8 7V4h8v3M9 11h6M9 15h6"/></svg></div>
        <h3>Cross-Dock &amp; Sortation</h3>
        <p>With Put-to-Light mode, incoming products are routed directly to the relevant shipping bin. The storage step is bypassed.</p>
        <div class="typical">typical: same-day shipping</div>
      </article>
    </div>
  </div>
</section>







<!-- CTA -->
<section class="cta-section">
  <div class="container cta-inner">
    <div class="eyebrow">Pick-to-Light Demo &amp; Discovery</div>
    <h2>Let's measure together how it will work in your warehouse</h2>
    <p>Let's evaluate your operation profile (SKU count, order volume, current picking method). We'll come back with pilot scope, investment scale, and an achievable payback period.</p>
    <div class="hero-cta">
      <a class="btn btn-ptl btn-lg" href="/en/contact/">Request Demo
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      <a class="btn btn-secondary btn-lg" href="/en/platforms/tag-trace/">Go to Tag&amp;Trace</a>
    </div>
  </div>
</section>
</Base>

<style>
:root{
  /* Pick-to-Light accent tokens */
  --ptl:#E8A317;
  --ptl-deep:#B8800F;
  --ptl-soft:#FFF6E0;
  --ptl-glow:rgba(232,163,23,.35);
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
}
/* PtL amber eyebrow override */
.eyebrow{color:var(--ptl-deep)}
.eyebrow::before{background:var(--ptl)}
/* PtL accent button */
.btn-ptl{background:var(--ptl);color:#1a1200;box-shadow:0 6px 20px -10px var(--ptl-glow)}
.btn-ptl:hover{background:var(--ptl-deep);color:#fff;transform:translateY(-1px)}

/* Breadcrumb */
.breadcrumb{padding:24px 0 0;font-size:13px;color:var(--text-faint);display:flex;align-items:center;gap:10px;position:relative;z-index:2}
.breadcrumb a{color:var(--text-muted)}
.breadcrumb a:hover{color:var(--primary)}
.breadcrumb .sep{opacity:.5}

/* Hero */
.hero{
  position:relative;padding:48px 0 120px;overflow:hidden;
  background:
    radial-gradient(900px 500px at 80% -100px, rgba(232,163,23,.12), transparent 60%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid-bg{
  position:absolute;inset:0;pointer-events:none;opacity:.35;
  background-image:linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center;margin-top:32px}
.platform-pill{display:inline-flex;align-items:center;gap:10px;max-width:100%;flex-wrap:wrap;white-space:normal;line-height:1.35;padding:7px 14px 7px 8px;border-radius:6px;background:#fff;border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--slate);box-shadow:var(--shadow-sm)}
.platform-pill .pill-tag{background:var(--ptl);color:#1a1200;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:6px;text-transform:uppercase}
.product-name{
  font-size:clamp(48px,6vw,84px);font-weight:800;letter-spacing:-.035em;line-height:1;
  background:linear-gradient(135deg,#00125C 0%,#B8800F 60%,#E8A317 130%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin:24px 0 14px;padding-bottom:0.12em;
}
.hero h1.product-tag{font-size:clamp(26px,2.4vw,36px);font-weight:700;line-height:1.2;color:var(--navy-800)}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:540px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.hero-stats{display:grid;grid-template-columns:repeat(3,auto);gap:36px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);max-width:540px}
.hero-stat .v{font-family:"JetBrains Mono",monospace;font-size:24px;font-weight:700;color:var(--navy-800)}
.hero-stat .l{font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-top:4px}

/* Hero visual — rack with light modules */
.rack-scene{
  max-width:100%;min-width:0;background:#0F0F14;border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);overflow:hidden;position:relative;
  padding:32px;
}
.rack-scene::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(600px 300px at 30% 20%, rgba(232,163,23,.12), transparent 60%),
    repeating-linear-gradient(90deg,transparent,transparent 20px,rgba(255,255,255,.02) 20px,rgba(255,255,255,.02) 21px),
    repeating-linear-gradient(0deg,transparent,transparent 20px,rgba(255,255,255,.02) 20px,rgba(255,255,255,.02) 21px);
}
.rack-head{position:relative;display:flex;justify-content:space-between;align-items:center;color:#fff;margin-bottom:24px;font-size:12px}
.rack-head .ttl{font-weight:600;letter-spacing:-.01em}
.rack-head .meta{font-family:"JetBrains Mono",monospace;color:rgba(255,255,255,.5);font-size:11px;display:flex;gap:12px;align-items:center}
.rack-head .live{display:inline-flex;align-items:center;gap:5px;color:var(--ptl);font-weight:600}
.rack-head .live::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ptl);box-shadow:0 0 8px var(--ptl);animation:pulse 1.4s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.rack{position:relative;background:#1a1a22;border-radius:10px;padding:16px;display:grid;grid-template-rows:repeat(3,1fr);gap:12px;min-height:380px}
.rack-shelf{
  position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:8px;
  padding:12px 8px;background:linear-gradient(180deg,#222230,#1a1a22);border-radius:6px;
  border-top:1px solid rgba(255,255,255,.05);
}
.bin{
  position:relative;height:60px;background:linear-gradient(180deg,#2a2a35,#1f1f28);
  border:1px solid rgba(255,255,255,.04);border-radius:4px;
  display:flex;flex-direction:column;justify-content:flex-end;padding:4px;
  transition:transform .2s var(--ease,ease), border-color .2s;
}
.bin:hover{transform:translateY(-2px);border-color:rgba(255,255,255,.14)}
.bin .code{
  position:absolute;top:4px;left:5px;font-family:"JetBrains Mono",monospace;font-size:8.5px;
  color:rgba(255,255,255,.35);font-weight:600;letter-spacing:.04em;
}
/* Light module sitting under each shelf */
.lmod{
  position:relative;background:linear-gradient(180deg,#15151c,#0a0a0e);
  border:1px solid rgba(255,255,255,.06);border-radius:3px;
  height:22px;display:flex;align-items:center;justify-content:space-between;padding:0 8px;
  margin-top:6px;
}
.lmod .led{width:7px;height:7px;border-radius:50%;background:#2a2a35;flex-shrink:0;transition:all .3s}
.lmod .lcd{
  font-family:"JetBrains Mono",monospace;font-size:10px;color:#3a3a45;font-weight:700;
  letter-spacing:.04em;
}
.lmod .btn-tiny{
  width:14px;height:8px;background:#2a2a35;border-radius:2px;display:flex;align-items:center;justify-content:center;
}
/* Active states */
.bin.active .lmod .led{background:var(--ptl);box-shadow:0 0 8px var(--ptl),0 0 14px var(--ptl-glow)}
.bin.active .lmod .lcd{color:var(--ptl);text-shadow:0 0 6px var(--ptl-glow)}
.bin.active{box-shadow:inset 0 0 0 1px var(--ptl),0 0 18px var(--ptl-glow)}
.bin.active .code{color:var(--ptl);opacity:.8}
.bin.done .lmod .led{background:var(--ok);box-shadow:0 0 4px rgba(21,160,107,.6)}
.bin.done .lmod .lcd{color:var(--ok)}
/* Active LEDs breathe; staggered shelf-to-shelf for a gentle wave */
@media (prefers-reduced-motion: no-preference){
  .bin.active .lmod .led{animation:ledBreathe 1.9s ease-in-out infinite}
  .rack-shelf:nth-child(2) .bin.active .lmod .led{animation-delay:.45s}
  .rack-shelf:nth-child(3) .bin.active .lmod .led{animation-delay:.9s}
  @keyframes ledBreathe{
    0%,100%{box-shadow:0 0 6px var(--ptl),0 0 10px var(--ptl-glow);opacity:.82}
    50%{box-shadow:0 0 12px var(--ptl),0 0 22px var(--ptl-glow);opacity:1}
  }
}

.rack-foot{
  position:relative;margin-top:24px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px;
}
.rfoot{background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.06);border-radius:8px;padding:10px 12px}
.rfoot .l{font-size:9.5px;color:rgba(255,255,255,.5);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.rfoot .v{font-family:"JetBrains Mono",monospace;font-size:17px;font-weight:700;color:#fff;margin-top:4px}
.rfoot .v.amb{color:var(--ptl)}

/* Sections */
section{padding:110px 0}
.section-head{max-width:780px;margin:0 auto 64px;text-align:center}
.section-head.left{margin-left:0;text-align:left}
.section-head h2{margin-top:18px}
.section-head p{font-size:18px;margin-top:18px}

/* How it works — 3 step */
.howit{background:var(--bg-soft)}
.how-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;margin-top:48px;position:relative}
.how-step{background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:36px 32px;position:relative;transition:transform .25s,box-shadow .25s}
.how-step:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.how-step .n{
  position:absolute;top:-18px;left:32px;
  width:48px;height:48px;border-radius:12px;background:var(--ptl);color:#1a1200;
  display:flex;align-items:center;justify-content:center;font-weight:700;font-size:18px;
  font-family:"JetBrains Mono",monospace;
  box-shadow:0 4px 12px var(--ptl-glow);
}
.how-step h3{font-size:22px;margin:18px 0 12px}
.how-step p{font-size:15px;line-height:1.6}
.how-step .ex{
  margin-top:18px;padding:14px;background:var(--bg-soft);border-radius:10px;
  font-family:"JetBrains Mono",monospace;font-size:11.5px;color:var(--slate);
  display:flex;align-items:center;gap:10px;
}
.how-step .ex .lt{width:8px;height:8px;border-radius:50%;background:var(--ptl);box-shadow:0 0 6px var(--ptl)}
.how-step .ex .lt.g{background:var(--ok);box-shadow:0 0 4px rgba(21,160,107,.5)}

/* Hardware module showcase */
.hardware{background:#fff}
.hw-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.hw-copy h2{font-size:36px}
.hw-features{display:grid;gap:18px;margin-top:32px}
.hw-feat{display:flex;gap:16px;align-items:flex-start}
.hw-feat .ic{width:40px;height:40px;border-radius:10px;background:var(--ptl-soft);color:var(--ptl-deep);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.hw-feat h4{font-size:15.5px;color:var(--navy-800);margin-bottom:4px}
.hw-feat p{font-size:13.5px;line-height:1.55}

/* Hardware visual — close-up of light module */
.hw-display{
  position:relative;background:#0F0F14;border-radius:var(--radius-lg);padding:48px;
  box-shadow:var(--shadow-lg);overflow:hidden;min-height:480px;
  display:flex;align-items:center;justify-content:center;
}
.hw-display::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(circle at center, rgba(232,163,23,.18), transparent 60%);
}
.module-big{
  position:relative;background:linear-gradient(180deg,#1a1a22,#0a0a0e);
  border:1.5px solid rgba(255,255,255,.08);border-radius:14px;
  padding:28px 32px;display:flex;align-items:center;gap:28px;min-width:380px;
  box-shadow:0 30px 60px -20px rgba(0,0,0,.6),0 0 60px var(--ptl-glow);
}
.module-big .led-big{
  width:36px;height:36px;border-radius:50%;background:var(--ptl);
  box-shadow:0 0 20px var(--ptl),0 0 40px var(--ptl-glow),inset 0 -3px 8px rgba(0,0,0,.4);
  position:relative;flex-shrink:0;animation:blink-slow 1.6s infinite;
}
.module-big .led-big::after{
  content:"";position:absolute;inset:6px;background:radial-gradient(circle, #FFD970, var(--ptl));border-radius:50%;
}
@keyframes blink-slow{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.85;transform:scale(.96)}}
.module-big .lcd-big{
  flex:1;background:#000;border:1px solid rgba(232,163,23,.3);border-radius:6px;padding:14px 18px;
  font-family:"JetBrains Mono",monospace;font-size:48px;font-weight:700;color:var(--ptl);
  letter-spacing:.05em;text-shadow:0 0 12px var(--ptl-glow);text-align:center;
}
.module-big .btn-big{
  width:48px;height:48px;border-radius:8px;background:#2a2a35;border:1px solid rgba(255,255,255,.1);
  display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.5);font-size:12px;
  font-family:"JetBrains Mono",monospace;font-weight:600;letter-spacing:.05em;flex-shrink:0;
}
.module-callout{
  position:absolute;display:flex;align-items:center;gap:8px;color:#fff;font-size:12px;
  font-weight:500;
}
.module-callout .dot{width:8px;height:8px;border-radius:50%;background:var(--ptl);flex-shrink:0;box-shadow:0 0 8px var(--ptl)}
.module-callout .ln{height:1px;background:linear-gradient(90deg,var(--ptl),transparent);flex:1}
.module-callout.tl{top:80px;left:60px}
.module-callout.tr{top:80px;right:60px;flex-direction:row-reverse}
.module-callout.tr .ln{background:linear-gradient(-90deg,var(--ptl),transparent)}
.module-callout.bl{bottom:80px;left:60px}
.module-callout.br{bottom:80px;right:60px;flex-direction:row-reverse}
.module-callout.br .ln{background:linear-gradient(-90deg,var(--ptl),transparent)}

/* Modes (Pick-to-Light, Put-to-Light, Cluster) */
.modes{background:var(--bg-soft)}
.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}
.mode-card{
  background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);
  padding:32px;display:flex;flex-direction:column;gap:18px;transition:all .25s;position:relative;overflow:hidden;
}
.mode-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.mode-card .tag{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ptl-deep);align-self:flex-start;background:var(--ptl-soft);padding:5px 10px;border-radius:6px}
.mode-card h3{font-size:22px}
.mode-card p{font-size:14.5px;line-height:1.55}
/* mini diagrams per mode */
.mode-diagram{
  height:140px;background:#0F0F14;border-radius:10px;padding:16px;
  display:flex;align-items:center;justify-content:center;gap:10px;
}
.mini-bin{
  width:40px;height:50px;background:#1a1a22;border:1px solid rgba(255,255,255,.06);border-radius:3px;
  position:relative;display:flex;align-items:end;padding:3px;
}
.mini-bin .mlt{width:5px;height:5px;border-radius:50%;background:#2a2a35;margin:auto auto 0}
.mini-bin.lit{box-shadow:inset 0 0 0 1px var(--ptl),0 0 14px var(--ptl-glow)}
.mini-bin.lit .mlt{background:var(--ptl);box-shadow:0 0 6px var(--ptl)}
.mini-bin.green{box-shadow:inset 0 0 0 1px var(--ok),0 0 10px rgba(21,160,107,.4)}
.mini-bin.green .mlt{background:var(--ok)}
.mini-bin .qty{font-family:"JetBrains Mono",monospace;font-size:9px;color:var(--ptl);font-weight:700;position:absolute;top:4px;left:0;right:0;text-align:center;text-shadow:0 0 4px var(--ptl-glow)}
.mini-bin.green .qty{color:var(--ok);text-shadow:none}
.mode-card .impact{margin-top:auto;padding-top:14px;border-top:1px dashed var(--border-soft);display:flex;gap:24px}
.impact .v{font-family:"JetBrains Mono",monospace;font-size:18px;font-weight:700;color:var(--ptl-deep)}
.impact .l{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-top:2px}

/* Why pick-to-light */
.why{padding:110px 0}
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.why-card{
  background:linear-gradient(180deg,#fff,#FAFBFE);
  border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px 28px;
  position:relative;overflow:hidden;
}
.why-card::before{
  content:"";position:absolute;top:-30px;right:-30px;width:120px;height:120px;border-radius:50%;
  background:radial-gradient(circle, var(--ptl-soft) 0%, transparent 70%);
}
.why-card .b{position:relative;font-family:"JetBrains Mono",monospace;font-size:46px;font-weight:700;color:var(--navy-800);line-height:1;letter-spacing:-.04em}
.why-card .b sup{font-size:18px;color:var(--ptl-deep);font-weight:700;margin-left:2px}
.why-card .lbl{position:relative;font-size:14px;color:var(--slate);font-weight:600;margin-top:14px}
.why-card .meta{position:relative;font-size:12.5px;color:var(--text-muted);margin-top:6px;line-height:1.55}

/* Architecture */
.arch{background:var(--navy-800);color:#fff;position:relative;overflow:hidden}
.arch::before{
  content:"";position:absolute;inset:0;
  background-image:linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px);
  background-size:48px 48px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 80%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 80%);
}
.arch .container{position:relative}
.arch h2{color:#fff}
.arch .section-head p{color:rgba(255,255,255,.7)}
.arch .eyebrow{color:var(--ptl)}
.arch .eyebrow::before{background:var(--ptl)}
.arch-diagram{margin-top:48px;background:rgba(255,255,255,.03);border:1px solid rgba(255,255,255,.1);border-radius:18px;padding:48px}
.arch-flow{
  display:grid;grid-template-columns:1fr auto 1fr auto 1fr auto 1fr;gap:14px;align-items:center;
}
.arch-block{
  background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);border-radius:12px;
  padding:20px;text-align:center;
}
.arch-block.core{background:linear-gradient(135deg,rgba(232,163,23,.25),rgba(0,18,92,.4));border-color:var(--ptl)}
.arch-block .lbl{font-family:"JetBrains Mono",monospace;font-size:10.5px;color:var(--ptl);letter-spacing:.1em;font-weight:600;margin-bottom:10px}
.arch-block h4{color:#fff;font-size:15px;margin-bottom:8px}
.arch-block p{color:rgba(255,255,255,.6);font-size:12.5px;line-height:1.45}
.arch-arrow{
  width:32px;height:32px;display:flex;align-items:center;justify-content:center;
  color:var(--ptl);font-size:20px;
}

/* Use cases */
.uc{background:#fff}
.uc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.uc-card{background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:32px;display:flex;flex-direction:column;gap:14px;transition:all .25s}
.uc-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--ptl)}
.uc-card .ic{width:44px;height:44px;border-radius:11px;background:var(--ptl-soft);color:var(--ptl-deep);display:flex;align-items:center;justify-content:center}
.uc-card h3{font-size:18px}
.uc-card p{font-size:14px;line-height:1.55}
.uc-card .typical{margin-top:auto;padding-top:14px;border-top:1px dashed var(--border-soft);font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--text-faint);letter-spacing:.04em}

/* Compare with tag&trace */
.compare-block{padding:110px 0;background:var(--bg-soft)}
.compare-table{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden;box-shadow:var(--shadow-sm);max-width:1000px;margin:48px auto 0}
.crow{display:grid;grid-template-columns:1.4fr 1fr 1fr;align-items:center;border-bottom:1px solid var(--border-soft)}
.crow:last-child{border-bottom:none}
.crow > div{padding:18px 24px;font-size:14px}
.crow.head{background:var(--navy-800);color:#fff}
.crow.head > div{font-weight:700;font-size:14px;padding:20px 24px}
.crow.head .col-tt{color:var(--cyan)}
.crow.head .col-pl{color:var(--ptl)}
.crow .need{font-weight:500;color:var(--text)}
.crow .yes{color:var(--primary);font-weight:600;display:flex;align-items:center;gap:8px}
.crow .partial{color:var(--text-muted);display:flex;align-items:center;gap:8px}
.crow .focus{color:var(--ptl-deep);font-weight:600;display:flex;align-items:center;gap:8px}
.dot-yes{width:18px;height:18px;border-radius:50%;background:var(--primary);color:#fff;display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}
.dot-yes.ptl{background:var(--ptl);color:#1a1200}
.dot-no{width:18px;height:18px;border-radius:50%;background:var(--border);color:var(--text-faint);display:flex;align-items:center;justify-content:center;font-size:11px;font-weight:700;flex-shrink:0}

/* Cross-link */
.crosslink{padding:90px 0}
.crosslink-card{background:linear-gradient(135deg,#FFF,#FAFBFE);border:1px solid var(--border);border-radius:var(--radius-lg);padding:48px;display:grid;grid-template-columns:1fr auto;gap:32px;align-items:center;box-shadow:var(--shadow-sm)}
.crosslink-card .lbl{font-size:11px;font-weight:600;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint)}
.crosslink-card h3{font-size:26px;margin-top:10px;margin-bottom:10px}
.crosslink-card p{font-size:15px;max-width:640px}

/* Specs */
.specs{background:var(--bg-soft)}
.specs-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin-top:48px;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);overflow:hidden}
.spec-row{display:grid;grid-template-columns:200px 1fr;padding:22px 28px;border-bottom:1px solid var(--border-soft);border-right:1px solid var(--border-soft)}
.spec-row:nth-child(2n){border-right:none}
.spec-row:nth-last-child(-n+2){border-bottom:none}
.spec-row .k{font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.spec-row .v{font-size:14px;color:var(--slate);line-height:1.55}
.spec-row .v code{font-family:"JetBrains Mono",monospace;font-size:12.5px;background:var(--bg-soft);padding:2px 7px;border-radius:4px;color:var(--navy-800);font-weight:600}

/* CTA */
.cta-section{background:var(--navy-800);color:#fff;position:relative;overflow:hidden;padding:110px 0}
.cta-section::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(700px 400px at 80% 50%, rgba(232,163,23,.18), transparent 60%);
