<style>
:root{
  --navy-900:#000A3A;--navy-800:#00125C;--navy-700:#0A1E75;
  --bg:#FFFFFF;--bg-soft:#F6F8FC;--bg-blue:#EEF3FF;
  --text:#111827;--text-muted:#5F6675;--text-faint:#8A93A5;
  --border:#E3E8F2;--border-soft:#EEF1F7;
  --cyan:#18B7D6;--cyan-soft:#E8FAFD;
  --steel:#8B95A5;--slate:#334155;
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
  --primary:var(--navy-800);
  /* Retail & Textile — aubergine/plum, fashion-appropriate, not-red */
  --sector:#8E3F73;
  --sector-deep:#5D2A4D;
  --sector-soft:#F7EDF3;
  --sector-glow:rgba(142,63,115,.2);
  --radius:14px;--radius-lg:22px;
  --shadow-sm:0 1px 2px rgba(0,18,92,.04);
  --shadow:0 8px 28px -12px rgba(0,18,92,.18),0 2px 6px rgba(0,18,92,.05);
  --shadow-lg:0 30px 60px -25px rgba(0,18,92,.28),0 8px 20px -8px rgba(0,18,92,.12);
  --container:1240px;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:"Inter",system-ui,sans-serif;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.55}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}
.container{max-width:var(--container);margin:0 auto;padding:0 32px}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--sector-deep);display:inline-flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:24px;height:1px;background:var(--sector)}
h1,h2,h3,h4{font-family:inherit;color:var(--navy-800);margin:0;letter-spacing:-.02em;line-height:1.15;text-wrap:balance}
h1{font-size:clamp(40px,5vw,68px);font-weight:700}
h2{font-size:clamp(30px,3.2vw,44px);font-weight:700;letter-spacing:-.025em}
h3{font-size:20px;font-weight:600}
h4{font-size:16px;font-weight:600}
p{margin:0;color:var(--text-muted);text-wrap:pretty}

/* Header */
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--border-soft)}
.nav{display:flex;align-items:center;justify-content:space-between;height:76px}
.logo{display:flex;align-items:center;gap:12px}
.logo img{height:30px;width:auto}
.nav-links{display:flex;align-items:center;gap:36px}
.nav-links a{font-size:14.5px;color:var(--text);font-weight:500}
.nav-links a:hover{color:var(--primary)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;font-weight:600;font-size:14.5px;border-radius:10px;transition:all .2s;white-space:nowrap}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 6px 20px -10px rgba(0,18,92,.6)}
.btn-primary:hover{transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--primary);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--bg-soft)}
.btn-lg{padding:16px 28px;font-size:15.5px;border-radius:12px}

/* Breadcrumb */
.breadcrumb{padding:24px 0 0;font-size:13px;color:var(--text-faint);display:flex;align-items:center;gap:10px;position:relative;z-index:2}
.breadcrumb a{color:var(--text-muted)}
.breadcrumb a:hover{color:var(--primary)}
.breadcrumb .sep{opacity:.5}

/* Hero */
.hero{
  position:relative;padding:48px 0 120px;overflow:hidden;
  background:
    radial-gradient(900px 500px at 80% -100px, rgba(142,63,115,.10), transparent 60%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid-bg{
  position:absolute;inset:0;pointer-events:none;opacity:.35;
  background-image:linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1.05fr 1.05fr;gap:56px;align-items:center;margin-top:32px}
.sector-pill{display:inline-flex;align-items:center;gap:10px;padding:7px 14px 7px 8px;border-radius:6px;background:#fff;border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--slate);box-shadow:var(--shadow-sm)}
.sector-pill .pill-tag{background:var(--sector);color:#fff;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:6px;text-transform:uppercase}
.hero h1{margin-top:24px}
.hero h1 em{color:var(--sector);font-style:normal}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:540px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.hero-platforms{display:flex;gap:8px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);align-items:center;max-width:540px;flex-wrap:wrap}
.hero-platforms .lbl{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-right:6px}
.plat-chip{font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:7px;display:inline-flex;align-items:center;gap:6px;background:var(--bg-blue);color:var(--primary)}

/* Hero visual — RFID retail journey */
.retail-vis{
  position:relative;background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);overflow:hidden;
}
.retail-head{padding:14px 18px;border-bottom:1px solid var(--border-soft);background:#FCFCFE;display:flex;justify-content:space-between;align-items:center}
.retail-head .ttl{font-weight:600;font-size:13px;color:var(--navy-800)}
.retail-head .meta{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--text-faint);display:flex;gap:10px;align-items:center}
.retail-head .live{display:inline-flex;align-items:center;gap:5px;color:var(--ok);font-weight:600}
.retail-head .live::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 0 rgba(21,160,107,.5);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(21,160,107,.5)}70%{box-shadow:0 0 0 8px rgba(21,160,107,0)}100%{box-shadow:0 0 0 0 rgba(21,160,107,0)}}

.retail-body{padding:22px;background:linear-gradient(180deg,#FAFBFE,#fff);min-height:460px}

/* Journey stages */
.journey{
  display:grid;grid-template-columns:1fr 1fr 1fr;gap:14px;margin-bottom:18px;
  position:relative;
}
.journey-stage{
  background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:14px 12px;
  text-align:center;position:relative;display:flex;flex-direction:column;gap:8px;
}
.journey-stage .ic{
  width:38px;height:38px;border-radius:9px;background:var(--sector-soft);color:var(--sector-deep);
  display:flex;align-items:center;justify-content:center;margin:0 auto;
}
.journey-stage .lbl{font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:700}
.journey-stage .nm{font-size:13px;font-weight:600;color:var(--navy-800)}
.journey-stage .cnt{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--sector-deep);font-weight:700;background:var(--sector-soft);padding:3px 8px;border-radius:5px}
.journey-arrow{
  position:absolute;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--sector);font-size:14px;
  display:flex;align-items:center;justify-content:center;
}
.journey-arrow.a1{left:33.3%;margin-left:-7px}
.journey-arrow.a2{left:66.6%;margin-left:-7px}

/* RFID stream */
.rfid-stream{
  background:#0F0F14;border-radius:10px;padding:16px;position:relative;overflow:hidden;
}
.rfid-stream .head{display:flex;justify-content:space-between;color:#fff;font-size:11px;margin-bottom:12px;font-weight:600}
.rfid-stream .right{font-family:"JetBrains Mono",monospace;color:rgba(255,255,255,.5);font-size:10px;font-weight:500}
.tag-grid{display:grid;grid-template-columns:repeat(12,1fr);gap:4px}
.tag-pill{
  height:18px;border-radius:3px;background:linear-gradient(180deg,#2a2a35,#1a1a22);
  position:relative;border:1px solid rgba(255,255,255,.05);
}
.tag-pill.read{
  background:linear-gradient(180deg,rgba(142,63,115,.3),rgba(142,63,115,.15));
  border-color:var(--sector);box-shadow:0 0 6px rgba(142,63,115,.4);
}
.tag-pill.read::after{
  content:"";position:absolute;inset:1px;border-radius:2px;
  background:radial-gradient(circle at center, var(--sector), transparent 70%);opacity:.4;
}
.tag-pill.miss{
  background:linear-gradient(180deg,#3a1a1a,#2a0a0a);border-color:#d64545;
}
.tag-pill.shipped{
  background:linear-gradient(180deg,rgba(21,160,107,.4),rgba(21,160,107,.2));
  border-color:#15a06b;
}
.stream-stats{display:flex;justify-content:space-between;margin-top:12px;font-size:10px;color:rgba(255,255,255,.5);font-family:"JetBrains Mono",monospace}
.stream-stats .stat{display:flex;gap:5px;align-items:center}
.stream-stats .dot{width:8px;height:8px;border-radius:50%}
.stream-stats .dot.s{background:var(--sector)}
.stream-stats .dot.o{background:#15a06b}
.stream-stats .dot.x{background:#d64545}

/* Retail KPIs */
.retail-kpi-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
.retail-kpi{background:#fff;border:1px solid var(--border-soft);border-radius:8px;padding:10px 12px}
.retail-kpi .l{font-size:9.5px;color:var(--text-faint);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.retail-kpi .v{font-family:"JetBrains Mono",monospace;font-size:17px;font-weight:700;color:var(--navy-800);margin-top:3px}
.retail-kpi .v.ok{color:var(--ok)}
.retail-kpi .v.s{color:var(--sector-deep)}
.retail-kpi .meta{font-size:9.5px;color:var(--text-muted);margin-top:2px}

/* Sections */
section{padding:110px 0}
.section-head{max-width:780px;margin:0 auto 64px;text-align:center}
.section-head.left{margin-left:0;text-align:left}
.section-head h2{margin-top:18px}
.section-head p{font-size:18px;margin-top:18px}

/* Pain points */
.pains{background:var(--bg-soft)}
.pain-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.pain-card{background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:30px 26px;transition:all .25s;position:relative;overflow:hidden}
.pain-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.pain-card::before{content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--sector);opacity:0;transition:opacity .25s}
.pain-card:hover::before{opacity:1}
.pain-card .qty{font-family:"JetBrains Mono",monospace;font-size:30px;font-weight:700;color:var(--sector);line-height:1;margin-bottom:14px}
.pain-card h3{font-size:17px;margin-bottom:10px}
.pain-card p{font-size:13.5px;line-height:1.6}

/* Solution mapping */
.solution{position:relative;background:#fff}
.sol-map{display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:40px;align-items:stretch;background:linear-gradient(180deg,#FFF,#FAFBFE);border:1px solid var(--border);border-radius:var(--radius-lg);padding:48px;box-shadow:var(--shadow-sm);position:relative;overflow:hidden}
.sol-col h4{font-size:11px;font-family:"JetBrains Mono",monospace;color:var(--text-faint);letter-spacing:.1em;font-weight:600;margin-bottom:18px;text-transform:uppercase}
.sol-col .group{display:flex;flex-direction:column;gap:10px}
.sol-tile{background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:12px 14px;font-size:13.5px;font-weight:500;color:var(--slate);display:flex;align-items:center;gap:10px}
.sol-tile svg{color:var(--sector);flex-shrink:0}
.sol-platform{display:flex;flex-direction:column;gap:14px;justify-content:center}
.plat-card{background:#fff;border:1.5px solid var(--primary);border-radius:14px;padding:18px;box-shadow:var(--shadow-sm)}
.plat-card .nm{font-size:20px;font-weight:700;color:var(--primary);letter-spacing:-.01em;margin-bottom:6px}
.plat-card .role{font-size:12px;color:var(--text-muted);font-weight:500}
.plat-card ul{list-style:none;padding:0;margin:14px 0 0;display:flex;flex-direction:column;gap:6px}
.plat-card li{font-size:12.5px;color:var(--slate);display:flex;align-items:center;gap:8px}
.plat-card li::before{content:"";width:5px;height:5px;border-radius:50%;background:var(--primary)}

/* Use cases */
.uc{background:var(--bg-soft)}
.uc-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}
.uc-card{background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:32px;display:flex;flex-direction:column;gap:14px;transition:all .25s}
.uc-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.uc-card .ic{width:44px;height:44px;border-radius:11px;background:var(--sector-soft);color:var(--sector-deep);display:flex;align-items:center;justify-content:center}
.uc-card h3{font-size:18px}
.uc-card p{font-size:14px;line-height:1.55}
.uc-impact{margin-top:auto;padding-top:18px;border-top:1px dashed var(--border-soft);display:flex;gap:18px}
.uc-impact .m .v{font-family:"JetBrains Mono",monospace;font-size:18px;font-weight:700;color:var(--sector-deep)}
.uc-impact .m .l{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-top:2px}

/* RFID Hardware showcase — Altis tunnel & box */
.hw{padding:120px 0;background:#fff}
.hw-grid{display:grid;grid-template-columns:1.05fr 1fr;gap:64px;align-items:center}
.hw .badge{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--sector-deep);padding:5px 10px;background:var(--sector-soft);border-radius:6px}
.hw h3{font-size:32px;margin-top:18px;margin-bottom:18px}
.hw p{font-size:16.5px;line-height:1.65;margin-bottom:20px}
.hw ul.kv{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:14px}
.hw ul.kv li{display:flex;gap:12px;align-items:flex-start;font-size:14.5px;color:var(--slate)}
.hw ul.kv li svg{color:var(--sector);flex-shrink:0;margin-top:3px}
.hw ul.kv strong{color:var(--text);font-weight:600;display:block;margin-bottom:2px}

/* RFID Tunnel visual */
.tunnel-stage{
  position:relative;background:#0F0F14;border-radius:var(--radius-lg);padding:52px 32px 28px;
  box-shadow:var(--shadow-lg);overflow:hidden;min-height:480px;
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:26px;
}
.tunnel-stage::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(600px 300px at 50% 40%, rgba(142,63,115,.18), transparent 60%),
    repeating-linear-gradient(90deg,transparent,transparent 20px,rgba(255,255,255,.02) 20px,rgba(255,255,255,.02) 21px);
}
.tunnel-scene{
  position:relative;z-index:1;width:100%;max-width:380px;
  display:flex;flex-direction:column;align-items:center;gap:22px;
}
.tunnel{
  position:relative;width:100%;max-width:380px;height:220px;
}
.tunnel-frame{
  position:absolute;inset:0;border:3px solid var(--sector);border-radius:12px;
  background:linear-gradient(180deg,rgba(142,63,115,.05),transparent);
  box-shadow:0 0 40px rgba(142,63,115,.3),inset 0 0 20px rgba(142,63,115,.1);
}
.tunnel-frame::before,.tunnel-frame::after{
  content:"";position:absolute;top:-8px;width:30px;height:8px;background:var(--sector);
  border-radius:4px 4px 0 0;
}
.tunnel-frame::before{left:30px}
.tunnel-frame::after{right:30px}
.tunnel-label{
  position:absolute;top:-32px;left:50%;transform:translateX(-50%);
  font-family:"JetBrains Mono",monospace;font-size:10px;color:var(--sector);font-weight:700;
  letter-spacing:.1em;text-transform:uppercase;background:#0F0F14;padding:4px 12px;
  border:1px solid var(--sector);border-radius:5px;
}
.tunnel-antenna{
  position:absolute;width:14px;height:30px;background:linear-gradient(180deg,var(--sector),var(--sector-deep));
  border-radius:4px;
}
.tunnel-antenna.l1{top:14px;left:14px}
.tunnel-antenna.l2{bottom:14px;left:14px}
.tunnel-antenna.r1{top:14px;right:14px}
.tunnel-antenna.r2{bottom:14px;right:14px}
.tunnel-antenna::after{
  content:"";position:absolute;width:30px;height:30px;border-radius:50%;
  border:1.5px solid var(--sector);left:50%;top:50%;transform:translate(-50%,-50%);
  animation:antenna-pulse 1.6s ease-out infinite;opacity:0;
}
.tunnel-antenna.l1::after{animation-delay:0s}
.tunnel-antenna.r1::after{animation-delay:.4s}
.tunnel-antenna.l2::after{animation-delay:.8s}
