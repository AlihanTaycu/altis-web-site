---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/sections/SectionHead.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Manufacturing IoT and Operational Intelligence Solutions",
  "provider": { "@type": "Organization", "name": "Altis Technology" },
  "serviceType": "Manufacturing IoT and operational intelligence",
  "areaServed": "TR",
  "description": "OEE, predictive maintenance, energy monitoring, production traceability, SCADA, MES, and ERP integration solutions for manufacturing facilities"
};
---

<Base
  title="IoT and Operational Intelligence Solutions for Manufacturing | Altis Technology"
  description="Live OEE, predictive maintenance, energy monitoring, production traceability, SCADA/MES/ERP integration, and operational intelligence solutions for manufacturing facilities."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/sektorler/uretim/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/sectors/manufacturing/">Sectors</a>
      <span class="sep">/</span>
      <span style="color:var(--sector);font-weight:600">Manufacturing</span>
    </div>
    <div class="hero-inner">
      <div>
        <div class="sector-pill">
          <span class="pill-tag">Sector</span>
          <span>Factory · Production Line · Maintenance · Energy</span>
        </div>
        <h1>See line efficiency, machine health, and energy — <em>on the same screen</em>.</h1>
        <p class="hero-sub">Data from sensors, PLCs, SCADA, and energy meters comes together in Predictivo's single operational intelligence layer. OEE scores, predictive maintenance alerts, line performance, and energy consumption are monitored in real time; alarms and actions are automated with a visual rule engine.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/en/contact/">Request a Factory Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#use-cases">Explore Scenarios</a>
        </div>
        <div class="hero-platforms">
          <span class="lbl">Platforms used:</span>
          <a href="/en/platforms/predictivo/" class="plat-chip pr">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
            Predictivo
          </a>
          <a href="/en/platforms/tag-trace/" class="plat-chip tt">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/></svg>
            Tag&amp;Trace
          </a>
        </div>
      </div>

      <!-- Hero visual: factory line dashboard -->
      <div class="factory">
        <div class="fac-head">
          <div class="ttl">Facility · Line 02 · Shift B</div>
          <div class="meta">
            <span class="live">live</span>
            <span>08:14 · 4h 14m</span>
          </div>
        </div>
        <div class="fac-body">
          <div class="fac-kpi">
            <div class="l">OEE</div>
            <div class="v ok">82.4%</div>
            <div class="trend up">▲ 3.2 vs yesterday</div>
          </div>
          <div class="fac-kpi">
            <div class="l">Output / hour</div>
            <div class="v">412</div>
            <div class="trend up">target 400</div>
          </div>
          <div class="fac-kpi">
            <div class="l">Active Alarms</div>
            <div class="v warn">2</div>
            <div class="trend dn">1 critical · 1 warning</div>
          </div>

          <!-- Production line stations -->
          <div class="fac-line">
            <div class="head">
              <span>Line 02 · Station Health</span>
              <span class="right">live · vibration · heat · OEE</span>
            </div>
            <div class="fac-stations">
              <div class="station ok">
                <div class="name">CNC-01</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="16"/></svg>
                  <div class="pct">86</div>
                </div>
                <div class="label">Machining</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station warn">
                <div class="name">CNC-02</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="56"/></svg>
                  <div class="pct">50</div>
                </div>
                <div class="label">Vibration ↑</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station crit">
                <div class="name">WELD-03</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="85"/></svg>
                  <div class="pct">25</div>
                </div>
                <div class="label">Maintenance suggested</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station ok">
                <div class="name">QC-04</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="11"/></svg>
                  <div class="pct">90</div>
                </div>
                <div class="label">Quality</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station ok">
                <div class="name">PACK-05</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="22"/></svg>
                  <div class="pct">80</div>
                </div>
                <div class="label">Packaging</div>
              </div>
              <div class="belt-arrow"><svg width="14" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
            </div>
          </div>

          <!-- Energy chart -->
          <div class="fac-chart">
            <div class="head">
              <h5>Energy Consumption · last 12 hours</h5>
              <span class="meta">142 kWh · ▼ 7%</span>
            </div>
            <svg viewBox="0 0 320 60" preserveAspectRatio="none">
              <defs>
                <linearGradient id="g-energy" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0F8FA8" stop-opacity=".4"/>
                  <stop offset="100%" stop-color="#0F8FA8" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,45 L26,38 L52,40 L78,25 L104,32 L130,18 L156,24 L182,12 L208,22 L234,8 L260,18 L286,10 L320,16 L320,60 L0,60 Z" fill="url(#g-energy)"/>
              <path d="M0,45 L26,38 L52,40 L78,25 L104,32 L130,18 L156,24 L182,12 L208,22 L234,8 L260,18 L286,10 L320,16" stroke="#0F8FA8" stroke-width="2" fill="none" stroke-linecap="round"/>
              <circle cx="320" cy="16" r="3" fill="#fff" stroke="#0F8FA8" stroke-width="2"/>
            </svg>
          </div>

          <!-- Alarm strip -->
          <div class="alarm-strip">
            <span class="sev">Critical</span>
            <span class="txt"><strong>WELD-03</strong> · Vibration threshold exceeded 4.8 mm/s — work order created</span>
            <span class="t">2m ago</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pain points -->
<section class="pains">
  <div class="container">
    <SectionHead
      eyebrow="In Manufacturing Operations"
      heading="Sound familiar?"
      description="On modern production lines, data is everywhere — but it doesn't reach the right person at the right time. This disconnect turns into unplanned downtime, quality issues, and wasted energy."
    />
    <div class="pain-grid" data-reveal data-reveal-delay="100">
      <div class="pain-card">
        <div class="qty">∼ 30%</div>
        <h3>Invisible OEE loss</h3>
        <p>When availability, performance, and quality aren't measured together, real efficiency stays hidden in reports; improvement becomes guesswork.</p>
      </div>
      <div class="pain-card">
        <div class="qty">× Hours</div>
        <h3>Unexpected downtime</h3>
        <p>Machine vibration, heat, or current signals trouble a day in advance, but no one sees it. The failure erupts mid-shift when it could have been scheduled for planned maintenance.</p>
      </div>
      <div class="pain-card">
        <div class="qty">↑ kWh</div>
        <h3>Opaque energy use</h3>
        <p>The monthly bill tells you the total amount; it doesn't show how much energy was consumed by which line, which shift, or per unit produced.</p>
      </div>
      <div class="pain-card">
        <div class="qty">~ Manual</div>
        <h3>Records written into Excel</h3>
        <p>The operator enters data into Excel at the end of the shift; the report comes out a day later. By the time a problem is noticed, it's already too late to act.</p>
      </div>
    </div>
  </div>
</section>

<!-- Solution mapping -->
<section class="solution">
  <div class="container">
    <SectionHead
      eyebrow="Solution Map"
      heading="In manufacturing, every data source has the right platform"
      description="Different data sources in the manufacturing ecosystem require different capabilities. Predictivo handles the IoT and operational intelligence side; Tag&amp;Trace handles product traceability on the production line."
    />
    <div class="sol-map">
      <div class="sol-col">
        <h4>Need</h4>
        <div class="group">
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg>OEE &amp; line performance</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h3M18 12h3M12 3v3M12 18v3"/><circle cx="12" cy="12" r="4"/></svg>Machine health &amp; predictive maintenance</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg>Energy monitoring &amp; efficiency</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg>Ambient sensing (temperature, humidity, CO₂)</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v4H4zM4 12h16v4H4zM4 20h10"/><circle cx="18" cy="20" r="2"/></svg>Production traceability</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg>Management dashboards &amp; reports</div>
        </div>
      </div>
      <div class="sol-col sol-platform">
        <div class="plat-card">
          <div class="nm">Predictivo</div>
          <div class="role">Industrial IoT &amp; Operational Intelligence</div>
          <ul>
            <li>Live monitoring of OEE, machine health, energy</li>
            <li>Visual rule engine · alarms &amp; notifications</li>
            <li>MQTT · OPC UA · Modbus · SCADA connectivity</li>
            <li>Automated PDF reports · shift comparison</li>
          </ul>
        </div>
        <div class="plat-card tt">
          <div class="nm">Tag&amp;Trace</div>
          <div class="role">Product traceability &amp; line orchestration</div>
          <ul>
            <li>Station-based RFID / barcode reading</li>
            <li>Operator, part, and lot traceability</li>
            <li>Automatic logging to MES / ERP</li>
            <li>Label printing · product → quality chain</li>
          </ul>
        </div>
      </div>
      <div class="sol-col">
        <h4>Result</h4>
        <div class="group">
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Live OEE &amp; performance</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Failures detected in advance</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Line / product-level energy</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Lot ↔ quality traceability</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Shift comparison</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>MES / ERP parity</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Use cases -->
<section class="uc" id="use-cases">
  <div class="container">
    <SectionHead
      eyebrow="Manufacturing Scenarios"
      heading="6 actionable solutions for the factory"
      description="The scenarios below can start with a pilot line or a group of machines; once validated, they roll out across the entire facility."
    />
    <div class="uc-grid" data-reveal data-reveal-delay="100">
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg></div>
        <h3>Live OEE &amp; Line Performance</h3>
        <p>A live OEE score calculated from the Availability · Performance · Quality triad. Comparable by shift, line, and product; daily lost minutes become transparent.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">RT</div><div class="l">live score</div></div>
          <div class="m"><div class="v">×N</div><div class="l">shift comparison</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 4-5"/></svg></div>
        <h3>Predictive Maintenance</h3>
        <p>Vibration, temperature, current, and runtime data are analyzed to detect failure risk early. When a threshold is exceeded, a work order is created automatically and an SMS is sent to the maintenance team.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">↓ Downtime</div><div class="l">unplanned failures</div></div>
          <div class="m"><div class="v">Auto</div><div class="l">work order</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
        <h3>Energy Monitoring &amp; Efficiency</h3>
        <p>Electricity, gas, steam, and compressed air consumption become transparent per line, shift, and product. Above-target consumption instantly alerts the manager.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">↓ 15%</div><div class="l">typical savings</div></div>
          <div class="m"><div class="v">SKU</div><div class="l">cost per unit</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v4H4zM4 12h16v4H4zM4 20h10"/><circle cx="18" cy="20" r="2"/></svg></div>
        <h3>Production Traceability</h3>
        <p>Every product's journey on the line — station, operator, lot, quality check — is tracked with RFID or barcode. Recalls and root-cause analysis take seconds.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">Lot</div><div class="l">full traceability</div></div>
          <div class="m"><div class="v">Auto</div><div class="l">quality record</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h3>Ambient Monitoring</h3>
        <p>Temperature, humidity, CO₂, and air quality are continuously monitored across production areas; critical processes keep automatic, regulation-compliant records.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">7×24</div><div class="l">continuous logging</div></div>
          <div class="m"><div class="v">Audit</div><div class="l">traceable log</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></div>
        <h3>Management Reports</h3>
        <p>Daily operations, weekly performance, and monthly energy and maintenance reports are shared automatically as PDFs with management and operations teams.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">Auto</div><div class="l">PDF · scheduled</div></div>
          <div class="m"><div class="v">Role</div><div class="l">based distribution</div></div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Operations flow -->
<section class="opflow">
  <div class="container">
    <SectionHead
      eyebrow="Data Flow"
      heading="From the sensor on the floor to the management screen, in five steps"
      description="The path a vibration sensor's reading takes to reach the KPI screen in a management meeting. At every step: the right device, the right protocol, the right decision."
    />
    <div class="op-steps">
      <div class="op-step">
        <div class="step-num">01</div>
        <h4>Sensor Data</h4>
        <p>Real-time measurement from a vibration, temperature, current, or energy meter.</p>
        <span class="device">MQTT · Modbus</span>
      </div>
      <div class="op-step">
        <div class="step-num">02</div>
        <h4>Gateway / Edge</h4>
        <p>Data is collected and pre-processed locally; nothing is lost even on an offline network.</p>
        <span class="device">Edge Gateway</span>
      </div>
      <div class="op-step">
        <div class="step-num">03</div>
        <h4>Predictivo Core</h4>
        <p>Stored as time series; passes through the rule engine, threshold breaches are processed.</p>
        <span class="device">Rule Engine</span>
      </div>
      <div class="op-step">
        <div class="step-num">04</div>
        <h4>Action</h4>
        <p>Alarms, email, SMS, work orders, or device triggers fire automatically.</p>
        <span class="device">Webhook · CMMS</span>
      </div>
      <div class="op-step">
        <div class="step-num">05</div>
        <h4>Dashboard &amp; Report</h4>
        <p>Management, production, and maintenance teams see it live on role-based dashboards.</p>
        <span class="device">Web · PDF</span>
      </div>
    </div>
  </div>
</section>

<!-- ROI -->
<section class="roi">
  <div class="container">
    <SectionHead
      eyebrow="Expected Impact"
      heading="When data becomes visible, the factory learns"
      description="Typical operational improvements observed in pilot projects. Results vary by field conditions, machine age, and existing operational maturity."
    />
    <div class="roi-grid" data-reveal data-reveal-delay="100">
      <div class="roi-card">
        <div class="b">+10%<sup></sup></div>
        <div class="lbl">OEE increase</div>
        <div class="meta">Visibility plus early intervention brings line efficiency closer to the target level.</div>
      </div>
      <div class="roi-card">
        <div class="b">↓ 35%<sup></sup></div>
        <div class="lbl">Unplanned downtime</div>
        <div class="meta">Predictive maintenance alerts move failures to planned maintenance.</div>
      </div>
      <div class="roi-card">
        <div class="b">↓ 15%<sup></sup></div>
        <div class="lbl">Energy consumption</div>
        <div class="meta">Line / shift / SKU-level transparency exposes idle consumption and waste.</div>
      </div>
      <div class="roi-card">
        <div class="b">×N<sup></sup></div>
        <div class="lbl">Faster root-cause</div>
        <div class="meta">With lot traceability, quality issues are narrowed down to the relevant station and operator in seconds.</div>
      </div>
    </div>
  </div>
</section>

<!-- Integration -->
<section class="integ">
  <div class="container">
    <div class="integ-grid" data-reveal data-reveal-delay="100">
      <div>
        <div class="eyebrow">SCADA &amp; MES &amp; ERP Integration</div>
        <h2 style="margin-top:18px">Works with your existing automation infrastructure</h2>
        <p style="font-size:17px;margin-top:18px;line-height:1.6">Predictivo isn't designed to replace your existing PLC, SCADA, and MES systems — it's designed to make sense of and surface their data. Data flows both ways; the automation team stays in place, while management and maintenance teams gain a decision-support layer.</p>
        <div class="integ-list">
          <div class="integ-row">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><path d="M9 9h6v6H9z"/></svg></div>
            <div>
              <strong>PLC / SCADA connectivity</strong>
              <span>Siemens S7, Allen-Bradley, Mitsubishi, Beckhoff, OMRON, and any OPC UA-supported SCADA.</span>
            </div>
          </div>
          <div class="integ-row">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg></div>
            <div>
              <strong>IoT &amp; sensors</strong>
              <span>Sensors and meters connect directly to the platform via MQTT, LoRaWAN, NB-IoT, and Modbus.</span>
            </div>
          </div>
          <div class="integ-row">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></div>
            <div>
              <strong>MES / ERP integration</strong>
              <span>Production orders, status, lot, and quality records; two-way with SAP, Oracle, Logo, and custom systems.</span>
            </div>
          </div>
        </div>
