---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/sections/SectionHead.astro';
import CTABanner from '../../../components/sections/CTABanner.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Tag&Trace",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "RFID orchestration platform for managing operations from a single center",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" }
};
---

<Base
  title="Tag&Trace - RFID Orchestration Platform | Altis Technology"
  description="Tag&Trace is an RFID orchestration platform that connects RFID readers, printers, barcode systems, PLCs, sensors, and enterprise systems."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/platformlar/tag-trace/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/platforms/tag-trace/">Platforms</a>
      <span class="sep">/</span>
      <span style="color:var(--primary);font-weight:600">Tag&amp;Trace</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="platform-pill">
          <span class="pill-tag">Platform</span>
          <span>RFID and Auto-ID Orchestration · Edge Framework</span>
        </div>
        <div class="product-name" style="background-position: center center; background-size: cover; margin: 24px 0px 14px;">Tag<span class="amp" style=""><span style="color: rgba(0, 0, 0, 0.808);">&nbsp;&amp;&nbsp;</span></span>Trace</div>
        <h1 class="product-tag">Manage your RFID devices with confidence.</h1>
        <p class="hero-sub">A powerful orchestration and edge framework platform for RFID readers, printers, barcode systems, PLCs, sensors, and enterprise systems. Manage RFID hardware from one center, process data at the source, and transfer it reliably to your business systems.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/en/contact/">Request Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#capabilities">Explore Capabilities</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v" data-count>50+</div><div class="l">supported hardware</div></div>
          <div class="hero-stat"><div class="v" data-count>9</div><div class="l">protocols</div></div>
          <div class="hero-stat"><div class="v">7×24</div><div class="l">edge continuity</div></div>
        </div>
      </div>

      <!-- Live EPC stream panel -->
      <div class="hero-panel">
        <div class="panel-head">
          <span class="ttl">EPC Stream · Live</span>
          <span class="right"><span class="live-dot"></span>RDR-01 · Dispatch Door A</span>
        </div>
        <div class="epc-stream">
          <div class="epc-row new">
            <span class="ts">14:32:07.841</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 02 1F</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row new">
            <span class="ts">14:32:07.839</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 02 1E</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:07.612</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 02 1D</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:06.204</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 01 A2</span></span>
            <span class="ev warn">⚠ MISSING</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:05.991</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 01 A1</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:05.440</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 01 A0</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:04.118</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 00 F9</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row dim">
            <span class="ts">14:32:03.882</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 00 F8</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
        </div>
        <div class="panel-footer">
          <span>ORDER-78912 · 7/8 matched</span>
          <span style="color:#15a06b;font-weight:600">→ SAP confirmed</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trusted by -->
<div class="logos-strip">
  <div class="container">
    <div class="lbl">— Field-tested and integrated with enterprise systems —</div>
    <div class="logos-row">
      <div class="logo-box">Zebra</div>
      <div class="logo-box">Impinj</div>
      <div class="logo-box">Honeywell</div>
      <div class="logo-box">Nordic ID</div>
      <div class="logo-box">SATO</div>
      <div class="logo-box">Datalogic</div>
    </div>
  </div>
</div>

<!-- Three Pillars -->
<section class="pillars" id="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="Three Core Capabilities"
      heading="Manage devices, process data, connect systems"
      description="Tag&amp;Trace is built around three core capabilities that turn complex RFID hardware deployments into a standard operating interface."
    />
    <div class="pillar-grid" data-reveal data-reveal-delay="100">
      <div class="pillar">
        <div class="pn">01 · DEVICES</div>
        <h3>Vendor-independent device management</h3>
        <p>RFID readers, printers, barcode systems, PLCs, and sensors are registered, configured, and monitored from one center. Different brands and models are abstracted into a standard device object.</p>
        <ul>
          <li>Reader antenna, power, and session management</li>
          <li>Printer templates and print queue</li>
          <li>Device health and uptime monitoring</li>
          <li>Bulk configuration profiles</li>
        </ul>
      </div>
      <div class="pillar">
        <div class="pn">02 · DATA</div>
        <h3>Visual rule engine and edge processing</h3>
        <p>Field reads are processed in a visual flow editor. Filtering, matching, validation, and action rules are designed without code and run locally on edge nodes.</p>
        <ul>
          <li>In / Process / Out nodes</li>
          <li>Local edge execution</li>
          <li>Offline-first resilience</li>
          <li>Rule versioning &amp; deploy</li>
        </ul>
      </div>
      <div class="pillar">
        <div class="pn">03 · INTEGRATION</div>
        <h3>Enterprise system integration</h3>
        <p>Reliable two-way data flow is established with ERP, WMS, SAP, MES, and other enterprise systems. Industry-standard protocols connect every system.</p>
        <ul>
          <li>REST API · MQTT · OPC UA</li>
          <li>SAP / ERP / WMS adapters</li>
          <li>TCP Socket · Modbus · HTTP/S</li>
          <li>Audit log &amp; data lineage</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Feature deep dives -->
<section>
  <div class="container">
    <SectionHead
      eyebrow="Capabilities · Deep Dive"
      heading="What does Tag&amp;Trace do?"
    />

    <!-- Feature 0: Rule Engine -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Rule · Dispatch Verification</span>
          <span class="right">flow active · dispatch-verification</span>
        </div>
        <div class="surface-body" style="padding:0">
          <div class="rule-flow">
            <div class="rnode trig" style="left:10px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg></div>
              <div class="body">RFID Reader In<span class="meta">RDR-01 · port 5</span></div>
            </div>
            <div class="rnode trig" style="left:10px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M5 8l7-5 7 5"/></svg></div>
              <div class="body">MQTT In<span class="meta">topic: erp/ship</span></div>
            </div>
            <div class="rnode cond" style="left:200px;top:90px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83"/></svg></div>
              <div class="body">Validate &amp; Match<span class="meta">epc → order</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></div>
              <div class="body">HTTP → SAP<span class="meta">POST /sap/ship</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="9" rx="2"/><path d="M6 9V5h12v4"/></svg></div>
              <div class="body">Printer Out<span class="meta">PRN-03 · ZPL</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:250px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
              <div class="body">Alert: Missing<span class="meta">ops@altis</span></div>
            </div>
            <svg class="rflow-edge" viewBox="0 0 520 320">
              <path d="M150,46 C180,46 180,106 200,106"/>
              <path d="M150,156 C180,156 180,116 200,116"/>
              <path d="M340,106 C360,106 360,46 380,46"/>
              <path d="M340,106 C360,106 360,156 380,156"/>
              <path d="M340,106 C360,106 360,266 380,266"/>
            </svg>
            <svg class="rflow-pulse" viewBox="0 0 520 320" aria-hidden="true">
              <path pathLength="100" d="M150,46 C180,46 180,106 200,106"/>
              <path pathLength="100" d="M150,156 C180,156 180,116 200,116"/>
              <path pathLength="100" d="M340,106 C360,106 360,46 380,46"/>
              <path pathLength="100" d="M340,106 C360,106 360,156 380,156"/>
              <path pathLength="100" d="M340,106 C360,106 360,266 380,266"/>
            </svg>
          </div>
          <div class="re-footer">last 30 days: 1,240 dispatches · 18 errors caught · <span style="color:#15a06b">● active</span></div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Visual Rule Engine</span>
        <h3>Design field rules without writing code</h3>
        <p>Data from RFID reads is processed in a visual flow editor. Which read triggers under which condition, which system it matches, and which action it creates are all defined in a drag-and-drop interface and run locally on edge nodes.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>In / Process / Out nodes</strong><span>Source, processing, and output steps are modeled with separate node types.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Local execution at the edge</strong><span>Rules keep running in the field even if the internet connection is interrupted.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Rule versioning &amp; deploy</strong><span>New rule versions are approved in a test environment and deployed to the field.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 1: Device manager -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Device Management</span>
        <h3>All Auto-ID hardware in one inventory</h3>
        <p>RFID readers, printers, barcode systems, and sensors are inventoried in the same interface regardless of brand or model. Field teams see the real device name, location, last read time, and health status instead of vague device codes.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Auto-discovery</strong><span>Devices connected to the network are automatically detected and registered.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Health and uptime</strong><span>Live status, last read, ping, and error counters for every device.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Bulk configuration</strong><span>Bulk updates by profile, location, or tag.</span></div></li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Device inventory</span>
          <span class="right">182 devices · 24 locations</span>
        </div>
        <div class="surface-body" style="padding:0 4px">
          <table class="devtable">
            <thead>
              <tr><th style="padding-left:18px">ID</th><th>Device</th><th>Type</th><th>Location</th><th style="padding-right:18px">Status</th></tr>
            </thead>
            <tbody>
              <tr data-reveal data-reveal-delay="0"><td style="padding-left:18px"><span class="id">RDR-01</span></td><td>Impinj R700</td><td><span class="devtype">READER</span></td><td>Dispatch Door A</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Running</span></td></tr>
              <tr data-reveal data-reveal-delay="70"><td style="padding-left:18px"><span class="id">PRN-03</span></td><td>Zebra ZT411</td><td><span class="devtype">PRINTER</span></td><td>Labeling</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Ready</span></td></tr>
              <tr data-reveal data-reveal-delay="140"><td style="padding-left:18px"><span class="id">RDR-07</span></td><td>Zebra FX9600</td><td><span class="devtype">READER</span></td><td>Production Line 2</td><td style="padding-right:18px"><span class="dev-status warn"><span class="d"></span>Maintenance</span></td></tr>
              <tr data-reveal data-reveal-delay="210"><td style="padding-left:18px"><span class="id">SNS-12</span></td><td>Temperature</td><td><span class="devtype">SENSOR</span></td><td>Cold Storage</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Running</span></td></tr>
              <tr data-reveal data-reveal-delay="280"><td style="padding-left:18px"><span class="id">BCR-04</span></td><td>Honeywell</td><td><span class="devtype">BARCODE</span></td><td>Packing</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Running</span></td></tr>
              <tr data-reveal data-reveal-delay="350"><td style="padding-left:18px"><span class="id">PLC-02</span></td><td>Siemens S7</td><td><span class="devtype">PLC</span></td><td>Conveyor 1</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Running</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Feature 2: Reader config -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">RDR-01 · Antenna configuration</span>
          <span class="right">Impinj R700 · v3.2</span>
        </div>
        <div class="surface-body">
          <div style="margin-bottom:16px">
            <div style="font-size:12px;font-weight:600;color:var(--slate);margin-bottom:4px">Antenna 1 — Power (dBm)</div>
            <div class="slider-mock"><span class="dot"></span></div>
            <div style="display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--text-faint);margin-top:4px"><span>10</span><span style="color:var(--navy-800);font-weight:600">27.5 dBm</span><span>33</span></div>
          </div>
          <div class="config-panel">
            <div>
              <div class="cfg-row"><span class="k">Read mode</span><span class="v">Autonomous</span></div>
              <div class="cfg-row"><span class="k">Session</span><span class="v">S1</span></div>
              <div class="cfg-row"><span class="k">Search mode</span><span class="v">Single Target</span></div>
              <div class="cfg-row"><span class="k">Q parameter</span><span class="v">4</span></div>
            </div>
            <div>
              <div class="cfg-row"><span class="k">Frequency</span><span class="v">865-868 MHz</span></div>
              <div class="cfg-row"><span class="k">Trigger</span><span class="v">GPI Input</span></div>
              <div class="cfg-row"><span class="k">Filter</span><span class="v">EPC prefix</span></div>
              <div class="cfg-row"><span class="k">Connection</span><span class="v">TCP · 14150</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Reader Control</span>
        <h3>Reader profiles for field conditions</h3>
        <p>All reader parameters such as antenna power, read mode, session, frequency, and trigger mode are managed centrally. Separate profiles can be defined for dispatch gates and production lines, so field staff only select the right scenario profile.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Profile-based management</strong><span>Configuration per scenario with one-click switching.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>GPI / GPO support</strong><span>Photoelectric cells, light barriers, and door sensors can be used as triggers.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>EPC filtering</strong><span>Prefix and mask filters read only the relevant tags.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Label templates -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Labels &amp; Printers</span>
        <h3>ZPL templates with dynamic printing from ERP data</h3>
        <p>Label templates are designed with a visual editor or ZPL. They are dynamically filled with order, product, and dispatch data from ERP or WMS, then routed to the correct printer. Print queues are monitored and reprints are automated when errors occur.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>ZPL support</strong><span>Industry-standard compatibility with Zebra, Honeywell, and SATO.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Dynamic data binding</strong><span>&#123;&#123;order.id&#125;&#125;, &#123;&#123;sku&#125;&#125;, &#123;&#123;shipDate&#125;&#125; fields are filled automatically.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>RFID encoding</strong><span>EPC encoding, locking, and post-print read verification.</span></div></li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Template: SHIP-LABEL-A4</span>
          <span class="right">RFID + Barcode + QR</span>
        </div>
        <div class="surface-body">
          <div class="label-mock">
            <div class="label-inner">
              <div>
                <div class="label-meta"><div class="big">ALTIS</div>SKU-44821 · ORDER-78912</div>
                <div class="barcode" style="margin-top:14px">
                  <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
                </div>
                <div class="label-meta" style="margin-top:8px">044821-78912-2025</div>
              </div>
              <div class="qr-mock">
                <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
              </div>
            </div>
          </div>
          <div style="display:flex;justify-content:space-between;margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-faint)">
            <span>EPC: <span style="color:var(--navy-800)">E2 80 11 60 60 00 02 09 84 22</span></span>
            <span>PRN-03 · queue 4</span>
          </div>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Architecture -->
<section class="arch">
  <div class="container">
    <SectionHead
      eyebrow="Architecture"
      heading="From field to enterprise system in four layers"
      description="Tag&amp;Trace provides a standard connection model across device, edge, platform, and enterprise layers. Each layer scales independently and every boundary communicates securely."
    />
    <div class="arch-diagram">
      <div class="arch-cols">
        <div class="arch-col">
          <div class="lyr">L1 · DEVICE</div>
          <h4>Field Devices</h4>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"></path><path d="M4 4a16 16 0 0 1 16 16"></path></svg>RFID Readers</div>
