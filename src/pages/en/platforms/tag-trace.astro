/* Hero */
.hero{
  position:relative;padding:64px 0 120px;overflow:hidden;
  background:
    radial-gradient(900px 500px at 80% -100px, rgba(24,183,214,.10), transparent 60%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid-bg{
  position:absolute;inset:0;pointer-events:none;opacity:.4;
  background-image:linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1fr 1fr;gap:56px;align-items:center}
.platform-pill{display:inline-flex;align-items:center;gap:10px;padding:7px 14px 7px 8px;border-radius:6px;background:#fff;border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--slate);box-shadow:var(--shadow-sm)}
.platform-pill .pill-tag{background:var(--primary);color:#fff;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:6px;text-transform:uppercase}
.product-name{
  font-size:clamp(56px,7vw,96px);font-weight:800;letter-spacing:-.04em;line-height:1;
  background:linear-gradient(135deg,#00125C 0%,#1E2F8C 60%,#18B7D6 130%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin:24px 0 14px;padding-bottom:0.12em;
}
.product-name .amp{font-weight:400;opacity:.75}
.hero h1.product-tag{font-size:clamp(28px,2.6vw,38px);font-weight:700;line-height:1.2;color:var(--navy-800)}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:520px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.hero-stats{display:grid;grid-template-columns:repeat(3,auto);gap:36px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);max-width:520px}
.hero-stat .v{font-family:"JetBrains Mono",monospace;font-size:24px;font-weight:700;color:var(--navy-800)}
.hero-stat .l{font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-top:4px}

/* Hero visual — EPC stream panel */
.hero-panel{
  background:#0B1120;border:1px solid rgba(24,183,214,.25);border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg),0 0 40px -10px rgba(24,183,214,.12);overflow:hidden;
}
.panel-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:12px 18px;border-bottom:1px solid rgba(255,255,255,.07);background:rgba(255,255,255,.03);
}
.panel-head .ttl{font-family:"JetBrains Mono",monospace;font-size:12px;font-weight:600;color:rgba(255,255,255,.9)}
.panel-head .right{font-family:"JetBrains Mono",monospace;font-size:10.5px;color:rgba(255,255,255,.35);display:flex;align-items:center;gap:6px}
.live-dot{width:7px;height:7px;border-radius:50%;background:#15a06b;box-shadow:0 0 6px #15a06b;animation:pulse 1.8s ease-in-out infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
.epc-stream{padding:6px 0}
.epc-row{
  display:grid;grid-template-columns:100px 1fr auto;align-items:center;gap:10px;
  padding:9px 18px;border-bottom:1px solid rgba(255,255,255,.04);
  font-family:"JetBrains Mono",monospace;font-size:11px;
  transition:background .15s;
}
.epc-row.new{background:rgba(24,183,214,.06);border-left:2px solid var(--cyan)}
.epc-row.dim{opacity:.35}
.epc-row .ts{color:rgba(255,255,255,.3);font-size:10px}
.epc-row .epc{color:rgba(255,255,255,.55)}
.epc-row .epc .hi{color:rgba(255,255,255,.9)}
.epc-row .ev{font-size:10.5px;font-weight:700;letter-spacing:.04em}
.epc-row .ev.ok{color:#15a06b}
.epc-row .ev.warn{color:#f59e0b}
.panel-footer{
  padding:10px 18px;background:rgba(255,255,255,.03);border-top:1px solid rgba(255,255,255,.07);
  display:flex;justify-content:space-between;
  font-family:"JetBrains Mono",monospace;font-size:10.5px;color:rgba(255,255,255,.35);
}

/* Rule engine flow mock */
.rule-flow{
  padding:24px;
  background:repeating-radial-gradient(circle at center,rgba(0,18,92,.05) 1px,transparent 1px) 0 0 / 18px 18px,#FAFBFE;
  position:relative;height:340px;
}
.rnode{position:absolute;background:#fff;border:1.5px solid var(--border);border-radius:8px;padding:8px 12px;font-size:11.5px;font-weight:600;color:var(--slate);display:flex;align-items:center;gap:8px;min-width:130px;box-shadow:0 4px 12px -4px rgba(0,18,92,.12)}
.rnode .meta{font-family:"JetBrains Mono",monospace;font-size:9.5px;color:var(--text-faint);font-weight:500;display:block;margin-top:1px}
.rnode.trig{border-color:var(--primary)}
.rnode.cond{border-color:var(--cyan)}
.rnode.act{border-color:#16a34a}
.rnode .ic{width:22px;height:22px;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rnode.trig .ic{background:var(--bg-blue);color:var(--primary)}
