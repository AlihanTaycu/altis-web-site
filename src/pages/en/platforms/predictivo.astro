---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/sections/SectionHead.astro';
import CTABanner from '../../../components/sections/CTABanner.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Predictivo",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "Industrial IoT platform that turns IoT and operational data into decision support",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" }
};
---

<Base
  title="Predictivo - Industrial IoT and Operational Intelligence Platform | Altis Technology"
  description="Predictivo turns sensor, machine, meter, beacon, SCADA, and operational data into dashboards, alerts, reports, and rule-driven decision support."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/platformlar/predictivo/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/platforms/predictivo/">Platforms</a>
      <span class="sep">/</span>
      <span style="color:var(--predicto);font-weight:600">Predictivo</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="platform-pill">
          <span class="pill-tag">Platform</span>
          <span>Industrial IoT · Dashboard · Rule Engine · Reports</span>
        </div>
        <div class="product-name">Predictivo</div>
        <h1 class="product-tag">Turn operational data into decision support.</h1>
        <p class="hero-sub">An Industrial IoT platform that collects sensor, machine, meter, beacon, SCADA, and operational data in one center. Turn data into meaningful action with dashboards, alerts, reports, and a visual rule engine.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/en/contact/">Request Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#capabilities">Explore Capabilities</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v" data-count>12+</div><div class="l">protocol support</div></div>
          <div class="hero-stat"><div class="v">∞</div><div class="l">sensor scalability</div></div>
          <div class="hero-stat"><div class="v">RT</div><div class="l">live dashboard</div></div>
        </div>
      </div>

      <!-- Live dashboard mockup -->
      <div class="dash">
        <div class="dash-head">
          <div class="tabs">
            <span class="tab active">Operations</span>
          </div>
          <div class="ctrl">
            <span class="live-dot"></span>
            <span>live · last 24h</span>
          </div>
        </div>
        <div class="dash-body">
          <!-- KPIs -->
          <div class="kpi-row">
            <div class="kpi">
              <div class="l">OEE</div>
              <div class="v"><span data-count>82.4</span><span class="u">%</span></div>
              <div class="trend up">↑ 3.2 vs yesterday</div>
            </div>
            <div class="kpi">
              <div class="l">Energy</div>
              <div class="v"><span data-count>142</span><span class="u">kWh</span></div>
              <div class="trend dn">↓ -8% target</div>
            </div>
            <div class="kpi">
              <div class="l">Active Alerts</div>
              <div class="v" style="color:var(--warn)" data-count>3</div>
              <div class="trend up" style="color:var(--text-faint)">2 critical · 1 warning</div>
            </div>
            <div class="kpi">
              <div class="l">Devices</div>
              <div class="v"><span data-count>248</span><span class="u">/250</span></div>
              <div class="trend up">99.2% online</div>
            </div>
          </div>

          <!-- Energy chart -->
          <div class="dash-card chart-card" data-reveal data-reveal-delay="120">
            <div class="ttl"><h5>Energy Consumption · Line 2</h5><span class="meta">kWh · last 12h</span></div>
            <div class="chart">
              <svg viewBox="0 0 300 96" preserveAspectRatio="none">
                <defs>
                  <linearGradient id="area-grad" x1="0" y1="0" x2="0" y2="1">
                    <stop offset="0%" stop-color="#0F8FA8" stop-opacity=".35"/>
                    <stop offset="100%" stop-color="#0F8FA8" stop-opacity="0"/>
                  </linearGradient>
                </defs>
                <g class="grid">
                  <line x1="0" y1="24" x2="300" y2="24"/>
                  <line x1="0" y1="48" x2="300" y2="48"/>
                  <line x1="0" y1="72" x2="300" y2="72"/>
                </g>
                <path class="area" d="M0,70 L25,55 L50,60 L75,40 L100,48 L125,30 L150,38 L175,22 L200,32 L225,18 L250,28 L275,14 L300,24 L300,96 L0,96 Z"/>
                <path class="line" pathLength="1" d="M0,70 L25,55 L50,60 L75,40 L100,48 L125,30 L150,38 L175,22 L200,32 L225,18 L250,28 L275,14 L300,24"/>
                <circle class="point" cx="300" cy="24" r="3.5"/>
              </svg>
            </div>
          </div>

          <!-- Machine health gauges -->
          <div class="dash-card gauge-card" data-reveal data-reveal-delay="200">
            <div class="ttl"><h5>Machine Health</h5><span class="meta">4/5 healthy</span></div>
            <div class="gauges">
              <div class="gauge">
                <div class="ring">
                  <svg viewBox="0 0 60 60">
                    <circle class="bg" cx="30" cy="30" r="24"/>
                    <circle class="fg" cx="30" cy="30" r="24" stroke="var(--ok)" stroke-dasharray="150.8" style="--t:22.6"/>
                  </svg>
                  <div class="v"><span data-count>85</span><small>HEALTH</small></div>
                </div>
                <div class="lbl">CNC-01</div>
              </div>
              <div class="gauge">
                <div class="ring">
                  <svg viewBox="0 0 60 60">
                    <circle class="bg" cx="30" cy="30" r="24"/>
                    <circle class="fg" cx="30" cy="30" r="24" stroke="var(--warn)" stroke-dasharray="150.8" style="--t:75.4"/>
                  </svg>
                  <div class="v"><span data-count>50</span><small>HEALTH</small></div>
                </div>
                <div class="lbl">CNC-02</div>
              </div>
            </div>
          </div>

          <!-- Alarms -->
          <div class="dash-card">
            <div class="ttl"><h5>Active Alerts</h5><span class="meta">3</span></div>
            <div class="alarm-list">
              <div class="alarm crit" data-reveal data-reveal-delay="60">
                <div class="sev"></div>
                <div class="body">Vibration threshold exceeded<span class="sub">CNC-02 · X axis · 4.8mm/s</span></div>
                <div class="t">14:22</div>
              </div>
              <div class="alarm warn" data-reveal data-reveal-delay="140">
                <div class="sev"></div>
                <div class="body">Energy target exceeded<span class="sub">Line 2 · +12% trend</span></div>
                <div class="t">13:50</div>
              </div>
              <div class="alarm info" data-reveal data-reveal-delay="220">
                <div class="sev"></div>
                <div class="body">Sensor calibration suggested<span class="sub">TEMP-12 · drift nearby</span></div>
                <div class="t">12:08</div>
              </div>
            </div>
          </div>

          <!-- Mini RTLS map -->
          <div class="dash-card">
            <div class="ttl"><h5>RTLS · Warehouse Locations</h5><span class="meta">42 tags</span></div>
            <div class="map-mini">
              <div class="map-zone" style="left:8%;top:14%;width:32%;height:28%"></div>
              <div class="map-zone" style="left:52%;top:14%;width:40%;height:28%"></div>
              <div class="map-zone" style="left:8%;top:54%;width:60%;height:34%"></div>
              <div class="map-zone" style="left:74%;top:54%;width:18%;height:34%"></div>
              <span class="map-label" style="left:10%;top:6%">Zone A</span>
              <span class="map-label" style="left:54%;top:6%">Zone B</span>
              <span class="map-label" style="left:10%;top:46%">Production</span>
              <span class="map-label" style="left:76%;top:46%">Dispatch</span>
              <div class="map-pin" style="left:18%;top:28%"></div>
              <div class="map-pin" style="left:30%;top:32%"></div>
              <div class="map-pin b" style="left:62%;top:26%"></div>
              <div class="map-pin" style="left:78%;top:34%"></div>
              <div class="map-pin" style="left:24%;top:70%"></div>
              <div class="map-pin c" style="left:42%;top:64%"></div>
              <div class="map-pin" style="left:55%;top:74%"></div>
              <div class="map-pin" style="left:80%;top:70%"></div>
            </div>
          </div>

        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trusted by -->
<div class="logos-strip">
  <div class="container">
    <div class="lbl">— Field-tested and integrated with enterprise systems —</div>
    <div class="logos-row">
      <div class="logo-box">Siemens</div>
      <div class="logo-box">Turck</div>
      <div class="logo-box">SICK</div>
      <div class="logo-box">Honeywell</div>
      <div class="logo-box">Datalogic</div>
      <div class="logo-box">Stanley Healthcare</div>
    </div>
  </div>
</div>

<!-- 5-step flow -->
<section class="flow5" id="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="Five Steps From Data to Action"
      heading="Connect · Process · Visualize · Act · Report"
      description="Predictivo's five core capabilities create a consistent data lifecycle that turns raw field data into manageable operations."
    />
    <div class="flow5-steps">
      <div class="flow5-step">
        <div class="num">01 · CONNECT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14a3.5 3.5 0 0 0 5 0l4-4a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M14 10a3.5 3.5 0 0 0-5 0l-4 4a3.5 3.5 0 0 0 5 5l1-1"/></svg></div>
        <h4>Connect</h4>
        <p>Collect data from sensors, machines, meters, beacons, SCADA, gateways, and third-party systems.</p>
        <div class="ex">MQTT · HTTP · OPC UA · Modbus · LoRaWAN</div>
      </div>
      <div class="flow5-step">
        <div class="num">02 · PROCESS</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51"/></svg></div>
        <h4>Process</h4>
        <p>Filter incoming data, define thresholds, and build workflows with the rule engine.</p>
        <div class="ex">filter · aggregate · threshold · derive</div>
      </div>
      <div class="flow5-step">
        <div class="num">03 · VISUALIZE</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg></div>
        <h4>Visualize</h4>
        <p>Make data meaningful with dashboards, charts, counters, maps, and operation panels.</p>
        <div class="ex">widgets · drag &amp; drop · responsive</div>
      </div>
      <div class="flow5-step">
        <div class="num">04 · ACT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
        <h4>Act</h4>
        <p>Turn data into business outcomes with alerts, notifications, device triggers, and operational actions.</p>
        <div class="ex">alert · email · webhook · device</div>
      </div>
      <div class="flow5-step">
        <div class="num">05 · REPORT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></div>
        <h4>Report</h4>
        <p>Share performance, trends, and risks with management and operations teams through periodic PDF reports.</p>
        <div class="ex">daily · weekly · monthly · PDF</div>
      </div>
    </div>
  </div>
</section>

<!-- Feature deep dives -->
<section>
  <div class="container">
    <SectionHead
      eyebrow="Capabilities · Deep Dive"
      heading="What does Predictivo do?"
    />

    <!-- Feature 1: Dashboard builder -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Dashboard Builder</span>
        <h3>Operation-specific panels without writing code</h3>
        <p>Design live dashboards for your operation with drag-and-drop widgets. OEE and energy KPIs for management, machine health scores for maintenance, RTLS maps for warehouse teams: the same data from different viewpoints.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>20+ widget types</strong><span>Charts, gauges, counters, maps, tables, alert lists, and more.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Role-based views</strong><span>Separate dashboards for management, operations, and maintenance from one data source.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Full-screen mode</strong><span>The same quality on factory monitors, control rooms, or mobile devices.</span></div></li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Dashboard editor — Operations manager view</span>
          <span class="right">drag &amp; drop</span>
        </div>
        <div class="builder">
          <div class="builder-side">
            <h6>Widgets</h6>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
              Line chart
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              Gauge
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
              Big number
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Map
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
              Table
            </div>
            <h6 style="margin-top:14px">Datasources</h6>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>MQTT · enerji</div>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>OPC UA · MES</div>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>Modbus · PLC</div>
          </div>
          <div class="builder-canvas">
            <div class="bcell big-num">
              <div class="t">OEE</div>
              <div class="num">82.4%</div>
            </div>
            <div class="bcell">
              <div class="t">Energy Trend</div>
              <svg viewBox="0 0 120 50" preserveAspectRatio="none" style="width:100%;height:50px">
                <path d="M0,40 L20,30 L40,32 L60,18 L80,22 L100,12 L120,18" fill="none" stroke="var(--predicto)" stroke-width="2"/>
              </svg>
            </div>
            <div class="bcell spark">
              <div class="t" style="width:100%;position:absolute;top:8px;left:10px">Production · 7g</div>
              <div class="bar" style="height:55%"></div>
              <div class="bar" style="height:72%"></div>
              <div class="bar" style="height:48%"></div>
              <div class="bar" style="height:85%"></div>
              <div class="bar" style="height:62%"></div>
              <div class="bar" style="height:78%"></div>
              <div class="bar" style="height:90%"></div>
            </div>
            <div class="bcell">
              <div class="t">Alert Count</div>
              <div style="display:flex;align-items:end;justify-content:space-between;height:50px">
                <div style="font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--warn)">3</div>
                <div style="font-size:10px;color:var(--text-faint)">2 critical · 1 warning</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Rule engine for alarms -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Rule · Predictive Maintenance Alert</span>
          <span class="right">v2 · active</span>
        </div>
        <div class="surface-body">
          <div class="rule-flow">
            <!-- Trigger -->
            <div class="rnode trig" style="left:10px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg></div>
              <div class="body">Trigger<span class="meta">CNC-02 · vibration</span></div>
            </div>
            <div class="rnode trig" style="left:10px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M9 9h6v6H9z"/></svg></div>
              <div class="body">Trigger<span class="meta">CNC-02 · temp</span></div>
            </div>

            <!-- Condition -->
            <div class="rnode cond" style="left:200px;top:90px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 22h20z"/></svg></div>
              <div class="body">If &gt; 4mm/s &amp; &gt;72°C<span class="meta">15 min window</span></div>
            </div>

            <!-- Actions -->
            <div class="rnode act" style="left:380px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h6l3-9 4 18 3-9h4"/></svg></div>
              <div class="body">Alert: Critical<span class="meta">maintenance@altis</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
              <div class="body">Create work order<span class="meta">CMMS webhook</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:250px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h12l3 3h3v11H3z"/></svg></div>
              <div class="body">SMS · Engineer<span class="meta">+90 5xx ...</span></div>
            </div>

            <svg class="rflow-edge" viewBox="0 0 520 320" preserveAspectRatio="none">
              <path d="M150,46 C180,46 180,106 200,106"/>
              <path d="M150,156 C180,156 180,116 200,116"/>
              <path d="M340,106 C360,106 360,46 380,46"/>
              <path d="M340,106 C360,106 360,156 380,156"/>
              <path d="M340,106 C360,106 360,266 380,266"/>
            </svg>
          </div>
          <div style="display:flex;justify-content:space-between;margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-faint)">
            <span>last 30 days: 12 triggers · 2 real failures prevented</span>
            <span style="color:var(--ok)">● active</span>
          </div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Visual Rule Engine</span>
        <h3>Data → Threshold → Action, without code</h3>
        <p>Which sensor value triggers which action under which condition? This logic is built in a visual flow editor. Operations teams do not wait for software teams to define new rules; they manage thresholds, conditions, and actions themselves.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Trigger · Condition · Action</strong><span>A simple three-layer model; complex scenarios through compound rules.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Multi-channel action</strong><span>E-posta, SMS, webhook, devices tetikleme, dashboard alarm — biri veya hepsi.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>History and impact</strong><span>Which rule ran when and what it caused remains fully traceable.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Reports -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Otomatik Reportr</span>
        <h3>Monthly PDFs for management, daily PDFs for operations</h3>
        <p>Dashboards prepared in Predictivo are automatically converted into PDF report templates and sent to the right people on daily, weekly, or monthly schedules. KPI summaries, trend analyses, alert statistics, and machine performance are collected in one document.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Template-based</strong><span>Management, operations, maintenance, energy: different reports for different recipients.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Automatic distribution</strong><span>Cron-like scheduled delivery by email or file target.</span></div></li>
