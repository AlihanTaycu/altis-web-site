    />
    <div class="arch-diagram">
      <div class="arch-cols">
        <div class="arch-col">
          <div class="lyr">L1 · DEVICE</div>
          <h4>Field Data Sources</h4>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg>Sensors · measurement</div>
