---
import Base from '../../../layouts/Base.astro';
import SectionHead from '../../../components/sections/SectionHead.astro';
import CTABanner from '../../../components/sections/CTABanner.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Predictivo",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "An industrial IoT platform that turns IoT and operations data into a decision-support system",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" }
};
---

<Base
  title="Predictivo - Industrial IoT and Operational Intelligence Platform | Altis Technology"
  description="Predictivo turns sensor, machine, meter, beacon, SCADA, and operations data into a decision-support system with dashboards, alerts, reports, and a rule engine."
  {schema}
  lang="en"
  alternateUrl="https://www.altis.com.tr/platformlar/predictivo/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/en/">Home</a>
      <span class="sep">/</span>
      <a href="/en/platforms/">Platforms</a>
      <span class="sep">/</span>
      <span style="color:var(--predicto);font-weight:600">Predictivo</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="platform-pill">
          <span>Industrial IoT &nbsp;·&nbsp; Dashboard &nbsp;·&nbsp; Rule Engine &nbsp;·&nbsp; Reports</span>
        </div>
        <div class="product-name">Predictivo</div>
        <h1 class="product-tag">Turn your operational data into a decision-support system.</h1>
        <p class="hero-sub">An industrial IoT platform that brings together sensor, machine, meter, beacon, SCADA, and operations data in one center. Turn data into meaningful action with dashboards, alerts, reports, and a visual rule engine.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/en/contact/">Request Demo
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#capabilities">Explore Capabilities</a>
        </div>
      </div>

      <!-- Real dashboard screenshot -->
      <div class="hero-visual">
        <img src="/images/Predictivo-transperent.png" alt="Predictivo Dashboard - Actual Screenshot" class="hero-img"/>
      </div>
    </div>

    <!-- Stats marquee -->
    <div class="stats-marquee">
      <div class="stats-track">
        <div class="hero-stat"><div class="v">SAP</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">7×24</div><div class="l">continuous monitoring</div></div>
        <div class="hero-stat"><div class="v">WMS</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">RT</div><div class="l">real-time data</div></div>
        <div class="hero-stat"><div class="v">MQTT</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">500+</div><div class="l">connectable sensor types</div></div>
        <div class="hero-stat"><div class="v">Automatic</div><div class="l">alerts</div></div>
        <div class="hero-stat"><div class="v">ERP</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">∞</div><div class="l">scalable architecture</div></div>
        <div class="hero-stat"><div class="v">Web Service</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">20+</div><div class="l">supported protocols</div></div>
        <div class="hero-stat"><div class="v">5min</div><div class="l">setup time</div></div>
        <div class="hero-stat"><div class="v">REST API</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">Automatic</div><div class="l">reporting</div></div>
        <!-- duplicate for seamless loop -->
        <div class="hero-stat"><div class="v">SAP</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">7×24</div><div class="l">continuous monitoring</div></div>
        <div class="hero-stat"><div class="v">WMS</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">RT</div><div class="l">real-time data</div></div>
        <div class="hero-stat"><div class="v">MQTT</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">500+</div><div class="l">connectable sensor types</div></div>
        <div class="hero-stat"><div class="v">Automatic</div><div class="l">alerts</div></div>
        <div class="hero-stat"><div class="v">ERP</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">∞</div><div class="l">scalable architecture</div></div>
        <div class="hero-stat"><div class="v">Web Service</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">20+</div><div class="l">supported protocols</div></div>
        <div class="hero-stat"><div class="v">5min</div><div class="l">setup time</div></div>
        <div class="hero-stat"><div class="v">REST API</div><div class="l">integration</div></div>
        <div class="hero-stat"><div class="v">Automatic</div><div class="l">reporting</div></div>
      </div>
    </div>
  </div>
</section>

<!-- Trusted by -->
<div class="logos-strip">
  <div class="container">
    <div class="lbl">Field-tested and integrated with enterprise systems</div>
    <div class="logos-row">
      <div class="logo-box">SICK</div>
      <div class="logo-box">Çimtaş</div>
      <div class="logo-box">THY</div>
      <div class="logo-box">Siemens</div>
      <div class="logo-box">Turck</div>
      <div class="logo-box">Stanley Healthcare</div>
    </div>
  </div>
</div>

<!-- 5-step flow -->
<section class="flow5" id="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="Data to Action in Five Steps"
      heading="Connect. Process. Visualize. Act. Report."
      description="Predictivo's five core capabilities form a consistent data lifecycle that turns raw field data into manageable operations."
    />
    <div class="flow5-steps">
      <div class="flow5-step">
        <div class="num">01 · CONNECT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14a3.5 3.5 0 0 0 5 0l4-4a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M14 10a3.5 3.5 0 0 0-5 0l-4 4a3.5 3.5 0 0 0 5 5l1-1"/></svg></div>
        <h4>Connect</h4>
        <p>Receive data from sensors, machines, SCADA, and third-party systems.</p>
        <div class="ex">MQTT · HTTP · OPC UA · Modbus · LoRaWAN</div>
      </div>
      <div class="flow5-step">
        <div class="num">02 · PROCESS</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51"/></svg></div>
        <h4>Process</h4>
        <p>Filter data, define thresholds, and build flows with the rule engine.</p>
        <div class="ex">filter · aggregate · threshold · derive</div>
      </div>
      <div class="flow5-step">
        <div class="num">03 · VISUALIZE</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg></div>
        <h4>Visualize</h4>
        <p>Make data meaningful with live dashboards, charts, and maps.</p>
        <div class="ex">widgets · drag &amp; drop · responsive</div>
      </div>
      <div class="flow5-step">
        <div class="num">04 · ACT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
        <h4>Act</h4>
        <p>Turn data into immediate business outcomes with alerts and notifications.</p>
        <div class="ex">alert · email · webhook · device</div>
      </div>
      <div class="flow5-step">
        <div class="num">05 · REPORT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></div>
        <h4>Report</h4>
        <p>Share performance with teams through daily, weekly, and monthly PDF reports.</p>
        <div class="ex">daily · weekly · monthly · PDF</div>
      </div>
    </div>
  </div>
</section>

<!-- Feature deep dives -->
<section>
  <div class="container">
    <SectionHead
      eyebrow="Capabilities · Deep Dive"
      heading="What does Predictivo do?"
    />

    <!-- Feature 1: Dashboard builder -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Dashboard Builder</span>
        <h3>Operation-specific panels, no code required</h3>
        <p>Design live dashboards tailored to your operation with drag-and-drop widgets. OEE and energy KPIs for management, machine health scores for the maintenance team, an RTLS map for the warehouse — same data, different perspectives.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>20+ widget types</strong><span>Charts, gauges, counters, maps, tables, alarm lists, and more.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Role-based views</strong><span>Separate dashboards for management, operations, and maintenance — one data source.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Full-screen mode</strong><span>Same quality on factory monitors, in the control room, or on mobile.</span></div></li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Dashboard editor — Operations Manager view</span>
          <span class="right">drag &amp; drop</span>
        </div>
        <div class="builder">
          <div class="builder-side">
            <h6>Widgets</h6>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
              Line chart
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              Gauge
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
              Big number
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Map
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
              Table
            </div>
            <h6 style="margin-top:14px">Datasources</h6>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>MQTT · energy</div>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>OPC UA · MES</div>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>Modbus · PLC</div>
          </div>
          <div class="builder-canvas">
            <div class="bcell big-num">
              <div class="t">OEE</div>
              <div class="num">82.4%</div>
            </div>
            <div class="bcell">
              <div class="t">Energy Trend</div>
              <svg viewBox="0 0 120 50" preserveAspectRatio="none" style="width:100%;height:50px">
                <path d="M0,40 L20,30 L40,32 L60,18 L80,22 L100,12 L120,18" fill="none" stroke="var(--predicto)" stroke-width="2"/>
              </svg>
            </div>
            <div class="bcell spark">
              <div class="t" style="width:100%;position:absolute;top:8px;left:10px">Production · 7d</div>
              <div class="bar" style="height:55%"></div>
              <div class="bar" style="height:72%"></div>
              <div class="bar" style="height:48%"></div>
              <div class="bar" style="height:85%"></div>
              <div class="bar" style="height:62%"></div>
              <div class="bar" style="height:78%"></div>
              <div class="bar" style="height:90%"></div>
            </div>
            <div class="bcell">
              <div class="t">Alarm Count</div>
              <div style="display:flex;align-items:end;justify-content:space-between;height:50px">
                <div style="font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--warn)">3</div>
                <div style="font-size:10px;color:var(--text-faint)">2 critical · 1 warning</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Rule engine for alarms -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Rule · Predictive Maintenance Alert</span>
          <span class="right">v2 · active</span>
        </div>
        <div class="surface-body">
          <div class="rule-flow">
            <!-- Trigger -->
            <div class="rnode trig" style="left:10px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg></div>
              <div class="body">Trigger<span class="meta">CNC-02 · vibration</span></div>
            </div>
            <div class="rnode trig" style="left:10px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M9 9h6v6H9z"/></svg></div>
              <div class="body">Trigger<span class="meta">CNC-02 · temp</span></div>
            </div>

            <!-- Condition -->
            <div class="rnode cond" style="left:200px;top:90px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 22h20z"/></svg></div>
              <div class="body">If &gt; 4mm/s &amp; &gt;72°C<span class="meta">15 min window</span></div>
            </div>

            <!-- Actions -->
            <div class="rnode act" style="left:380px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h6l3-9 4 18 3-9h4"/></svg></div>
              <div class="body">Alarm: Critical<span class="meta">maintenance@altis</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
              <div class="body">Create work order<span class="meta">CMMS webhook</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:250px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h12l3 3h3v11H3z"/></svg></div>
              <div class="body">SMS · Engineer<span class="meta">+90 5xx ...</span></div>
            </div>

            <svg class="rflow-edge" viewBox="0 0 520 320" preserveAspectRatio="none">
              <path d="M150,46 C180,46 180,106 200,106"/>
              <path d="M150,156 C180,156 180,116 200,116"/>
              <path d="M340,106 C360,106 360,46 380,46"/>
              <path d="M340,106 C360,106 360,156 380,156"/>
              <path d="M340,106 C360,106 360,266 380,266"/>
            </svg>
          </div>
          <div style="display:flex;justify-content:space-between;margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-faint)">
            <span>last 30 days: 12 triggers · 2 actual failures prevented</span>
            <span style="color:var(--ok)">● active</span>
          </div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Visual Rule Engine</span>
        <h3>Data → Threshold → Action, no code required</h3>
        <p>Which sensor value, under what condition, triggers which action? This logic is built in a visual flow editor. The operations team doesn't wait on the software team to define a new rule — they manage thresholds, conditions, and actions themselves.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Trigger · Condition · Action</strong><span>A simple three-layer model; complex scenarios handled with compound rules.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Multi-channel action</strong><span>Email, SMS, webhook, device trigger, dashboard alert — one or all of them.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>History and impact</strong><span>Which rule ran when, and what result it led to — fully traceable.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Reports -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Automated Reports</span>
        <h3>Monthly PDFs for management, daily for operations</h3>
        <p>Dashboards built in Predictivo are automatically converted into PDF report templates. At set intervals — daily, weekly, monthly — they are emailed to the relevant recipients. KPI summaries, trend analyses, alarm statistics, and machine performance are gathered into a single document.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Template-based</strong><span>Management, operations, maintenance, energy — different reports, different recipients.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Automatic distribution</strong><span>Cron-like scheduled delivery; email or file destination.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Branded output</strong><span>Corporate template, logo, and color palette applied to reports.</span></div></li>
        </ul>
      </div>
      <div class="report">
        <div class="report-head">
          <div>
            <div class="t">Operations Monthly Report</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:11px;opacity:.8;margin-top:2px">Facility · Istanbul Hadımköy</div>
          </div>
          <div class="d">March 2026 · page 1/8</div>
        </div>
        <div class="report-body">
          <div>
            <div class="rep-kpi">
              <div class="l">Average OEE</div>
              <div class="v">82.4%</div>
            </div>
            <div class="rep-kpi">
              <div class="l">Total Energy</div>
              <div class="v">4,182 kWh</div>
            </div>
            <div class="rep-kpi">
              <div class="l">Failures Prevented</div>
              <div class="v">7</div>
            </div>
            <div class="rep-kpi">
              <div class="l">Critical Alarms</div>
              <div class="v" style="color:var(--crit)">14</div>
            </div>
          </div>
          <div>
            <div style="font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:8px">Production · Daily</div>
            <div class="rep-chart">
              <div class="bar" style="height:55%"></div>
              <div class="bar" style="height:62%"></div>
              <div class="bar" style="height:48%"></div>
              <div class="bar" style="height:78%"></div>
              <div class="bar" style="height:65%"></div>
              <div class="bar" style="height:88%"></div>
              <div class="bar" style="height:72%"></div>
              <div class="bar" style="height:81%"></div>
              <div class="bar" style="height:67%"></div>
              <div class="bar" style="height:92%"></div>
              <div class="bar" style="height:74%"></div>
              <div class="bar" style="height:83%"></div>
              <div class="bar" style="height:79%"></div>
              <div class="bar" style="height:95%"></div>
            </div>
          </div>
        </div>
        <div class="rep-foot">
          <span>Predictivo · Altis Technology</span>
          <span>3 recipients · auto-send</span>
        </div>
      </div>
    </div>

  </div>
</section>

<!-- Architecture -->
<section class="arch">
  <div class="container">
    <SectionHead
      eyebrow="Architecture"
      heading="From the field to the user, a four-layer IoT architecture"
      description="Predictivo builds a scalable and secure IoT data lifecycle across the device, gateway, platform, and user layers. Each layer is independent, and every boundary is standardized."
    />
    <div class="arch-diagram">
      <div class="arch-cols">
        <div class="arch-col">
          <div class="lyr">L1 · DEVICE</div>
          <h4>Field Data Sources</h4>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg>Sensors · measurement</div>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/></svg>PLC / Machine</div>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>Meters · energy</div>
