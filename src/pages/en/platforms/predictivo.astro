<style>
:root{
  /* Page-specific tokens not in global.css */
  --predicto:#0F8FA8;
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
}
.mono{font-family:"JetBrains Mono",monospace}

/* Breadcrumb */
.breadcrumb{padding:24px 0 0;font-size:13px;color:var(--text-faint);display:flex;align-items:center;gap:10px}
.breadcrumb a{color:var(--text-muted)}
.breadcrumb a:hover{color:var(--primary)}
.breadcrumb .sep{opacity:.5}

/* Hero */
.hero{
  position:relative;padding:64px 0 120px;overflow:hidden;
  background:#fff;
}
.hero-grid-bg{display:none}
.hero-inner{position:relative;display:grid;grid-template-columns:1fr 1.4fr;gap:48px;align-items:center}
.platform-pill{display:inline-flex;align-items:center;gap:10px;padding:7px 0;font-size:13px;font-weight:600;color:var(--text-muted)}
.platform-pill .pill-tag{background:var(--predicto);color:#fff;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:6px;text-transform:uppercase}
.product-name{
  font-size:clamp(56px,7vw,96px);font-weight:800;letter-spacing:-.04em;line-height:1;
  background:linear-gradient(135deg,#00125C 0%,#0F8FA8 60%,#18B7D6 130%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin:24px 0 14px;padding-bottom:0.12em;
}
.hero h1.product-tag{font-size:clamp(28px,2.6vw,38px);font-weight:700;line-height:1.2;color:var(--navy-800)}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:520px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.stats-marquee{margin-top:64px;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent);mask-image:linear-gradient(90deg,transparent,#000 10%,#000 90%,transparent)}
.stats-track{display:flex;width:max-content;animation:marquee 48s linear infinite}
@keyframes marquee{0%{transform:translateX(0)}100%{transform:translateX(-50%)}}
.hero-stat{padding:24px 48px;text-align:center;flex-shrink:0}
.hero-stat .v{font-family:"JetBrains Mono",monospace;font-size:22px;font-weight:700;color:var(--navy-800)}
.hero-stat .l{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.07em;font-weight:600;margin-top:6px}

/* Hero visual — real screenshot */
.hero-visual{display:flex;align-items:center;justify-content:center}
.hero-img{width:100%;border-radius:var(--radius-lg)}

/* Section base */
section{padding:110px 0}
.section-head{max-width:780px;margin:0 auto 64px;text-align:center}
.section-head.left{margin-left:0;text-align:left}
.section-head h2{margin-top:18px}
.section-head p{font-size:18px;margin-top:18px}

/* Logos strip */
.logos-strip{padding:48px 0;background:#fff}
.logos-strip .lbl{text-align:center;font-size:13px;color:var(--text-muted);font-weight:500;margin-bottom:32px}
.logos-row{display:flex;justify-content:center;align-items:center;gap:48px;flex-wrap:wrap}
.logo-box{font-size:18px;font-weight:700;color:var(--navy-800);letter-spacing:-.01em}

/* Five-step flow (Connect → Process → Visualize → Act → Report) */
.flow5{background:var(--bg-soft);padding:120px 0}
.flow5-steps{display:grid;grid-template-columns:repeat(5,1fr);gap:28px;margin-top:48px;position:relative}
.flow5-step{background:#fff;border-radius:var(--radius);padding:32px 28px;position:relative;display:flex;flex-direction:column;gap:12px;transition:transform .25s,box-shadow .25s}
.flow5-step:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.flow5-step .num{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--predicto);font-weight:600;letter-spacing:.1em}
.flow5-step .ic{width:42px;height:42px;border-radius:11px;background:var(--cyan-soft);color:var(--predicto);display:flex;align-items:center;justify-content:center}
.flow5-step h4{font-size:18px;color:var(--navy-800);margin:0}
.flow5-step p{font-size:13px;line-height:1.55;color:var(--text-muted)}
.flow5-step .ex{font-size:11px;color:var(--text-faint);font-family:"JetBrains Mono",monospace;padding-top:10px;margin-top:auto;letter-spacing:.02em}

/* Feature deep blocks */
.feature-block{display:grid;grid-template-columns:1fr 1.1fr;gap:80px;align-items:center;margin-bottom:130px}
.feature-block:last-child{margin-bottom:0}
.feature-block.flip{grid-template-columns:1.1fr 1fr}
.feature-block.flip .copy{order:2}
.feature-block .badge{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--predicto);padding:5px 10px;background:var(--cyan-soft);border-radius:6px}
.feature-block h3{font-size:32px;margin-top:18px;margin-bottom:18px}
.feature-block .copy > p{font-size:16.5px;line-height:1.65;margin-bottom:20px}
.feature-block ul.kv{list-style:none;padding:0;margin:24px 0 0;display:grid;gap:14px}
.feature-block ul.kv li{display:flex;gap:12px;align-items:flex-start;font-size:14.5px}
.feature-block ul.kv li svg{color:var(--predicto);flex-shrink:0;margin-top:3px}
.feature-block ul.kv strong{color:var(--text);font-weight:600;display:block;margin-bottom:2px}
.feature-block ul.kv span{color:var(--text-muted)}

/* Surfaces */
.surface{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);box-shadow:var(--shadow);overflow:hidden}
.surface-head{padding:14px 18px;border-bottom:1px solid var(--border-soft);background:#FCFCFE;display:flex;align-items:center;justify-content:space-between}
.surface-head .ttl{font-size:13px;font-weight:600;color:var(--navy-800)}
.surface-head .right{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--text-faint)}
.surface-body{padding:20px}

/* Builder mock (dashboard editor) */
.builder{display:grid;grid-template-columns:170px 1fr;height:380px}
.builder-side{border-right:1px solid var(--border-soft);padding:12px;background:#FAFBFE;overflow:hidden}
.builder-side h6{font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:700;margin:8px 0 6px}
.widget-chip{display:flex;align-items:center;gap:8px;padding:8px 10px;background:#fff;border:1px solid var(--border-soft);border-radius:6px;font-size:11.5px;color:var(--slate);font-weight:500;margin-bottom:6px;cursor:grab}
.widget-chip svg{color:var(--predicto);flex-shrink:0}
.builder-canvas{padding:16px;background:repeating-linear-gradient(0deg,transparent,transparent 22px,rgba(0,18,92,.04) 22px,rgba(0,18,92,.04) 23px),repeating-linear-gradient(90deg,transparent,transparent 22px,rgba(0,18,92,.04) 22px,rgba(0,18,92,.04) 23px);display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;gap:10px}
.bcell{background:#fff;border:1.5px solid var(--predicto);border-radius:8px;padding:10px;font-size:11px;color:var(--slate);position:relative}
.bcell::before{content:"";position:absolute;top:-4px;left:-4px;width:8px;height:8px;border:2px solid var(--predicto);border-radius:50%;background:#fff}
.bcell .t{font-weight:600;font-size:11px;color:var(--navy-800);margin-bottom:6px}
.bcell.spark{display:flex;align-items:end;gap:2px;padding-bottom:14px}
.bcell.spark .bar{flex:1;background:linear-gradient(180deg,var(--predicto),var(--cyan));border-radius:2px 2px 0 0}
.bcell.big-num{display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center}
.bcell.big-num .num{font-family:"JetBrains Mono",monospace;font-size:28px;font-weight:700;color:var(--navy-800);line-height:1}

/* Rule engine block */
.rule-flow{padding:24px;background:repeating-radial-gradient(circle at center,rgba(0,18,92,.05) 1px,transparent 1px) 0 0 / 18px 18px,#FAFBFE;border-radius:10px;position:relative;height:340px}
.rnode{position:absolute;background:#fff;border:1.5px solid var(--border);border-radius:8px;padding:8px 12px;font-size:11.5px;font-weight:600;color:var(--slate);display:flex;align-items:center;gap:8px;min-width:130px;box-shadow:0 4px 12px -4px rgba(0,18,92,.12)}
.rnode .meta{font-family:"JetBrains Mono",monospace;font-size:9.5px;color:var(--text-faint);font-weight:500;display:block;margin-top:1px}
.rnode.trig{border-color:var(--predicto)}
.rnode.cond{border-color:var(--warn)}
.rnode.act{border-color:var(--ok)}
.rnode .ic{width:22px;height:22px;border-radius:5px;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.rnode.trig .ic{background:var(--cyan-soft);color:var(--predicto)}
.rnode.cond .ic{background:#FEF6E7;color:var(--warn)}
.rnode.act .ic{background:#E6F7EE;color:var(--ok)}
.rnode .body{display:flex;flex-direction:column;line-height:1.2}
.rflow-edge{position:absolute;inset:0;pointer-events:none}
.rflow-edge path{stroke:var(--predicto);stroke-width:2;fill:none;stroke-dasharray:5 4;animation:dash 1.4s linear infinite}
@keyframes dash{to{stroke-dashoffset:-18}}

/* PDF report mock */
.report{background:#fff;border:1px solid var(--border);border-radius:10px;overflow:hidden}
.report-head{background:linear-gradient(135deg,var(--navy-800),var(--predicto));color:#fff;padding:16px 20px;display:flex;justify-content:space-between;align-items:center}
.report-head .t{font-weight:700;font-size:15px}
.report-head .d{font-family:"JetBrains Mono",monospace;font-size:11px;opacity:.8}
.report-body{padding:18px 20px;display:grid;grid-template-columns:1fr 1fr;gap:18px}
.rep-kpi{padding:10px 0;border-bottom:1px solid var(--border-soft)}
.rep-kpi:last-child{border-bottom:none}
.rep-kpi .l{font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600}
.rep-kpi .v{font-family:"JetBrains Mono",monospace;font-size:18px;font-weight:700;color:var(--navy-800);margin-top:2px}
.rep-chart{height:100%;min-height:130px;display:flex;align-items:end;gap:3px}
.rep-chart .bar{flex:1;background:linear-gradient(180deg,var(--predicto),var(--cyan));border-radius:2px 2px 0 0}
.rep-foot{padding:10px 20px;background:#FAFBFE;font-family:"JetBrains Mono",monospace;font-size:10px;color:var(--text-faint);display:flex;justify-content:space-between;border-top:1px solid var(--border-soft)}

/* Architecture */
.arch{background:#fff;position:relative}
.arch-diagram{margin-top:48px;border-radius:18px;padding:48px 0}
.arch-cols{display:grid;grid-template-columns:1fr 1fr 1fr 1fr;gap:20px;align-items:stretch}
.arch-col{display:flex;flex-direction:column;gap:10px}
.arch-col .lyr{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--predicto);letter-spacing:.1em;font-weight:600;margin-bottom:8px}
.arch-col h4{color:var(--navy-800);font-size:17px;margin-bottom:14px}
.arch-node{padding:12px 14px;background:var(--bg-soft);border-radius:9px;font-size:13px;color:var(--slate);display:flex;align-items:center;gap:10px}
.arch-node svg{color:var(--predicto);flex-shrink:0}
