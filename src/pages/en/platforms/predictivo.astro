<style>
:root{
  /* Page-specific tokens not in global.css */
  --predicto:#0F8FA8;
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
}
.mono{font-family:"JetBrains Mono",monospace}

/* Breadcrumb */
.breadcrumb{padding:24px 0 0;font-size:13px;color:var(--text-faint);display:flex;align-items:center;gap:10px}
.breadcrumb a{color:var(--text-muted)}
.breadcrumb a:hover{color:var(--primary)}
.breadcrumb .sep{opacity:.5}

/* Hero */
.hero{
  position:relative;padding:64px 0 120px;overflow:hidden;
  background:
    radial-gradient(900px 500px at 80% -100px, rgba(15,143,168,.10), transparent 60%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid-bg{
  position:absolute;inset:0;pointer-events:none;opacity:.4;
  background-image:linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1fr 1.1fr;gap:64px;align-items:center}
.platform-pill{display:inline-flex;align-items:center;gap:10px;padding:7px 14px 7px 8px;border-radius:6px;background:#fff;border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--slate);box-shadow:var(--shadow-sm)}
.platform-pill .pill-tag{background:var(--predicto);color:#fff;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:6px;text-transform:uppercase}
.product-name{
  font-size:clamp(56px,7vw,96px);font-weight:800;letter-spacing:-.04em;line-height:1;
  background:linear-gradient(135deg,#00125C 0%,#0F8FA8 60%,#18B7D6 130%);
  -webkit-background-clip:text;background-clip:text;color:transparent;
  margin:24px 0 14px;padding-bottom:0.12em;
}
.hero h1.product-tag{font-size:clamp(28px,2.6vw,38px);font-weight:700;line-height:1.2;color:var(--navy-800)}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:520px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.hero-stats{display:grid;grid-template-columns:repeat(3,auto);gap:36px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);max-width:520px}
.hero-stat .v{font-family:"JetBrains Mono",monospace;font-size:24px;font-weight:700;color:var(--navy-800)}
.hero-stat .l{font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-top:4px}

/* Hero visual — live dashboard */
.dash{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);padding:0;overflow:hidden;position:relative;
}
.dash-head{
  display:flex;align-items:center;justify-content:space-between;
  padding:14px 20px;border-bottom:1px solid var(--border-soft);background:#FCFCFE;
}
.dash-head .tabs{display:flex;gap:6px}
.dash-head .tab{font-size:11.5px;padding:5px 10px;border-radius:6px;color:var(--text-muted);font-weight:600}
.dash-head .tab.active{background:var(--cyan-soft);color:var(--predicto)}
.dash-head .ctrl{display:flex;gap:10px;align-items:center;font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--text-faint)}
.live-dot{width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 0 rgba(21,160,107,.5);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(21,160,107,.5)}70%{box-shadow:0 0 0 8px rgba(21,160,107,0)}100%{box-shadow:0 0 0 0 rgba(21,160,107,0)}}
.dash-body{padding:18px;display:grid;grid-template-columns:1.4fr 1fr;grid-template-rows:auto auto;gap:14px;background:#FAFBFE}

.kpi-row{grid-column:1/-1;display:grid;grid-template-columns:repeat(4,1fr);gap:10px}
.kpi{background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:12px 14px}
.kpi .l{font-size:10.5px;color:var(--text-faint);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.kpi .v{font-family:"JetBrains Mono",monospace;font-size:20px;font-weight:700;color:var(--navy-800);margin-top:4px;display:flex;align-items:baseline;gap:6px}
.kpi .u{font-size:10px;color:var(--text-faint);font-weight:600}
.kpi .trend{font-size:10.5px;font-weight:600;margin-top:2px;display:inline-flex;gap:3px;align-items:center}
.kpi .trend.up{color:var(--ok)}
.kpi .trend.dn{color:var(--crit)}

.dash-card{background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:14px;display:flex;flex-direction:column}
.dash-card .ttl{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}
.dash-card .ttl h5{font-size:12px;color:var(--slate);font-weight:600;margin:0}
.dash-card .ttl .meta{font-family:"JetBrains Mono",monospace;font-size:10px;color:var(--text-faint)}

/* Energy chart */
.chart{height:96px;position:relative}
.chart svg{width:100%;height:100%;display:block}
.chart .grid line{stroke:var(--border-soft);stroke-width:1}
.chart .area{fill:url(#area-grad)}
.chart .line{fill:none;stroke:var(--predicto);stroke-width:2}
.chart .point{fill:#fff;stroke:var(--predicto);stroke-width:2}

/* Alarms */
.alarm-list{display:flex;flex-direction:column;gap:8px}
.alarm{display:grid;grid-template-columns:auto 1fr auto;gap:10px;align-items:center;padding:8px 10px;background:#FAFBFE;border-radius:8px;font-size:12px}
.alarm .sev{width:7px;height:24px;border-radius:3px}
.alarm.crit .sev{background:var(--crit)}
.alarm.warn .sev{background:var(--warn)}
.alarm.info .sev{background:var(--predicto)}
.alarm .body{color:var(--slate);font-weight:500}
.alarm .body .sub{font-family:"JetBrains Mono",monospace;color:var(--text-faint);font-size:10px;display:block;margin-top:1px}
.alarm .t{font-family:"JetBrains Mono",monospace;font-size:10.5px;color:var(--text-faint)}

/* Health gauge */
.gauges{display:grid;grid-template-columns:1fr 1fr;gap:14px;flex:1;align-items:center}
.gauge{display:flex;flex-direction:column;align-items:center;gap:4px}
.gauge .ring{position:relative;width:78px;height:78px}
.gauge .ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.gauge .ring .bg{fill:none;stroke:var(--border-soft);stroke-width:8}
.gauge .ring .fg{fill:none;stroke-width:8;stroke-linecap:round;transition:stroke-dashoffset .6s}
.gauge .v{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;font-family:"JetBrains Mono",monospace;font-weight:700;color:var(--navy-800);font-size:16px;line-height:1}
.gauge .v small{font-size:8px;color:var(--text-faint);font-weight:600;margin-top:2px}
.gauge .lbl{font-size:11px;color:var(--text-muted);font-weight:500;text-align:center}

/* Map */
.map-mini{position:relative;height:160px;background:#F1F4FA;border-radius:8px;overflow:hidden}
.map-mini::before{
  content:"";position:absolute;inset:0;
  background-image:
    linear-gradient(rgba(0,18,92,.06) 1px,transparent 1px),
    linear-gradient(90deg,rgba(0,18,92,.06) 1px,transparent 1px);
  background-size:18px 18px;
}
.map-zone{position:absolute;border:1px dashed rgba(15,143,168,.4);border-radius:6px}
.map-pin{position:absolute;width:10px;height:10px;border-radius:50%;background:var(--predicto);box-shadow:0 0 0 4px rgba(15,143,168,.2)}
