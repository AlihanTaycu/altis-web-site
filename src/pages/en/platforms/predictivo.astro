          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>Meters · energy</div>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/></svg>Beacon / RTLS</div>
        </div>
        <div class="arch-col">
          <div class="lyr">L2 · EDGE / GATEWAY</div>
          <h4>Data Collection Layer</h4>
