        <div class="arch-col">
          <div class="lyr">L3 · PLATFORM</div>
          <h4>Operational Intelligence</h4>
          <div class="arch-node core">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
            Predictivo Core
          </div>
          <div class="arch-node">Time-series storage</div>
