          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="4" width="18" height="14" rx="2"/><path d="M8 21h8M12 18v3"/></svg>Web · Tablet</div>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="2" width="12" height="20" rx="2"/></svg>Mobile App</div>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/></svg>PDF Reportr</div>
          <div class="arch-node"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg>ERP / SCADA</div>
        </div>
      </div>
      <div class="arch-flow">
        <span class="ln"></span>
        <span>Field</span>
        <span class="ln"></span>
        <span>Gateway</span>
        <span class="ln"></span>
        <span style="color:var(--cyan)">Platform</span>
        <span class="ln"></span>
        <span>User</span>
        <span class="ln"></span>
      </div>
    </div>
  </div>
</section>

