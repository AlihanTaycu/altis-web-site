---
import Base from '../../layouts/Base.astro';
---

<Base
  title="Page Not Found | Altis Technology"
  description="The page you are looking for does not exist or may have been moved."
  lang="en"
  alternateUrl="https://www.altis.com.tr/404/"
  noindex={true}
>
  <section class="not-found">
    <div class="container">
      <div class="nf-inner">
        <span class="nf-code">404</span>
        <h1 class="nf-title">Page not found</h1>
        <p class="nf-desc">
          The page you are looking for may have been removed, moved, or never existed.
        </p>
        <div class="nf-actions">
          <a href="/en/" class="btn btn-primary btn-lg">Back to Home</a>
          <a href="/en/contact/" class="btn btn-secondary btn-lg">Contact Us</a>
        </div>
        <nav class="nf-links" aria-label="Quick links">
          <span class="nf-links-label">Try one of these:</span>
          <a href="/en/platforms/">Platforms</a>
          <a href="/en/solutions/">Solutions</a>
          <a href="/en/sectors/">Sectors</a>
          <a href="/en/products/">Products</a>
          <a href="/en/about/">About</a>
        </nav>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: var(--section-y) 0;
    background: var(--bg-soft);
  }

  .nf-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .nf-code {
    display: block;
    font-size: clamp(80px, 16vw, 140px);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--navy-700) 0%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -4px;
    margin-bottom: 24px;
  }

  .nf-title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 16px;
  }

  .nf-desc {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .nf-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 36px;
  }

  .nf-links {
    display: flex;
    gap: 14px;
    justify-content: center;
    flex-wrap: wrap;
    font-size: 14px;
    color: var(--text-muted);
  }

  .nf-links-label {
    width: 100%;
    font-weight: 600;
    color: var(--text);
    margin-bottom: 2px;
  }

  .nf-links a {
    color: var(--primary);
    font-weight: 600;
  }
</style>
