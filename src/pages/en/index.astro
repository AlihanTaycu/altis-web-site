---
import Base from '../../layouts/Base.astro';

const title = 'Altis Technology - RFID, IoT and Industrial Software';
const description = 'Altis Technology delivers RFID hardware, IoT platforms, industrial software, and field integration projects for warehouses, retail, logistics, and manufacturing.';

const productLinks = [
  { href: '/en/products/rfid-readers/', title: 'RFID Readers', text: 'Fixed, portable, and integrated RFID readers.' },
  { href: '/en/products/rfid-handhelds/', title: 'RFID Handhelds', text: 'Mobile RFID terminals for inventory and field operations.' },
  { href: '/en/products/rfid-printers/', title: 'RFID Printers', text: 'RFID label printing and encoding devices.' },
  { href: '/en/products/rfid-retail/', title: 'RFID Retail Products', text: 'Altis RFID gates, tunnels, and retail automation systems.' },
  { href: '/en/products/rfid-tags/', title: 'RFID Tags', text: 'RFID labels and tags selected for project requirements.' },
];
---

<Base {title} {description} lang="en" alternateUrl="https://www.altis.com.tr/">
  <section class="hero">
    <div class="container hero-inner">
      <p class="eyebrow">Altis Technology</p>
      <h1>RFID, IoT and industrial software for visible operations.</h1>
      <p class="lead">
        We help teams connect field devices, RFID hardware, sensors, and enterprise systems into reliable operational workflows.
      </p>
      <div class="actions">
        <a href="/en/products/" class="btn btn-primary btn-lg">Explore Products</a>
        <a href="/iletisim/" class="btn btn-secondary btn-lg">Contact Altis</a>
      </div>
    </div>
  </section>

  <section class="product-section container">
    <div class="section-head">
      <p class="eyebrow dark">Product Portfolio</p>
      <h2>RFID products ready for project delivery</h2>
      <p>Browse galleries, datasheets, and quote options for Altis Technology's RFID product categories.</p>
    </div>
    <div class="product-grid">
      {productLinks.map(item => (
        <a href={item.href} class="product-card">
          <span>RFID</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </a>
      ))}
    </div>
  </section>
</Base>

<style>
.hero { background: linear-gradient(135deg, var(--primary) 0%, #0a2a8c 100%); color: #fff; padding: 88px 0 78px; }
.hero-inner { max-width: 920px; }
.eyebrow { font-size: 12px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; color: var(--cyan); margin-bottom: 14px; }
.eyebrow.dark { color: var(--cyan); margin-bottom: 10px; }
.hero h1 { color: #fff; font-size: clamp(2.1rem, 5vw, 3.7rem); font-weight: 800; line-height: 1.08; max-width: 820px; margin-bottom: 20px; }
.lead { max-width: 660px; color: rgba(255,255,255,.78); font-size: 1.08rem; line-height: 1.72; margin: 0 0 32px; }
.actions { display: flex; gap: 12px; flex-wrap: wrap; }
.product-section { padding-top: 62px; padding-bottom: 76px; }
.section-head { max-width: 720px; margin-bottom: 28px; }
.section-head h2 { color: var(--primary); font-size: clamp(1.5rem, 3vw, 2.1rem); font-weight: 800; margin-bottom: 10px; }
.section-head p { color: var(--text-muted); line-height: 1.7; margin: 0; }
.product-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 18px; }
.product-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 24px; min-height: 190px; display: flex; flex-direction: column; transition: transform .2s, box-shadow .2s, border-color .2s; }
.product-card:hover { transform: translateY(-2px); border-color: rgba(24,183,214,.5); box-shadow: 0 12px 28px rgba(0,18,92,.08); }
.product-card span { color: var(--cyan); font-size: 11px; font-weight: 800; letter-spacing: .12em; text-transform: uppercase; margin-bottom: 14px; }
.product-card h3 { color: var(--primary); font-size: 1.05rem; font-weight: 800; margin-bottom: 10px; }
.product-card p { color: var(--text-muted); font-size: 13.5px; line-height: 1.6; margin: 0; }
</style>
