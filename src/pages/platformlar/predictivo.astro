---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import CTABanner from '../../components/sections/CTABanner.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Predictivo",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "IoT ve operasyon verilerini karar destek sistemine dönüştüren endüstriyel IoT platformu",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" }
};
---

<Base
  title="Predictivo - Industrial IoT ve Operational Intelligence Platformu | Altis Teknoloji"
  description="Predictivo; sensör, makine, sayaç, beacon, SCADA ve operasyon verilerini dashboard, alarm, rapor ve kural motoruyla karar destek sistemine dönüştürür."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/platforms/predictivo/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/platformlar/">Platformlar</a>
      <span class="sep">/</span>
      <span style="color:var(--predicto);font-weight:600">Predictivo</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="platform-pill">
          <span>Industrial IoT &nbsp;·&nbsp; Dashboard &nbsp;·&nbsp; Rule Engine &nbsp;·&nbsp; Reports</span>
        </div>
        <div class="product-name">Predictivo</div>
        <h1 class="product-tag">Operasyonel verilerinizi karar destek sistemine dönüştürün.</h1>
        <p class="hero-sub">Sensör, makine, sayaç, beacon, SCADA ve operasyon verilerini tek merkezde toplayan endüstriyel IoT platformu. Dashboard, alarm, rapor ve görsel kural motoruyla veriyi anlamlı aksiyonlara dönüştürün.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/iletisim/">Demo Talep Et
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#capabilities">Yetenekleri İncele</a>
        </div>
      </div>

      <!-- Real dashboard screenshot -->
      <div class="hero-visual">
        <img src="/images/Predictivo-transperent.png" alt="Predictivo Dashboard - Gerçek Ekran Görüntüsü" class="hero-img"/>
      </div>
    </div>

    <!-- Stats marquee -->
    <div class="stats-marquee">
      <div class="stats-track">
        <div class="hero-stat"><div class="v">SAP</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">7×24</div><div class="l">kesintisiz izleme</div></div>
        <div class="hero-stat"><div class="v">WMS</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">RT</div><div class="l">gerçek zamanlı veri</div></div>
        <div class="hero-stat"><div class="v">MQTT</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">500+</div><div class="l">bağlanabilir sensör tipi</div></div>
        <div class="hero-stat"><div class="v">Otomatik</div><div class="l">alarm</div></div>
        <div class="hero-stat"><div class="v">ERP</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">∞</div><div class="l">ölçeklenebilir mimari</div></div>
        <div class="hero-stat"><div class="v">Web Servis</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">20+</div><div class="l">desteklenen protokol</div></div>
        <div class="hero-stat"><div class="v">5dk</div><div class="l">kurulum süresi</div></div>
        <div class="hero-stat"><div class="v">REST API</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">Otomatik</div><div class="l">rapor</div></div>
        <!-- duplicate for seamless loop -->
        <div class="hero-stat"><div class="v">SAP</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">7×24</div><div class="l">kesintisiz izleme</div></div>
        <div class="hero-stat"><div class="v">WMS</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">RT</div><div class="l">gerçek zamanlı veri</div></div>
        <div class="hero-stat"><div class="v">MQTT</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">500+</div><div class="l">bağlanabilir sensör tipi</div></div>
        <div class="hero-stat"><div class="v">Otomatik</div><div class="l">alarm</div></div>
        <div class="hero-stat"><div class="v">ERP</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">∞</div><div class="l">ölçeklenebilir mimari</div></div>
        <div class="hero-stat"><div class="v">Web Servis</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">20+</div><div class="l">desteklenen protokol</div></div>
        <div class="hero-stat"><div class="v">5dk</div><div class="l">kurulum süresi</div></div>
        <div class="hero-stat"><div class="v">REST API</div><div class="l">entegrasyon</div></div>
        <div class="hero-stat"><div class="v">Otomatik</div><div class="l">rapor</div></div>
      </div>
    </div>
  </div>
</section>

<!-- Trusted by -->
<div class="logos-strip">
  <div class="container">
    <div class="lbl">Sahada test edilmiş, kurumsal sistemlerle entegre çalışan</div>
    <div class="logos-row">
      <div class="logo-box">SICK</div>
      <div class="logo-box">Çimtaş</div>
      <div class="logo-box">THY</div>
      <div class="logo-box">Siemens</div>
      <div class="logo-box">Turck</div>
      <div class="logo-box">Stanley Healthcare</div>
    </div>
  </div>
</div>

<!-- 5-step flow -->
<section class="flow5" id="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="Beş Adımda Veri Aksiyona Dönüşür"
      heading="Bağlan. İşle. Görselleştir. Harekete Geç. Raporla."
      description="Predictivo'nun beş temel yeteneği, sahadan gelen ham veriyi yönetilebilir operasyona dönüştüren tutarlı bir veri yaşam döngüsü oluşturur."
    />
    <div class="flow5-steps">
      <div class="flow5-step">
        <div class="num">01 · CONNECT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 14a3.5 3.5 0 0 0 5 0l4-4a3.5 3.5 0 0 0-5-5l-1 1"/><path d="M14 10a3.5 3.5 0 0 0-5 0l-4 4a3.5 3.5 0 0 0 5 5l1-1"/></svg></div>
        <h4>Bağlan</h4>
        <p>Sensör, makine, SCADA ve üçüncü parti sistemlerden veri alın.</p>
        <div class="ex">MQTT · HTTP · OPC UA · Modbus · LoRaWAN</div>
      </div>
      <div class="flow5-step">
        <div class="num">02 · PROCESS</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09a1.65 1.65 0 0 0-1-1.51"/></svg></div>
        <h4>İşle</h4>
        <p>Veriyi filtreleyin, eşikler tanımlayın, kural motoru ile akışlar kurun.</p>
        <div class="ex">filter · aggregate · threshold · derive</div>
      </div>
      <div class="flow5-step">
        <div class="num">03 · VISUALIZE</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg></div>
        <h4>Görselleştir</h4>
        <p>Canlı dashboard'lar, grafikler ve haritalarla veriyi anlamlı hale getirin.</p>
        <div class="ex">widgets · drag &amp; drop · responsive</div>
      </div>
      <div class="flow5-step">
        <div class="num">04 · ACT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
        <h4>Harekete Geç</h4>
        <p>Alarm ve bildirimlerle veriyi anında iş sonucuna dönüştürün.</p>
        <div class="ex">alert · email · webhook · device</div>
      </div>
      <div class="flow5-step">
        <div class="num">05 · REPORT</div>
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></div>
        <h4>Raporla</h4>
        <p>Günlük, haftalık, aylık PDF raporlarla performansı ekiplerle paylaşın.</p>
        <div class="ex">günlük · haftalık · aylık · PDF</div>
      </div>
    </div>
  </div>
</section>

<!-- Feature deep dives -->
<section>
  <div class="container">
    <SectionHead
      eyebrow="Yetenekler · Derinlemesine"
      heading="Predictivo neler yapar?"
    />

    <!-- Feature 1: Dashboard builder -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Dashboard Builder</span>
        <h3>Kod yazmadan, operasyona özel paneller</h3>
        <p>Sürükle-bırak widget'larla operasyonunuza özel canlı dashboard'lar tasarlayın. Yönetim için OEE ve enerji KPI'ları, bakım ekibi için makine sağlık skorları, depo için RTLS haritası — aynı veri, farklı bakış açıları.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>20+ widget tipi</strong><span>Grafik, gauge, sayaç, harita, tablo, alarm listesi ve daha fazlası.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Rol bazlı görünüm</strong><span>Yönetim, operasyon, bakım için ayrı dashboard'lar; tek veri kaynağı.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Tam ekran mod</strong><span>Fabrika monitörlerinde, kontrol odasında veya mobilde aynı kalite.</span></div></li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Dashboard editörü — Operasyon Müdürü görünümü</span>
          <span class="right">drag &amp; drop</span>
        </div>
        <div class="builder">
          <div class="builder-side">
            <h6>Widgets</h6>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
              Line chart
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/></svg>
              Gauge
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
              Big number
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>
              Map
            </div>
            <div class="widget-chip">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 3v18"/></svg>
              Table
            </div>
            <h6 style="margin-top:14px">Datasources</h6>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>MQTT · enerji</div>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>OPC UA · MES</div>
            <div class="widget-chip" style="font-size:10.5px"><span style="width:6px;height:6px;border-radius:50%;background:var(--ok);display:inline-block"></span>Modbus · PLC</div>
          </div>
          <div class="builder-canvas">
            <div class="bcell big-num">
              <div class="t">OEE</div>
              <div class="num">82.4%</div>
            </div>
            <div class="bcell">
              <div class="t">Enerji Trendi</div>
              <svg viewBox="0 0 120 50" preserveAspectRatio="none" style="width:100%;height:50px">
                <path d="M0,40 L20,30 L40,32 L60,18 L80,22 L100,12 L120,18" fill="none" stroke="var(--predicto)" stroke-width="2"/>
              </svg>
            </div>
            <div class="bcell spark">
              <div class="t" style="width:100%;position:absolute;top:8px;left:10px">Üretim · 7g</div>
              <div class="bar" style="height:55%"></div>
              <div class="bar" style="height:72%"></div>
              <div class="bar" style="height:48%"></div>
              <div class="bar" style="height:85%"></div>
              <div class="bar" style="height:62%"></div>
              <div class="bar" style="height:78%"></div>
              <div class="bar" style="height:90%"></div>
            </div>
            <div class="bcell">
              <div class="t">Alarm Sayısı</div>
              <div style="display:flex;align-items:end;justify-content:space-between;height:50px">
                <div style="font-family:'JetBrains Mono',monospace;font-size:22px;font-weight:700;color:var(--warn)">3</div>
                <div style="font-size:10px;color:var(--text-faint)">2 kritik · 1 uyarı</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Feature 2: Rule engine for alarms -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Kural · Kestirimci Bakım Uyarısı</span>
          <span class="right">v2 · aktif</span>
        </div>
        <div class="surface-body">
          <div class="rule-flow">
            <!-- Trigger -->
            <div class="rnode trig" style="left:10px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 8v4l3 2"/></svg></div>
              <div class="body">Trigger<span class="meta">CNC-02 · vibration</span></div>
            </div>
            <div class="rnode trig" style="left:10px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v16H4z"/><path d="M9 9h6v6H9z"/></svg></div>
              <div class="body">Trigger<span class="meta">CNC-02 · temp</span></div>
            </div>

            <!-- Condition -->
            <div class="rnode cond" style="left:200px;top:90px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 2 22h20z"/></svg></div>
              <div class="body">If &gt; 4mm/s &amp; &gt;72°C<span class="meta">15 dk pencere</span></div>
            </div>

            <!-- Actions -->
            <div class="rnode act" style="left:380px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12h6l3-9 4 18 3-9h4"/></svg></div>
              <div class="body">Alarm: Kritik<span class="meta">bakim@altis</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg></div>
              <div class="body">İş emri oluştur<span class="meta">CMMS webhook</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:250px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 5h12l3 3h3v11H3z"/></svg></div>
              <div class="body">SMS · Mühendis<span class="meta">+90 5xx ...</span></div>
            </div>

            <svg class="rflow-edge" viewBox="0 0 520 320" preserveAspectRatio="none">
              <path d="M150,46 C180,46 180,106 200,106"/>
              <path d="M150,156 C180,156 180,116 200,116"/>
              <path d="M340,106 C360,106 360,46 380,46"/>
              <path d="M340,106 C360,106 360,156 380,156"/>
              <path d="M340,106 C360,106 360,266 380,266"/>
            </svg>
          </div>
          <div style="display:flex;justify-content:space-between;margin-top:14px;font-family:'JetBrains Mono',monospace;font-size:11px;color:var(--text-faint)">
            <span>son 30 gün: 12 tetiklenme · 2 gerçek arıza önlendi</span>
            <span style="color:var(--ok)">● aktif</span>
          </div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Görsel Kural Motoru</span>
        <h3>Veri → Eşik → Aksiyon, kod yazmadan</h3>
        <p>Hangi sensör değeri, hangi koşulda, hangi aksiyonu tetikleyecek? Bu mantık görsel bir akış editöründe kurulur. Operasyon ekibi yeni kural tanımlamak için yazılım ekibini beklemez; eşikleri, koşulları ve aksiyonları kendisi yönetir.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Trigger · Condition · Action</strong><span>Sade üç katmanlı model; karmaşık senaryolar bileşik kurallarla.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Çok-kanallı aksiyon</strong><span>E-posta, SMS, webhook, cihaz tetikleme, dashboard alarm — biri veya hepsi.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Geçmiş ve etki</strong><span>Hangi kural ne zaman çalıştı, hangi sonuca yol açtı — tam izlenebilir.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Reports -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Otomatik Raporlar</span>
        <h3>Yönetim için aylık, operasyon için günlük PDF'ler</h3>
        <p>Predictivo'da hazırlanan dashboard'lar otomatik olarak PDF rapor şablonlarına dönüştürülür. Belirlenen periyotlarda — günlük, haftalık, aylık — ilgili kişilere e-posta ile gönderilir. KPI özetleri, trend analizleri, alarm istatistikleri, makine performansı tek belgede toplanır.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Şablon bazlı</strong><span>Yönetim, operasyon, bakım, enerji — farklı raporlar, farklı alıcılar.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Otomatik dağıtım</strong><span>Cron benzeri planlı gönderim; e-posta veya dosya hedefi.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg><div><strong>Markalı çıktı</strong><span>Kurumsal şablon, logo ve renk paleti raporlara işlenir.</span></div></li>
        </ul>
      </div>
      <div class="report">
        <div class="report-head">
          <div>
            <div class="t">Operasyon Aylık Raporu</div>
            <div style="font-family:'JetBrains Mono',monospace;font-size:11px;opacity:.8;margin-top:2px">Tesis · İstanbul Hadımköy</div>
          </div>
          <div class="d">Mart 2026 · sayfa 1/8</div>
        </div>
        <div class="report-body">
          <div>
            <div class="rep-kpi">
              <div class="l">Ortalama OEE</div>
              <div class="v">82.4%</div>
            </div>
            <div class="rep-kpi">
              <div class="l">Toplam Enerji</div>
              <div class="v">4,182 kWh</div>
            </div>
            <div class="rep-kpi">
              <div class="l">Önlenen Arıza</div>
              <div class="v">7</div>
            </div>
            <div class="rep-kpi">
              <div class="l">Kritik Alarm</div>
              <div class="v" style="color:var(--crit)">14</div>
            </div>
          </div>
          <div>
            <div style="font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-bottom:8px">Üretim · Günlük</div>
            <div class="rep-chart">
