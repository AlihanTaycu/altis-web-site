        <div class="uc-metrics">
          <div class="uc-m"><div class="v">RT</div><div class="l">canlı konum</div></div>
          <div class="uc-m"><div class="v">Geo-fence</div><div class="l">bölge alarmı</div></div>
        </div>
      </article>
