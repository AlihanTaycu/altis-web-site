---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import CTABanner from '../../components/sections/CTABanner.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Tag&Trace",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "RFID operasyonlarını tek merkezden yöneten orkestrasyon platformu",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" }
};
---

<Base
  title="Tag&Trace - RFID Orkestrasyon Platformu | Altis Teknoloji"
  description="Tag&Trace; RFID okuyucular, yazıcılar, barkod sistemleri, PLC'ler, sensörler ve kurumsal sistemler arasında çalışan RFID orkestrasyon platformudur."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/platforms/tag-trace/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/platformlar/tag-trace/">Platformlar</a>
      <span class="sep">/</span>
      <span style="color:var(--primary);font-weight:600">Tag&amp;Trace</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="platform-pill">
          <span class="pill-tag">Platform</span>
          <span>RFID ve Auto-ID Orchestration · Edge Framework</span>
        </div>
        <div class="product-name" style="background-position: center center; background-size: cover; margin: 24px 0px 14px;">Tag<span class="amp" style=""><span style="color: rgba(0, 0, 0, 0.808);">&nbsp;&amp;&nbsp;</span></span>Trace</div>
        <h1 class="product-tag">RFID cihazlarınızı rahatça yönetin.</h1>
        <p class="hero-sub">RFID okuyucular, yazıcılar, barkod sistemleri, PLC'ler, sensörler ve kurumsal sistemler arasında çalışan güçlü bir orkestrasyon ve edge framework platformu. Sahadaki RFID donanımlarınızı tek merkezden yönetin, veriyi kaynakta işleyin, kurumsal sistemlerinize güvenilir şekilde aktarın.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/iletisim/">Demo Talep Et
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#capabilities">Yetenekleri İncele</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v" data-count>50+</div><div class="l">desteklenen donanım</div></div>
          <div class="hero-stat"><div class="v" data-count>9</div><div class="l">protokol</div></div>
          <div class="hero-stat"><div class="v">7×24</div><div class="l">edge sürekliliği</div></div>
        </div>
      </div>

      <!-- Live EPC stream panel -->
      <div class="hero-panel">
        <div class="panel-head">
          <span class="ttl">EPC Stream · Canlı</span>
          <span class="right"><span class="live-dot"></span>RDR-01 · Sevkiyat Kapı A</span>
        </div>
        <div class="epc-stream">
          <div class="epc-row new">
            <span class="ts">14:32:07.841</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 02 1F</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row new">
            <span class="ts">14:32:07.839</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 02 1E</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:07.612</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 02 1D</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:06.204</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 01 A2</span></span>
            <span class="ev warn">⚠ MISSING</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:05.991</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 01 A1</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:05.440</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 01 A0</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row">
            <span class="ts">14:32:04.118</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 00 F9</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
          <div class="epc-row dim">
            <span class="ts">14:32:03.882</span>
            <span class="epc">E2 80 11 60 <span class="hi">60 00 00 F8</span></span>
            <span class="ev ok">✓ MATCH</span>
          </div>
        </div>
        <div class="panel-footer">
          <span>ORDER-78912 · 7/8 eşleşti</span>
          <span style="color:#15a06b;font-weight:600">→ SAP onaylandı</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Trusted by -->
<div class="logos-strip">
  <div class="container">
    <div class="lbl">— Sahada test edilmiş, kurumsal sistemlerle entegre çalışan —</div>
    <div class="logos-row">
      <div class="logo-box">Zebra</div>
      <div class="logo-box">Impinj</div>
      <div class="logo-box">Honeywell</div>
      <div class="logo-box">Nordic ID</div>
      <div class="logo-box">SATO</div>
      <div class="logo-box">Datalogic</div>
    </div>
  </div>
</div>

<!-- Three Pillars -->
<section class="pillars" id="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="Üç Temel Yetenek"
      heading="Cihazı yönet, veriyi işle, sisteme bağla"
      description="Tag&amp;Trace; karmaşık RFID donanım kurulumlarını standart bir arayüze indirgeyen üç temel yetenek üzerine kuruludur."
    />
    <div class="pillar-grid" data-reveal data-reveal-delay="100">
      <div class="pillar">
        <div class="pn">01 · DEVICES</div>
        <h3>Marka bağımsız cihaz yönetimi</h3>
        <p>RFID okuyucular, yazıcılar, barkod sistemleri, PLC'ler ve sensörler tek merkezden kaydedilir, yapılandırılır ve izlenir. Farklı marka ve modeller standart bir cihaz nesnesine soyutlanır.</p>
        <ul>
          <li>Reader anten / güç / session yönetimi</li>
          <li>Printer şablon ve baskı kuyruğu</li>
          <li>Cihaz sağlığı ve uptime izleme</li>
          <li>Toplu yapılandırma profilleri</li>
        </ul>
      </div>
      <div class="pillar">
        <div class="pn">02 · DATA</div>
        <h3>Görsel kural motoru &amp; edge işleme</h3>
        <p>Sahadan gelen okumalar görsel bir akış editöründe işlenir. Filtreleme, eşleştirme, doğrulama ve aksiyon kuralları kod yazmadan tasarlanır; edge node'larda lokal çalıştırılır.</p>
        <ul>
          <li>In / Process / Out node'ları</li>
          <li>Lokal edge çalıştırma</li>
          <li>Offline-first dayanıklılık</li>
          <li>Rule versioning &amp; deploy</li>
        </ul>
      </div>
      <div class="pillar">
        <div class="pn">03 · INTEGRATION</div>
        <h3>Kurumsal sistem entegrasyonu</h3>
        <p>ERP, WMS, SAP, MES ve diğer kurumsal sistemlerle çift yönlü, güvenilir veri akışı kurulur. Endüstri standart protokoller ile her sistem konuşturulur.</p>
        <ul>
          <li>REST API · MQTT · OPC UA</li>
          <li>SAP / ERP / WMS adaptörleri</li>
          <li>TCP Socket · Modbus · HTTP/S</li>
          <li>Audit log &amp; data lineage</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Feature deep dives -->
<section>
  <div class="container">
    <SectionHead
      eyebrow="Yetenekler · Derinlemesine"
      heading="Tag&amp;Trace neler yapar?"
    />

    <!-- Feature 0: Rule Engine -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Kural · Sevkiyat Doğrulama</span>
          <span class="right">flow aktif · sevkiyat-doğrulama</span>
        </div>
        <div class="surface-body" style="padding:0">
          <div class="rule-flow">
            <div class="rnode trig" style="left:10px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/><circle cx="5" cy="19" r="1"/></svg></div>
              <div class="body">RFID Reader In<span class="meta">RDR-01 · port 5</span></div>
            </div>
            <div class="rnode trig" style="left:10px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 3v18M5 8l7-5 7 5"/></svg></div>
              <div class="body">MQTT In<span class="meta">topic: erp/ship</span></div>
            </div>
            <div class="rnode cond" style="left:200px;top:90px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83"/></svg></div>
              <div class="body">Validate &amp; Match<span class="meta">epc → sipariş</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:30px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><ellipse cx="12" cy="6" rx="8" ry="3"/><path d="M4 6v12c0 1.7 3.6 3 8 3s8-1.3 8-3V6"/></svg></div>
              <div class="body">HTTP → SAP<span class="meta">POST /sap/ship</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:140px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="9" rx="2"/><path d="M6 9V5h12v4"/></svg></div>
              <div class="body">Printer Out<span class="meta">PRN-03 · ZPL</span></div>
            </div>
            <div class="rnode act" style="left:380px;top:250px">
              <div class="ic"><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
              <div class="body">Alarm: Eksik<span class="meta">ops@altis</span></div>
            </div>
            <svg class="rflow-edge" viewBox="0 0 520 320">
              <path d="M150,46 C180,46 180,106 200,106"/>
              <path d="M150,156 C180,156 180,116 200,116"/>
              <path d="M340,106 C360,106 360,46 380,46"/>
              <path d="M340,106 C360,106 360,156 380,156"/>
              <path d="M340,106 C360,106 360,266 380,266"/>
            </svg>
            <svg class="rflow-pulse" viewBox="0 0 520 320" aria-hidden="true">
              <path pathLength="100" d="M150,46 C180,46 180,106 200,106"/>
              <path pathLength="100" d="M150,156 C180,156 180,116 200,116"/>
              <path pathLength="100" d="M340,106 C360,106 360,46 380,46"/>
              <path pathLength="100" d="M340,106 C360,106 360,156 380,156"/>
              <path pathLength="100" d="M340,106 C360,106 360,266 380,266"/>
            </svg>
          </div>
          <div class="re-footer">son 30 gün: 1,240 sevkiyat · 18 hata yakalandı · <span style="color:#15a06b">● aktif</span></div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Görsel Kural Motoru</span>
        <h3>Saha kurallarını kod yazmadan tasarlayın</h3>
        <p>RFID okumalarından gelen veri, görsel bir akış editöründe işlenir. Hangi okuma hangi koşulda tetiklenecek, hangi sistemle eşleşecek ve ne tür aksiyon üretecek — bunların tümü sürükle-bırak arayüzde tanımlanır; edge node'larda lokal çalıştırılır.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>In / Process / Out node'ları</strong><span>Kaynak, işleme ve çıkış adımları ayrı node türleriyle modellenir.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Edge'de lokal çalıştırma</strong><span>İnternet kesilse bile kurallar sahada çalışmaya devam eder.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Rule versioning &amp; deploy</strong><span>Yeni kural versiyonları test ortamında onaylanıp sahaya dağıtılır.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 1: Device manager -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Cihaz Yönetimi</span>
        <h3>Tüm Auto-ID donanımlarınız tek bir envanterde</h3>
        <p>RFID okuyucular, yazıcılar, barkod sistemleri ve sensörler — marka ve modelden bağımsız şekilde — aynı arayüzde envantere alınır. Saha personeli "RDR-01 kapalı" demek yerine, gerçek cihaz adı, lokasyonu, son okuma zamanı ve sağlık durumuyla net bilgi görür.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Auto-discovery</strong><span>Ağa bağlanan cihazlar otomatik tespit edilir, kaydedilir.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Sağlık ve uptime</strong><span>Her cihaz için canlı durum, son okuma, ping ve hata sayacı.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Toplu yapılandırma</strong><span>Profil bazlı, lokasyon bazlı veya etiket bazlı toplu güncellemeler.</span></div></li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Cihaz envanteri</span>
          <span class="right">182 cihaz · 24 lokasyon</span>
        </div>
        <div class="surface-body" style="padding:0 4px">
          <table class="devtable">
            <thead>
              <tr><th style="padding-left:18px">ID</th><th>Cihaz</th><th>Tip</th><th>Konum</th><th style="padding-right:18px">Durum</th></tr>
            </thead>
            <tbody>
              <tr data-reveal data-reveal-delay="0"><td style="padding-left:18px"><span class="id">RDR-01</span></td><td>Impinj R700</td><td><span class="devtype">READER</span></td><td>Sevkiyat Kapı A</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Çalışıyor</span></td></tr>
              <tr data-reveal data-reveal-delay="70"><td style="padding-left:18px"><span class="id">PRN-03</span></td><td>Zebra ZT411</td><td><span class="devtype">PRINTER</span></td><td>Etiketleme</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Hazır</span></td></tr>
              <tr data-reveal data-reveal-delay="140"><td style="padding-left:18px"><span class="id">RDR-07</span></td><td>Zebra FX9600</td><td><span class="devtype">READER</span></td><td>Üretim Hattı 2</td><td style="padding-right:18px"><span class="dev-status warn"><span class="d"></span>Bakım</span></td></tr>
              <tr data-reveal data-reveal-delay="210"><td style="padding-left:18px"><span class="id">SNS-12</span></td><td>Temperature</td><td><span class="devtype">SENSOR</span></td><td>Soğuk Hava</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Çalışıyor</span></td></tr>
              <tr data-reveal data-reveal-delay="280"><td style="padding-left:18px"><span class="id">BCR-04</span></td><td>Honeywell</td><td><span class="devtype">BARCODE</span></td><td>Paketleme</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Çalışıyor</span></td></tr>
              <tr data-reveal data-reveal-delay="350"><td style="padding-left:18px"><span class="id">PLC-02</span></td><td>Siemens S7</td><td><span class="devtype">PLC</span></td><td>Konveyör 1</td><td style="padding-right:18px"><span class="dev-status ok"><span class="d"></span>Çalışıyor</span></td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- Feature 2: Reader config -->
    <div class="feature-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">RDR-01 · Anten yapılandırması</span>
          <span class="right">Impinj R700 · v3.2</span>
        </div>
        <div class="surface-body">
          <div style="margin-bottom:16px">
            <div style="font-size:12px;font-weight:600;color:var(--slate);margin-bottom:4px">Anten 1 — Güç (dBm)</div>
            <div class="slider-mock"><span class="dot"></span></div>
            <div style="display:flex;justify-content:space-between;font-family:'JetBrains Mono',monospace;font-size:10.5px;color:var(--text-faint);margin-top:4px"><span>10</span><span style="color:var(--navy-800);font-weight:600">27.5 dBm</span><span>33</span></div>
          </div>
          <div class="config-panel">
            <div>
              <div class="cfg-row"><span class="k">Okuma modu</span><span class="v">Autonomous</span></div>
              <div class="cfg-row"><span class="k">Session</span><span class="v">S1</span></div>
              <div class="cfg-row"><span class="k">Search mode</span><span class="v">Single Target</span></div>
              <div class="cfg-row"><span class="k">Q parameter</span><span class="v">4</span></div>
            </div>
            <div>
              <div class="cfg-row"><span class="k">Frekans</span><span class="v">865-868 MHz</span></div>
              <div class="cfg-row"><span class="k">Tetikleme</span><span class="v">GPI Input</span></div>
              <div class="cfg-row"><span class="k">Filtre</span><span class="v">EPC prefix</span></div>
              <div class="cfg-row"><span class="k">Bağlantı</span><span class="v">TCP · 14150</span></div>
            </div>
          </div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Reader Kontrolü</span>
        <h3>Saha koşullarına göre okuyucu profilleri</h3>
        <p>Anten gücü, okuma modu, session, frekans ve tetikleme modu gibi tüm reader parametreleri merkezden yönetilir. Sevkiyat kapısı için ayrı, üretim hattı için ayrı bir profil tanımlanır — saha personeli sadece "Sevkiyat Profili" seçer.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Profil tabanlı yönetim</strong><span>Senaryo başına yapılandırma; tek tıkla değişim.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>GPI / GPO desteği</strong><span>Foto-cell, ışık bariyeri, kapı sensörleri tetikleyici olarak kullanılır.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>EPC filtreleme</strong><span>Sadece ilgili etiketleri okumak için prefix / mask filtreleri.</span></div></li>
        </ul>
      </div>
    </div>

    <!-- Feature 3: Label templates -->
    <div class="feature-block">
      <div class="copy">
        <span class="badge">Etiket &amp; Yazıcı</span>
        <h3>ZPL şablonları, ERP verisiyle dinamik baskı</h3>
        <p>Etiket şablonları görsel editör veya ZPL ile tasarlanır. ERP veya WMS'den gelen sipariş, ürün ve sevkiyat verisiyle dinamik olarak doldurulur ve doğru yazıcıya yönlendirilir. Baskı kuyruğu izlenir, hata durumunda yeniden basım otomatikleşir.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>ZPL desteği</strong><span>Endüstri standardı; Zebra, Honeywell, SATO uyumluluğu.</span></div></li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"></path></svg><div><strong>Dinamik veri bağlama</strong><span>&#123;&#123;order.id&#125;&#125;, &#123;&#123;sku&#125;&#125;, &#123;&#123;shipDate&#125;&#125; gibi alanlar otomatik.</span></div></li>
