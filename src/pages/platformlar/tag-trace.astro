          <div class="uc-m"><div class="v">RT</div><div class="l">canlı konum</div></div>
          <div class="uc-m"><div class="v">WMS</div><div class="l">çift yönlü sync</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 3"></path></svg></div>
        <h3>Perakende &amp; Mağaza</h3>
