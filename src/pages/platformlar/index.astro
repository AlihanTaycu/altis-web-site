---
import Base from '../../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Altis Platformlar",
  "description": "Altis Teknoloji platformları: Tag&Trace ve Predictivo"
};
---

<Base
  title="Platformlar | Altis Teknoloji"
  description="RFID, Auto-ID ve Industrial IoT operasyonları için Altis Teknoloji platformları: Tag&Trace ve Predictivo."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/platforms/"
>
  <section class="hub-hero">
    <div class="container">
      <div class="eyebrow">Platformlar</div>
      <h1>Operasyon verisini sahadan karar ekranına taşıyan iki ana platform.</h1>
      <p>Tag&Trace fiziksel akışı ve Auto-ID katmanını yönetir. Predictivo makine, enerji ve operasyon verisini canlı zekâya dönüştürür.</p>
    </div>
  </section>

  <section class="hub-list">
    <div class="container grid">
      <a class="hub-card" href="/platformlar/tag-trace/">
        <span class="tag">RFID & Auto-ID</span>
        <h2>Tag&Trace</h2>
        <p>RFID reader, barkod, etiket, WMS/ERP ve saha cihazlarını tek merkezden orkestre eden izlenebilirlik platformu.</p>
      </a>
      <a class="hub-card" href="/platformlar/predictivo/">
        <span class="tag">Industrial IoT</span>
        <h2>Predictivo</h2>
        <p>Makine sağlığı, OEE, enerji ve sensör verisini canlı dashboard, alarm ve rapor akışına çeviren operasyonel zekâ platformu.</p>
      </a>
    </div>
  </section>
</Base>

<style>
.hub-hero { padding: 96px 0 52px; background: linear-gradient(180deg, #f6f8fc 0%, #fff 100%); }
.hub-hero h1 { max-width: 900px; margin-top: 18px; font-size: clamp(38px, 5vw, 62px); }
.hub-hero p { max-width: 760px; margin-top: 20px; font-size: 19px; }
.hub-list { padding: 40px 0 100px; }
.grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 22px; }
.hub-card { display: grid; gap: 14px; min-height: 280px; padding: 34px; border: 1px solid var(--border); border-radius: 8px; background: #fff; transition: transform .2s, box-shadow .2s, border-color .2s; }
.hub-card:hover { transform: translateY(-3px); box-shadow: var(--shadow); border-color: var(--primary); }
.hub-card h2 { font-size: 32px; }
.hub-card p { font-size: 16.5px; }
.tag { width: fit-content; color: var(--primary); background: var(--bg-blue); border: 1px solid var(--border); border-radius: 999px; padding: 6px 10px; font-size: 12px; font-weight: 700; }
@media (max-width: 760px) { .grid { grid-template-columns: 1fr; } .hub-card { min-height: auto; } }
</style>
