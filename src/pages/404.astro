---
import Base from '../layouts/Base.astro';
---

<Base
  title="Sayfa Bulunamadı — Altis Teknoloji"
  description="Aradığınız sayfa mevcut değil veya taşınmış olabilir."
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/404/"
  noindex={true}
>
  <section class="not-found">
    <div class="container">
      <div class="nf-inner">
        <span class="nf-code">404</span>
        <h1 class="nf-title">Sayfa bulunamadı</h1>
        <p class="nf-desc">
          Aradığınız sayfa kaldırılmış, taşınmış ya da hiç var olmamış olabilir.
        </p>
        <div class="nf-actions">
          <a href="/" class="btn btn-primary btn-lg">Ana Sayfaya Dön</a>
          <a href="/iletisim/" class="btn btn-secondary btn-lg">Bize Ulaşın</a>
        </div>
        <nav class="nf-links" aria-label="Hızlı bağlantılar">
          <span class="nf-links-label">Sizi götürelim:</span>
          <a href="/platformlar/">Platformlar</a>
          <a href="/cozumler/">Çözümler</a>
          <a href="/sektorler/">Sektörler</a>
          <a href="/urunler/">Ürünler</a>
          <a href="/hakkimizda/">Hakkımızda</a>
        </nav>
      </div>
    </div>
  </section>
</Base>

<style>
  .not-found {
    min-height: calc(100vh - 72px);
    display: flex;
    align-items: center;
    padding: var(--section-y) 0;
    background: var(--bg-soft);
  }

  .nf-inner {
    max-width: 560px;
    margin: 0 auto;
    text-align: center;
  }

  .nf-code {
    display: block;
    font-size: clamp(80px, 16vw, 140px);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(135deg, var(--navy-700) 0%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -4px;
    margin-bottom: 24px;
  }

  .nf-title {
    font-size: clamp(24px, 4vw, 36px);
    font-weight: 700;
    color: var(--navy);
    margin-bottom: 16px;
  }

  .nf-desc {
    font-size: 17px;
    color: var(--text-muted);
    line-height: 1.6;
    margin-bottom: 40px;
  }

  .nf-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 48px;
  }

  .nf-links {
    display: flex;
    align-items: center;
    gap: 8px 16px;
    flex-wrap: wrap;
    justify-content: center;
    font-size: 14px;
  }

  .nf-links-label {
    color: var(--text-faint);
  }

  .nf-links a {
    color: var(--navy-700);
    text-decoration: none;
    font-weight: 500;
    transition: color var(--dur-fast) var(--ease);
  }

  .nf-links a:hover {
    color: var(--cyan);
  }
</style>
