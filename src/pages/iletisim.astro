---
import Base from '../layouts/Base.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "ContactPage",
    "name": "Altis Teknoloji İletişim",
    "url": "https://www.altis.com.tr/iletisim/",
    "mainEntity": { "@id": "https://www.altis.com.tr/#organization" }
  },
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "@id": "https://www.altis.com.tr/#organization",
    "name": "Altis Teknoloji Yazılım Danışmanlık",
    "url": "https://www.altis.com.tr",
    "telephone": "+90-216-415-82-55",
    "email": "info@altis.com.tr",
    "address": [
      {
        "@type": "PostalAddress",
        "name": "İMES Head Office",
        "streetAddress": "Natoyolu Cad. İlkyaz Sok. Kartal Plaza No: 24-28 Kat: 1 D: 1",
        "addressLocality": "Ümraniye",
        "addressRegion": "İstanbul",
        "postalCode": "34776",
        "addressCountry": "TR"
      },
      {
        "@type": "PostalAddress",
        "name": "BÜDOTEK R&D Office",
        "streetAddress": "Dudullu OSB Boğaziçi Üniversitesi Teknopark DES 2. Cadde D: 8",
        "addressLocality": "Ümraniye",
        "addressRegion": "İstanbul",
        "addressCountry": "TR"
      }
    ]
  }
];
---

<Base
  title="İletişim | Altis Teknoloji"
  description="Altis Teknoloji ile demo, keşif ve proje görüşmesi için iletişime geçin."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/contact/"
>
  <section class="contact-hero">
    <div class="container grid">
      <div>
        <div class="eyebrow">İletişim</div>
        <h1>Demo Talep Et</h1>
        <p>RFID, IoT, depo otomasyonu veya üretim zekâsı ihtiyacınızı birlikte netleştirelim. Ekibimiz uygun platform, pilot kapsam ve yol haritası ile geri döner.</p>
      </div>
      <div class="contact-card">
        <h2>Altis Teknoloji Yazılım Danışmanlık</h2>
        <a href="mailto:info@altis.com.tr">info@altis.com.tr</a>
        <a href="tel:+902164158255">+90 216 415 82 55</a>
        <div class="offices">
          <div class="office">
            <strong>İMES Head Office</strong>
            <address>
              Natoyolu Cad. İlkyaz Sok.<br />
              Kartal Plaza No: 24-28 Kat: 1 D: 1<br />
              34776 Ümraniye / İstanbul
            </address>
          </div>
          <div class="office">
            <strong>BÜDOTEK R&amp;D Office</strong>
            <address>
              Dudullu OSB Boğaziçi Üniversitesi<br />
              Teknopark DES 2. Cadde D: 8<br />
              Ümraniye / İstanbul
            </address>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="form-section">
    <div class="container form-grid">
      <form class="contact-form">
        <label>Ad Soyad<input name="name" autocomplete="name" /></label>
        <label>E-posta<input name="email" type="email" autocomplete="email" /></label>
        <label>Şirket<input name="company" autocomplete="organization" /></label>
        <label>Mesaj<textarea name="message" rows="5"></textarea></label>
        <button class="btn btn-primary" type="submit">Demo Talep Et</button>
      </form>
      <div class="map-box">
        <iframe
          src="https://www.google.com/maps?q=Altis+Teknoloji,+Natoyolu+Cad,+%C4%B0lkyaz+Sok,+Kartal+Plaza,+%C3%9Cmraniye/%C4%B0stanbul&output=embed"
          title="Altis Teknoloji ofis konumu — Kartal Plaza, Ümraniye/İstanbul"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>
  </section>
</Base>

<style>
.contact-hero { padding: 96px 0 48px; background: var(--bg-soft); }
.grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(300px, .7fr); gap: 36px; align-items: end; }
h1 { margin-top: 18px; }
.contact-hero p { max-width: 720px; margin-top: 18px; font-size: 19px; }
.contact-card { display: grid; gap: 14px; padding: 28px; border: 1px solid var(--border); border-radius: 8px; background: #fff; }
.contact-card h2 { font-size: 22px; }
.contact-card > a { color: var(--primary); font-weight: 700; }
.offices { display: grid; gap: 16px; margin-top: 4px; }
.office { border-top: 1px solid var(--border); padding-top: 12px; }
.office strong { display: block; font-size: 13px; text-transform: uppercase; letter-spacing: .04em; color: var(--cyan); margin-bottom: 6px; }
address { font-style: normal; font-size: 14px; line-height: 1.7; color: var(--text); }
.form-section { padding: 56px 0 100px; }
.form-grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(280px, .8fr); gap: 28px; }
.contact-form { display: grid; gap: 16px; padding: 28px; border: 1px solid var(--border); border-radius: 8px; }
label { display: grid; gap: 7px; color: var(--text); font-weight: 700; }
input, textarea { width: 100%; border: 1px solid var(--border); border-radius: 8px; padding: 12px 13px; font: inherit; color: var(--text); }
input:focus, textarea:focus { outline: 2px solid var(--cyan-soft); border-color: var(--cyan); }
.map-box { min-height: 360px; border-radius: 12px; overflow: hidden; border: 1px solid var(--border); background: var(--bg-soft); }
.map-box iframe { width: 100%; height: 100%; min-height: 360px; border: 0; display: block; }
@media (max-width: 820px) { .grid, .form-grid { grid-template-columns: 1fr; } }
</style>
