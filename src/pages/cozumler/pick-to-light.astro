<style>
:root{
  --navy-900:#000A3A;--navy-800:#00125C;--navy-700:#0A1E75;
  --bg:#FFFFFF;--bg-soft:#F6F8FC;--bg-blue:#EEF3FF;
  --text:#111827;--text-muted:#5F6675;--text-faint:#8A93A5;
  --border:#E3E8F2;--border-soft:#EEF1F7;
  --slate:#334155;
  --cyan:#18B7D6;--cyan-soft:#E8FAFD;
  /* Pick-to-Light yellow — warm amber that reads as classic PtL */
  --ptl:#E8A317;
  --ptl-deep:#B8800F;
  --ptl-soft:#FFF6E0;
  --ptl-glow:rgba(232,163,23,.35);
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
  --primary:var(--navy-800);
  --radius:14px;--radius-lg:22px;
  --shadow-sm:0 1px 2px rgba(0,18,92,.04);
  --shadow:0 8px 28px -12px rgba(0,18,92,.18),0 2px 6px rgba(0,18,92,.05);
