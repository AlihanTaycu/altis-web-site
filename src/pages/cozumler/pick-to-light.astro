/* Hardware module showcase */
.hardware{background:#fff}
.hw-grid{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.hw-copy h2{font-size:36px}
.hw-features{display:grid;gap:18px;margin-top:32px}
.hw-feat{display:flex;gap:16px;align-items:flex-start}
.hw-feat .ic{width:40px;height:40px;border-radius:10px;background:var(--ptl-soft);color:var(--ptl-deep);display:flex;align-items:center;justify-content:center;flex-shrink:0}
.hw-feat h4{font-size:15.5px;color:var(--navy-800);margin-bottom:4px}
.hw-feat p{font-size:13.5px;line-height:1.55}

/* Hardware visual — close-up of light module */
.hw-display{
  position:relative;background:#0F0F14;border-radius:var(--radius-lg);padding:48px;
  box-shadow:var(--shadow-lg);overflow:hidden;min-height:480px;
  display:flex;align-items:center;justify-content:center;
}
.hw-display::before{
  content:"";position:absolute;inset:0;
  background:radial-gradient(circle at center, rgba(232,163,23,.18), transparent 60%);
}
.module-big{
  position:relative;background:linear-gradient(180deg,#1a1a22,#0a0a0e);
  border:1.5px solid rgba(255,255,255,.08);border-radius:14px;
  padding:28px 32px;display:flex;align-items:center;gap:28px;min-width:380px;
  box-shadow:0 30px 60px -20px rgba(0,0,0,.6),0 0 60px var(--ptl-glow);
}
.module-big .led-big{
  width:36px;height:36px;border-radius:50%;background:var(--ptl);
  box-shadow:0 0 20px var(--ptl),0 0 40px var(--ptl-glow),inset 0 -3px 8px rgba(0,0,0,.4);
  position:relative;flex-shrink:0;animation:blink-slow 1.6s infinite;
}
.module-big .led-big::after{
