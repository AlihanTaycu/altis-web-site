  font-family:"JetBrains Mono",monospace;font-size:48px;font-weight:700;color:var(--ptl);
  letter-spacing:.05em;text-shadow:0 0 12px var(--ptl-glow);text-align:center;
}
.module-big .btn-big{
  width:48px;height:48px;border-radius:8px;background:#2a2a35;border:1px solid rgba(255,255,255,.1);
  display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,.5);font-size:12px;
  font-family:"JetBrains Mono",monospace;font-weight:600;letter-spacing:.05em;flex-shrink:0;
}
.module-callout{
  position:absolute;display:flex;align-items:center;gap:8px;color:#fff;font-size:12px;
  font-weight:500;
}
.module-callout .dot{width:8px;height:8px;border-radius:50%;background:var(--ptl);flex-shrink:0;box-shadow:0 0 8px var(--ptl)}
.module-callout .ln{height:1px;background:linear-gradient(90deg,var(--ptl),transparent);flex:1}
.module-callout.tl{top:80px;left:60px}
.module-callout.tr{top:80px;right:60px;flex-direction:row-reverse}
.module-callout.tr .ln{background:linear-gradient(-90deg,var(--ptl),transparent)}
.module-callout.bl{bottom:80px;left:60px}
.module-callout.br{bottom:80px;right:60px;flex-direction:row-reverse}
.module-callout.br .ln{background:linear-gradient(-90deg,var(--ptl),transparent)}

/* Modes (Pick-to-Light, Put-to-Light, Cluster) */
.modes{background:var(--bg-soft)}
.mode-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:48px}
.mode-card{
  background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);
  padding:32px;display:flex;flex-direction:column;gap:18px;transition:all .25s;position:relative;overflow:hidden;
}
.mode-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.mode-card .tag{font-size:11px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:var(--ptl-deep);align-self:flex-start;background:var(--ptl-soft);padding:5px 10px;border-radius:6px}
.mode-card h3{font-size:22px}
.mode-card p{font-size:14.5px;line-height:1.55}
