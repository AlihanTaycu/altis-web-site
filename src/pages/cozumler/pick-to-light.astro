.mini-bin.green .mlt{background:var(--ok)}
.mini-bin .qty{font-family:"JetBrains Mono",monospace;font-size:9px;color:var(--ptl);font-weight:700;position:absolute;top:4px;left:0;right:0;text-align:center;text-shadow:0 0 4px var(--ptl-glow)}
.mini-bin.green .qty{color:var(--ok);text-shadow:none}
.mode-card .impact{margin-top:auto;padding-top:14px;border-top:1px dashed var(--border-soft);display:flex;gap:24px}
.impact .v{font-family:"JetBrains Mono",monospace;font-size:18px;font-weight:700;color:var(--ptl-deep)}
.impact .l{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:600;margin-top:2px}

/* Why pick-to-light */
.why{padding:110px 0}
.why-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.why-card{
  background:linear-gradient(180deg,#fff,#FAFBFE);
