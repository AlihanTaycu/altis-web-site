.hero-stats{display:grid;grid-template-columns:repeat(3,auto);gap:36px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);max-width:540px}
.hero-stat .v{font-family:"JetBrains Mono",monospace;font-size:24px;font-weight:700;color:var(--navy-800)}
.hero-stat .l{font-size:12px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-top:4px}

/* Hero visual — rack with light modules */
.rack-scene{
  background:#0F0F14;border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);overflow:hidden;position:relative;
  padding:32px;
}
.rack-scene::before{
  content:"";position:absolute;inset:0;
  background:
    radial-gradient(600px 300px at 30% 20%, rgba(232,163,23,.12), transparent 60%),
    repeating-linear-gradient(90deg,transparent,transparent 20px,rgba(255,255,255,.02) 20px,rgba(255,255,255,.02) 21px),
    repeating-linear-gradient(0deg,transparent,transparent 20px,rgba(255,255,255,.02) 20px,rgba(255,255,255,.02) 21px);
}
.rack-head{position:relative;display:flex;justify-content:space-between;align-items:center;color:#fff;margin-bottom:24px;font-size:12px}
.rack-head .ttl{font-weight:600;letter-spacing:-.01em}
.rack-head .meta{font-family:"JetBrains Mono",monospace;color:rgba(255,255,255,.5);font-size:11px;display:flex;gap:12px;align-items:center}
.rack-head .live{display:inline-flex;align-items:center;gap:5px;color:var(--ptl);font-weight:600}
.rack-head .live::before{content:"";width:6px;height:6px;border-radius:50%;background:var(--ptl);box-shadow:0 0 8px var(--ptl);animation:pulse 1.4s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}

.rack{position:relative;background:#1a1a22;border-radius:10px;padding:16px;display:grid;grid-template-rows:repeat(3,1fr);gap:12px;min-height:380px}
.rack-shelf{
  position:relative;display:grid;grid-template-columns:repeat(6,1fr);gap:8px;
  padding:12px 8px;background:linear-gradient(180deg,#222230,#1a1a22);border-radius:6px;
  border-top:1px solid rgba(255,255,255,.05);
}
.bin{
  position:relative;height:60px;background:linear-gradient(180deg,#2a2a35,#1f1f28);
  border:1px solid rgba(255,255,255,.04);border-radius:4px;
  display:flex;flex-direction:column;justify-content:flex-end;padding:4px;
}
.bin .code{
  position:absolute;top:4px;left:5px;font-family:"JetBrains Mono",monospace;font-size:8.5px;
  color:rgba(255,255,255,.35);font-weight:600;letter-spacing:.04em;
}
/* Light module sitting under each shelf */
.lmod{
  position:relative;background:linear-gradient(180deg,#15151c,#0a0a0e);
  border:1px solid rgba(255,255,255,.06);border-radius:3px;
  height:22px;display:flex;align-items:center;justify-content:space-between;padding:0 8px;
