---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/sections/SectionHead.astro';

const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    "name": "Pick-to-Light",
    "brand": { "@type": "Brand", "name": "Altis Teknoloji" },
    "description": "Işıklı toplama, put-to-light ve cluster picking operasyonları için P2Cloud tabanlı saha çözümü"
  },
  {
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Pick-to-Light Sistem Kurulumu",
    "provider": { "@type": "Organization", "name": "Altis Teknoloji" },
    "serviceType": "Warehouse automation",
    "description": "Depo toplama operasyonları için Pick-to-Light donanım, yazılım ve entegrasyon hizmeti"
  }
];
---

<Base
  title="Pick-to-Light - Işıklı Toplama Sistemleri | Altis Teknoloji"
  description="Pick-to-Light; ışıklı modüller, P2Cloud Framework ve WMS/ERP entegrasyonu ile depo toplama hızını ve doğruluğunu artıran Altis çözümüdür."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/solutions/pick-to-light/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/cozumler/pick-to-light/">Ürünler</a>
      <span class="sep">/</span>
      <span style="color:var(--ptl-deep);font-weight:600">Pick-to-Light</span>
    </div>
    <div class="hero-inner">
      <div>
        <div class="platform-pill">
          <span class="pill-tag">Ürün</span>
          <span>P2Cloud Framework · ThePickToLight.com</span>
        </div>
        <div class="product-name">Pick-to-Light</div>
        <h1 class="product-tag">Işık yanar — operatör doğru rafa, doğru miktara saniyeler içinde gider.</h1>
        <p class="hero-sub">Altis Teknoloji'nin kendi geliştirdiği <strong style="color:var(--text);font-weight:600">P2Cloud Framework</strong> ve tescilli <strong style="color:var(--text);font-weight:600">ThePickToLight.com</strong> markası altında sunduğumuz ışıklı toplama çözümü; raf üzerine yerleştirilen modüllerle sipariş bazlı toplama operasyonunu yönlendirir. Operatörün eli kâğıtta veya ekranda değildir; gözü sadece yanan ışığa, eli sadece doğru bölmededir. E-ticaret, perakende dağıtım, ilaç ve yedek parça depolarında toplama hızını ve doğruluğunu radikal şekilde artırır.</p>
        <div class="hero-cta">
          <a class="btn btn-ptl btn-lg" href="/iletisim/">Pick-to-Light Demosu
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#how">Nasıl Çalışır?</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v">×2-3</div><div class="l">toplama hızı</div></div>
          <div class="hero-stat"><div class="v">%99.9</div><div class="l">toplama doğruluğu</div></div>
          <div class="hero-stat"><div class="v">~3sa</div><div class="l">eğitim süresi</div></div>
        </div>
      </div>

      <!-- Hero visual: rack with active picking lights -->
      <div class="rack-scene">
        <div class="rack-head">
          <div class="ttl">Aktif Sipariş · ORDER-78912</div>
          <div class="meta">
            <span>4/12 kalem</span>
            <span class="live">canlı</span>
          </div>
        </div>
        <div class="rack">
          <!-- Shelf 1 -->
          <div class="rack-shelf">
            <div class="bin">
              <span class="code">A1-01</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin done">
              <span class="code">A1-02</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A1-03</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin active">
              <span class="code">A1-04</span>
              <div class="lmod"><span class="led"></span><span class="lcd">×3</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A1-05</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A1-06</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
          </div>
          <!-- Shelf 2 -->
          <div class="rack-shelf">
            <div class="bin done">
              <span class="code">A2-01</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A2-02</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin active">
              <span class="code">A2-03</span>
              <div class="lmod"><span class="led"></span><span class="lcd">×1</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A2-04</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A2-05</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin done">
              <span class="code">A2-06</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
          </div>
          <!-- Shelf 3 -->
          <div class="rack-shelf">
            <div class="bin">
              <span class="code">A3-01</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin active">
              <span class="code">A3-02</span>
              <div class="lmod"><span class="led"></span><span class="lcd">×2</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A3-03</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A3-04</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin done">
              <span class="code">A3-05</span>
              <div class="lmod"><span class="led"></span><span class="lcd">OK</span><span class="btn-tiny"></span></div>
            </div>
            <div class="bin">
              <span class="code">A3-06</span>
              <div class="lmod"><span class="led"></span><span class="lcd">000</span><span class="btn-tiny"></span></div>
            </div>
          </div>
        </div>
        <div class="rack-foot">
          <div class="rfoot"><div class="l">Aktif Bin</div><div class="v amb">3</div></div>
          <div class="rfoot"><div class="l">Toplanan</div><div class="v">4 / 12</div></div>
          <div class="rfoot"><div class="l">Süre</div><div class="v">02:14</div></div>
          <div class="rfoot"><div class="l">Doğruluk</div><div class="v" style="color:#7ED957">100%</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="howit" id="how">
  <div class="container">
    <SectionHead
      eyebrow="Nasıl Çalışır?"
      heading="Sipariş gelir, ışık yanar, operatör toplar."
      description="Pick-to-Light sürecin tamamını basitleştirir: operatörün cebinden kâğıt çıkar, gözden ekran çıkar, dikkati sadece rafa ve ışığa odaklanır."
    />
    <div class="how-grid">
      <div class="how-step">
        <div class="n">01</div>
        <h3>Sipariş Düşer</h3>
        <p>WMS veya ERP'den gelen sipariş <strong style="color:var(--text);font-weight:600">P2Cloud Framework</strong>'e aktarılır; ilgili bölme adresleri ve miktarları belirlenir.</p>
        <div class="ex"><span class="lt g"></span>WMS · ORDER-78912 · 12 kalem</div>
      </div>
      <div class="how-step">
        <div class="n">02</div>
        <h3>Işıklar Yanar</h3>
        <p>Doğru bölmelerdeki ışık modülleri aynı anda yanar; her modülün dijital ekranında alınması gereken miktar gösterilir.</p>
        <div class="ex"><span class="lt"></span>A1-04 · ×3 · sarı yanıyor</div>
      </div>
      <div class="how-step">
        <div class="n">03</div>
        <h3>Onayla &amp; Bitir</h3>
        <p>Operatör ürünleri alır, modüldeki onay butonuna basar; ışık söner, sıradaki bölme yanar. Toplama tamamlanınca WMS güncellenir.</p>
        <div class="ex"><span class="lt g"></span>OK · sipariş kapandı · ERP'ye iletildi</div>
      </div>
    </div>
  </div>
</section>

<!-- Hardware showcase -->
<section class="hardware">
  <div class="container">
    <div class="hw-grid">
      <div class="hw-display">
        <div class="module-big">
          <div class="led-big"></div>
          <div class="lcd-big">×3</div>
          <div class="btn-big">OK</div>
        </div>
        <div class="module-callout tl">
          <div class="dot"></div>
          <div class="ln"></div>
          <span>Yüksek-parlaklık LED</span>
        </div>
        <div class="module-callout tr">
          <span>7-segment dijital ekran</span>
          <div class="ln"></div>
          <div class="dot"></div>
        </div>
        <div class="module-callout bl">
          <div class="dot"></div>
          <div class="ln"></div>
          <span>Onay butonu</span>
        </div>
        <div class="module-callout br">
          <span>RS-485 / Ethernet bus</span>
          <div class="ln"></div>
          <div class="dot"></div>
        </div>
      </div>
      <div class="hw-copy">
        <div class="eyebrow">Donanım</div>
        <h2>Sade modül, sağlam saha</h2>
        <p style="font-size:17px;margin-top:18px;line-height:1.6">Her bölmenin önüne yerleştirilen kompakt modül; yüksek-parlaklık LED, 7-segment dijital ekran ve onay butonu içerir. Modüller bus bağlantısıyla birbirine zincirlenir, tek bir kontrolcüden yönetilir.</p>
        <div class="hw-features">
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"/><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/></svg></div>
            <div>
              <h4>Geniş açılı, parlak LED</h4>
              <p>Aydınlık depolarda bile uzaktan görünür; çoklu renk seçeneğiyle farklı sipariş veya operatör ayırt edilebilir.</p>
            </div>
          </div>
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="6" width="18" height="12" rx="2"/><path d="M7 10h2M11 10h2M15 10h2"/></svg></div>
            <div>
              <h4>Dijital miktar ekranı</h4>
              <p>3 haneli sayaç; operatör miktarı tahmin etmez, ekrandan okur. Yanlış miktar pratikte sıfıra iner.</p>
            </div>
          </div>
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg></div>
            <div>
              <h4>Onay butonu</h4>
              <p>Toplama tamamlandığında basılır — kayıt anlık olarak WMS'e iletilir. Çift basım koruması, parmak hatası tolere edilir.</p>
            </div>
          </div>
          <div class="hw-feat">
            <div class="ic"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 8h12l-2 12H8z"/><path d="M9 8V5a3 3 0 0 1 6 0v3"/></svg></div>
            <div>
              <h4>Endüstriyel dayanıklılık</h4>
              <p>Tozlu, soğuk veya yüksek devirli ortamlarda 7×24 çalışacak şekilde tasarlanmış kasa; saha bakımı kolay.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Working modes -->
<section class="modes">
  <div class="container">
    <SectionHead
      eyebrow="Çalışma Modları"
      heading="Pick-to-Light, Put-to-Light, Cluster Picking"
      description="Aynı donanım, farklı operasyonel mantıkla çalışabilir. Toplama, dağıtım ve çoklu sipariş senaryolarının her birine özel mod desteği."
    />
    <div class="mode-grid">
      <div class="mode-card">
        <span class="tag">Mode 01</span>
        <h3>Pick-to-Light</h3>
        <p>Klasik mod: operatör rafa gelir, sipariş kalemleri için sırayla yanan ışıkları takip eder, doğru miktarda ürün alır.</p>
        <div class="mode-diagram">
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin lit"><span class="qty">×3</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin lit"><span class="qty">×1</span><div class="mlt"></div></div>
        </div>
        <div class="impact">
          <div><div class="v">×2-3</div><div class="l">toplama hızı</div></div>
          <div><div class="v">%99.9</div><div class="l">doğruluk</div></div>
        </div>
      </div>
      <div class="mode-card">
        <span class="tag">Mode 02</span>
        <h3>Put-to-Light</h3>
        <p>Toplanan ürünlerin doğru siparişe (bölmeye, kovaya, çantaya) yerleştirildiği mod. Cross-dock ve sevkiyat ayrıştırmada idealdir.</p>
        <div class="mode-diagram">
          <div class="mini-bin green"><span class="qty">↓2</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">↓1</span><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">↓3</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
        </div>
        <div class="impact">
          <div><div class="v">×4</div><div class="l">ayrıştırma</div></div>
          <div><div class="v">↓ Hata</div><div class="l">sipariş karışması</div></div>
        </div>
      </div>
      <div class="mode-card">
        <span class="tag">Mode 03</span>
        <h3>Cluster Picking</h3>
        <p>Tek raf turunda birden fazla sipariş aynı anda toplanır. Farklı renkler veya bölme grupları farklı siparişi temsil eder.</p>
        <div class="mode-diagram">
          <div class="mini-bin lit"><span class="qty">A×2</span><div class="mlt"></div></div>
          <div class="mini-bin"><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">B×1</span><div class="mlt"></div></div>
          <div class="mini-bin lit"><span class="qty">A×1</span><div class="mlt"></div></div>
          <div class="mini-bin green"><span class="qty">B×2</span><div class="mlt"></div></div>
        </div>
        <div class="impact">
          <div><div class="v">×N</div><div class="l">eş zamanlı sipariş</div></div>
          <div><div class="v">↓ %50</div><div class="l">yürüyüş yolu</div></div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Why pick-to-light -->
<section class="why">
  <div class="container">
    <SectionHead
      eyebrow="Beklenen Etki"
      heading="Işıklı toplama, ölçülebilir kazanç"
      description="Pick-to-Light özellikle yüksek-frekanslı, çok-kalemli sipariş yapısında belirgin kazanç sağlar. Tipik pilot sonuçları:"
    />
    <div class="why-grid">
      <div class="why-card">
        <div class="b">×2-3<sup></sup></div>
        <div class="lbl">Toplama hızı</div>
        <div class="meta">Kâğıt ve mobil ekran tabanlı yöntemlere göre 2-3 kat hızlı toplama.</div>
      </div>
      <div class="why-card">
        <div class="b">%99.9<sup></sup></div>
        <div class="lbl">Toplama doğruluğu</div>
        <div class="meta">Operatör miktarı ekrandan okur, ışıkla yönlendirilir; yanlış raf veya yanlış miktar pratikte sıfırlanır.</div>
      </div>
      <div class="why-card">
        <div class="b">↓ 50<sup>%</sup></div>
        <div class="lbl">Eğitim süresi</div>
        <div class="meta">Yeni operatör birkaç saatte verimli hâle gelir; sezonluk işgücünde büyük avantaj.</div>
      </div>
      <div class="why-card">
        <div class="b">↓ %35<sup></sup></div>
        <div class="lbl">İade &amp; hata maliyeti</div>
        <div class="meta">Yanlış ürün veya yanlış miktar kaynaklı iadeler ve müşteri şikayetleri azalır.</div>
      </div>
    </div>
  </div>
</section>

<!-- Architecture -->
<section class="arch">
  <div class="container">
    <SectionHead
      eyebrow="Mimari"
      heading="WMS / ERP'den rafa, dört blokta"
      description="Siparişin Pick-to-Light modüllerine ulaşma yolu basit ve standarttır. Mevcut WMS veya ERP'nizle entegre çalışır; istenirse Tag&amp;Trace orkestrasyon katmanı eklenir."
    />
    <div class="arch-diagram">
      <div class="arch-flow">
        <div class="arch-block">
          <div class="lbl">L1 · ENTERPRISE</div>
          <h4>WMS / ERP</h4>
          <p>Sipariş, ürün, miktar, rota bilgisi</p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-block core">
          <div class="lbl">L2 · P2CLOUD</div>
          <h4>P2Cloud Framework</h4>
          <p>Bulut tabanlı yazılım çatısı · sipariş ayrıştırma · modül yönetimi · performans kaydı</p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-block">
          <div class="lbl">L3 · BUS</div>
          <h4>RS-485 / Ethernet</h4>
          <p>Modüller arası dayanıklı bağlantı</p>
        </div>
        <div class="arch-arrow">→</div>
        <div class="arch-block">
          <div class="lbl">L4 · MODULES</div>
          <h4>Işıklı Modüller</h4>
          <p>LED, ekran, onay butonu — her bölme önünde</p>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Use cases -->
<section class="uc">
  <div class="container">
    <SectionHead
      eyebrow="Kullanım Senaryoları"
      heading="Pick-to-Light nerede en güçlü?"
      description="Yüksek-frekanslı, çok-kalemli ve hata maliyeti yüksek toplama operasyonlarında Pick-to-Light vazgeçilmez bir çözümdür."
    />
    <div class="uc-grid">
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="20" r="2"/><circle cx="17" cy="20" r="2"/><path d="M3 4h2l2.4 11.4a2 2 0 0 0 2 1.6h8.2a2 2 0 0 0 2-1.5L21 7H6"/></svg></div>
        <h3>E-Ticaret Depoları</h3>
        <p>Yüksek sipariş hacmi, kısa toplama süresi, kampanya günlerinde patlayan iş yükü. Pick-to-Light kapasiteyi 2-3 katına çıkarır.</p>
        <div class="typical">tipik: 5K+ sipariş / gün</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7v10l8 4 8-4z"/><path d="M4 7l8 4 8-4M12 11v10"/></svg></div>
        <h3>Perakende Dağıtım Merkezleri</h3>
        <p>Mağazalara sipariş bazlı sevkiyat. Put-to-Light moduyla aynı raftan farklı mağaza siparişleri eş zamanlı ayrıştırılır.</p>
        <div class="typical">tipik: mağaza başına gün/hafta</div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 2h4l1 4h-6zM6 6h12l-1 14H7z"/><path d="M9 10v6M15 10v6M12 10v6"/></svg></div>
        <h3>İlaç &amp; Kozmetik Depoları</h3>
        <p>Yüksek SKU sayısı, küçük ambalajlar, sıkı doğruluk gereksinimi. Yanlış kalem regülasyon ve marka kaybı maliyeti yaratır.</p>
        <div class="typical">tipik: GMP / GDP uyumlu</div>
      </article>
      <article class="uc-card">
