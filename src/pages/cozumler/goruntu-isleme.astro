---
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/sections/SectionHead.astro';
import { partnerLogos } from '../../data/partner-logos';

const heroTrustLogos = partnerLogos.filter(l => ['Zebra','Honeywell','Datalogic','SATO','Nordic ID'].includes(l.name));

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "TrueScan",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  "description": "Standart endüstriyel kameraları yapay zeka tabanlı okuma motoruyla akıllandıran, pilot koşullarında %99.5 seviyesine kadar 2D/QR/barkod okuma performansı hedefleyen görüntü işleme çözümü.",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "TRY" },
  "provider": { "@type": "Organization", "name": "Altis Teknoloji" }
};
---

<Base
  title="TrueScan – Endüstriyel Görüntü İşleme | Altis Teknoloji"
  description="TrueScan; metal parlama, kirli etiket ve düşük kontrast gibi zorlu saha koşullarında standart okuyucuların zorlandığı noktalarda yapay zeka ile pilot koşullarında %99.5 seviyesine kadar okuma performansı hedefler."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/solutions/image-processing/"
>

<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/cozumler/">Çözümler</a>
      <span class="sep">/</span>
      <span style="color:var(--primary);font-weight:600">TrueScan</span>
    </div>
    <div class="hero-inner" style="margin-top:32px">
      <div>
        <div class="solution-pill">
          <span class="pill-tag">Çözüm</span>
          <span>Görüntü İşleme · Yapay Zeka · Barkod / 2D / QR</span>
        </div>
        <div class="product-name" style="margin: 24px 0 14px">TrueScan</div>
        <h1 class="product-tag">Donanımın okuyamadığını yazılım okur.</h1>
        <p class="hero-sub">Metal parlama, kirli etiket, düşük kontrast, perspektif bozulması — standart okuyucuların zorlandığı yerde TrueScan, mevcut kameralarınızı yapay zeka ile akıllandırarak okuma performansını ölçülebilir şekilde iyileştirir.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/iletisim/">Demo Talep Et
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#nasil-calisar">Nasıl Çalışır</a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v" data-count>%99.5</div><div class="l">pilot hedef doğruluğu</div></div>
          <div class="hero-stat"><div class="v">2D · QR</div><div class="l">desteklenen kod tipleri</div></div>
          <div class="hero-stat"><div class="v">Mevcut</div><div class="l">kamera altyapısı</div></div>
        </div>
        <p class="hero-note">Pilot sonuçları; kamera, ışık, etiket, hat ve saha koşullarına göre değişebilir.</p>
        <div class="hero-trust">
          <span class="hero-trust-label">Donanım çözüm ortaklarımız</span>
          <div class="hero-trust-logos">
            {heroTrustLogos.map(logo => (
              <img src={logo.src} alt={`${logo.name} logo`} width="100" height="32" loading="lazy" />
            ))}
          </div>
        </div>
      </div>

      <!-- Comparison mockup -->
      <div class="compare-card">
        <div class="compare-head">
          <span class="ttl">True Scan</span>
        </div>
        <div class="compare-body">
          <div class="scan-anim" aria-label="TrueScan demo">
            <svg class="scan-base" viewBox="0 0 360 140" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
              <defs>
                <linearGradient id="metal" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0" stop-color="#D5DEF0" />
                  <stop offset=".5" stop-color="#EEF1F7" />
                  <stop offset="1" stop-color="#C5CFE3" />
                </linearGradient>
                <linearGradient id="glare-static" x1="0" y1="0" x2="1" y2="0">
                  <stop offset="0" stop-color="#fff" stop-opacity="0" />
                  <stop offset=".42" stop-color="#fff" stop-opacity=".7" />
                  <stop offset=".58" stop-color="#fff" stop-opacity=".7" />
                  <stop offset="1" stop-color="#fff" stop-opacity="0" />
                </linearGradient>
                <pattern id="noise" patternUnits="userSpaceOnUse" width="3" height="3">
                  <rect width="3" height="3" fill="rgba(0,0,0,0)" />
                  <circle cx="1" cy="1" r=".4" fill="rgba(0,0,0,.08)" />
                </pattern>
              </defs>
              <rect x="0" y="0" width="360" height="140" fill="url(#metal)" />
              <rect x="0" y="0" width="360" height="140" fill="url(#noise)" />
              {/* Dirty / damaged barcode — deterministic pattern */}
              <g transform="translate(46, 28)" opacity=".88">
                {[2,4,2,3,5,2,4,3,2,5,3,2,4,3,5,2,3,4,2,5,3,2,4,3,5,2,3,5,2,4,3,2,5,3,4,2,5,3].map((w, i, arr) => {
                  const x = arr.slice(0, i).reduce((a, b) => a + b, 0) * 1.85;
                  const dim = (i === 5 || i === 12 || i === 19 || i === 27) ? .25 : (i % 3 === 0 ? .55 : .85);
                  return <rect x={x} y={i % 4 === 0 ? 2 : 0} width={w * .9} height={i % 4 === 0 ? 64 : 66} fill="#0a1f3a" opacity={dim} />;
                })}
              </g>
              <rect x="40" y="20" width="280" height="80" fill="url(#glare-static)" opacity=".6" />
              {/* Dirt smudge */}
              <ellipse cx="240" cy="58" rx="22" ry="14" fill="#5F6675" opacity=".18" />
              <ellipse cx="120" cy="68" rx="18" ry="9" fill="#5F6675" opacity=".14" />
              <text x="50" y="120" font-family="JetBrains Mono, monospace" font-size="8" fill="#475569" opacity=".5">1234 5••• ••12 ••56</text>
            </svg>

            {/* Phase 1 — red standard scan */}
            <div class="scan-line scan-line-red" aria-hidden="true"></div>
            <div class="scan-badge scan-badge-1">STANDART · TARANIYOR</div>
            <div class="scan-fail" aria-hidden="true">
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
              <span>OKUMA BAŞARISIZ</span>
            </div>

            {/* Phase 2 — AI corners + cyan scan */}
            <div class="scan-corners" aria-hidden="true">
              <span></span><span></span><span></span><span></span>
            </div>
            <div class="scan-line scan-line-cyan" aria-hidden="true"></div>
            <div class="scan-badge scan-badge-2">AI · TRUESCAN BAŞLATILDI</div>

            {/* Phase 3 — success + extracted data */}
            <div class="scan-success" aria-hidden="true">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>
              <span>%99.5 PILOT HEDEF</span>
            </div>
            <div class="scan-extracted" aria-hidden="true">
              <span class="se-label">EPC ⟶</span>
              <span class="se-data">3034 ABF1 02C8 6E91</span>
            </div>
          </div>
          <div class="scan-cap">SAHA · METAL YÜZEY · YÜKSEK PARLAMA · KİRLİ ETİKET</div>

          <div class="compare-row fail">
            <div class="compare-label">
              <div class="dot dot-fail"></div>
              <span>Standart Donanım</span>
            </div>
            <div class="compare-result">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
              <span>Okuma başarısız</span>
            </div>
          </div>
          <div class="compare-row pass">
            <div class="compare-label">
              <div class="dot dot-pass"></div>
              <span>TrueScan</span>
            </div>
            <div class="compare-result">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><path d="m9 12 2 2.5 4-5"></path></svg>
              <span>pilot ölçümde %99.5</span>
            </div>
          </div>
          <div class="extracted">
            <span class="ext-label">çıkarılan veri</span>
            <code>EPC <strong>3034 ABF1 02C8 6E91</strong> · LOT <strong>YL-2025-08-A4</strong></code>
          </div>
          <div class="condition-tags">
            <span class="ctag">Metal parlama</span>
            <span class="ctag">Kirli etiket</span>
            <span class="ctag">Düşük kontrast</span>
            <span class="ctag">Perspektif bozulması</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Problem -->
<section class="problem">
  <div class="container">
    <SectionHead
      eyebrow="Problem"
      heading="Teoride kolay görünen barkod okuma, sahada darboğaza dönüşür"
      description="Standart endüstriyel okuyucular ideal koşullar için tasarlanmıştır. Gerçek üretim sahası ise ideal değildir."
    />
    <div class="problem-grid" data-reveal data-reveal-delay="100">
      <div class="problem-group">
        <div class="problem-group-label">Saha Koşulları</div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>
          <div>
            <strong>Metal Parlama</strong>
            <p>Yüzey yansımaları standart sensörlerin görüşünü kör eder.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
          <div>
            <strong>Değişken Işık</strong>
            <p>Düşük kontrast ve yetersiz aydınlatma okuma hatalarını tetikler.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h4l3-9 4 18 3-9h4"></path></svg>
          <div>
            <strong>Dinamik Ortam</strong>
            <p>Hareketli hatlar ve titreşim odaklanma sorunları yaratır.</p>
          </div>
        </div>
      </div>
      <div class="problem-group">
        <div class="problem-group-label">Etiket Durumu</div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m3 3 18 18M9 9c-.9.9-1.5 2.2-1.5 3.5 0 2.8 2.2 5 5 5 1.3 0 2.6-.5 3.5-1.5"></path><path d="M14.5 9.5A3.5 3.5 0 0 0 9.5 14.5"></path><path d="m21 3-9 9"></path></svg>
          <div>
            <strong>Kirli ve Hasarlı</strong>
            <p>Yağ, kir ve fiziksel çizikler barkod bütünlüğünü bozar.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m2 2 20 20M7 7H4l-1 5h14M7 7V4h10v3M7 7h10M12 7v4"></path></svg>
          <div>
            <strong>Perspektif Kaybı</strong>
            <p>Eğik açılar ve deformasyon geometrik bozulmaya yol açar.</p>
          </div>
        </div>
        <div class="problem-item">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="9" rx="2"></rect><path d="M6 9V5h12v4"></path></svg>
          <div>
            <strong>Kötü Baskı</strong>
            <p>Silik ve düşük çözünürlüklü baskılar standart okuyucuları durdurur.</p>
          </div>
        </div>
      </div>
      <div class="problem-impact">
        <div class="impact-label">Kritik Kayıplar</div>
        <div class="impact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
          <span>Operasyonel yavaşlama</span>
        </div>
        <div class="impact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
          <span>Artan manuel müdahale</span>
        </div>
        <div class="impact-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="m15 9-6 6M9 9l6 6"></path></svg>
          <span>Yüksek donanım maliyeti</span>
        </div>
        <blockquote>"Teoride kolay görünen barkod okuma, sahada bir darboğaza dönüşür."</blockquote>
      </div>
    </div>
  </div>
</section>

<!-- How it works -->
<section class="approach" id="nasil-calisar">
  <div class="container">
    <SectionHead
      eyebrow="Yaklaşım"
      heading="Donanım değil, yazılım kazanır"
      description="Pahalı ve özel donanımlar yerine, mevcut standart endüstriyel kameraları yapay zeka tabanlı bir okuma motoruyla akıllandırıyoruz. Yatırım korunur, kapasite artırılır."
    />
    <div class="approach-grid" data-reveal data-reveal-delay="100">
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M9 9h6M9 12h6M9 15h4"></path></svg>
        </div>
        <h3>Yazılım Odaklı Mimari</h3>
        <p>Mevcut standart kameralar üzerine entegre edilen esnek okuma motoru. Donanım markasından bağımsız çalışır.</p>
      </div>
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2a10 10 0 1 0 10 10"></path><path d="M12 6v6l4 2"></path><circle cx="18" cy="6" r="4" fill="currentColor" opacity=".2" stroke="currentColor"></circle><path d="m16 6 2 2 4-4"></path></svg>
        </div>
        <h3>Yapay Zeka Tabanlı Analiz</h3>
        <p>Görüntüyü sadece taramak yerine, her pikseli anlamlandıran derin öğrenme modelleri ile okuma yapılır.</p>
      </div>
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path></svg>
        </div>
        <h3>Maliyet Verimliliği</h3>
        <p>Pahalı AI entegreli kameralara ihtiyaç duymadan mevcut altyapıyı akıllandırma. Yatırım korunur.</p>
      </div>
      <div class="approach-card">
        <div class="ac-icon">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"></path><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"></path></svg>
        </div>
        <h3>Esnek Entegrasyon</h3>
        <p>Donanım markasından bağımsız, her türlü üretim hattına ve kurumsal sisteme hızlı adaptasyon.</p>
      </div>
    </div>
  </div>
</section>

<!-- TrueScan capabilities -->
<section class="capabilities">
  <div class="container">
    <SectionHead
      eyebrow="TrueScan Teknolojisi"
      heading="Görüntüyü anlamlandırmak için dört algoritma"
      description="Her saha koşulu farklı bir sorun yaratır. TrueScan, bu dört kritik sorunu ayrı algoritmalarla çözer."
    />
    <div class="cap-grid" data-reveal data-reveal-delay="100">
      <div class="cap-card">
        <div class="cap-num">01</div>
        <h3>Perspektif Düzeltme</h3>
        <p>Eğik açılardan gelen görüntüleri gerçek zamanlı olarak düzeltir. Geometrik bozulmaları ortadan kaldırarak barkodu ideal okuma açısına getirir.</p>
        <div class="cap-tag">Gerçek zamanlı</div>
      </div>
      <div class="cap-card">
        <div class="cap-num">02</div>
        <h3>Parlama Toleransı</h3>
        <p>Metal yüzeylerdeki ışık patlamalarını filtreler. Dinamik eşikleme algoritmaları ile parlamanın altındaki veriyi kurtarır.</p>
        <div class="cap-tag">Dinamik eşikleme</div>
      </div>
      <div class="cap-card">
        <div class="cap-num">03</div>
        <h3>Düşük Kontrast Okuma</h3>
        <p>Silik baskıları ve yetersiz ışık altındaki etiketleri analiz eder. Yapay zeka ile piksel bazlı iyileştirme yaparak okuma sağlar.</p>
        <div class="cap-tag">Piksel bazlı AI</div>
      </div>
      <div class="cap-card">
        <div class="cap-num">04</div>
        <h3>Hasar Analizi</h3>
        <p>Kirlenmiş, çizilmiş veya yırtılmış etiketlerdeki eksik veriyi hata düzeltme kodları ve örüntü tanıma ile tamamlar.</p>
        <div class="cap-tag">Örüntü tanıma</div>
      </div>
    </div>
  </div>
</section>

<!-- Case study: Yeşilyurt -->
<section class="casestudy">
  <div class="container">
    <div class="cs-grid" data-reveal>
      <div class="cs-copy">
        <div class="eyebrow">Referans Proje</div>
        <h2 style="margin-top:18px">Yeşilyurt Demir Çelik</h2>
        <p style="font-size:17px;margin-top:16px;line-height:1.65">Türkiye'nin en büyük sanayi kuruluşlarından biri olan Yeşilyurt Demir Çelik'in üretim sahasında silik, düşük kontrastlı ve deforme barkodlar standart endüstriyel okuyucular için kararlı okuma üretmeyi zorlaştırıyordu. Bu durum manuel kontrol ve tekrar okuma ihtiyacını artırıyordu.</p>
        <p style="font-size:17px;margin-top:14px;line-height:1.65">TrueScan pilotunda görüntüler yazılım katmanında iyileştirilerek okunabilir veri sisteme daha güvenilir şekilde aktarıldı.</p>
        <div class="cs-metrics">
          <div class="cs-metric">
            <div class="cs-v">%99.5</div>
            <div class="cs-l">Pilot doğruluk</div>
          </div>
          <div class="cs-metric">
            <div class="cs-v">Azalan</div>
            <div class="cs-l">Manuel kontrol</div>
          </div>
          <div class="cs-metric">
            <div class="cs-v">İSO 500</div>
            <div class="cs-l">İlk 100 / 750+ çalışan</div>
          </div>
        </div>
      </div>
      <div class="cs-results">
        <div class="cs-result-head">Proje Kazanımları</div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Kararlı Okuma</strong>
            <span>Sorunlu barkod örneklerinde okuma kararlılığı artırıldı.</span>
          </div>
        </div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Minimum Müdahale</strong>
            <span>Manuel kontrol ve tekrar okuma ihtiyacı azaltıldı, personel verimliliği desteklendi.</span>
          </div>
        </div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Yüksek Güven</strong>
            <span>Hata oranları ölçülebilir şekilde azaltıldı, veri bütünlüğü güçlendirildi.</span>
          </div>
        </div>
        <div class="cs-result-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="m5 12 5 5 9-11"></path></svg>
          <div>
            <strong>Hızlı Akış</strong>
            <span>Okuma kaynaklı duraksamaların azaltılması hedeflendi, çevrim süreleri takip edilebilir hale geldi.</span>
          </div>
        </div>
        <div class="cs-quote">"Özel donanım almadan önce mevcut görüntü verisini yazılımla değerlendirmek çoğu sahada daha doğru ilk adımdır."</div>
      </div>
    </div>
  </div>
</section>

<!-- Process -->
<section class="process">
  <div class="container">
    <SectionHead
      eyebrow="Nasıl başlarız?"
      heading="Üç adımda sahaya alın"
      description="Tek hat pilotuyla başlar, ölçülen sonuç uygun olduğunda yaygınlaştırırız."
    />
    <div class="process-grid" data-reveal data-reveal-delay="100">
      <div class="process-card">
