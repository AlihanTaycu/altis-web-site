/* CTA */
.cta-section{background:var(--navy-800);color:#fff;position:relative;overflow:hidden;padding:110px 0}
.cta-section::before{content:"";position:absolute;inset:0;background:radial-gradient(700px 400px at 80% 50%,rgba(24,183,214,.15),transparent 60%)}
.cta-inner{position:relative;text-align:center;max-width:780px;margin:0 auto}
.cta-inner .eyebrow{color:var(--cyan)}
.cta-inner .eyebrow::before{background:var(--cyan)}
.cta-inner h2{color:#fff;margin-top:18px}
.cta-inner p{color:rgba(255,255,255,.75);font-size:18px;margin-top:18px}
.cta-inner .hero-cta{justify-content:center;margin-top:36px}
.cta-section .btn-secondary{color:#fff;border-color:rgba(255,255,255,.25)}
.cta-section .btn-secondary:hover{background:rgba(255,255,255,.08)}

/* Hero trust strip */
.hero-trust{margin-top:32px;padding-top:24px;border-top:1px dashed var(--border);max-width:520px}
.hero-trust-label{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--text-faint);display:block;margin-bottom:14px}
.hero-trust-logos{display:flex;align-items:center;gap:22px;flex-wrap:wrap}
.hero-trust-logos img{max-height:24px;width:auto;opacity:.55;filter:grayscale(100%);transition:opacity .2s,filter .2s}
.hero-trust-logos img:hover{opacity:1;filter:grayscale(0)}

/* ============ Scan narrative animation ============ */
.scan-anim{position:relative;border-radius:10px;overflow:hidden;border:1px solid var(--border-soft);background:#C5CFE3;aspect-ratio:360/140}
.scan-base{display:block;width:100%;height:100%}
.scan-cap{margin:8px 0 16px;font-family:"JetBrains Mono",monospace;font-size:10px;font-weight:700;letter-spacing:.1em;color:var(--text-faint);text-align:center}

/* Master timing: 6s loop, 4 phases */
/* Phase 1: 0-30% = standart fail */
/* Phase 2: 30-58% = AI scan */
/* Phase 3: 58-92% = success + data */
/* Phase 4: 92-100% = reset */

.scan-line{position:absolute;left:0;right:0;height:2px;pointer-events:none;will-change:transform,opacity;box-shadow:0 0 16px currentColor}
.scan-line-red{color:#EF4444;background:currentColor;animation:scanLineRed 6s infinite ease-in-out}
.scan-line-cyan{color:#18B7D6;background:currentColor;animation:scanLineCyan 6s infinite ease-in-out;opacity:0}

@keyframes scanLineRed{
  0%{top:100%;opacity:0}
  3%{opacity:1}
  25%{top:0;opacity:1}
  28%{top:0;opacity:0}
  100%{top:0;opacity:0}
}
@keyframes scanLineCyan{
  0%,30%{top:100%;opacity:0}
  32%{opacity:1}
  55%{top:0;opacity:1}
  58%{top:0;opacity:0}
  100%{opacity:0}
}

.scan-badge{position:absolute;top:10px;left:10px;font-family:"JetBrains Mono",monospace;font-size:9.5px;font-weight:700;letter-spacing:.1em;padding:5px 10px;border-radius:4px;display:inline-flex;align-items:center;gap:6px;will-change:opacity,transform}
.scan-badge::before{content:"";width:6px;height:6px;border-radius:50%;background:currentColor;box-shadow:0 0 8px currentColor;animation:badgePulse 1.2s infinite}
.scan-badge-1{background:rgba(239,68,68,.95);color:#fff;animation:phase1Badge 6s infinite}
.scan-badge-2{background:rgba(24,183,214,.95);color:#fff;opacity:0;animation:phase2Badge 6s infinite}
.scan-badge-1::before{background:#fff}
.scan-badge-2::before{background:#fff}

@keyframes badgePulse{0%,100%{opacity:1}50%{opacity:.4}}
@keyframes phase1Badge{
  0%{opacity:0;transform:translateY(-4px)}
  4%,25%{opacity:1;transform:translateY(0)}
  28%,100%{opacity:0;transform:translateY(0)}
}
@keyframes phase2Badge{
  0%,28%{opacity:0;transform:translateY(-4px)}
  32%,55%{opacity:1;transform:translateY(0)}
  58%,100%{opacity:0}
}

/* Fail X */
.scan-fail{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.6);color:#EF4444;display:flex;flex-direction:column;align-items:center;gap:4px;opacity:0;will-change:opacity,transform;animation:scanFail 6s infinite}
.scan-fail span{font-family:"JetBrains Mono",monospace;font-size:9.5px;font-weight:800;letter-spacing:.12em;background:#EF4444;color:#fff;padding:3px 8px;border-radius:4px}
@keyframes scanFail{
  0%,24%{opacity:0;transform:translate(-50%,-50%) scale(.6) rotate(-8deg)}
  27%{opacity:1;transform:translate(-50%,-50%) scale(1.15) rotate(0)}
  29%,30%{opacity:1;transform:translate(-50%,-50%) scale(1) rotate(0)}
  31%,100%{opacity:0;transform:translate(-50%,-50%) scale(.6) rotate(0)}
}

/* AI Detection Corners */
.scan-corners{position:absolute;top:14px;left:30px;right:30px;bottom:18px;pointer-events:none;opacity:0;animation:cornersIn 6s infinite}
.scan-corners span{position:absolute;width:18px;height:18px;border:2px solid #18B7D6;box-shadow:0 0 12px rgba(24,183,214,.7);animation:cornerPulse 1.4s infinite ease-in-out}
.scan-corners span:nth-child(1){top:0;left:0;border-right:none;border-bottom:none;border-top-left-radius:2px}
.scan-corners span:nth-child(2){top:0;right:0;border-left:none;border-bottom:none;border-top-right-radius:2px}
.scan-corners span:nth-child(3){bottom:0;left:0;border-right:none;border-top:none;border-bottom-left-radius:2px}
.scan-corners span:nth-child(4){bottom:0;right:0;border-left:none;border-top:none;border-bottom-right-radius:2px}
@keyframes cornersIn{
  0%,29%{opacity:0;transform:scale(1.1)}
  32%,92%{opacity:1;transform:scale(1)}
  95%,100%{opacity:0}
}
@keyframes cornerPulse{0%,100%{box-shadow:0 0 12px rgba(24,183,214,.7)}50%{box-shadow:0 0 20px rgba(24,183,214,1)}}

/* Success badge */
.scan-success{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%) scale(.7);display:flex;align-items:center;gap:8px;padding:8px 14px;background:rgba(16,160,107,.95);color:#fff;border-radius:8px;box-shadow:0 8px 24px rgba(16,160,107,.4);opacity:0;will-change:opacity,transform;animation:scanSuccess 6s infinite}
.scan-success span{font-family:"JetBrains Mono",monospace;font-size:11px;font-weight:800;letter-spacing:.1em}
@keyframes scanSuccess{
  0%,58%{opacity:0;transform:translate(-50%,-50%) scale(.7)}
  62%{opacity:1;transform:translate(-50%,-50%) scale(1.1)}
  66%,88%{opacity:1;transform:translate(-50%,-50%) scale(1)}
  92%,100%{opacity:0;transform:translate(-50%,-50%) scale(1)}
}

/* Extracted data */
.scan-extracted{position:absolute;bottom:10px;left:10px;right:10px;display:flex;align-items:center;gap:8px;padding:7px 12px;background:rgba(10,31,58,.92);backdrop-filter:blur(6px);border:1px solid rgba(24,183,214,.4);border-radius:6px;font-family:"JetBrains Mono",monospace;opacity:0;will-change:opacity,transform;animation:scanExtracted 6s infinite}
.se-label{font-size:9px;font-weight:700;letter-spacing:.1em;color:#18B7D6}
.se-data{font-size:11px;font-weight:700;color:#fff;letter-spacing:.04em}
@keyframes scanExtracted{
  0%,62%{opacity:0;transform:translateY(6px)}
  66%,88%{opacity:1;transform:translateY(0)}
  92%,100%{opacity:0;transform:translateY(0)}
}

@media (prefers-reduced-motion: reduce){
  .scan-line,.scan-badge,.scan-fail,.scan-corners,.scan-corners span,.scan-success,.scan-extracted{animation:none !important;opacity:1 !important}
  .scan-line-red{display:none}
  .scan-badge-1{display:none}
  .scan-fail{display:none}
}
.extracted{margin-top:10px;padding:10px 14px;border:1px solid #86EFAC;background:#F0FDF4;border-radius:10px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.ext-label{font-size:10px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:#15a06b}
.extracted code{font-family:"JetBrains Mono",monospace;font-size:11.5px;color:var(--navy-800);background:none}
.extracted code strong{color:#0F766E;font-weight:700}

/* Process section */
.process{background:#fff}
.process-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.process-card{position:relative;padding:32px;border:1px solid var(--border-soft);border-radius:var(--radius-lg);background:#fff;transition:all .25s;display:grid;gap:14px;align-content:start}
