.cs-results{background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);padding:32px;display:grid;gap:18px}
.cs-result-head{font-size:11px;font-weight:700;letter-spacing:.1em;text-transform:uppercase;color:var(--accent);padding-bottom:14px;border-bottom:1px solid var(--border-soft)}
.cs-result-item{display:flex;gap:12px;align-items:flex-start;font-size:14.5px}
.cs-result-item svg{color:var(--accent);flex-shrink:0;margin-top:3px}
