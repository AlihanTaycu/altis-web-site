---
import Base from '../../layouts/Base.astro';
import HubCard from '../../components/sections/HubCard.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import {
  Camera, Lightbulb, QrCode, Store, Tag, CreditCard, ArrowRight,
} from '@lucide/astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Altis Çözümler",
  "description": "Altis Teknoloji çözümleri: TrueScan, Pick-to-Light, Asset Yönetimi, RFID Perakende ve Tag&Trace."
};

const metrics = [
  { value: '%99.5', label: 'barkod okuma doğruluğu', sub: 'TrueScan' },
  { value: '×2–3',  label: 'depo toplama hızı',      sub: 'Pick-to-Light' },
  { value: '%80',   label: 'demirbaş verimlilik',     sub: 'Asset Yönetimi' },
];
---

<Base
  title="Çözümler | Altis Teknoloji"
  description="Depo, saha ve varlık operasyonları için Altis Teknoloji çözümleri: TrueScan, Pick-to-Light, Asset Yönetimi ve daha fazlası."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/solutions/"
>

<!-- ===== Hero ===== -->
<section class="sol-hero">
  <div class="sol-grid-bg" aria-hidden="true"></div>
  <div class="sol-glow-tl" aria-hidden="true"></div>
  <div class="sol-glow-br" aria-hidden="true"></div>

  <div class="container sol-inner">
    <div class="eyebrow sol-eyebrow">Çözümler</div>
    <h1>Sahadaki işi hızlandıran, doğrulayan ve kayda alan uygulamalar.</h1>
    <p class="sol-lead">Altis çözümleri belirli operasyon problemlerine odaklanır — toplama hatasını azaltmak, varlıkları izlemek, okumayı güvenilir kılmak ve saha ekiplerine net iş akışı vermek.</p>

    <!-- Kategori pills -->
    <div class="sol-pills" data-reveal>
      <a href="/cozumler/goruntu-isleme/" class="sol-pill">
        <Camera size={14} stroke-width={2} />
        Görüntü İşleme
      </a>
      <a href="/cozumler/pick-to-light/" class="sol-pill">
        <Lightbulb size={14} stroke-width={2} />
        Depo Operasyonu
      </a>
      <a href="/cozumler/asset-yonetimi/" class="sol-pill">
        <QrCode size={14} stroke-width={2} />
        Varlık Takibi
      </a>
      <a href="/urunler/rfid-perakende/" class="sol-pill">
        <Store size={14} stroke-width={2} />
        Perakende
      </a>
      <a href="/platformlar/tag-trace/" class="sol-pill">
        <Tag size={14} stroke-width={2} />
        RFID & Auto-ID
      </a>
    </div>

    <!-- Sonuç metrikleri -->
    <div class="sol-metrics" data-reveal data-reveal-delay="120">
      {metrics.map(m => (
        <div class="sol-metric">
          <span class="sol-metric-val" data-count={m.value}>{m.value}</span>
          <span class="sol-metric-label">{m.label}</span>
          <span class="sol-metric-sub">{m.sub}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<!-- ===== Çözüm kartları ===== -->
<section class="hub-list">
  <div class="container">
    <div class="featured-row" data-reveal>
      <HubCard
        variant="big"
        href="/cozumler/goruntu-isleme/"
        Icon={Camera}
        tag="Görüntü işleme"
        title="TrueScan"
        desc="Mevcut kameralara entegre AI okuma motoru ile metal parlama, kirli etiket ve düşük kontrast koşullarında %99.5 doğrulukla barkod ve 2D/QR okuma."
      >
        <svg slot="visual" viewBox="0 0 480 240" xmlns="http://www.w3.org/2000/svg">
          <defs>
            <linearGradient id="ts-bg" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0" stop-color="#EEF3FF" />
              <stop offset="1" stop-color="#E8FAFD" />
            </linearGradient>
          </defs>
          <rect x="0" y="0" width="480" height="240" rx="10" fill="url(#ts-bg)" />
          <rect x="40" y="40" width="280" height="160" rx="8" fill="#fff" stroke="#D5DEF0" />
          <g transform="translate(60, 70)">
            {Array.from({ length: 14 }).map((_, i) => (
              <rect x={i * 17} y="0" width={i % 3 === 0 ? 6 : 3} height="80" fill="#00125C" />
            ))}
          </g>
          <rect x="58" y="160" width="244" height="22" rx="3" fill="#EEF3FF" />
          <circle cx="380" cy="80" r="42" fill="#18B7D6" opacity=".18" />
          <circle cx="380" cy="80" r="22" fill="#18B7D6" opacity=".35" />
          <rect x="346" y="140" width="100" height="6" rx="3" fill="#00125C" opacity=".3" />
          <rect x="346" y="156" width="76" height="6" rx="3" fill="#00125C" opacity=".18" />
          <text x="346" y="190" font-family="Inter, sans-serif" font-size="11" font-weight="700" fill="#18B7D6">99.5% ✓</text>
        </svg>
      </HubCard>

      <div class="featured-small-stack">
        <HubCard
          href="/cozumler/pick-to-light/"
          Icon={Lightbulb}
          tag="Depo operasyonu"
          title="Pick-to-Light"
          desc="Işıklı yönlendirme ile toplama, ayrıştırma ve hat besleme süreçlerinde hız ve doğruluk."
        />
        <HubCard
          href="/cozumler/asset-yonetimi/"
          Icon={QrCode}
          tag="Varlık takibi"
          title="Asset Yönetimi"
          desc="NFC, QR ve mobil uygulama ile ekipman, zimmet ve servis kayıtlarını sahadan yönet."
        />
      </div>
    </div>

    <div class="row-three" data-reveal data-reveal-delay="120">
      <HubCard
        href="/urunler/rfid-perakende/"
        Icon={Store}
        tag="Perakende"
        title="RFID Perakende"
        desc="Mağaza, tünel, kasa ve sevkiyat senaryolarına özel RFID çözümleri ve entegre donanım."
      />
      <HubCard
        href="/platformlar/tag-trace/"
        Icon={Tag}
        tag="Platform"
        title="Tag&Trace"
        desc="RFID, barkod ve saha cihazlarını tek merkezden orkestre eden uçtan uca izlenebilirlik platformu."
      />
      <HubCard
        variant="dark"
        href="https://roxcard.com.tr"
        external
        Icon={CreditCard}
        tag="Dijital Kimlik"
        title="Rox Card"
        desc="NFC ve QR teknolojisiyle çalışan yeni nesil dijital kartvizit platformu. Tek dokunuşla paylaş, panelden yönet."
        cta="roxcard.com.tr"
      />
    </div>
  </div>
</section>

<CTABanner
  heading="Operasyonunuza uygun çözümü birlikte seçelim"
  description="İhtiyacınızı dinleyip doğru çözüm ve pilot kapsamı öneren uzman ekibimizle tanışın."
  secondaryLabel="Platformları İncele"
  secondaryHref="/platformlar/tag-trace/"
/>
</Base>

<style>
/* ===== Hero ===== */
.sol-hero {
  position: relative;
  padding: 96px 0 72px;
  background:
    radial-gradient(900px 500px at 80% -80px, rgba(24, 183, 214, .10), transparent 60%),
    linear-gradient(180deg, #fff 0%, var(--bg-soft) 100%);
  overflow: hidden;
}
.sol-grid-bg {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .35;
  background-image:
    linear-gradient(rgba(0, 18, 92, .05) 1px, transparent 1px),
    linear-gradient(90deg, rgba(0, 18, 92, .05) 1px, transparent 1px);
  background-size: 56px 56px;
  -webkit-mask-image: radial-gradient(ellipse 80% 80% at 50% 0%, #000 40%, transparent 100%);
          mask-image: radial-gradient(ellipse 80% 80% at 50% 0%, #000 40%, transparent 100%);
}
.sol-glow-tl {
  position: absolute;
  top: -120px;
  right: -60px;
  width: 380px;
  height: 380px;
  border-radius: 50%;
  background: rgba(24, 183, 214, .18);
  filter: blur(80px);
  pointer-events: none;
}
.sol-glow-br {
  position: absolute;
  bottom: -100px;
  left: -80px;
  width: 320px;
  height: 320px;
  border-radius: 50%;
  background: rgba(0, 18, 92, .06);
  filter: blur(70px);
  pointer-events: none;
}

.sol-inner { position: relative; max-width: 860px; }
.sol-eyebrow { color: var(--cyan); }
.sol-eyebrow::before { background: var(--cyan); }

.sol-hero h1 {
  max-width: 780px;
  margin-top: 18px;
  font-size: clamp(36px, 4.8vw, 62px);
  line-height: 1.08;
}
.sol-lead {
  max-width: 640px;
  margin-top: 18px;
  font-size: 18px;
  line-height: 1.65;
  color: var(--text-muted);
}

/* Category pills */
.sol-pills {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 32px;
}
.sol-pill {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 14px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  color: var(--primary);
  background: #fff;
  border: 1px solid var(--border);
  box-shadow: var(--shadow-sm);
  transition: border-color var(--dur-fast), color var(--dur-fast), transform var(--dur-fast), box-shadow var(--dur-fast);
}
.sol-pill :global(svg) { color: var(--cyan); flex-shrink: 0; }
.sol-pill:hover {
  border-color: var(--cyan);
  color: var(--primary);
  transform: translateY(-1px);
  box-shadow: var(--shadow);
}

/* Metrics */
.sol-metrics {
  display: flex;
  flex-wrap: wrap;
  gap: 0;
  margin-top: 44px;
  padding-top: 28px;
  border-top: 1px solid var(--border-soft);
  max-width: 680px;
}
.sol-metric {
  display: flex;
  flex-direction: column;
  gap: 3px;
  padding: 0 36px 0 0;
  margin-right: 36px;
  border-right: 1px solid var(--border);
}
.sol-metric:last-child { border-right: none; padding-right: 0; margin-right: 0; }
.sol-metric-val {
  font-family: "JetBrains Mono", monospace;
  font-size: 32px;
  font-weight: 800;
  color: var(--primary);
  line-height: 1;
  letter-spacing: -.02em;
}
.sol-metric-label {
  font-size: 12.5px;
  color: var(--text-muted);
  font-weight: 500;
}
.sol-metric-sub {
  font-size: 11px;
  font-weight: 700;
  color: var(--cyan);
  letter-spacing: .06em;
  text-transform: uppercase;
}

/* ===== Cards section ===== */
.hub-list { padding: 40px 0 80px; }

.featured-row {
  display: grid;
  grid-template-columns: 1.55fr 1fr;
  gap: 20px;
  margin-bottom: 20px;
}
.featured-small-stack {
  display: grid;
  grid-template-rows: 1fr 1fr;
  gap: 20px;
}
.row-three {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
}

@media (max-width: 1000px) {
  .featured-row { grid-template-columns: 1fr; }
  .featured-small-stack { grid-template-rows: 1fr; grid-template-columns: 1fr 1fr; grid-auto-flow: column; }
  .row-three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
@media (max-width: 760px) {
  .sol-hero { padding: 72px 0 52px; }
  .sol-metrics { flex-direction: column; gap: 20px; }
  .sol-metric { border-right: none; border-bottom: 1px solid var(--border-soft); padding: 0 0 20px; margin: 0; }
  .sol-metric:last-child { border-bottom: none; padding-bottom: 0; }
  .featured-small-stack { grid-template-columns: 1fr; grid-template-rows: auto auto; grid-auto-flow: row; }
  .row-three { grid-template-columns: 1fr; }
}
</style>
