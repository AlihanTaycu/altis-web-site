---
import Base from '../../layouts/Base.astro';
import HubHero from '../../components/sections/HubHero.astro';
import HubCard from '../../components/sections/HubCard.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import {
  Camera, Lightbulb, QrCode, Store, Tag, CreditCard,
} from '@lucide/astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Altis Çözümler",
  "description": "Altis Teknoloji çözümleri: TrueScan, Pick-to-Light, Asset Yönetimi, RFID Perakende ve Tag&Trace."
};
---

<Base
  title="Çözümler | Altis Teknoloji"
  description="Depo, saha ve varlık operasyonları için Altis Teknoloji çözümleri: TrueScan, Pick-to-Light, Asset Yönetimi ve daha fazlası."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/solutions/"
>
  <HubHero
    eyebrow="Çözümler"
    heading="Sahadaki işi hızlandıran, doğrulayan ve kayda alan uygulamalar."
    description="Altis çözümleri belirli operasyon problemlerine odaklanır: toplama hatasını azaltmak, varlıkları izlemek ve saha ekiplerine net iş akışı vermek."
  />

  <section class="hub-list">
    <div class="container">
      <div class="featured-row" data-reveal>
        <HubCard
          variant="big"
          href="/cozumler/goruntu-isleme/"
          Icon={Camera}
          tag="Görüntü işleme"
          title="TrueScan"
          desc="Mevcut kameralara entegre AI okuma motoru ile metal parlama, kirli etiket ve düşük kontrast koşullarında %99.5 doğrulukla barkod ve 2D/QR okuma."
        >
          <svg slot="visual" viewBox="0 0 480 240" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="ts-bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#EEF3FF" />
                <stop offset="1" stop-color="#E8FAFD" />
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="480" height="240" rx="10" fill="url(#ts-bg)" />
            <rect x="40" y="40" width="280" height="160" rx="8" fill="#fff" stroke="#D5DEF0" />
            <g transform="translate(60, 70)">
              {Array.from({ length: 14 }).map((_, i) => (
                <rect x={i * 17} y="0" width={i % 3 === 0 ? 6 : 3} height="80" fill="#00125C" />
              ))}
            </g>
            <rect x="58" y="160" width="244" height="22" rx="3" fill="#EEF3FF" />
            <circle cx="380" cy="80" r="42" fill="#18B7D6" opacity=".18" />
            <circle cx="380" cy="80" r="22" fill="#18B7D6" opacity=".35" />
            <rect x="346" y="140" width="100" height="6" rx="3" fill="#00125C" opacity=".3" />
            <rect x="346" y="156" width="76" height="6" rx="3" fill="#00125C" opacity=".18" />
            <text x="346" y="190" font-family="Inter, sans-serif" font-size="11" font-weight="700" fill="#18B7D6">99.5% ✓</text>
          </svg>
        </HubCard>

        <div class="featured-small-stack">
          <HubCard
            href="/cozumler/pick-to-light/"
            Icon={Lightbulb}
            tag="Depo operasyonu"
            title="Pick-to-Light"
            desc="Işıklı yönlendirme ile toplama, ayrıştırma ve hat besleme süreçlerinde hız ve doğruluk."
          />
          <HubCard
            href="/cozumler/asset-yonetimi/"
            Icon={QrCode}
            tag="Varlık takibi"
            title="Asset Yönetimi"
            desc="NFC, QR ve mobil uygulama ile ekipman, zimmet ve servis kayıtlarını sahadan yönet."
          />
        </div>
      </div>

      <div class="row-three" data-reveal data-reveal-delay="120">
        <HubCard
          href="/urunler/rfid-perakende/"
          Icon={Store}
          tag="Perakende"
          title="RFID Perakende"
          desc="Mağaza, tünel, kasa ve sevkiyat senaryolarına özel RFID çözümleri ve entegre donanım."
        />
        <HubCard
          href="/platformlar/tag-trace/"
          Icon={Tag}
          tag="Platform"
          title="Tag&Trace"
          desc="RFID, barkod ve saha cihazlarını tek merkezden orkestre eden uçtan uca izlenebilirlik platformu."
        />
        <HubCard
          variant="dark"
          href="https://roxcard.com.tr"
          external
          Icon={CreditCard}
          tag="Dijital Kimlik"
          title="Rox Card"
          desc="NFC ve QR teknolojisiyle çalışan yeni nesil dijital kartvizit platformu. Tek dokunuşla paylaş, panelden yönet."
          cta="roxcard.com.tr"
        />
      </div>
    </div>
  </section>

  <CTABanner
    heading="Operasyonunuza uygun çözümü birlikte seçelim"
    description="İhtiyacınızı dinleyip doğru çözüm ve pilot kapsamı öneren uzman ekibimizle tanışın."
    secondaryLabel="Platformları İncele"
    secondaryHref="/platformlar/tag-trace/"
  />
</Base>

<style>
  .hub-list { padding: 40px 0 80px; }

  .featured-row {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .featured-small-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 20px;
  }
  .row-three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 1000px) {
    .featured-row { grid-template-columns: 1fr; }
    .featured-small-stack { grid-template-rows: 1fr; grid-template-columns: 1fr 1fr; grid-auto-flow: column; }
    .row-three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .featured-small-stack { grid-template-columns: 1fr; grid-template-rows: auto auto; grid-auto-flow: row; }
    .row-three { grid-template-columns: 1fr; }
  }
</style>
