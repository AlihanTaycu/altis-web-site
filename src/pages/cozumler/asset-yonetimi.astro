---
import Base from '../../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Asset Tag & Trace",
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web, iOS, Android",
  "description": "Barkod, QR, NFC ve RFID destekli bulut tabanlı demirbaş ve varlık yönetim sistemi",
  "offers": {
    "@type": "Offer",
    "price": "49",
    "priceCurrency": "USD",
    "description": "İlk 30 gün ücretsiz, yıllık başlangıç paketi"
  }
};
---

<Base
  title="Asset Tag & Trace - Demirbaş Yönetim Sistemi | Altis Teknoloji"
  description="Asset Tag & Trace; barkod, QR, NFC ve RFID ile çalışan, iOS, Android ve web üzerinden kullanılabilen bulut tabanlı demirbaş yönetim sistemidir."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/solutions/asset-management/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/cozumler/asset-yonetimi/">Ürünler</a>
      <span class="sep">/</span>
      <span style="color:var(--att-deep);font-weight:600">Asset Tag &amp; Trace</span>
    </div>
    <div class="hero-inner">
      <div>
        <div class="platform-pill">
          <span class="pill-tag">Ürün</span>
          <span>SaaS · Web + iOS + Android · Bulut Tabanlı</span>
        </div>
        <div class="product-name">Asset Tag <span class="amp">&amp;</span> Trace</div>
        <h1 class="product-tag">Demirbaş yönetimi — el terminali değil, telefon yeter.</h1>
        <p class="hero-sub">Varlıklarınızın nerede olduğunu bilmek için artık özel donanıma ihtiyacınız yok. Asset Tag &amp; Trace; <strong style="color:var(--text);font-weight:600">Barkod, QR, NFC ve RFID</strong> teknolojileriyle uyumlu, bulut tabanlı bir demirbaş yönetim sistemidir. Telefon, tablet veya bilgisayardan envantere %80'e kadar verimlilik artışıyla bakım, arıza ve transfer süreçlerini yönetin.</p>
        <div class="hero-cta">
          <a class="btn btn-att btn-lg" href="#pricing">15 Gün Ücretsiz Dene
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#features">Nasıl Çalışır?</a>
        </div>
        <div class="app-badges">
          <span class="lbl">İndir:</span>
          <a class="app-badge" href="https://apps.apple.com/tr/app/tagandtrace-asset/id6737413510" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M17.05 20.28c-.98.95-2.05.8-3.08.35-1.09-.46-2.09-.48-3.24 0-1.44.62-2.2.44-3.06-.35C2.79 15.25 3.51 7.59 9.05 7.31c1.35.07 2.29.74 3.08.8 1.18-.24 2.31-.93 3.57-.84 1.51.12 2.65.72 3.4 1.8-3.12 1.87-2.38 5.98.48 7.13-.57 1.5-1.31 2.99-2.54 4.09M12.03 7.25c-.15-2.23 1.66-4.07 3.74-4.25.29 2.58-2.34 4.5-3.74 4.25"/></svg>
            <div>
              <div class="top">App Store</div>
              <div class="bot">iOS</div>
            </div>
          </a>
          <a class="app-badge" href="https://play.google.com/store/apps/details?id=com.tagandtrace.inventory.web.tagandtraceinventorymobile" target="_blank" rel="noopener">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M3.6 1.62c-.39.4-.6.99-.6 1.73v17.3c0 .74.21 1.33.6 1.73l.07.07L13.4 12.07v-.13L3.67 1.55l-.07.07m12.81 12.71-3.27-3.27v-.13l3.27-3.27.07.04L20.4 9.5c1.13.64 1.13 1.69 0 2.33l-3.92 2.43-.07.07m-3.27-3.27-9.54 9.54c.37.4.97.45 1.66.04l11.27-6.4-3.39-3.18m3.39-9.79L5.26 4.16c-.69-.4-1.29-.35-1.66.04l9.54 9.54 3.39-3.18-.04.04"/></svg>
            <div>
              <div class="top">Google Play</div>
              <div class="bot">Android</div>
            </div>
          </a>
        </div>
        <div class="hero-stats">
          <div class="hero-stat"><div class="v">%80</div><div class="l">verimlilik artışı</div></div>
          <div class="hero-stat"><div class="v">4</div><div class="l">teknoloji desteği</div></div>
          <div class="hero-stat"><div class="v">15 gün</div><div class="l">ücretsiz deneme</div></div>
        </div>
      </div>

      <!-- Hero showcase: laptop + phone -->
      <div class="showcase">
        <div class="laptop">
          <div class="laptop-screen">
            <div class="laptop-head">
              <div class="tabs">
                <span class="tab active">Envanter</span>
                <span class="tab">Bakım</span>
                <span class="tab">Arıza</span>
                <span class="tab">Hareket</span>
              </div>
              <div class="ctrl">1 487 / 5 000</div>
            </div>
            <div class="laptop-body">
              <div class="att-kpi">
                <div class="l">Toplam Varlık</div>
                <div class="v">1 487</div>
                <div class="meta" style="color:var(--att-deep)">▲ 24 bu ay</div>
              </div>
              <div class="att-kpi">
                <div class="l">Aktif Bakım</div>
                <div class="v warn">8</div>
                <div class="meta">3 yaklaşıyor</div>
              </div>
              <div class="att-kpi">
                <div class="l">Sayım Doğruluğu</div>
                <div class="v ok">%99.4</div>
                <div class="meta">son sayım: bugün</div>
              </div>
              <div class="asset-table">
                <h6>Son hareketler</h6>
                <div class="asset-row">
                  <span class="id">AST-04812</span>
                  <span class="nm">Dell Latitude 7430</span>
                  <span class="loc">Ofis-2 · K3</span>
                  <span class="st ok">AKTİF</span>
                </div>
                <div class="asset-row">
                  <span class="id">AST-04821</span>
                  <span class="nm">Forklift Linde H30</span>
                  <span class="loc">Depo-A</span>
                  <span class="st warn">BAKIM</span>
                </div>
                <div class="asset-row">
                  <span class="id">AST-04832</span>
                  <span class="nm">RFID Reader Impinj R700</span>
                  <span class="loc">Kapı-B</span>
                  <span class="st move">TRANSFER</span>
                </div>
                <div class="asset-row">
                  <span class="id">AST-04877</span>
                  <span class="nm">Projeksiyon Epson EB-L</span>
                  <span class="loc">Toplantı-3</span>
                  <span class="st ok">AKTİF</span>
                </div>
              </div>
            </div>
          </div>
        </div>
        <div class="phone">
          <div class="phone-screen">
            <div class="phone-head">
              <div class="t">Tara &amp; Sayım</div>
              <div class="ic">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 8v4l3 2"/></svg>
              </div>
            </div>
            <div class="scan-card">
              <div class="scan-frame">
                <div class="scan-line"></div>
                <svg class="scan-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><path d="M14 14h3v3h-3zM21 14h-3M14 21h3v-3"/></svg>
              </div>
              <div class="scan-meta">
                <strong>AST-04832</strong>
                NFC · RFID · QR · Barkod
              </div>
            </div>
            <div class="phone-tabs">
              <div class="ptab active">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>
                Tara
              </div>
              <div class="ptab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/></svg>
                Liste
              </div>
              <div class="ptab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 7 12 3 4 7v10l8 4 8-4z"/></svg>
                Sayım
              </div>
              <div class="ptab">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="8" r="4"/><path d="M4 21v-1a6 6 0 0 1 16 0v1"/></svg>
                Profil
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Modules -->
<section class="modules">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Üç Temel Modül</div>
      <h2>Demirbaşlarınız için özel modüller</h2>
      <p>Asset Tag &amp; Trace üç ana modül üzerine kuruludur: bakım planlama, arıza takibi ve hareket yönetimi. Her modül birbiriyle entegre, tek arayüzden.</p>
    </div>
    <div class="mod-grid">
      <div class="mod-card">
        <div class="tag">01 · BAKIM</div>
        <div class="ic">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14.7 6.3a4 4 0 0 1 0 5.4l-7 7a4 4 0 1 1-5.4-5.4l7-7a4 4 0 0 1 5.4 0M21 12l-7 7M16 7l5 5"/></svg>
        </div>
        <h3>Bakım Modülü</h3>
        <p>Varlıklarınıza ne zaman, nasıl bakım yapacağınızı takip mi edemiyorsunuz? Periyodik bakım planları tanımlayın, otomatik hatırlatma alın. Demirbaşlarınız bakımsız ve ilgisiz kalmasın.</p>
      </div>
      <div class="mod-card">
        <div class="tag">02 · ARIZA</div>
        <div class="ic">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v6M12 16v6M5 12H1m22 0h-4M5.6 5.6l2.8 2.8m11.2 11.2-2.8-2.8m-8.4 0-2.8 2.8m11.2-11.2-2.8 2.8"/></svg>
        </div>
        <h3>Arıza Modülü</h3>
        <p>Arıza tamir için şirket içinde ya da dışındaki varlıklarınızı takip mi edemiyorsunuz? Arıza kayıtları açın, servis sürecini izleyin, geçmiş arızalardan kök neden analizi yapın.</p>
      </div>
      <div class="mod-card">
        <div class="tag">03 · HAREKET</div>
        <div class="ic">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7M5 19l3-3-3-3"/></svg>
        </div>
        <h3>Hareket Modülü</h3>
        <p>Transfer modülüyle demirbaşlarınızın hareketlerini adım adım izleyin. Lokasyon değişikliği, departman transferi, zimmet devri — her adım dijital kayıt altında.</p>
      </div>
    </div>
  </div>
</section>

<!-- Features quick grid -->
<section class="features" id="features">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Yeni Nesil Demirbaş Yönetimi</div>
      <h2>Envanteriniz her zaman kontrol altında</h2>
    </div>
    <div class="feat-grid">
      <div class="feat-card">
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M16 13H8M16 17H8M10 9H8"/></svg></div>
        <h4>Kolay ve Hızlı Envanter Yönetimi</h4>
        <p>Excel ile demirbaş kayıtlarını yükleyin; Barkod, QR ve NFC ile tam uyumlu yapı sayesinde hızlı kurulum ve kolay kullanım.</p>
      </div>
      <div class="feat-card">
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="6" y="2" width="12" height="20" rx="2"/><path d="M11 18h2"/></svg></div>
        <h4>İhtiyaçlarınıza Uygun Esnek Kullanım</h4>
        <p>El terminaline ihtiyaç duymadan; telefon, tablet veya bilgisayarınızla tüm envanterinizi zahmetsizce yönetin.</p>
      </div>
      <div class="feat-card">
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 2v4M12 18v4M2 12h4M18 12h4"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h4>Gerçek Zamanlı İzleme</h4>
        <p>Demirbaşlarınızın konumunu ve durumunu gerçek zamanlı olarak öğrenin; eşik aşımı veya alan dışı hareket için bildirim alın.</p>
      </div>
      <div class="feat-card">
        <div class="ic"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><path d="m3.27 6.96 8.73 5.05 8.73-5.05M12 22.08V12"/></svg></div>
        <h4>Tüm Cihazlarla Tam Uyum</h4>
        <p>Android, iOS ya da web — el terminali, cep telefonu veya tabletten varlıklarınızı sayın, yönetin, transfer edin.</p>
      </div>
    </div>
  </div>
</section>

<!-- Deep dive blocks -->
<section class="deep">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Yetenekler · Derinlemesine</div>
      <h2>İşletmeniz ne kadar büyük olursa olsun, kontrol sizde</h2>
    </div>

    <!-- Multi-location -->
    <div class="deep-block">
      <div class="copy">
        <span class="badge">Çoklu Lokasyon</span>
        <h3>Tüm demirbaşlarınız, tüm lokasyonlarda</h3>
        <p>Tüm demirbaşlarınızı farklı lokasyon, bina veya kampüslerde ayrı ayrı yönetin. Departman, lokasyon ve kullanıcı atamasıyla organizasyon yapınızı yansıtın. Bir kampüsten diğerine transferler tek tıkla.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Lokasyon · bina · kat · oda hiyerarşisi</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Departman ve kullanıcı atama</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Lokasyon bazlı raporlama</li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Lokasyon Yönetimi</span>
          <span class="right">4 lokasyon · 1 487 varlık</span>
        </div>
        <div class="surface-body">
          <div class="loc-grid">
            <div class="loc-card">
              <div class="h">
                <span class="nm">Genel Müdürlük · Ümraniye</span>
                <span class="cnt">487</span>
              </div>
              <div class="bar"><div style="width:78%"></div></div>
              <div class="meta"><span>78% kapasite</span><span>4 kat · 22 oda</span></div>
            </div>
            <div class="loc-card">
              <div class="h">
                <span class="nm">Üretim · Hadımköy</span>
                <span class="cnt">612</span>
              </div>
              <div class="bar"><div style="width:92%"></div></div>
              <div class="meta"><span>92% kapasite</span><span>3 hat · 8 bölüm</span></div>
            </div>
            <div class="loc-card">
              <div class="h">
                <span class="nm">Depo · Tuzla</span>
                <span class="cnt">312</span>
              </div>
              <div class="bar"><div style="width:55%"></div></div>
              <div class="meta"><span>55% kapasite</span><span>2 blok</span></div>
            </div>
            <div class="loc-card">
              <div class="h">
                <span class="nm">Ofis · Ankara</span>
                <span class="cnt">76</span>
              </div>
              <div class="bar"><div style="width:34%"></div></div>
              <div class="meta"><span>34% kapasite</span><span>1 kat</span></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Counting tasks -->
    <div class="deep-block flip">
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Sayım Görevleri · Mart 2026</span>
          <span class="right">3 görev · 1 aktif</span>
        </div>
        <div class="surface-body">
          <div class="task-list">
            <div class="task-row">
              <div class="num">01</div>
              <div class="body">
                <strong>Q1 Genel Sayım — Üretim Hattı 2</strong>
                <div class="meta">atanan: Ayşe Yıldız · 312 varlık · son 12 Mart</div>
              </div>
              <span class="status done">Tamamlandı</span>
            </div>
            <div class="task-row">
              <div class="num">02</div>
              <div class="body">
                <strong>Ofis IT Ekipman Doğrulama</strong>
                <div class="meta">atanan: Mehmet Şahin · 87 / 142 tarandı</div>
              </div>
              <span class="status prog">Devam ediyor</span>
            </div>
            <div class="task-row">
              <div class="num">03</div>
              <div class="body">
                <strong>Depo Aylık Sayımı</strong>
                <div class="meta">atanan: Depo Ekibi · planlanan: 30 Mart</div>
              </div>
              <span class="status todo">Bekliyor</span>
            </div>
          </div>
        </div>
      </div>
      <div class="copy">
        <span class="badge">Sayım Emirleri</span>
        <h3>Sayım süreçleri ve görev atamaları</h3>
        <p>Sayım süreçlerini planlayın, ekip üyelerine görev atayın ve süreci baştan sona dijital olarak yönetin. Operatörler mobil uygulamadan tarar; yönetici canlı ilerlemeyi izler.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Periyodik veya tek seferlik sayım emirleri</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Çalışan / ekip bazlı görev atama</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Anlık ilerleme takibi · sapma raporu</li>
        </ul>
      </div>
    </div>

    <!-- Smart reporting -->
    <div class="deep-block">
      <div class="copy">
        <span class="badge">Akıllı Raporlama</span>
        <h3>Verileri içgörüye dönüştürün</h3>
        <p>Sayım sonuçları, demirbaş hareketleri, bakım ve arıza geçmişi… Asset Tag &amp; Trace, tüm verileri anlamlı raporlara dönüştürerek karar süreçlerinizi kolaylaştırır. Excel/PDF çıktılarıyla yönetime sunum yapmanız artık çok daha kolay.</p>
        <ul class="kv">
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Sayım doğruluğu · sapma raporu</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Bakım planı ve tamamlanma oranı</li>
          <li><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-11"/></svg>Excel ve PDF çıktı · yönetim sunumu</li>
        </ul>
      </div>
      <div class="surface">
        <div class="surface-head">
          <span class="ttl">Q1 2026 Demirbaş Raporu</span>
          <span class="right">PDF · Excel</span>
        </div>
        <div class="surface-body" style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
          <div class="rep-box">
            <h6>Sayım Doğruluğu</h6>
            <div class="donut">
              <svg width="80" height="80" viewBox="0 0 80 80">
                <circle cx="40" cy="40" r="30" fill="none" stroke="var(--border-soft)" stroke-width="10"/>
                <circle cx="40" cy="40" r="30" fill="none" stroke="var(--att)" stroke-width="10" stroke-dasharray="188.5" stroke-dashoffset="11.3" stroke-linecap="round"/>
              </svg>
              <div class="info">
                <div class="v">%99.4</div>
                <div class="l">son sayım</div>
              </div>
            </div>
          </div>
          <div class="rep-box">
            <h6>Durum Dağılımı</h6>
            <div class="donut" style="gap:10px">
              <svg width="80" height="80" viewBox="0 0 80 80">
                <circle cx="40" cy="40" r="30" fill="none" stroke="var(--att)" stroke-width="10" stroke-dasharray="120 188.5" stroke-dashoffset="0"/>
                <circle cx="40" cy="40" r="30" fill="none" stroke="var(--cyan)" stroke-width="10" stroke-dasharray="40 188.5" stroke-dashoffset="-120"/>
