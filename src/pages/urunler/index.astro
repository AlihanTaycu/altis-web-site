---
import Base from '../../layouts/Base.astro';
import HubHero from '../../components/sections/HubHero.astro';
import HubCard from '../../components/sections/HubCard.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import { Glasses, Tag, Radio, Smartphone, Printer, Store } from '@lucide/astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "RFID Ürünler — Altis Teknoloji",
  "description": "Altis Teknoloji RFID ürün portföyü: etiketler, okuyucular, el terminalleri, yazıcılar ve perakende ürünler.",
  "url": "https://www.altis.com.tr/urunler/"
};
---

<Base
  title="RFID Ürünler — Altis Teknoloji"
  description="Altis Teknoloji RFID ürün portföyü: etiketler, okuyucular, el terminalleri, yazıcılar ve perakende ürünler."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/products/"
>
  <HubHero
    eyebrow="Ürün Portföyü"
    heading="RFID donanımı ve hands-free saha cihazları."
    description="Projelerinize en uygun RFID donanımını ve akıllı gözlük çözümünü seçin. Altis Teknoloji, sektör lideri markalarla çalışarak ihtiyacınıza göre yapılandırılmış ürün ve entegrasyon desteği sunar."
  />

  <section class="hub-list">
    <div class="container">
      <div class="featured-row" data-reveal>
        <HubCard
          variant="big"
          href="/urunler/akilli-gozluk/"
          Icon={Glasses}
          tag="Akıllı Gözlükler"
          title="Vuzix Akıllı Gözlükler"
          desc="Depo, üretim ve saha operasyonlarında hands-free çalışma için Vuzix M400, M4000 ve LX1 akıllı gözlükler. Türkiye distribütörü Altis Teknoloji."
        >
          <svg slot="visual" viewBox="0 0 480 220" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <linearGradient id="vx-bg" x1="0" y1="0" x2="1" y2="1">
                <stop offset="0" stop-color="#EEF3FF" />
                <stop offset="1" stop-color="#E8FAFD" />
              </linearGradient>
            </defs>
            <rect x="0" y="0" width="480" height="220" rx="10" fill="url(#vx-bg)" />
            <g transform="translate(110, 70)">
              <rect x="0" y="20" width="80" height="50" rx="10" fill="#fff" stroke="#00125C" stroke-width="2" />
              <rect x="100" y="20" width="80" height="50" rx="10" fill="#fff" stroke="#00125C" stroke-width="2" />
              <line x1="80" y1="40" x2="100" y2="40" stroke="#00125C" stroke-width="3" />
              <rect x="180" y="32" width="80" height="6" rx="3" fill="#00125C" />
              <rect x="-20" y="32" width="20" height="6" rx="3" fill="#00125C" />
              <circle cx="40" cy="45" r="12" fill="#18B7D6" opacity=".4" />
              <circle cx="140" cy="45" r="12" fill="#18B7D6" opacity=".4" />
              <text x="40" y="50" font-family="Inter, sans-serif" font-size="10" font-weight="700" fill="#18B7D6" text-anchor="middle">AR</text>
              <text x="140" y="50" font-family="Inter, sans-serif" font-size="10" font-weight="700" fill="#18B7D6" text-anchor="middle">AR</text>
            </g>
            <g transform="translate(300, 160)">
              <rect x="0" y="0" width="60" height="20" rx="3" fill="#00125C" opacity=".1" />
              <text x="30" y="13" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700" fill="#00125C" text-anchor="middle">M400</text>
            </g>
            <g transform="translate(370, 160)">
              <rect x="0" y="0" width="60" height="20" rx="3" fill="#00125C" opacity=".1" />
              <text x="30" y="13" font-family="JetBrains Mono, monospace" font-size="9" font-weight="700" fill="#00125C" text-anchor="middle">M4000</text>
            </g>
          </svg>
        </HubCard>

        <div class="featured-small-stack">
          <HubCard
            href="/urunler/rfid-etiketler/"
            Icon={Tag}
            tag="Etiket"
            title="RFID Etiketler"
            desc="UHF, HF ve özel form faktörlü etiketler. Tekstilden metale, dondurucu ortamdan dış sahaya her uygulama."
          />
          <HubCard
            href="/urunler/rfid-okuyucular/"
            Icon={Radio}
            tag="Okuyucu"
            title="RFID Okuyucular"
            desc="Sabit portal, portatif ve entegre okuyucu çözümleri. Yüksek okuma hızı ve geniş alan kapsama."
          />
        </div>
      </div>

      <div class="row-three" data-reveal data-reveal-delay="120">
        <HubCard
          href="/urunler/rfid-el-terminalleri/"
          Icon={Smartphone}
          tag="El Terminali"
          title="RFID El Terminalleri"
          desc="Mobil RFID işlem ve envanter terminalleri. Depo, mağaza ve saha operasyonlarında hız ve doğruluk."
        />
        <HubCard
          href="/urunler/rfid-yazicilar/"
          Icon={Printer}
          tag="Yazıcı"
          title="RFID Yazıcılar"
          desc="RFID etiket yazdırma ve kodlama cihazları. Masaüstünden endüstriyel ölçeğe tam çözüm yelpazesi."
        />
        <HubCard
          variant="dark"
          href="/urunler/rfid-perakende/"
          Icon={Store}
          tag="Perakende"
          title="RFID Perakende"
          desc="Perakende operasyonlarına özel RFID çözümler. EAS, envanter sayımı ve müşteri deneyimi için entegre donanım."
        />
      </div>
    </div>
  </section>

  <CTABanner
    heading="Projeniz için doğru ürünü bulmak ister misiniz?"
    description="Uzmanlarımız ihtiyaç analizi yaparak size en uygun RFID donanımını ve akıllı gözlük çözümünü önerir."
    primaryLabel="Uzmanla Konuşun"
  />
</Base>

<style>
  .hub-list { padding: 40px 0 80px; }

  .featured-row {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
    margin-bottom: 20px;
  }
  .featured-small-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 20px;
  }
  .row-three {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 20px;
  }

  @media (max-width: 1000px) {
    .featured-row { grid-template-columns: 1fr; }
    .featured-small-stack { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; }
    .row-three { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 760px) {
    .featured-small-stack { grid-template-columns: 1fr; grid-template-rows: auto auto; }
    .row-three { grid-template-columns: 1fr; }
  }
</style>
