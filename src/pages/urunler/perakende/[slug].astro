---
import Base from '../../../layouts/Base.astro';
import { retailProducts } from '../../../data/rfid-perakende';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return retailProducts.map(p => ({
    params: { slug: p.slug },
    props: { product: p },
  }));
};

const { product } = Astro.props;

const related = retailProducts.filter(p => p.slug !== product.slug).slice(0, 3);
const contactHref = `/iletisim/?urun=${encodeURIComponent(product.title)}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": product.title,
  "description": product.shortDesc,
  "brand": { "@type": "Brand", "name": product.brand },
  "image": product.image,
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Organization", "name": "Altis Teknoloji" }
  }
};
---

<Base
  title={`${product.title} — Altis Teknoloji`}
  description={product.shortDesc}
  {schema}
  lang="tr"
  alternateUrl={`https://www.altis.com.tr/en/products/rfid-retail/${product.slug}/`}
>
  <nav class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/urunler/">Ürünler</a>
      <span>›</span>
      <a href="/urunler/rfid-perakende/">RFID Perakende</a>
      <span>›</span>
      <span>{product.title}</span>
    </div>
  </nav>

  <section class="product-hero container">
    <div class="product-image-col">
      {product.isAltisOwn && <div class="own-banner">Altis Teknoloji Kendi Ürünü</div>}
      <div class="product-image-wrap">
        <img id="main-img" src={product.image} alt={product.title} width="560" height="420" loading="eager" />
      </div>
      {product.gallery && product.gallery.length > 1 && (
        <div class="gallery-thumbs">
          {product.gallery.map((src, i) => (
            <button class:list={['thumb-btn', { active: src === product.image }]} onclick={`document.getElementById('main-img').src='${src}';this.closest('.gallery-thumbs').querySelectorAll('.thumb-btn').forEach(b=>b.classList.remove('active'));this.classList.add('active')`} type="button">
              <img src={src} alt={`${product.title} görsel ${i + 1}`} width="80" height="60" loading="lazy" />
            </button>
          ))}
        </div>
      )}
    </div>

    <div class="product-info">
      <div class="badges">
        <span class:list={['brand-badge', { 'brand-badge--own': product.isAltisOwn }]}>{product.brand}</span>
        <span class="category-badge">{product.category}</span>
      </div>
      <h1>{product.title}</h1>

      <div class="connectivity-row">
        <span class="conn-label">Bağlantı:</span>
        {product.connectivity.map(c => <span class="conn-chip">{c}</span>)}
      </div>

      <div class="tags-row">
        {product.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>

      <p class="description">{product.shortDesc}</p>

      <div class="cta-group">
        <a href={contactHref} class="btn btn-primary">Fiyat Teklifi Al</a>
        <a href="/iletisim/" class="btn btn-outline">Uzmanla Konuş</a>
      </div>

      <div class="trust-row">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>{product.isAltisOwn ? 'Altis Kendi Ürünü' : 'Resmi Distribütör'}</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Hızlı Teslimat</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <span>Teknik Destek</span>
        </div>
      </div>

      {product.datasheet && (
        <a href={product.datasheet} class="datasheet-card" target="_blank" rel="noopener">
          <span class="datasheet-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6 2h8l4 4v16H6V2Z" fill="currentColor" opacity=".14"/><path d="M14 2v5h5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 2h8l5 5v15H6V2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.4 15.8h7.2M8.4 18.2h5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M8.5 9.5h2.8c1 0 1.7.6 1.7 1.5s-.7 1.5-1.7 1.5H9.8v1.7H8.5V9.5Zm5.4 0h1.9c1.5 0 2.6 1 2.6 2.35 0 1.35-1.1 2.35-2.6 2.35h-1.9V9.5Z" fill="currentColor"/></svg>
          </span>
          <span class="datasheet-copy">
            <span class="datasheet-eyebrow">PDF Dökümantasyon</span>
            <span class="datasheet-title">{product.title} Teknik Dökümanı</span>
          </span>
          <span class="datasheet-action">PDF'i Aç</span>
        </a>
      )}
    </div>
  </section>

  <section class="overview-section container">
    <h2 class="section-title">Ürün Hakkında</h2>
    <p class="overview-text">
      {product.title}, perakende mağaza girişleri ve satış alanlarında RFID tabanlı ürün takibi,
      EAS alarm yönetimi ve mağaza operasyon entegrasyonu için konumlandırılan kompakt bir akıllı geçit çözümüdür.
      UHF RFID mimarisi, hızlı etiket okuma performansı ve çoklu bağlantı seçenekleriyle envanter görünürlüğünü,
      kayıp önlemeyi ve operasyonel doğrulamayı tek cihaz üzerinde birleştirir.
    </p>
  </section>

  <section class="features-section container">
    <h2 class="section-title">Öne Çıkan Özellikler</h2>
    <ul class="features-list">
      {product.featureHighlights.map(f => (
        <li>
          <span class="check-icon" aria-hidden="true">✓</span>
          {f}
        </li>
      ))}
    </ul>
  </section>

  <section class="specs-section container">
    <h2 class="section-title">Teknik Özellikler</h2>
    {product.sections.map(section => (
      <div class="spec-block">
        <h3 class="spec-group-title">{section.name}</h3>
        <table class="spec-table">
          <tbody>
            {Object.entries(section.items).map(([key, val]) => (
              <tr>
                <th>{key}</th>
                <td>{val}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    ))}
  </section>

  {related.length > 0 && (
    <section class="related-section container">
      <h2 class="section-title">Benzer Ürünler</h2>
      <div class="related-grid">
        {related.map(p => (
          <a href={`/urunler/perakende/${p.slug}/`} class="related-card">
            <img src={p.image} alt={p.title} width="200" height="150" loading="lazy" />
            <div class="related-info">
              <span class="related-brand">{p.brand}</span>
              <span class="related-title">{p.title}</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="cta-strip">
    <div class="container">
      <p>Bu ürün hakkında daha fazla bilgi almak ister misiniz?</p>
      <a href={contactHref} class="btn btn-primary">Fiyat Teklifi Al</a>
    </div>
  </section>
</Base>

<style>
.breadcrumb-bar { background: var(--bg-soft); border-bottom: 1px solid var(--border); padding: 10px 0; }
.breadcrumb-inner { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; }
.breadcrumb-inner a { color: var(--primary); font-weight: 500; transition: color .2s; }
.breadcrumb-inner a:hover { color: var(--cyan); }
.breadcrumb-inner span { color: var(--text-muted); }

.product-hero {
  display: grid;
  grid-template-columns: 0.8fr 1fr;
  gap: 60px;
  padding-top: 56px;
  padding-bottom: 56px;
  align-items: start;
}
.product-image-col { display: flex; flex-direction: column; gap: 12px; }
.product-image-wrap {
  background: #f8f9fb;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 8px;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 320px;
}
.product-image-wrap img { max-width: 100%; max-height: 460px; width: auto; height: auto; object-fit: contain; display: block; }
.own-banner {
  align-self: flex-start;
  background: var(--cyan);
  color: #fff;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  text-align: center;
  padding: 8px 14px;
  border-radius: 999px;
}

.product-info { display: flex; flex-direction: column; gap: 16px; }
.badges { display: flex; gap: 8px; flex-wrap: wrap; }
.brand-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--primary);
  background: rgba(0,18,92,.07);
  border: 1px solid rgba(0,18,92,.15);
  padding: 4px 12px;
  border-radius: 20px;
}
.brand-badge--own { background: var(--cyan); color: #fff; border-color: var(--cyan); }
.category-badge {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  padding: 4px 12px;
  border-radius: 20px;
}
.product-info h1 { font-size: clamp(1.6rem, 3vw, 2.2rem); font-weight: 800; color: var(--primary); line-height: 1.15; margin: 0; }

.connectivity-row { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; }
.conn-label { font-size: 12px; font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: .06em; }
.conn-chip { font-size: 12px; font-weight: 600; color: var(--primary); background: rgba(0,18,92,.07); border: 1px solid rgba(0,18,92,.15); padding: 3px 10px; border-radius: 4px; }

.tags-row { display: flex; flex-wrap: wrap; gap: 6px; }
.tag { font-size: 11.5px; font-weight: 600; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); padding: 4px 10px; border-radius: 20px; }

.description { font-size: 0.95rem; color: var(--text-muted); line-height: 1.75; margin: 0; }

.cta-group { display: flex; gap: 12px; flex-wrap: wrap; }
.btn-outline { background: transparent; border: 1.5px solid var(--primary); color: var(--primary); }
.btn-outline:hover { background: var(--primary); color: #fff; }

.datasheet-card {
  order: 3;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  width: 100%;
  margin-top: 18px;
  color: var(--text);
  background: linear-gradient(180deg,#fff,#f8fbff);
  border: 1px solid #d9e3f3;
  border-radius: 12px;
  padding: 16px;
  min-height: 86px;
  box-shadow: 0 10px 26px rgba(0,18,92,.06);
  transition: border-color .2s, box-shadow .2s, transform .2s;
}
.datasheet-card:hover {
  border-color: rgba(24,183,214,.45);
  box-shadow: 0 10px 28px rgba(0,18,92,.08);
  transform: translateY(-1px);
}
.datasheet-icon {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  color: #e53935;
  background: #fff4f3;
  border: 1px solid #ffd7d3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.datasheet-copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.datasheet-eyebrow {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--cyan);
}
.datasheet-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.35;
}
.datasheet-action {
  font-size: 12.5px;
  font-weight: 800;
  color: #fff;
  background: #1479d4;
  border-radius: 999px;
  padding: 10px 18px;
  white-space: nowrap;
}

.trust-row { order: 2; display: flex; gap: 18px; flex-wrap: wrap; padding-top: 4px; }
.trust-item { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-muted); }
.trust-item svg { color: var(--cyan); flex-shrink: 0; }

.gallery-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
.thumb-btn {
  padding: 4px;
  border: 2px solid var(--border);
  border-radius: 8px;
  background: #f8f9fb;
  cursor: pointer;
  transition: border-color .2s;
  overflow: hidden;
}
.thumb-btn img { width: 72px; height: 54px; object-fit: contain; display: block; }
.thumb-btn:hover { border-color: var(--primary); }
.thumb-btn.active { border-color: var(--cyan); }

.section-title {
  font-size: 1.25rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 24px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border-soft);
}

.overview-section { padding-top: 48px; }
.overview-text {
  font-size: 0.94rem;
  line-height: 1.8;
  color: var(--text-muted);
  margin: 0;
  max-width: 920px;
}

.features-section { padding-top: 48px; }
.features-list { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 12px; }
.features-list li {
  display: flex;
  align-items: flex-start;
  gap: 10px;
  font-size: 0.9rem;
  color: var(--text);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 8px;
  padding: 12px 14px;
  line-height: 1.5;
}
.check-icon { color: var(--cyan); font-weight: 900; font-size: 14px; flex-shrink: 0; margin-top: 1px; }

.specs-section { padding-top: 56px; padding-bottom: 16px; }
.spec-block { margin-bottom: 32px; }
.spec-group-title {
  font-size: 0.85rem;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 12px;
}
.spec-table { width: 100%; border-collapse: collapse; font-size: 0.88rem; }
.spec-table th, .spec-table td { padding: 10px 14px; text-align: left; border-bottom: 1px solid var(--border); }
.spec-table th { width: 36%; font-weight: 600; color: var(--text-muted); background: var(--bg-soft); }
.spec-table td { color: var(--text); }
.spec-table tr:last-child th, .spec-table tr:last-child td { border-bottom: none; }

.related-section { padding-top: 48px; padding-bottom: 48px; }
.related-grid { display: flex; gap: 16px; flex-wrap: wrap; }
.related-card {
  display: flex;
  align-items: center;
  gap: 14px;
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 12px 16px;
  transition: border-color .2s, box-shadow .2s;
  flex: 1;
  min-width: 220px;
}
.related-card:hover { border-color: var(--primary); box-shadow: 0 4px 16px rgba(0,18,92,.08); }
.related-card img { width: 60px; height: 45px; object-fit: contain; background: var(--bg-soft); border-radius: 6px; flex-shrink: 0; }
.related-info { display: flex; flex-direction: column; gap: 2px; }
.related-brand { font-size: 10px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--cyan); }
.related-title { font-size: 13px; font-weight: 600; color: var(--primary); line-height: 1.3; }

.cta-strip { background: linear-gradient(135deg, var(--primary) 0%, #0a2a8c 100%); padding: 48px 0; margin-top: 16px; }
.cta-strip .container { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.cta-strip p { font-size: 1.1rem; font-weight: 600; color: #fff; margin: 0; }

@media (max-width: 768px) {
  .product-hero { grid-template-columns: 1fr; gap: 32px; }
  .datasheet-card { grid-template-columns: auto 1fr; }
  .datasheet-action { grid-column: 1 / -1; text-align: center; }
  .gallery-thumbs { gap: 6px; }
  .features-list { grid-template-columns: 1fr; }
  .cta-strip .container { flex-direction: column; text-align: center; }
}
</style>
