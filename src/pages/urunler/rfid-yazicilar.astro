---
import Base from '../../layouts/Base.astro';
import { printers } from '../../data/rfid-yazicilar';

const brands = [...new Set(printers.map(p => p.brand))].sort();
const types = [
  { key: 'endüstriyel', label: 'Endüstriyel' },
  { key: 'masaüstü',   label: 'Masaüstü' },
  { key: 'mobil',      label: 'Mobil' },
] as const;

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "RFID Yazıcılar — Altis Teknoloji",
  "description": "Sato ve Zebra RFID etiket yazıcıları. Masaüstü, endüstriyel ve mobil modeller, UHF ve HF/NFC kodlama.",
  "url": "https://www.altis.com.tr/urunler/rfid-yazicilar/"
};
---

<Base
  title="RFID Yazıcılar — Altis Teknoloji"
  description="Sato ve Zebra RFID etiket yazıcıları. Masaüstü, endüstriyel ve mobil modeller, UHF ve HF/NFC kodlama."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/products/rfid-printers/"
>
  <section class="hero">
    <div class="container">
      <a href="/urunler/" class="breadcrumb">← Ürünler</a>
      <p class="eyebrow">RFID Donanım</p>
      <h1>RFID Yazıcılar</h1>
      <p class="lead">
        RFID etiket yazdırma ve kodlama cihazları. Sato ve Zebra markalarından
        masaüstü, endüstriyel ve mobil modeller — {printers.length} ürün stokta.
      </p>
      <div class="hero-stats">
        <div class="stat"><strong>{printers.length}</strong><span>Model</span></div>
        <div class="stat"><strong>{brands.length}</strong><span>Marka</span></div>
        <div class="stat"><strong>UHF + HF/NFC</strong><span>Kodlama</span></div>
      </div>
    </div>
  </section>

  <section class="filter-bar container">
    <div class="filter-group">
      {brands.map(b => <span class="brand-badge">{b}</span>)}
      {types.map(t => <span class="type-badge">{t.label}</span>)}
    </div>
    <a href="/iletisim/" class="btn btn-outline">Toplu Teklif İste</a>
  </section>

  {types.map(({ key, label }) => {
    const group = printers.filter(p => p.type === key);
    if (!group.length) return null;
    return (
      <section class="product-group container">
        <h2 class="group-heading">{label} Yazıcılar</h2>
        <div class="products-grid">
          {group.map(printer => (
            <article class="product-card">
              <a href={`/urunler/yazicilar/${printer.slug}/`} class="card-image-link">
                <img
                  src={printer.image}
                  alt={printer.title}
                  loading="lazy"
                  width="400"
                  height="300"
                />
              </a>
              <div class="card-body">
                <span class="brand-label">{printer.brand}</span>
                <h3><a href={`/urunler/yazicilar/${printer.slug}/`}>{printer.title}</a></h3>
                <p class="short-desc">{printer.shortDesc}</p>
                <div class="card-tags">
                  {printer.tags.slice(0, 3).map(tag => (
                    <span class="tag">{tag}</span>
                  ))}
                </div>
                <div class="card-actions">
                  <a href={`/urunler/yazicilar/${printer.slug}/`} class="btn btn-primary btn-sm">Ürünü İncele</a>
                  <a href={`/iletisim/?urun=${encodeURIComponent(printer.title)}`} class="btn btn-outline btn-sm">Fiyat Teklifi Al</a>
                  {printer.datasheet && (
                    <a href={printer.datasheet} class="btn btn-pdf btn-sm" target="_blank" rel="noopener">PDF</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}

  <section class="cta-strip">
    <div class="container">
      <p>Projenize en uygun RFID yazıcıyı birlikte seçelim.</p>
      <a href="/iletisim/" class="btn btn-primary">Uzmanla Konuşun</a>
    </div>
  </section>
</Base>

<style>
.hero {
  background: linear-gradient(135deg, var(--primary) 0%, #0a2a8c 100%);
  color: #fff;
  padding: 72px 0 60px;
}
.breadcrumb {
  display: inline-block;
  font-size: 13px;
  font-weight: 600;
  color: rgba(255,255,255,.65);
  margin-bottom: 20px;
  transition: color .2s;
}
.breadcrumb:hover { color: #fff; }
.eyebrow {
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .12em;
  text-transform: uppercase;
  color: var(--cyan);
  margin-bottom: 12px;
}
.hero h1 {
  font-size: clamp(1.9rem, 4vw, 2.8rem);
  font-weight: 800;
  color: #fff;
  margin-bottom: 16px;
  line-height: 1.15;
}
.lead {
  font-size: 1.05rem;
  color: rgba(255,255,255,.8);
  max-width: 620px;
  line-height: 1.7;
  margin-bottom: 36px;
}
.hero-stats { display: flex; gap: 40px; }
.stat { display: flex; flex-direction: column; gap: 2px; }
.stat strong { font-size: 1.5rem; font-weight: 800; color: var(--cyan); line-height: 1; }
.stat span { font-size: 12px; color: rgba(255,255,255,.6); text-transform: uppercase; letter-spacing: .06em; }

.filter-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding-top: 32px;
  padding-bottom: 8px;
  flex-wrap: wrap;
}
.filter-group { display: flex; gap: 8px; flex-wrap: wrap; }
.brand-badge {
  font-size: 12.5px;
  font-weight: 700;
  color: var(--primary);
  background: rgba(0,18,92,.07);
  border: 1px solid rgba(0,18,92,.15);
  padding: 5px 12px;
  border-radius: 20px;
}
.type-badge {
  font-size: 12.5px;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  padding: 5px 12px;
  border-radius: 20px;
}

.product-group { padding-top: 40px; padding-bottom: 16px; }
.group-heading {
  font-size: 1.15rem;
  font-weight: 700;
  color: var(--primary);
  margin-bottom: 20px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--cyan);
  display: inline-block;
}
.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 20px;
}

.product-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow .2s, border-color .2s, transform .2s;
}
.product-card:hover {
  border-color: var(--primary);
  box-shadow: 0 8px 32px rgba(0,18,92,.1);
  transform: translateY(-2px);
}
.card-image-link {
  display: block;
  background: #f8f9fb;
  padding: 24px;
  aspect-ratio: 4/3;
  overflow: hidden;
}
.card-image-link img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform .3s;
}
.product-card:hover .card-image-link img { transform: scale(1.04); }

.card-body {
  padding: 18px 20px 22px;
  display: flex;
  flex-direction: column;
  gap: 8px;
  flex: 1;
}
.brand-label {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: var(--cyan);
}
.card-body h3 { font-size: 14.5px; font-weight: 700; line-height: 1.35; margin: 0; }
.card-body h3 a { color: var(--primary); transition: color .2s; }
.card-body h3 a:hover { color: var(--cyan); }
.short-desc { font-size: 13px; color: var(--text-muted); line-height: 1.55; flex: 1; margin: 0; }
.card-tags { display: flex; flex-wrap: wrap; gap: 5px; margin-top: 4px; }
.tag {
  font-size: 11px;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  padding: 3px 8px;
  border-radius: 4px;
}
.card-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.btn-sm { font-size: 13px; padding: 8px 16px; }
.btn-pdf {
  background: #fff4f3;
  border: 1.5px solid #ffd7d3;
  color: #c62828;
}
.btn-pdf:hover {
  background: #c62828;
  border-color: #c62828;
  color: #fff;
}
.btn-outline {
  background: transparent;
  border: 1.5px solid var(--primary);
  color: var(--primary);
}
.btn-outline:hover { background: var(--primary); color: #fff; }

.cta-strip {
  background: linear-gradient(135deg, var(--primary) 0%, #0a2a8c 100%);
  padding: 48px 0;
  margin-top: 40px;
}
.cta-strip .container {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.cta-strip p { font-size: 1.1rem; font-weight: 600; color: #fff; margin: 0; }

@media (max-width: 600px) {
  .filter-bar { flex-direction: column; align-items: flex-start; }
  .cta-strip .container { flex-direction: column; text-align: center; }
}
</style>
