---
import Base from '../../layouts/Base.astro';
import { readers, brands } from '../../data/rfid-okuyucular';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "RFID Okuyucular — Altis Teknoloji",
  "description": "Sabit UHF RFID okuyucular: Altis, Alien, Hopeland, Impinj, Nordic ID, SICK ve Zebra. Portal, raf, masaüstü ve giyilebilir modeller.",
  "url": "https://www.altis.com.tr/urunler/rfid-okuyucular/"
};
---

<Base
  title="RFID Okuyucular — Altis Teknoloji"
  description="Sabit UHF RFID okuyucular: Altis, Alien, Hopeland, Impinj, Nordic ID, SICK ve Zebra. Portal, raf, masaüstü ve giyilebilir modeller."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/products/rfid-readers/"
>
  <section class="hero">
    <div class="container">
      <a href="/urunler/" class="breadcrumb">← Ürünler</a>
      <p class="eyebrow">RFID Donanım</p>
      <h1>RFID Okuyucular</h1>
      <p class="lead">
        Sabit ve taşınabilir UHF RFID okuyucular. Portal, raf, masaüstü ve giyilebilir modeller —
        {readers.length} ürün, {brands.length} marka. Altis\'in kendi tasarladığı R-Gate dahil.
      </p>
      <div class="hero-stats">
        <div class="stat"><strong>{readers.length}</strong><span>Model</span></div>
        <div class="stat"><strong>{brands.length}</strong><span>Marka</span></div>
        <div class="stat"><strong>1 Port → 16 Port</strong><span>Ölçek</span></div>
      </div>
    </div>
  </section>

  <section class="brand-nav container">
    {brands.map(brand => (
      <a href={`#brand-${brand.toLowerCase().replace(/\s/g, '-')}`} class:list={['brand-btn', { 'brand-btn--own': brand === 'Altis' }]}>
        {brand === 'Altis' && <span class="own-dot" aria-label="Altis ürünü" />}
        {brand}
      </a>
    ))}
    <a href="/iletisim/" class="btn btn-outline btn-sm">Toplu Teklif İste</a>
  </section>

  {brands.map(brand => {
    const group = readers.filter(r => r.brand === brand);
    return (
      <section class="brand-section container" id={`brand-${brand.toLowerCase().replace(/\s/g, '-')}`}>
        <div class="brand-header">
          <h2 class:list={['brand-title', { 'brand-title--own': brand === 'Altis' }]}>
            {brand === 'Altis' && <span class="own-badge">Altis Markası</span>}
            {brand} <span class="count">({group.length} ürün)</span>
          </h2>
        </div>
        <div class="products-grid">
          {group.map(reader => (
            <article class:list={['product-card', { 'product-card--own': reader.isAltisOwn }]}>
              <a href={`/urunler/okuyucular/${reader.slug}/`} class="card-image-link">
                <img src={reader.image} alt={reader.title} loading="lazy" width="400" height="300" />
                {reader.isAltisOwn && <span class="own-ribbon">Kendi Ürünümüz</span>}
              </a>
              <div class="card-body">
                <span class="brand-label">{reader.brand}</span>
                {reader.ports && <span class="port-badge">{reader.ports} Port</span>}
                <h3><a href={`/urunler/okuyucular/${reader.slug}/`}>{reader.title}</a></h3>
                <p class="short-desc">{reader.shortDesc}</p>
                {reader.connectivity && (
                  <div class="connectivity">
                    {reader.connectivity.slice(0, 4).map(c => <span class="conn-tag">{c}</span>)}
                  </div>
                )}
                <div class="card-actions">
                  <a href={`/urunler/okuyucular/${reader.slug}/`} class="btn btn-primary btn-sm">İncele</a>
                  <a href={`/iletisim/?urun=${encodeURIComponent(reader.title)}`} class="btn btn-outline btn-sm">Teklif Al</a>
                  {reader.datasheet && (
                    <a href={reader.datasheet} class="btn btn-pdf btn-sm" target="_blank" rel="noopener">PDF</a>
                  )}
                </div>
              </div>
            </article>
          ))}
        </div>
      </section>
    );
  })}

  <section class="cta-strip">
    <div class="container">
      <p>Projenize en uygun RFID okuyucuyu birlikte belirleyelim.</p>
      <a href="/iletisim/" class="btn btn-primary">Uzmanla Konuşun</a>
    </div>
  </section>
</Base>

<style>
.hero {
  background: linear-gradient(135deg, var(--primary) 0%, #0a2a8c 100%);
  color: #fff;
  padding: 72px 0 60px;
}
.breadcrumb { display: inline-block; font-size: 13px; font-weight: 600; color: rgba(255,255,255,.65); margin-bottom: 20px; transition: color .2s; }
.breadcrumb:hover { color: #fff; }
.eyebrow { font-size: 12px; font-weight: 700; letter-spacing: .12em; text-transform: uppercase; color: var(--cyan); margin-bottom: 12px; }
.hero h1 { font-size: clamp(1.9rem, 4vw, 2.8rem); font-weight: 800; color: #fff; margin-bottom: 16px; line-height: 1.15; }
.lead { font-size: 1.05rem; color: rgba(255,255,255,.8); max-width: 640px; line-height: 1.7; margin-bottom: 36px; }
.hero-stats { display: flex; gap: 40px; }
.stat { display: flex; flex-direction: column; gap: 2px; }
.stat strong { font-size: 1.5rem; font-weight: 800; color: var(--cyan); line-height: 1; }
.stat span { font-size: 12px; color: rgba(255,255,255,.6); text-transform: uppercase; letter-spacing: .06em; }

.brand-nav {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 28px;
  padding-bottom: 12px;
  flex-wrap: wrap;
}
.brand-btn {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  font-size: 13px;
  font-weight: 700;
  color: var(--primary);
  background: rgba(0,18,92,.06);
  border: 1px solid rgba(0,18,92,.15);
  padding: 6px 14px;
  border-radius: 20px;
  transition: background .2s, color .2s;
}
.brand-btn:hover { background: var(--primary); color: #fff; }
.brand-btn--own { background: var(--cyan); color: #fff; border-color: var(--cyan); }
.brand-btn--own:hover { background: #0fa5c0; border-color: #0fa5c0; }
.own-dot {
  width: 7px; height: 7px;
  background: #fff;
  border-radius: 50%;
  flex-shrink: 0;
}
.btn-outline { background: transparent; border: 1.5px solid var(--primary); color: var(--primary); margin-left: auto; }
.btn-outline:hover { background: var(--primary); color: #fff; }
.btn-sm { font-size: 13px; padding: 7px 14px; }

.brand-section { padding-top: 44px; padding-bottom: 16px; }
.brand-header { margin-bottom: 20px; }
.brand-title {
  font-size: 1.2rem;
  font-weight: 700;
  color: var(--primary);
  display: flex;
  align-items: center;
  gap: 10px;
  padding-bottom: 10px;
  border-bottom: 2px solid var(--border-soft);
}
.brand-title--own { border-bottom-color: var(--cyan); }
.own-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #fff;
  background: var(--cyan);
  padding: 3px 10px;
  border-radius: 20px;
}
.count { font-size: 14px; font-weight: 500; color: var(--text-muted); }

.products-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  gap: 18px;
}
.product-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: box-shadow .2s, border-color .2s, transform .2s;
}
.product-card:hover { border-color: var(--primary); box-shadow: 0 8px 28px rgba(0,18,92,.09); transform: translateY(-2px); }
.product-card--own { border-color: rgba(24,183,214,.3); }
.product-card--own:hover { border-color: var(--cyan); }
.card-image-link {
  display: block;
  background: #f8f9fb;
  padding: 20px;
  aspect-ratio: 4/3;
  overflow: hidden;
  position: relative;
}
.card-image-link img { width: 100%; height: 100%; object-fit: contain; transition: transform .3s; }
.product-card:hover .card-image-link img { transform: scale(1.04); }
.own-ribbon {
  position: absolute;
  top: 10px; right: -24px;
  background: var(--cyan);
  color: #fff;
  font-size: 10px;
  font-weight: 700;
  padding: 4px 32px;
  transform: rotate(35deg);
  letter-spacing: .06em;
}
.card-body { padding: 16px 18px 20px; display: flex; flex-direction: column; gap: 6px; flex: 1; }
.brand-label { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--cyan); }
.port-badge {
  display: inline-block;
  font-size: 10.5px;
  font-weight: 700;
  color: var(--primary);
  background: rgba(0,18,92,.07);
  border: 1px solid rgba(0,18,92,.12);
  padding: 2px 8px;
  border-radius: 4px;
  align-self: flex-start;
}
.card-body h3 { font-size: 13.5px; font-weight: 700; line-height: 1.35; margin: 0; }
.card-body h3 a { color: var(--primary); transition: color .2s; }
.card-body h3 a:hover { color: var(--cyan); }
.short-desc { font-size: 12.5px; color: var(--text-muted); line-height: 1.55; flex: 1; margin: 0; }
.connectivity { display: flex; flex-wrap: wrap; gap: 4px; margin-top: 2px; }
.conn-tag { font-size: 10.5px; font-weight: 600; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); padding: 2px 7px; border-radius: 4px; }
.card-actions { display: flex; gap: 8px; margin-top: 8px; flex-wrap: wrap; }
.card-actions .btn-outline { margin-left: 0; }
.btn-pdf {
  background: #fff4f3;
  border: 1.5px solid #ffd7d3;
  color: #c62828;
}
.btn-pdf:hover {
  background: #c62828;
  border-color: #c62828;
  color: #fff;
}

.cta-strip { background: linear-gradient(135deg, var(--primary) 0%, #0a2a8c 100%); padding: 48px 0; margin-top: 40px; }
.cta-strip .container { display: flex; align-items: center; justify-content: space-between; gap: 24px; flex-wrap: wrap; }
.cta-strip p { font-size: 1.1rem; font-weight: 600; color: #fff; margin: 0; }

@media (max-width: 600px) {
  .brand-nav { gap: 6px; }
  .btn-outline { margin-left: 0; width: 100%; justify-content: center; }
  .cta-strip .container { flex-direction: column; text-align: center; }
}
</style>
