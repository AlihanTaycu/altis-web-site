---
import Base from '../../../layouts/Base.astro';
import { printers } from '../../../data/rfid-yazicilar';
import type { Printer } from '../../../data/rfid-yazicilar';
import type { GetStaticPaths } from 'astro';

export const getStaticPaths: GetStaticPaths = () => {
  return printers.map(p => ({
    params: { slug: p.slug },
    props: { printer: p },
  }));
};

const { printer } = Astro.props;
const gallery = printer.gallery && printer.gallery.length > 0 ? printer.gallery : [printer.image];

const typeLabel = { endüstriyel: 'Endüstriyel', masaüstü: 'Masaüstü', mobil: 'Mobil' }[printer.type];

const related = [
  ...printers.filter(p => p.slug !== printer.slug && p.brand === printer.brand),
  ...printers.filter(p => p.slug !== printer.slug && p.brand !== printer.brand),
].slice(0, 3);

const contactHref = `/iletisim/?urun=${encodeURIComponent(printer.title)}`;

const schema = {
  "@context": "https://schema.org",
  "@type": "Product",
  "name": printer.title,
  "description": printer.shortDesc,
  "brand": { "@type": "Brand", "name": printer.brand },
  "image": printer.image,
  "offers": {
    "@type": "Offer",
    "availability": "https://schema.org/InStock",
    "seller": { "@type": "Organization", "name": "Altis Teknoloji" }
  }
};
---

<Base
  title={`${printer.title} — Altis Teknoloji`}
  description={printer.shortDesc}
  {schema}
  lang="tr"
  alternateUrl={`https://www.altis.com.tr/en/products/rfid-printers/${printer.slug}/`}
>
  <nav class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/urunler/">Ürünler</a>
      <span aria-hidden="true">›</span>
      <a href="/urunler/rfid-yazicilar/">RFID Yazıcılar</a>
      <span aria-hidden="true">›</span>
      <span>{printer.title}</span>
    </div>
  </nav>

  <section class="product-hero container">
    <div class="product-image-col">
      <div class="product-image-wrap" id="product-image-wrap">
        <img
          id="main-img"
          src={gallery[0]}
          alt={printer.title}
          width="560"
          height="420"
          loading="eager"
          data-index="0"
        />
        <button class="zoom-hint" type="button" aria-label="Görseli büyüt">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          <span>Büyüt</span>
        </button>
      </div>
      {gallery.length > 1 && (
        <div class="gallery-thumbs" id="gallery-thumbs">
          {gallery.map((src, i) => (
            <button class:list={['thumb-btn', { active: i === 0 }]} data-index={i} data-src={src} type="button">
              <img src={src} alt={`${printer.title} görsel ${i + 1}`} width="80" height="60" loading="lazy" />
            </button>
          ))}
        </div>
      )}
      {printer.datasheet && (
        <a href={printer.datasheet} class="datasheet-card" target="_blank" rel="noopener">
          <span class="datasheet-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6 2h8l4 4v16H6V2Z" fill="currentColor" opacity=".14"/><path d="M14 2v5h5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 2h8l5 5v15H6V2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.4 15.8h7.2M8.4 18.2h5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/><path d="M8.5 9.5h2.8c1 0 1.7.6 1.7 1.5s-.7 1.5-1.7 1.5H9.8v1.7H8.5V9.5Zm5.4 0h1.9c1.5 0 2.6 1 2.6 2.35 0 1.35-1.1 2.35-2.6 2.35h-1.9V9.5Z" fill="currentColor"/></svg>
          </span>
          <span class="datasheet-copy">
            <span class="datasheet-eyebrow">PDF Dökümantasyon</span>
            <span class="datasheet-title">{printer.title} Teknik Dökümanı</span>
          </span>
          <span class="datasheet-action">PDF'i Aç</span>
        </a>
      )}
    </div>

    <div class="product-info">
      <div class="badges">
        <span class="brand-badge">{printer.brand}</span>
        <span class="type-badge">{typeLabel}</span>
      </div>
      <h1>{printer.title}</h1>

      <div class="tags-row">
        {printer.tags.map(tag => <span class="tag">{tag}</span>)}
      </div>

      <p class="description">{printer.description}</p>

      <div class="price-block">
        <p class="price-label">Fiyat bilgisi için teklif alın</p>
        <p class="price-sub">Ürün, adet ve teslimat koşullarına göre özel fiyatlandırma sunuyoruz.</p>
      </div>

      <div class="cta-group">
        <a href={contactHref} class="btn btn-primary btn-lg">Fiyat Teklifi Al</a>
        <a href="/iletisim/" class="btn btn-outline btn-lg">Demo Talep Et</a>
      </div>

      <div class="trust-row">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Resmi Distribütör</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Hızlı Teslimat</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <span>Teknik Destek</span>
        </div>
      </div>
    </div>
  </section>

  <section class="details-section container">
    <div class="detail-card full">
      <h2>Ürün Hakkında</h2>
      <p>{printer.description}</p>
    </div>
    <div class="detail-card">
      <h2>Marka & Stok</h2>
      <p class="brand-info">
        <strong>{printer.brand}</strong> — Altis Teknoloji, bu markanın Türkiye resmi distribütörü olarak stok ve teknik destek sağlamaktadır.
      </p>
      <a href={printer.storeUrl} target="_blank" rel="noopener" class="external-link">
        Eski mağazamızda görüntüle →
      </a>
    </div>
    <div class="detail-card">
      <h2>Yazıcı Tipi</h2>
      <p><strong>{typeLabel}</strong> — {
        printer.type === 'mobil'
          ? 'Saha, depo ve mağaza içi hareketli kullanım için tasarlanmış.'
          : printer.type === 'endüstriyel'
          ? 'Yüksek hacimli üretim ve lojistik hatları için optimize edilmiş.'
          : 'Ofis ve bant başı baskı istasyonları için kompakt çözüm.'
      }</p>
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section container">
      <h2>Benzer Ürünler</h2>
      <div class="related-grid">
        {related.map(rel => (
          <a href={`/urunler/yazicilar/${rel.slug}/`} class="related-card">
            <img src={rel.image} alt={rel.title} loading="lazy" width="200" height="150" />
            <div class="related-info">
              <span class="brand-label">{rel.brand}</span>
              <p>{rel.title}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bottom-cta">
    <div class="container">
      <h2>Bu yazıcı hakkında teknik bilgi almak ister misiniz?</h2>
      <p>RFID uzmanlarımız doğru yazıcı seçimi ve entegrasyon konusunda size yardımcı olur.</p>
      <div class="bottom-cta-btns">
        <a href={contactHref} class="btn btn-primary">Fiyat Teklifi Al</a>
        <a href="/urunler/rfid-yazicilar/" class="btn btn-outline-white">Tüm Yazıcılar</a>
      </div>
    </div>
  </section>
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Ürün görseli görüntüleyici" hidden>
    <button class="lb-close" id="lb-close" type="button" aria-label="Kapat">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lb-nav lb-prev" id="lb-prev" type="button" aria-label="Önceki görsel">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lb-nav lb-next" id="lb-next" type="button" aria-label="Sonraki görsel">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lb-stage" id="lb-stage">
      <img class="lb-image" id="lb-image" src="" alt="" />
    </div>
    <div class="lb-toolbar">
      <button class="lb-tool" id="lb-zoom-out" type="button" aria-label="Uzaklaştır">-</button>
      <span class="lb-counter" id="lb-counter">1 / 1</span>
      <button class="lb-tool" id="lb-zoom-in" type="button" aria-label="Yakınlaştır">+</button>
    </div>
  </div>

  <script is:inline define:vars={{ gallery, title: printer.title }}>
    (function () {
      const mainImg = document.getElementById('main-img');
      const thumbs = document.querySelectorAll('#gallery-thumbs .thumb-btn');
      const wrap = document.getElementById('product-image-wrap');
      const lightbox = document.getElementById('lightbox');
      const lbImage = document.getElementById('lb-image');
      const lbCounter = document.getElementById('lb-counter');
      const lbClose = document.getElementById('lb-close');
      const lbPrev = document.getElementById('lb-prev');
      const lbNext = document.getElementById('lb-next');
      const lbStage = document.getElementById('lb-stage');
      const lbZoomIn = document.getElementById('lb-zoom-in');
      const lbZoomOut = document.getElementById('lb-zoom-out');
      if (!mainImg || !wrap || !lightbox || !lbImage) return;

      let currentIndex = 0;
      let zoom = 1;
      let panX = 0;
      let panY = 0;
      let dragging = false;
      let startX = 0;
      let startY = 0;

      function setMain(i) {
        currentIndex = (i + gallery.length) % gallery.length;
        mainImg.src = gallery[currentIndex];
        mainImg.dataset.index = currentIndex;
        thumbs.forEach((item, itemIndex) => item.classList.toggle('active', itemIndex === currentIndex));
      }

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => setMain(parseInt(thumb.dataset.index, 10)));
      });

      function applyTransform() {
        lbImage.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + zoom + ')';
        lbImage.style.cursor = zoom > 1 ? (dragging ? 'grabbing' : 'grab') : 'zoom-in';
      }

      function setZoom(z) {
        zoom = Math.max(1, Math.min(4, z));
        if (zoom === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      function updateLightbox() {
        lbImage.src = gallery[currentIndex];
        lbImage.alt = title + ' görsel ' + (currentIndex + 1);
        lbCounter.textContent = (currentIndex + 1) + ' / ' + gallery.length;
        setZoom(1);
      }

      function openLightbox(i) {
        currentIndex = i;
        updateLightbox();
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => lightbox.classList.add('open'));
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        setTimeout(() => {
          lightbox.hidden = true;
        }, 220);
      }

      wrap.addEventListener('click', (event) => {
        if (event.target.closest('.zoom-hint') || event.target === mainImg || event.target === wrap) {
          openLightbox(parseInt(mainImg.dataset.index || '0', 10));
        }
      });

      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + gallery.length) % gallery.length;
        updateLightbox();
      });
      lbNext.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % gallery.length;
        updateLightbox();
      });

      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox || event.target === lbStage) closeLightbox();
      });

      document.addEventListener('keydown', (event) => {
        if (lightbox.hidden) return;
        if (event.key === 'Escape') closeLightbox();
        else if (event.key === 'ArrowLeft') lbPrev.click();
        else if (event.key === 'ArrowRight') lbNext.click();
        else if (event.key === '+' || event.key === '=') setZoom(zoom + 0.5);
        else if (event.key === '-') setZoom(zoom - 0.5);
      });

      lbZoomIn.addEventListener('click', () => setZoom(zoom + 0.5));
      lbZoomOut.addEventListener('click', () => setZoom(zoom - 0.5));

      lbImage.addEventListener('click', (event) => {
        event.stopPropagation();
        if (zoom === 1) setZoom(2);
        else setZoom(1);
      });

      lbImage.addEventListener('wheel', (event) => {
        event.preventDefault();
        setZoom(zoom + (event.deltaY < 0 ? 0.25 : -0.25));
      }, { passive: false });

      lbImage.addEventListener('mousedown', (event) => {
        if (zoom <= 1) return;
        dragging = true;
        startX = event.clientX - panX;
        startY = event.clientY - panY;
        applyTransform();
      });

      window.addEventListener('mousemove', (event) => {
        if (!dragging) return;
        panX = event.clientX - startX;
        panY = event.clientY - startY;
        applyTransform();
      });

      window.addEventListener('mouseup', () => {
        dragging = false;
        applyTransform();
      });

      let touchStartX = null;
      lbStage.addEventListener('touchstart', (event) => {
        if (event.touches.length === 1) touchStartX = event.touches[0].clientX;
      });
      lbStage.addEventListener('touchend', (event) => {
        if (touchStartX === null) return;
        const dx = event.changedTouches[0].clientX - touchStartX;
        if (Math.abs(dx) > 50 && zoom === 1) {
          if (dx < 0) lbNext.click();
          else lbPrev.click();
        }
        touchStartX = null;
      });
    })();
  </script>
</Base>

<style>
.breadcrumb-bar {
  border-bottom: 1px solid var(--border-soft);
  background: #fff;
}
.breadcrumb-inner {
  display: flex;
  align-items: center;
  gap: 8px;
  padding-top: 14px;
  padding-bottom: 14px;
  font-size: 13px;
  color: var(--text-muted);
  flex-wrap: wrap;
}
.breadcrumb-inner a { color: var(--text-muted); transition: color .2s; }
.breadcrumb-inner a:hover { color: var(--primary); }
.breadcrumb-inner span:last-child { color: var(--primary); font-weight: 600; }

.product-hero {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 60px;
  padding-top: 56px;
  padding-bottom: 56px;
  align-items: start;
}
.product-image-col {
  display: flex;
  flex-direction: column;
  gap: 18px;
}
.product-image-wrap {
  background: #f8f9fb;
  border: 1px solid var(--border);
  border-radius: 16px;
  padding: 32px;
  aspect-ratio: 4/3;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  position: relative;
  cursor: zoom-in;
  transition: border-color .2s, box-shadow .2s;
}
.product-image-wrap:hover {
  border-color: rgba(24, 183, 214, .5);
  box-shadow: 0 6px 22px rgba(0, 18, 92, .08);
}
.product-image-wrap:hover .zoom-hint {
  opacity: 1;
  transform: translateY(0);
}
.product-image-wrap img {
  width: 100%;
  height: 100%;
  object-fit: contain;
  transition: transform .35s ease;
}
.product-image-wrap:hover img { transform: scale(1.02); }
.zoom-hint {
  position: absolute;
  right: 14px;
  bottom: 14px;
  display: inline-flex;
  align-items: center;
  gap: 6px;
  background: rgba(0, 18, 92, .85);
  color: #fff;
  font-size: 12px;
  font-weight: 700;
  padding: 7px 12px;
  border: none;
  border-radius: 999px;
  cursor: zoom-in;
  opacity: 0;
  transform: translateY(6px);
  transition: opacity .2s, transform .2s;
  backdrop-filter: blur(6px);
  letter-spacing: .03em;
}
.zoom-hint svg { color: var(--cyan); }

.gallery-thumbs {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}
.thumb-btn {
  padding: 4px;
  border: 2px solid var(--border);
  border-radius: 8px;
  background: #f8f9fb;
  cursor: pointer;
  transition: border-color .2s;
  overflow: hidden;
}
.thumb-btn img {
  width: 72px;
  height: 54px;
  object-fit: contain;
  display: block;
}
.thumb-btn:hover { border-color: var(--primary); }
.thumb-btn.active { border-color: var(--cyan); }

.datasheet-card {
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 14px;
  color: var(--text);
  background: linear-gradient(180deg, #fff, #f8fbff);
  border: 1px solid #d9e3f3;
  border-radius: 12px;
  padding: 16px;
  min-height: 86px;
  box-shadow: 0 10px 26px rgba(0, 18, 92, .06);
  transition: border-color .2s, box-shadow .2s, transform .2s;
}
.datasheet-card:hover {
  border-color: rgba(24, 183, 214, .45);
  box-shadow: 0 10px 28px rgba(0, 18, 92, .08);
  transform: translateY(-1px);
}
.datasheet-icon {
  width: 52px;
  height: 52px;
  border-radius: 10px;
  color: #e53935;
  background: #fff4f3;
  border: 1px solid #ffd7d3;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.datasheet-copy {
  display: flex;
  flex-direction: column;
  gap: 3px;
  min-width: 0;
}
.datasheet-eyebrow {
  font-size: 10.5px;
  font-weight: 800;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--cyan);
}
.datasheet-title {
  font-size: 14px;
  font-weight: 700;
  color: var(--primary);
  line-height: 1.35;
}
.datasheet-action {
  font-size: 12.5px;
  font-weight: 800;
  color: #fff;
  background: #1479d4;
  border-radius: 999px;
  padding: 10px 18px;
  white-space: nowrap;
}

.badges { display: flex; gap: 8px; margin-bottom: 14px; align-items: center; }
.brand-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .1em;
  text-transform: uppercase;
  color: #fff;
  background: var(--cyan);
  padding: 4px 12px;
  border-radius: 20px;
}
.type-badge {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--primary);
  background: rgba(0,18,92,.08);
  border: 1px solid rgba(0,18,92,.15);
  padding: 4px 12px;
  border-radius: 20px;
}
.product-info h1 {
  font-size: clamp(1.4rem, 3vw, 2rem);
  font-weight: 800;
  color: var(--primary);
  line-height: 1.2;
  margin-bottom: 16px;
}
.tags-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
.tag {
  font-size: 11.5px;
  font-weight: 600;
  color: var(--text-muted);
  background: var(--bg-soft);
  border: 1px solid var(--border);
  padding: 4px 10px;
  border-radius: 5px;
}
.description {
  font-size: 14.5px;
  line-height: 1.75;
  color: var(--text-muted);
  margin-bottom: 28px;
}
.price-block {
  background: var(--bg-soft);
  border: 1px solid var(--border);
  border-radius: 10px;
  padding: 18px 20px;
  margin-bottom: 24px;
}
.price-label { font-size: 16px; font-weight: 700; color: var(--primary); margin: 0 0 4px; }
.price-sub { font-size: 13px; color: var(--text-muted); margin: 0; }

.cta-group { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
.btn-lg { padding: 14px 28px; font-size: 15px; }
.btn-outline {
  background: transparent;
  border: 1.5px solid var(--primary);
  color: var(--primary);
}
.btn-outline:hover { background: var(--primary); color: #fff; }

.trust-row {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
  padding-top: 16px;
  border-top: 1px solid var(--border-soft);
}
.trust-item { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-muted); }
.trust-item svg { color: var(--cyan); flex-shrink: 0; }

.details-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20px;
  padding-bottom: 60px;
}
.detail-card {
  background: #fff;
  border: 1px solid var(--border);
  border-radius: 12px;
  padding: 28px;
}
.detail-card.full { grid-column: 1 / -1; }
.detail-card h2 { font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 12px; }
.detail-card p { font-size: 14px; line-height: 1.7; color: var(--text-muted); margin: 0; }
