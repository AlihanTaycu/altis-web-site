<style>
:root{
  --navy-900:#000A3A;--navy-800:#00125C;--navy-700:#0A1E75;--navy-600:#1E2F8C;
  --bg:#FFFFFF;--bg-soft:#F6F8FC;--bg-blue:#EEF3FF;
  --text:#111827;--text-muted:#5F6675;--text-faint:#8A93A5;
  --border:#E3E8F2;--border-soft:#EEF1F7;
  --cyan:#18B7D6;--cyan-soft:#E8FAFD;
  --steel:#8B95A5;--slate:#334155;
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
  --primary:var(--navy-800);--accent:var(--cyan);
  /* Sector accent — warmer industrial orange to distinguish from product pages */
  --sector:#E07A2C;
  --sector-soft:#FFF1E2;
  --radius:14px;--radius-lg:22px;
  --shadow-sm:0 1px 2px rgba(0,18,92,.04);
  --shadow:0 8px 28px -12px rgba(0,18,92,.18),0 2px 6px rgba(0,18,92,.05);
  --shadow-lg:0 30px 60px -25px rgba(0,18,92,.28),0 8px 20px -8px rgba(0,18,92,.12);
  --container:1240px;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:"Inter",system-ui,sans-serif;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.55}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}
.container{max-width:var(--container);margin:0 auto;padding:0 32px}
.mono{font-family:"JetBrains Mono",monospace}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--sector);display:inline-flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:24px;height:1px;background:var(--sector)}
h1,h2,h3,h4{font-family:inherit;color:var(--navy-800);margin:0;letter-spacing:-.02em;line-height:1.15;text-wrap:balance}
h1{font-size:clamp(40px,5vw,68px);font-weight:700}
h2{font-size:clamp(30px,3.2vw,44px);font-weight:700;letter-spacing:-.025em}
h3{font-size:20px;font-weight:600}
h4{font-size:16px;font-weight:600}
p{margin:0;color:var(--text-muted);text-wrap:pretty}

/* Header */
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--border-soft)}
.nav{display:flex;align-items:center;justify-content:space-between;height:76px}
.logo{display:flex;align-items:center;gap:12px}
.logo img{height:30px;width:auto}
.nav-links{display:flex;align-items:center;gap:36px}
.nav-links a{font-size:14.5px;color:var(--text);font-weight:500}
.nav-links a:hover{color:var(--primary)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;font-weight:600;font-size:14.5px;border-radius:10px;transition:all .2s;white-space:nowrap}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 6px 20px -10px rgba(0,18,92,.6)}
.btn-primary:hover{transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--primary);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--bg-soft)}
.btn-lg{padding:16px 28px;font-size:15.5px;border-radius:12px}

/* Breadcrumb */
.breadcrumb{padding:24px 0 0;font-size:13px;color:var(--text-faint);display:flex;align-items:center;gap:10px;position:relative;z-index:2}
.breadcrumb a{color:var(--text-muted)}
.breadcrumb a:hover{color:var(--primary)}
.breadcrumb .sep{opacity:.5}

/* Hero */
.hero{
  position:relative;padding:48px 0 120px;overflow:hidden;
  background:
    radial-gradient(900px 500px at 80% -100px, rgba(224,122,44,.10), transparent 60%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid-bg{
  position:absolute;inset:0;pointer-events:none;opacity:.35;
  background-image:linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1.05fr 1fr;gap:64px;align-items:center;margin-top:32px}
.sector-pill{display:inline-flex;align-items:center;gap:10px;padding:7px 14px 7px 8px;border-radius:999px;background:#fff;border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--slate);box-shadow:var(--shadow-sm)}
.sector-pill .pill-tag{background:var(--sector);color:#fff;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:999px;text-transform:uppercase}
.hero h1{margin-top:24px}
.hero h1 em{color:var(--sector);font-style:normal}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:540px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.hero-platforms{display:flex;gap:8px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);align-items:center;max-width:540px;flex-wrap:wrap}
.hero-platforms .lbl{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-right:6px}
.plat-chip{font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:7px;display:inline-flex;align-items:center;gap:6px}
.plat-chip.tt{background:var(--bg-blue);color:var(--primary)}
.plat-chip.pr{background:var(--cyan-soft);color:#0c7d94}

/* Hero visual — warehouse isometric grid */
.warehouse{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);overflow:hidden;position:relative;
}
.wh-head{padding:14px 18px;border-bottom:1px solid var(--border-soft);background:#FCFCFE;display:flex;justify-content:space-between;align-items:center}
.wh-head .ttl{font-weight:600;font-size:13px;color:var(--navy-800)}
.wh-head .meta{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--text-faint);display:flex;gap:10px;align-items:center}
.wh-head .live{display:inline-flex;align-items:center;gap:5px;color:var(--ok);font-weight:600}
.wh-head .live::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 0 rgba(21,160,107,.5);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(21,160,107,.5)}70%{box-shadow:0 0 0 8px rgba(21,160,107,0)}100%{box-shadow:0 0 0 0 rgba(21,160,107,0)}}

.wh-body{padding:22px;background:linear-gradient(180deg,#FAFBFE,#fff);position:relative;min-height:460px}
.wh-grid{
  position:relative;display:grid;
  grid-template-columns:repeat(8,1fr);
  grid-template-rows:repeat(6,38px);
  gap:6px;
}
.wh-aisle{
  background:repeating-linear-gradient(135deg,rgba(0,18,92,.04),rgba(0,18,92,.04) 4px,transparent 4px,transparent 8px);
  border-radius:4px;
}
.wh-rack{
  background:#fff;border:1px solid var(--border-soft);border-radius:4px;
  display:flex;align-items:center;justify-content:center;
  font-family:"JetBrains Mono",monospace;font-size:9px;color:var(--text-faint);font-weight:600;
  position:relative;
}
.wh-rack.full{background:var(--bg-blue);border-color:var(--primary);color:var(--primary)}
.wh-rack.half{background:linear-gradient(180deg,var(--bg-blue) 0,var(--bg-blue) 50%,#fff 50%,#fff 100%);border-color:var(--primary);color:var(--primary)}
.wh-rack.empty{background:#FAFBFE;color:var(--text-faint)}
.wh-rack.alarm{background:#FFE9E2;border-color:var(--sector);color:var(--sector)}
.wh-door{
  background:linear-gradient(180deg,var(--sector) 0,var(--sector) 4px,#fff 4px);
  border:1px solid var(--sector);border-radius:4px;
  display:flex;align-items:center;justify-content:center;
  font-family:"JetBrains Mono",monospace;font-size:9px;color:var(--sector);font-weight:700;
  position:relative;
}
.rfid-reader{
  position:absolute;width:14px;height:14px;border-radius:3px;background:var(--primary);
  display:flex;align-items:center;justify-content:center;color:#fff;font-size:8px;font-weight:700;
  box-shadow:0 0 0 3px rgba(0,18,92,.15);
  z-index:2;
}
.rfid-reader::after{
  content:"";position:absolute;width:34px;height:34px;border:1.5px solid var(--cyan);border-radius:50%;
  opacity:.3;animation:ripple 2s ease-out infinite;
}
.rfid-reader.b::after{animation-delay:-1s}
@keyframes ripple{0%{transform:scale(.4);opacity:.7}100%{transform:scale(1);opacity:0}}

.wh-side{
  margin-top:18px;display:grid;grid-template-columns:repeat(4,1fr);gap:8px;
}
.wh-kpi{background:#fff;border:1px solid var(--border-soft);border-radius:8px;padding:10px 12px}
.wh-kpi .l{font-size:9.5px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600}
.wh-kpi .v{font-family:"JetBrains Mono",monospace;font-size:17px;font-weight:700;color:var(--navy-800);margin-top:3px}
.wh-kpi .v.warn{color:var(--sector)}
.wh-kpi .v.ok{color:var(--ok)}

.wh-feed{
  position:absolute;right:22px;top:80px;width:200px;background:#fff;border:1px solid var(--border-soft);border-radius:10px;
  box-shadow:0 8px 18px -8px rgba(0,18,92,.18);padding:10px 12px;
}
.wh-feed h6{font-size:10px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.06em;font-weight:700;margin:0 0 8px}
.wh-feed .row{display:flex;gap:8px;align-items:center;padding:6px 0;border-bottom:1px dashed var(--border-soft);font-size:11px;color:var(--slate)}
.wh-feed .row:last-child{border-bottom:none}
.wh-feed .tg{font-family:"JetBrains Mono",monospace;font-size:9.5px;background:var(--bg-blue);color:var(--primary);padding:2px 6px;border-radius:4px;font-weight:600}
.wh-feed .tg.warn{background:var(--sector-soft);color:var(--sector)}

/* Sections */
section{padding:110px 0}
.section-head{max-width:780px;margin:0 auto 64px;text-align:center}
.section-head.left{margin-left:0;text-align:left}
.section-head h2{margin-top:18px}
.section-head p{font-size:18px;margin-top:18px}

/* Pain points */
.pains{background:var(--bg-soft)}
.pain-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:20px}
.pain-card{background:#fff;border:1px solid var(--border-soft);border-radius:var(--radius-lg);padding:30px 26px;transition:all .25s;position:relative;overflow:hidden}
.pain-card:hover{transform:translateY(-3px);box-shadow:var(--shadow)}
.pain-card::before{
  content:"";position:absolute;top:0;left:0;right:0;height:3px;background:var(--sector);opacity:0;transition:opacity .25s;
}
.pain-card:hover::before{opacity:1}
.pain-card .qty{
  font-family:"JetBrains Mono",monospace;font-size:32px;font-weight:700;color:var(--sector);
  line-height:1;margin-bottom:14px;
}
.pain-card h3{font-size:17px;margin-bottom:10px}
.pain-card p{font-size:13.5px;line-height:1.6}

/* Solution mapping */
.solution{position:relative;background:#fff}
.sol-map{
  display:grid;grid-template-columns:1fr 1.4fr 1fr;gap:40px;align-items:stretch;
  background:linear-gradient(180deg,#FFF,#FAFBFE);
  border:1px solid var(--border);border-radius:var(--radius-lg);
