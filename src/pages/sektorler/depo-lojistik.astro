---
import Base from '../../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Depo ve Lojistik RFID Çözümleri",
  "provider": { "@type": "Organization", "name": "Altis Teknoloji" },
  "serviceType": "Warehouse and logistics automation",
  "areaServed": "TR",
  "description": "RFID, Auto-ID, WMS entegrasyonu, depo görünürlüğü ve lojistik operasyon optimizasyonu çözümleri"
};
---

<Base
  title="Depo ve Lojistik için RFID Çözümleri | Altis Teknoloji"
  description="Depo ve lojistik operasyonları için RFID kapı geçişleri, palet doğrulama, hızlı sayım, WMS entegrasyonu ve canlı operasyon dashboard çözümleri."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/sectors/warehouse-logistics/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/sektorler/depo-lojistik/">Sektörler</a>
      <span class="sep">/</span>
      <span style="color:var(--sector);font-weight:600">Depo &amp; Lojistik</span>
    </div>
    <div class="hero-inner">
      <div>
        <div class="sector-pill">
          <span class="pill-tag">Sektör</span>
          <span>Depo · Lojistik · Sevkiyat · Stok Yönetimi</span>
        </div>
        <h1>Stok doğruluğu, sevkiyat hızı ve depo görünürlüğü — <em>gerçek zamanlı.</em></h1>
        <p class="hero-sub">RFID kapı geçişleri, palet bazlı doğrulama, koridor sayımı ve WMS entegrasyonuyla depo operasyonlarınızı saatlerden saniyelere indirir. Tag&amp;Trace ve Predictivo platformlarımız, sahadaki cihazları kurumsal sistemlerinize görünür, izlenebilir ve güvenilir bir köprüyle bağlar.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/iletisim/">Depo Demosu Talep Et
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#use-cases">Senaryoları İncele</a>
        </div>
        <div class="hero-platforms">
          <span class="lbl">Kullanılan platformlar:</span>
          <a href="/platformlar/tag-trace/" class="plat-chip tt">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/></svg>
            Tag&amp;Trace
          </a>
          <a href="/platformlar/predictivo/" class="plat-chip pr">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
            Predictivo
          </a>
        </div>
      </div>

      <!-- Hero visual: Live warehouse -->
      <div class="warehouse">
        <div class="wh-head">
          <div class="ttl">Depo · İstanbul Hadımköy</div>
          <div class="meta">
            <span class="live">canlı</span>
            <span>12 047 SKU</span>
          </div>
        </div>
        <div class="wh-body">
          <div class="wh-grid">
            <!-- Row 1: Sevkiyat kapıları (top) -->
            <div class="wh-door" style="grid-column:span 2">DOOR-A</div>
            <div class="wh-aisle" style="grid-column:span 4"></div>
            <div class="wh-door" style="grid-column:span 2">DOOR-B</div>

            <!-- Row 2: rack rows + reader -->
            <div class="wh-rack full">A1</div>
            <div class="wh-rack full">A2</div>
            <div class="wh-rack half">A3</div>
            <div class="wh-rack empty">A4</div>
            <div class="wh-rack full">A5</div>
            <div class="wh-rack full">A6</div>
            <div class="wh-rack alarm">A7</div>
            <div class="wh-rack full">A8</div>

            <!-- Row 3 -->
            <div class="wh-rack full">B1</div>
            <div class="wh-rack half">B2</div>
            <div class="wh-rack full">B3</div>
            <div class="wh-rack full">B4</div>
            <div class="wh-rack empty">B5</div>
            <div class="wh-rack full">B6</div>
            <div class="wh-rack full">B7</div>
            <div class="wh-rack half">B8</div>

            <!-- Row 4: aisle -->
            <div class="wh-aisle" style="grid-column:span 8"></div>

            <!-- Row 5 -->
            <div class="wh-rack full">C1</div>
            <div class="wh-rack full">C2</div>
            <div class="wh-rack full">C3</div>
            <div class="wh-rack empty">C4</div>
            <div class="wh-rack full">C5</div>
            <div class="wh-rack full">C6</div>
            <div class="wh-rack half">C7</div>
            <div class="wh-rack full">C8</div>

            <!-- Row 6: Toplama -->
            <div class="wh-rack" style="grid-column:span 3;background:#FAFBFE;color:var(--text-muted)">Toplama Alanı</div>
            <div class="wh-rack" style="grid-column:span 3;background:#FAFBFE;color:var(--text-muted)">Paketleme</div>
            <div class="wh-rack" style="grid-column:span 2;background:#FAFBFE;color:var(--text-muted)">Sayım</div>

            <!-- RFID readers positioned at doors -->
            <div class="rfid-reader" style="left:8%;top:8px">R</div>
            <div class="rfid-reader b" style="right:8%;top:8px">R</div>
          </div>

          <div class="wh-feed">
            <h6>Son okumalar</h6>
            <div class="row"><span class="tg">A2</span><span style="flex:1">Palet IN</span></div>
            <div class="row"><span class="tg">B7</span><span style="flex:1">Palet OUT</span></div>
            <div class="row"><span class="tg warn">A7</span><span style="flex:1">Eksik koli</span></div>
            <div class="row"><span class="tg">DOOR-B</span><span style="flex:1">SHIP-04812</span></div>
            <div class="row"><span class="tg">C5</span><span style="flex:1">Sayım OK</span></div>
          </div>

          <div class="wh-side">
            <div class="wh-kpi"><div class="l">Doluluk</div><div class="v ok">73%</div></div>
            <div class="wh-kpi"><div class="l">Bugün IN</div><div class="v">1 482</div></div>
            <div class="wh-kpi"><div class="l">Bugün OUT</div><div class="v">1 308</div></div>
            <div class="wh-kpi"><div class="l">Anlık alarm</div><div class="v warn">2</div></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pain points -->
<section class="pains">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Depo Operasyonlarında</div>
      <h2>Tanıdık geliyor mu?</h2>
      <p>Modern depo operasyonlarında küçük sürtünmeler büyük maliyetler doğurur. Bu sürtünmelerin çoğu, sahadaki cihazlarla kurumsal sistemler arasındaki kopukluktan kaynaklanır.</p>
    </div>
    <div class="pain-grid">
      <div class="pain-card">
        <div class="qty">↓ %92</div>
        <h3>Stok doğruluğu</h3>
        <p>Manuel sayım ve barkod taramayla yapılan envanter güncellemeleri gerçek depo durumuyla saatlerce uyumsuz kalır.</p>
      </div>
      <div class="pain-card">
        <div class="qty">∼ 2sa</div>
        <h3>Sevkiyat doğrulama</h3>
        <p>Yanlış veya eksik ürün ancak alıcıdan dönüş gelince fark edilir. Hatalı sevkiyat, iade maliyeti ve müşteri kaybı.</p>
      </div>
      <div class="pain-card">
        <div class="qty">× N</div>
        <h3>Dağınık cihazlar</h3>
        <p>El terminali, kapı okuyucusu, yazıcı, sayım cihazı — her biri farklı arayüz, farklı kullanım, farklı destek hattı.</p>
      </div>
      <div class="pain-card">
        <div class="qty">~ 0</div>
        <h3>Anlık görünürlük</h3>
        <p>Yöneticiler depo durumunu gece raporlarından öğrenir. Problem fark edildiğinde aksiyon almak için çok geç olur.</p>
      </div>
    </div>
  </div>
</section>

<!-- Solution mapping: Sektör → Platform -->
<section class="solution">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Çözüm Haritası</div>
      <h2>Depodaki ihtiyaç, doğru platform</h2>
      <p>Depo operasyonunun farklı parçaları farklı yetenekler ister. Tag&amp;Trace cihaz orkestrasyonu ve etiketleme tarafını, Predictivo görünürlük ve operasyon zekâsı tarafını üstlenir.</p>
    </div>
    <div class="sol-map">
      <div class="sol-col">
        <h4>İhtiyaç</h4>
        <div class="group">
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9h18v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><path d="M3 9 5 4h14l2 5"/></svg>Sevkiyat doğrulama</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/></svg>Palet &amp; SKU sayım</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="9" rx="2"/><path d="M6 9V5h12v4"/></svg>RFID etiket basımı</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg>Konum &amp; bölge takibi</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg>Operasyon dashboard'ı</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg>Alarm &amp; eşik yönetimi</div>
        </div>
      </div>
      <div class="sol-col sol-platform">
        <div class="plat-card">
          <div class="nm">Tag&amp;Trace</div>
          <div class="role">Cihaz orkestrasyonu &amp; veri akışı</div>
          <ul>
            <li>RFID okuyucu, yazıcı, barkod, el terminali yönetimi</li>
            <li>ZPL etiket şablonları · ERP'den dinamik baskı</li>
            <li>Görsel kural motoru · edge processing</li>
            <li>WMS / ERP / SAP çift yönlü entegrasyon</li>
          </ul>
        </div>
        <div class="plat-card pred">
          <div class="nm">Predictivo</div>
          <div class="role">Görünürlük, dashboard &amp; analitik</div>
          <ul>
            <li>Canlı depo dashboard'ları · rol bazlı</li>
            <li>Alarm, bildirim ve eşik yönetimi</li>
            <li>RTLS ve bölge bazlı konum takibi</li>
            <li>Günlük / haftalık otomatik PDF rapor</li>
          </ul>
        </div>
      </div>
      <div class="sol-col">
        <h4>Sonuç</h4>
        <div class="group">
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Hatasız sevkiyat</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>%99+ stok doğruluğu</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Manuel iş yükü ↓</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Anlık operasyon görünümü</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>WMS / ERP eşitliği</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Hızlı sayım · saatlerden dakikalara</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Use cases (sector-specific) -->
<section class="uc" id="use-cases">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Depo Senaryoları</div>
      <h2>Depo operasyonu için 6 uygulanabilir çözüm</h2>
      <p>Bu senaryolar farklı sektörlerdeki depo operasyonlarına uyarlanır. Her biri pilot olarak başlatılabilir, ölçeklenebilir bir yapıdadır.</p>
    </div>
    <div class="uc-grid">
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M9 9h6v6H9z"/></svg></div>
        <h3>RFID Kapı Geçiş Doğrulama</h3>
        <p>Sevkiyat kapısında sabit RFID anteni; sipariş bazlı tüm ürünleri saniyeler içinde okur. Eksik veya yanlış kalemde anlık uyarı, doğru sevkiyatta otomatik onay.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">%99.5</div><div class="l">okuma doğruluğu</div></div>
          <div class="m"><div class="v">&lt;3sn</div><div class="l">palet okuma</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg></div>
        <h3>Palet ve Koli Bazlı İzlenebilirlik</h3>
        <p>Her palet ve koli için RFID etiketi; deponun her noktasında anlık konum bilgisi. Sevkiyat, depolama ve toplama süreçlerinde manuel takip ihtiyacı sıfıra iner.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">RT</div><div class="l">canlı konum</div></div>
          <div class="m"><div class="v">×3</div><div class="l">toplama hızı</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h20v4H2zM2 13h20v4H2zM2 19h20"/></svg></div>
        <h3>Hızlı Stok Sayımı</h3>
        <p>El RFID terminaliyle koridor geçişlerinde tüm raflar saniyeler içinde okunur. Aylık sayım operasyonu saatlerden dakikalara iner; mağaza-depo aktarımları kolaylaşır.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">×20</div><div class="l">sayım hızı</div></div>
          <div class="m"><div class="v">%100</div><div class="l">izlenebilirlik</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="9" width="18" height="9" rx="2"/><path d="M6 9V5h12v4M6 18v2h12v-2"/></svg></div>
        <h3>Otomatik Etiketleme</h3>
        <p>WMS veya ERP'den gelen sipariş verisi ile RFID ve barkod etiketleri otomatik basılır. EPC kodlama, doğrulama, baskı kuyruğu — hepsi platform tarafında.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">0</div><div class="l">manuel veri girişi</div></div>
          <div class="m"><div class="v">ZPL</div><div class="l">standart şablon</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0z"/><circle cx="12" cy="10" r="3"/></svg></div>
        <h3>RTLS · Forklift &amp; Ekipman Takibi</h3>
        <p>Forklift, transpalet ve önemli ekipmanların gerçek zamanlı konumu. Çalışma süreleri, bölge ihlalleri, atıl ekipman dağılımı şeffaflaşır.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">RT</div><div class="l">canlı izleme</div></div>
          <div class="m"><div class="v">Geo</div><div class="l">bölge alarmı</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg></div>
        <h3>Operasyon Dashboard'ı</h3>
        <p>Doluluk, in/out, kapı yoğunluğu, sayım performansı — depo müdürü için canlı bir kontrol odası. Mobilde, tabletde ve duvar ekranında aynı kalite.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">Live</div><div class="l">canlı yayın</div></div>
          <div class="m"><div class="v">Rol</div><div class="l">bazlı görünüm</div></div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Operations flow -->
<section class="opflow">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Operasyonda Tipik Akış</div>
      <h2>Mal kabulden sevkiyata, beş adımda</h2>
      <p>Bir RFID destekli depoda tipik bir kolinin yolculuğu. Her adımda doğru cihaz, doğru veri ve doğru sistem entegrasyonu çalışır.</p>
    </div>
    <div class="op-steps">
      <div class="op-step">
        <div class="step-num">01</div>
        <h4>Mal Kabul</h4>
        <p>Gelen koli sevkiyat kapısında RFID anteniyle okunur; sipariş verisiyle doğrulanır.</p>
        <span class="device">RFID Reader · WMS</span>
      </div>
      <div class="op-step">
        <div class="step-num">02</div>
        <h4>Etiketleme</h4>
        <p>Eksik etiket varsa veya yeniden etiketleme gerekiyorsa otomatik RFID etiket basılır.</p>
        <span class="device">RFID Printer · ZPL</span>
      </div>
      <div class="op-step">
        <div class="step-num">03</div>
        <h4>Yerleştirme</h4>
        <p>El terminali rafa yerleşim bilgisini WMS'e iletir; konum güncellenir.</p>
        <span class="device">Mobil RFID · WMS</span>
      </div>
      <div class="op-step">
        <div class="step-num">04</div>
        <h4>Toplama</h4>
        <p>Sipariş bazlı toplama listesi; her okuma siparişle eşleşir, yanlış ürün alarm verir.</p>
        <span class="device">Mobil RFID · Rule</span>
      </div>
      <div class="op-step">
        <div class="step-num">05</div>
        <h4>Sevkiyat</h4>
        <p>Kapıdan çıkarken son doğrulama; eksik ürün varsa otomatik uyarı, doğruysa ERP'ye onay.</p>
        <span class="device">RFID Reader · ERP</span>
      </div>
    </div>
  </div>
</section>

<!-- ROI -->
<section class="roi">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Beklenen Etki</div>
      <h2>RFID destekli depo, ölçülebilir kazanç</h2>
      <p>Pilot projelerde gözlemlenen tipik operasyonel iyileşmeler. Sonuçlar saha koşullarına, ürün karakteristiğine ve mevcut operasyon olgunluğuna göre farklılaşır.</p>
    </div>
    <div class="roi-grid">
      <div class="roi-card">
        <div class="b">×20<sup></sup></div>
        <div class="lbl">Sayım hızı</div>
        <div class="meta">Aylık envanter sayımı saatlerden dakikalara iner; rutin sayım haftalık veya günlüğe çekilebilir.</div>
      </div>
      <div class="roi-card">
        <div class="b">%99<sup>+</sup></div>
        <div class="lbl">Stok doğruluğu</div>
        <div class="meta">Otomatik okuma ve sürekli doğrulama, WMS ile gerçek depo arasındaki sapmayı sıfıra yaklaştırır.</div>
      </div>
      <div class="roi-card">
        <div class="b">↓ 40<sup>%</sup></div>
        <div class="lbl">Hatalı sevkiyat</div>
        <div class="meta">Sevkiyat kapısında otomatik doğrulama, yanlış ürün ve eksik kolinin alıcıya ulaşmadan tespiti.</div>
      </div>
      <div class="roi-card">
        <div class="b">↓ 30<sup>%</sup></div>
        <div class="lbl">Manuel iş yükü</div>
        <div class="meta">Manuel kayıt, sayım ve doğrulama adımlarının otomatikleşmesiyle saha personeli katma değerli işe odaklanır.</div>
      </div>
    </div>
  </div>
</section>

<!-- WMS / ERP integration -->
