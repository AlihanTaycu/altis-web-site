<style>
:root{
  --navy-900:#000A3A;--navy-800:#00125C;--navy-700:#0A1E75;
  --bg:#FFFFFF;--bg-soft:#F6F8FC;--bg-blue:#EEF3FF;
  --text:#111827;--text-muted:#5F6675;--text-faint:#8A93A5;
  --border:#E3E8F2;--border-soft:#EEF1F7;
  --cyan:#18B7D6;--cyan-soft:#E8FAFD;
  --steel:#8B95A5;--slate:#334155;
  --ok:#15a06b;--warn:#c47700;--crit:#d64545;
  --primary:var(--navy-800);
  /* Üretim sector — petrol/teal, aligns with Predictivo */
  --sector:#0F8FA8;
  --sector-deep:#0A6A7E;
  --sector-soft:#E3F5FA;
  --sector-glow:rgba(15,143,168,.18);
  --radius:14px;--radius-lg:22px;
  --shadow-sm:0 1px 2px rgba(0,18,92,.04);
  --shadow:0 8px 28px -12px rgba(0,18,92,.18),0 2px 6px rgba(0,18,92,.05);
  --shadow-lg:0 30px 60px -25px rgba(0,18,92,.28),0 8px 20px -8px rgba(0,18,92,.12);
  --container:1240px;
}
*,*::before,*::after{box-sizing:border-box}
html,body{margin:0;padding:0}
body{font-family:"Inter",system-ui,sans-serif;color:var(--text);background:var(--bg);-webkit-font-smoothing:antialiased;line-height:1.55}
img{max-width:100%;display:block}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:none;background:none}
.container{max-width:var(--container);margin:0 auto;padding:0 32px}
.eyebrow{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--sector-deep);display:inline-flex;align-items:center;gap:10px}
.eyebrow::before{content:"";width:24px;height:1px;background:var(--sector)}
h1,h2,h3,h4{font-family:inherit;color:var(--navy-800);margin:0;letter-spacing:-.02em;line-height:1.15;text-wrap:balance}
h1{font-size:clamp(40px,5vw,68px);font-weight:700}
h2{font-size:clamp(30px,3.2vw,44px);font-weight:700;letter-spacing:-.025em}
h3{font-size:20px;font-weight:600}
h4{font-size:16px;font-weight:600}
p{margin:0;color:var(--text-muted);text-wrap:pretty}

/* Header */
.site-header{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.82);backdrop-filter:saturate(180%) blur(14px);border-bottom:1px solid var(--border-soft)}
.nav{display:flex;align-items:center;justify-content:space-between;height:76px}
.logo{display:flex;align-items:center;gap:12px}
.logo img{height:30px;width:auto}
.nav-links{display:flex;align-items:center;gap:36px}
.nav-links a{font-size:14.5px;color:var(--text);font-weight:500}
.nav-links a:hover{color:var(--primary)}
.btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;padding:12px 22px;font-weight:600;font-size:14.5px;border-radius:10px;transition:all .2s;white-space:nowrap}
.btn-primary{background:var(--primary);color:#fff;box-shadow:0 6px 20px -10px rgba(0,18,92,.6)}
.btn-primary:hover{transform:translateY(-1px)}
.btn-secondary{background:transparent;color:var(--primary);border:1px solid var(--border)}
.btn-secondary:hover{background:var(--bg-soft)}
.btn-lg{padding:16px 28px;font-size:15.5px;border-radius:12px}

/* Breadcrumb */
.breadcrumb{padding:24px 0 0;font-size:13px;color:var(--text-faint);display:flex;align-items:center;gap:10px;position:relative;z-index:2}
.breadcrumb a{color:var(--text-muted)}
.breadcrumb a:hover{color:var(--primary)}
.breadcrumb .sep{opacity:.5}

/* Hero */
.hero{
  position:relative;padding:48px 0 120px;overflow:hidden;
  background:
    radial-gradient(900px 500px at 80% -100px, rgba(15,143,168,.10), transparent 60%),
    linear-gradient(180deg,#fff 0%,#FAFBFE 100%);
}
.hero-grid-bg{
  position:absolute;inset:0;pointer-events:none;opacity:.35;
  background-image:linear-gradient(rgba(0,18,92,.045) 1px, transparent 1px),linear-gradient(90deg, rgba(0,18,92,.045) 1px, transparent 1px);
  background-size:64px 64px;
  -webkit-mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
          mask-image:radial-gradient(ellipse at center, #000 30%, transparent 75%);
}
.hero-inner{position:relative;display:grid;grid-template-columns:1.05fr 1.05fr;gap:56px;align-items:center;margin-top:32px}
.sector-pill{display:inline-flex;align-items:center;gap:10px;padding:7px 14px 7px 8px;border-radius:999px;background:#fff;border:1px solid var(--border);font-size:12.5px;font-weight:600;color:var(--slate);box-shadow:var(--shadow-sm)}
.sector-pill .pill-tag{background:var(--sector);color:#fff;font-size:11px;letter-spacing:.08em;padding:3px 9px;border-radius:999px;text-transform:uppercase}
.hero h1{margin-top:24px}
.hero h1 em{color:var(--sector);font-style:normal}
.hero-sub{font-size:18px;color:var(--text-muted);margin-top:22px;max-width:540px;line-height:1.6}
.hero-cta{display:flex;gap:12px;margin-top:32px;flex-wrap:wrap}
.hero-platforms{display:flex;gap:8px;margin-top:40px;padding-top:32px;border-top:1px solid var(--border-soft);align-items:center;max-width:540px;flex-wrap:wrap}
.hero-platforms .lbl{font-size:11px;color:var(--text-faint);text-transform:uppercase;letter-spacing:.08em;font-weight:600;margin-right:6px}
.plat-chip{font-size:12.5px;font-weight:600;padding:6px 12px;border-radius:7px;display:inline-flex;align-items:center;gap:6px}
.plat-chip.pr{background:var(--sector-soft);color:var(--sector-deep)}
.plat-chip.tt{background:var(--bg-blue);color:var(--primary)}

/* Hero visual — production line dashboard */
.factory{
  background:#fff;border:1px solid var(--border);border-radius:var(--radius-lg);
  box-shadow:var(--shadow-lg);overflow:hidden;position:relative;
}
.fac-head{padding:14px 18px;border-bottom:1px solid var(--border-soft);background:#FCFCFE;display:flex;justify-content:space-between;align-items:center}
.fac-head .ttl{font-weight:600;font-size:13px;color:var(--navy-800)}
.fac-head .meta{font-family:"JetBrains Mono",monospace;font-size:11px;color:var(--text-faint);display:flex;gap:10px;align-items:center}
.fac-head .live{display:inline-flex;align-items:center;gap:5px;color:var(--ok);font-weight:600}
.fac-head .live::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--ok);box-shadow:0 0 0 0 rgba(21,160,107,.5);animation:pulse 2s infinite}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(21,160,107,.5)}70%{box-shadow:0 0 0 8px rgba(21,160,107,0)}100%{box-shadow:0 0 0 0 rgba(21,160,107,0)}}

.fac-body{padding:18px;background:linear-gradient(180deg,#FAFBFE,#fff);display:grid;grid-template-columns:1fr 1fr 1fr;grid-template-rows:auto auto auto;gap:12px}
.fac-kpi{background:#fff;border:1px solid var(--border-soft);border-radius:10px;padding:12px 14px}
.fac-kpi .l{font-size:10px;color:var(--text-faint);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.fac-kpi .v{font-family:"JetBrains Mono",monospace;font-size:20px;font-weight:700;color:var(--navy-800);margin-top:3px}
.fac-kpi .v.ok{color:var(--ok)}
.fac-kpi .v.warn{color:var(--warn)}
.fac-kpi .trend{font-size:10px;color:var(--text-muted);margin-top:2px;font-weight:600}
.fac-kpi .trend.up{color:var(--ok)}
.fac-kpi .trend.dn{color:var(--crit)}

.fac-line{grid-column:1/-1;background:#0F0F14;border-radius:10px;padding:18px;position:relative}
.fac-line .head{display:flex;justify-content:space-between;align-items:center;color:#fff;font-size:11px;margin-bottom:14px;font-weight:600}
.fac-line .head .right{font-family:"JetBrains Mono",monospace;color:rgba(255,255,255,.5);font-size:10px;font-weight:500}
.fac-stations{position:relative;display:grid;grid-template-columns:repeat(5,1fr) 28px;gap:8px;align-items:center}
.station{
  background:linear-gradient(180deg,#1a1a22,#0a0a0e);border:1px solid rgba(255,255,255,.08);
  border-radius:8px;padding:10px;text-align:center;position:relative;
}
.station .name{font-family:"JetBrains Mono",monospace;font-size:10px;color:rgba(255,255,255,.7);font-weight:600;letter-spacing:.04em}
.station .ring{position:relative;width:42px;height:42px;margin:8px auto 4px}
.station .ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.station .ring .bg{fill:none;stroke:rgba(255,255,255,.08);stroke-width:5}
.station .ring .fg{fill:none;stroke-width:5;stroke-linecap:round}
.station .pct{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:"JetBrains Mono",monospace;font-size:11px;font-weight:700;color:#fff}
.station.ok .ring .fg{stroke:#7ED957}
.station.ok .pct{color:#7ED957}
.station.warn .ring .fg{stroke:#FFB94A}
.station.warn .pct{color:#FFB94A}
.station.crit .ring .fg{stroke:#FF6B6B}
.station.crit .pct{color:#FF6B6B}
.station.crit::after{
  content:"";position:absolute;top:-3px;right:-3px;width:10px;height:10px;border-radius:50%;background:#FF6B6B;
  box-shadow:0 0 8px #FF6B6B;animation:pulse-r 1.2s infinite;
}
@keyframes pulse-r{0%,100%{opacity:1}50%{opacity:.4}}
.station .label{font-size:9px;color:rgba(255,255,255,.5);font-weight:500;margin-top:2px}
.belt-arrow{color:var(--sector);font-size:18px;text-align:center;font-weight:bold;display:flex;align-items:center;justify-content:center;height:100%}
.belt-arrow svg{animation:slide 1.6s linear infinite}
@keyframes slide{0%{opacity:.4;transform:translateX(-4px)}50%{opacity:1}100%{opacity:.4;transform:translateX(4px)}}

.fac-chart{
