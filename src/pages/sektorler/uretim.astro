            <div class="center" style="border-color:var(--cyan);color:var(--cyan)">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/></svg>
            </div>
            <div class="right">
              <strong>Alarm tetiklendi</strong>
              <div class="meta">kritik · bakım kanalı</div>
            </div>
          </div>
          <div class="chain-link"></div>
          <div class="chain-step">
            <div class="left">
              <strong>CMMS / İş emri</strong>
              <div class="meta">webhook</div>
            </div>
            <div class="center">
