---
import Base from '../../layouts/Base.astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "Üretim IoT ve Operasyonel Zekâ Çözümleri",
  "provider": { "@type": "Organization", "name": "Altis Teknoloji" },
  "serviceType": "Manufacturing IoT and operational intelligence",
  "areaServed": "TR",
  "description": "Üretim tesisleri için OEE, kestirimci bakım, enerji izleme, üretim izlenebilirliği, SCADA, MES ve ERP entegrasyonu çözümleri"
};
---

<Base
  title="Üretim için IoT ve Operasyonel Zekâ Çözümleri | Altis Teknoloji"
  description="Üretim tesisleri için canlı OEE, kestirimci bakım, enerji izleme, üretim izlenebilirliği, SCADA/MES/ERP entegrasyonu ve operasyonel zekâ çözümleri."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/sectors/manufacturing/"
>
<!-- Hero -->
<section class="hero">
  <div class="hero-grid-bg"></div>
  <div class="container">
    <div class="breadcrumb">
      <a href="/">Ana Sayfa</a>
      <span class="sep">/</span>
      <a href="/sektorler/uretim/">Sektörler</a>
      <span class="sep">/</span>
      <span style="color:var(--sector);font-weight:600">Üretim</span>
    </div>
    <div class="hero-inner">
      <div>
        <div class="sector-pill">
          <span class="pill-tag">Sektör</span>
          <span>Fabrika · Üretim Hattı · Bakım · Enerji</span>
        </div>
        <h1>Hat verimliliğini, makine sağlığını ve enerjiyi — <em>aynı ekranda</em> görün.</h1>
        <p class="hero-sub">Sensör, PLC, SCADA ve enerji sayaçlarından gelen veriler Predictivo'da tek operasyon zekâsı katmanında birleşir. OEE skorları, kestirimci bakım uyarıları, hat performansı ve enerji tüketimi gerçek zamanlı izlenir; alarm ve aksiyonlar görsel kural motoruyla otomatikleşir.</p>
        <div class="hero-cta">
          <a class="btn btn-primary btn-lg" href="/iletisim/">Fabrika Demosu Talep Et
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a class="btn btn-secondary btn-lg" href="#use-cases">Senaryoları İncele</a>
        </div>
        <div class="hero-platforms">
          <span class="lbl">Kullanılan platformlar:</span>
          <a href="/platformlar/predictivo/" class="plat-chip pr">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M3 12h4l3-9 4 18 3-9h4"/></svg>
            Predictivo
          </a>
          <a href="/platformlar/tag-trace/" class="plat-chip tt">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M4 11a9 9 0 0 1 9 9"/><path d="M4 4a16 16 0 0 1 16 16"/></svg>
            Tag&amp;Trace
          </a>
        </div>
      </div>

      <!-- Hero visual: factory line dashboard -->
      <div class="factory">
        <div class="fac-head">
          <div class="ttl">Tesis · Hat 02 · Vardiya B</div>
          <div class="meta">
            <span class="live">canlı</span>
            <span>08:14 · 4sa 14dk</span>
          </div>
        </div>
        <div class="fac-body">
          <div class="fac-kpi">
            <div class="l">OEE</div>
            <div class="v ok">82.4%</div>
            <div class="trend up">▲ 3.2 dün</div>
          </div>
          <div class="fac-kpi">
            <div class="l">Çıktı / saat</div>
            <div class="v">412</div>
            <div class="trend up">hedef 400</div>
          </div>
          <div class="fac-kpi">
            <div class="l">Aktif Alarm</div>
            <div class="v warn">2</div>
            <div class="trend dn">1 kritik · 1 uyarı</div>
          </div>

          <!-- Production line stations -->
          <div class="fac-line">
            <div class="head">
              <span>Hat 02 · İstasyon Sağlığı</span>
              <span class="right">canlı · vibrasyon · ısı · OEE</span>
            </div>
            <div class="fac-stations">
              <div class="station ok">
                <div class="name">CNC-01</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="16"/></svg>
                  <div class="pct">86</div>
                </div>
                <div class="label">İşleme</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station warn">
                <div class="name">CNC-02</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="56"/></svg>
                  <div class="pct">50</div>
                </div>
                <div class="label">Vibrasyon ↑</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station crit">
                <div class="name">WELD-03</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="85"/></svg>
                  <div class="pct">25</div>
                </div>
                <div class="label">Bakım önerisi</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station ok">
                <div class="name">QC-04</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="11"/></svg>
                  <div class="pct">90</div>
                </div>
                <div class="label">Kalite</div>
              </div>
              <div class="belt-arrow"><svg width="20" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
              <div class="station ok">
                <div class="name">PACK-05</div>
                <div class="ring">
                  <svg viewBox="0 0 44 44"><circle class="bg" cx="22" cy="22" r="18"/><circle class="fg" cx="22" cy="22" r="18" stroke-dasharray="113" stroke-dashoffset="22"/></svg>
                  <div class="pct">80</div>
                </div>
                <div class="label">Paketleme</div>
              </div>
              <div class="belt-arrow"><svg width="14" height="14" viewBox="0 0 20 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 7h14M11 2l5 5-5 5"/></svg></div>
            </div>
          </div>

          <!-- Energy chart -->
          <div class="fac-chart">
            <div class="head">
              <h5>Enerji Tüketimi · son 12 saat</h5>
              <span class="meta">142 kWh · ▼ 7%</span>
            </div>
            <svg viewBox="0 0 320 60" preserveAspectRatio="none">
              <defs>
                <linearGradient id="g-energy" x1="0" y1="0" x2="0" y2="1">
                  <stop offset="0%" stop-color="#0F8FA8" stop-opacity=".4"/>
                  <stop offset="100%" stop-color="#0F8FA8" stop-opacity="0"/>
                </linearGradient>
              </defs>
              <path d="M0,45 L26,38 L52,40 L78,25 L104,32 L130,18 L156,24 L182,12 L208,22 L234,8 L260,18 L286,10 L320,16 L320,60 L0,60 Z" fill="url(#g-energy)"/>
              <path d="M0,45 L26,38 L52,40 L78,25 L104,32 L130,18 L156,24 L182,12 L208,22 L234,8 L260,18 L286,10 L320,16" stroke="#0F8FA8" stroke-width="2" fill="none" stroke-linecap="round"/>
              <circle cx="320" cy="16" r="3" fill="#fff" stroke="#0F8FA8" stroke-width="2"/>
            </svg>
          </div>

          <!-- Alarm strip -->
          <div class="alarm-strip">
            <span class="sev">Kritik</span>
            <span class="txt"><strong>WELD-03</strong> · Titreşim eşik aşımı 4.8 mm/s — iş emri oluşturuldu</span>
            <span class="t">2dk önce</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Pain points -->
<section class="pains">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Üretim Operasyonlarında</div>
      <h2>Tanıdık geliyor mu?</h2>
      <p>Modern üretim hatlarında veri her yerdedir — ama doğru zamanda doğru kişiye ulaşmaz. Bu kopukluk planlı olmayan duruşa, kalite sorununa ve enerji israfına dönüşür.</p>
    </div>
    <div class="pain-grid">
      <div class="pain-card">
        <div class="qty">∼ %30</div>
        <h3>Görünmeyen OEE kaybı</h3>
        <p>Mevcudiyet, performans ve kalite — üçü birden ölçülmediğinde gerçek verimlilik raporlardan görünmez; iyileştirme tahmine kalır.</p>
      </div>
      <div class="pain-card">
        <div class="qty">× Saat</div>
        <h3>Beklenmedik duruşlar</h3>
        <p>Makine titreşimi, ısısı veya akımı bir gün önce sinyal verir ama kimse görmez. Arıza vardiya ortasında patlar; planlı bakıma çekilebilirdi.</p>
      </div>
      <div class="pain-card">
        <div class="qty">↑ kWh</div>
        <h3>Şeffaf olmayan enerji</h3>
        <p>Aylık fatura toplam tutarı söyler; hangi hat, hangi vardiya, hangi ürün başına ne kadar enerji tüketildiği görünmez.</p>
      </div>
      <div class="pain-card">
        <div class="qty">~ Manuel</div>
        <h3>Excel'e yazılan kayıt</h3>
        <p>Operatör vardiya sonunda Excel'e veri girer; rapor bir gün sonra çıkar. Problem fark edildiğinde aksiyon almak için çoktan geçtir.</p>
      </div>
    </div>
  </div>
</section>

<!-- Solution mapping -->
<section class="solution">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Çözüm Haritası</div>
      <h2>Üretimde her veri kaynağı, doğru platform</h2>
      <p>Üretim ekosistemindeki farklı veri kaynakları farklı yetenekler ister. Predictivo IoT ve operasyonel zekâ tarafını; Tag&amp;Trace üretim hattındaki ürün izlenebilirliği tarafını üstlenir.</p>
    </div>
    <div class="sol-map">
      <div class="sol-col">
        <h4>İhtiyaç</h4>
        <div class="group">
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg>OEE &amp; hat performansı</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12h3M18 12h3M12 3v3M12 18v3"/><circle cx="12" cy="12" r="4"/></svg>Makine sağlığı &amp; kestirimci bakım</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg>Enerji izleme &amp; verimlilik</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg>Ortam sensörü (ısı, nem, CO₂)</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v4H4zM4 12h16v4H4zM4 20h10"/><circle cx="18" cy="20" r="2"/></svg>Üretim izlenebilirliği</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><path d="M7 14l3-3 3 3 4-5"/></svg>Yönetim dashboard'ları &amp; raporlar</div>
        </div>
      </div>
      <div class="sol-col sol-platform">
        <div class="plat-card">
          <div class="nm">Predictivo</div>
          <div class="role">Industrial IoT &amp; Operational Intelligence</div>
          <ul>
            <li>OEE, makine sağlığı, enerji canlı izleme</li>
            <li>Görsel kural motoru · alarm &amp; bildirim</li>
            <li>MQTT · OPC UA · Modbus · SCADA bağlantısı</li>
            <li>Otomatik PDF raporlar · vardiya karşılaştırma</li>
          </ul>
        </div>
        <div class="plat-card tt">
          <div class="nm">Tag&amp;Trace</div>
          <div class="role">Ürün izlenebilirliği &amp; hat orkestrasyonu</div>
          <ul>
            <li>İstasyon bazlı RFID / barkod okuma</li>
            <li>Operatör, parça, lot izlenebilirliği</li>
            <li>MES / ERP'ye otomatik kayıt</li>
            <li>Etiket basımı · ürün → kalite zinciri</li>
          </ul>
        </div>
      </div>
      <div class="sol-col">
        <h4>Sonuç</h4>
        <div class="group">
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Canlı OEE &amp; performans</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Önceden tespit edilen arıza</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Hat / ürün bazlı enerji</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Lot ↔ kalite izlenebilirliği</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>Vardiya karşılaştırma</div>
          <div class="sol-tile"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="m5 12 5 5 9-11"/></svg>MES / ERP eşitliği</div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Use cases -->
<section class="uc" id="use-cases">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Üretim Senaryoları</div>
      <h2>Fabrika için 6 uygulanabilir çözüm</h2>
      <p>Aşağıdaki senaryolar pilot bir hat veya bir makine grubuyla başlatılabilir; doğrulandıktan sonra tüm tesise yayılır.</p>
    </div>
    <div class="uc-grid">
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="9"/><path d="M12 3v18M3 12h18"/></svg></div>
        <h3>Canlı OEE &amp; Hat Performansı</h3>
        <p>Mevcudiyet · Performans · Kalite üçlüsünden hesaplanan canlı OEE skoru. Vardiya, hat ve ürün bazında karşılaştırılabilir; günlük kayıp dakikalar şeffaflaşır.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">RT</div><div class="l">canlı skor</div></div>
          <div class="m"><div class="v">×N</div><div class="l">vardiya karşılaştırma</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 3v18h18"/><path d="M7 14l3-3 3 3 4-5"/></svg></div>
        <h3>Kestirimci Bakım</h3>
        <p>Titreşim, sıcaklık, akım ve çalışma süresi verileri analiz edilerek arıza riski erken tespit edilir. Eşik aşıldığında otomatik iş emri ve bakım ekibine SMS.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">↓ Duruş</div><div class="l">plansız arıza</div></div>
          <div class="m"><div class="v">Auto</div><div class="l">iş emri</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2 3 14h9l-1 8 10-12h-9z"/></svg></div>
        <h3>Enerji İzleme &amp; Verimlilik</h3>
        <p>Elektrik, gaz, buhar ve hava tüketimi hat, vardiya ve ürün başına şeffaflaşır. Hedef-üstü tüketim anlık olarak yöneticiye uyarı düşer.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">↓ %15</div><div class="l">tipik tasarruf</div></div>
          <div class="m"><div class="v">SKU</div><div class="l">başına maliyet</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16v4H4zM4 12h16v4H4zM4 20h10"/><circle cx="18" cy="20" r="2"/></svg></div>
        <h3>Üretim İzlenebilirliği</h3>
        <p>Her ürünün üretim hattındaki yolculuğu — istasyon, operatör, lot, kalite kontrol — RFID veya barkod ile takip edilir. Geri çağırma ve kök neden analizi saniyeler içinde yapılır.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">Lot</div><div class="l">tam izlenebilirlik</div></div>
          <div class="m"><div class="v">Auto</div><div class="l">kalite kayıt</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="4" y="4" width="16" height="16" rx="2"/><circle cx="12" cy="12" r="3"/></svg></div>
        <h3>Ortam İzleme</h3>
        <p>Üretim alanlarında sıcaklık, nem, CO₂ ve hava kalitesi sürekli izlenir; kritik proseslerde regülasyona uygun otomatik kayıt tutulur.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">7×24</div><div class="l">sürekli kayıt</div></div>
          <div class="m"><div class="v">Audit</div><div class="l">izlenebilir log</div></div>
        </div>
      </article>
      <article class="uc-card">
        <div class="ic"><svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h4"/></svg></div>
        <h3>Yönetim Raporları</h3>
        <p>Günlük operasyon, haftalık performans, aylık enerji ve bakım raporları otomatik PDF olarak yönetim ve operasyon ekipleriyle paylaşılır.</p>
        <div class="uc-impact">
          <div class="m"><div class="v">Auto</div><div class="l">PDF · planlı</div></div>
          <div class="m"><div class="v">Rol</div><div class="l">bazlı dağıtım</div></div>
        </div>
      </article>
    </div>
  </div>
</section>

<!-- Operations flow -->
<section class="opflow">
  <div class="container">
    <div class="section-head">
      <div class="eyebrow">Veri Akışı</div>
      <h2>Saha sensöründen yönetim ekranına, beş adımda</h2>
      <p>Bir titreşim sensörünün ürettiği değerin yönetim toplantısındaki KPI ekranına ulaşana kadar geçtiği yol. Her adımda doğru cihaz, doğru protokol, doğru karar.</p>
    </div>
    <div class="op-steps">
      <div class="op-step">
        <div class="step-num">01</div>
        <h4>Sensör Verisi</h4>
        <p>Titreşim, sıcaklık, akım veya enerji sayacından gerçek zamanlı ölçüm.</p>
        <span class="device">MQTT · Modbus</span>
      </div>
      <div class="op-step">
        <div class="step-num">02</div>
        <h4>Gateway / Edge</h4>
        <p>Veri lokal olarak toplanır, ön-işlenir; offline ağda bile kayıp olmaz.</p>
        <span class="device">Edge Gateway</span>
      </div>
      <div class="op-step">
        <div class="step-num">03</div>
        <h4>Predictivo Core</h4>
        <p>Zaman serisi olarak saklanır; kural motorundan geçer, eşik aşımları işlenir.</p>
        <span class="device">Rule Engine</span>
      </div>
      <div class="op-step">
        <div class="step-num">04</div>
        <h4>Aksiyon</h4>
        <p>Alarm, e-posta, SMS, iş emri veya cihaz tetikleme otomatik tetiklenir.</p>
        <span class="device">Webhook · CMMS</span>
      </div>
      <div class="op-step">
        <div class="step-num">05</div>
        <h4>Dashboard &amp; Rapor</h4>
        <p>Yönetim, üretim ve bakım ekipleri rol bazlı dashboard'larda canlı görür.</p>
        <span class="device">Web · PDF</span>
      </div>
    </div>
  </div>
</section>

<!-- ROI -->
