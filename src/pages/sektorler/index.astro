---
import Base from '../../layouts/Base.astro';
import HubHero from '../../components/sections/HubHero.astro';
import HubCard from '../../components/sections/HubCard.astro';
import CTABanner from '../../components/sections/CTABanner.astro';
import { Warehouse, Store, Factory } from '@lucide/astro';

const schema = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": "Altis Sektörler",
  "description": "Altis Teknoloji sektör çözümleri"
};
---

<Base
  title="Sektörler | Altis Teknoloji"
  description="Depo & lojistik, perakende & tekstil ve üretim için RFID, IoT ve operasyonel zekâ çözümleri."
  {schema}
  lang="tr"
  alternateUrl="https://www.altis.com.tr/en/sectors/"
>
  <HubHero
    eyebrow="Sektörler"
    heading="Her sektör için aynı teknoloji değil, doğru operasyon modeli."
    description="Altis, RFID ve IoT altyapısını sektöre göre kurgular: depoda sevkiyat doğrulama, mağazada stok görünürlüğü, fabrikada OEE ve bakım zekâsı."
  />

  <section class="hub-list">
    <div class="container">
      <div class="featured-row" data-reveal>
        <HubCard
          variant="big"
          href="/sektorler/depo-lojistik/"
          Icon={Warehouse}
          tag="Depo & Lojistik"
          title="Depo & Lojistik"
          desc="RFID kapı geçişi, palet doğrulama, WMS entegrasyonu ve hızlı sayım senaryolarıyla depo operasyonunu uçtan uca görünür kılar."
        >
          <img
            slot="visual"
            src="/images/pick-to-light/p2l-marketing.png"
            alt="Pick-to-Light raf yönlendirme ile depo operatörü çalışma görseli"
            width="1844"
            height="921"
            loading="lazy"
            decoding="async"
          />
        </HubCard>

        <div class="featured-small-stack">
          <HubCard
            href="/sektorler/perakende-tekstil/"
            Icon={Store}
            tag="Perakende"
            title="Perakende & Tekstil"
            desc="Fabrikadan mağazaya kadar ürün izlenebilirliği, mağaza sayımı ve sezon devir optimizasyonu."
          />
          <HubCard
            variant="dark"
            href="/sektorler/uretim/"
            Icon={Factory}
            tag="Üretim"
            title="Üretim"
            desc="OEE, kestirimci bakım, enerji izleme ve SCADA/MES/ERP entegrasyonu ile akıllı fabrika zinciri."
          />
        </div>
      </div>
    </div>
  </section>

  <CTABanner
    heading="Sektörünüze özel operasyon modelini konuşalım"
    description="Depo, perakende veya üretim — sahadaki ihtiyacınıza göre doğru RFID/IoT kurgusunu birlikte tasarlayalım."
    secondaryLabel="Çözümleri İncele"
    secondaryHref="/cozumler/"
  />
</Base>

<style>
  .hub-list { padding: 40px 0 80px; }

  .featured-row {
    display: grid;
    grid-template-columns: 1.55fr 1fr;
    gap: 20px;
  }
  .featured-small-stack {
    display: grid;
    grid-template-rows: 1fr 1fr;
    gap: 20px;
  }

  @media (max-width: 1000px) {
    .featured-row { grid-template-columns: 1fr; }
    .featured-small-stack { grid-template-columns: 1fr 1fr; grid-template-rows: 1fr; }
  }
  @media (max-width: 760px) {
    .featured-small-stack { grid-template-columns: 1fr; grid-template-rows: auto auto; }
  }
</style>
