---
import Base from '../../layouts/Base.astro';
import { translateEnglishTags } from '../../data/english-product-copy';

type Item = {
  slug: string;
  title: string;
  brand: string;
  image: string;
  gallery?: string[];
  datasheet?: string;
  shortDesc: string;
  description?: string;
  tags: string[];
  storeUrl?: string;
};

interface Props {
  item: Item;
  categoryTitle: string;
  listHref: string;
  relatedHrefBase: string;
  related: Item[];
  alternateUrl?: string;
}

const { item, categoryTitle, listHref, relatedHrefBase, related, alternateUrl } = Astro.props;
const displayTitle = (value: string) => value
  .replace(/RFID Okuyucu/g, 'RFID Reader')
  .replace(/Okuyucu/g, 'Reader')
  .replace(/RFID Yazıcı/g, 'RFID Printer')
  .replace(/Yazıcı/g, 'Printer')
  .replace(/El Terminali/g, 'Handheld Terminal');
const displayTag = (value: string) => translateEnglishTags([value])[0];
const productTitle = displayTitle(item.title);
const englishDatasheet = (value?: string) => value?.replace(/\.pdf$/, '-en.pdf');
const gallery = item.gallery && item.gallery.length > 0 ? item.gallery : [item.image];
const contactHref = `/en/contact/?product=${encodeURIComponent(productTitle)}`;
const description = `${productTitle} is part of Altis Technology's RFID product portfolio. Review gallery images, open the technical datasheet, and request project-based pricing for configuration and delivery details.`;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: productTitle,
  description,
  brand: { '@type': 'Brand', name: item.brand },
  image: item.image,
};
---

<Base title={`${productTitle} - Altis Technology`} {description} {schema} lang="en" {alternateUrl}>
  <nav class="breadcrumb-bar">
    <div class="container breadcrumb-inner">
      <a href="/en/products/">Products</a>
      <span>›</span>
      <a href={listHref}>{categoryTitle}</a>
      <span>›</span>
      <span>{productTitle}</span>
    </div>
  </nav>

  <section class="product-hero container">
    <div class="product-image-col">
      <div class="product-image-wrap" id="product-image-wrap">
        <img id="main-img" src={gallery[0]} alt={productTitle} width="560" height="420" loading="eager" data-index="0" />
        <button class="zoom-hint" type="button" aria-label="Enlarge image">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><line x1="21" y1="21" x2="16.65" y2="16.65"/><line x1="11" y1="8" x2="11" y2="14"/><line x1="8" y1="11" x2="14" y2="11"/></svg>
          <span>Enlarge</span>
        </button>
      </div>
      {gallery.length > 1 && (
        <div class="gallery-thumbs" id="gallery-thumbs">
          {gallery.map((src, i) => (
            <button class:list={['thumb-btn', { active: i === 0 }]} data-index={i} type="button">
              <img src={src} alt={`${productTitle} image ${i + 1}`} width="80" height="60" loading="lazy" />
            </button>
          ))}
        </div>
      )}
      {item.datasheet && (
        <a href={englishDatasheet(item.datasheet)} class="datasheet-card" target="_blank" rel="noopener">
          <span class="datasheet-icon" aria-hidden="true">
            <svg width="26" height="26" viewBox="0 0 24 24" fill="none"><path d="M6 2h8l4 4v16H6V2Z" fill="currentColor" opacity=".14"/><path d="M14 2v5h5" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 2h8l5 5v15H6V2Z" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/><path d="M8.4 15.8h7.2M8.4 18.2h5.4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/></svg>
          </span>
          <span class="datasheet-copy">
            <span class="datasheet-eyebrow">PDF Documentation</span>
            <span class="datasheet-title">{productTitle} Technical Datasheet</span>
          </span>
          <span class="datasheet-action">Open PDF</span>
        </a>
      )}
    </div>

    <div class="product-info">
      <div class="badges">
        <span class="brand-badge">{item.brand}</span>
      </div>
      <h1>{productTitle}</h1>
      <div class="tags-row">
        {item.tags.map(tag => <span class="tag">{displayTag(tag)}</span>)}
      </div>
      <p class="description">{description}</p>
      <div class="price-block">
        <p class="price-label">Request a quote for pricing</p>
        <p class="price-sub">We provide project-based pricing depending on quantity, configuration, and delivery scope.</p>
      </div>
      <div class="cta-group">
        <a href={contactHref} class="btn btn-primary btn-lg">Request Quote</a>
        <a href="/en/contact/" class="btn btn-outline btn-lg">Request Demo</a>
      </div>
      <div class="trust-row">
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <span>Official Distributor</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
          <span>Fast Delivery</span>
        </div>
        <div class="trust-item">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
          <span>Technical Support</span>
        </div>
      </div>
    </div>
  </section>

  <section class="details-section container">
    <div class="detail-card">
      <h2>Product Overview</h2>
      <p>{description}</p>
    </div>
    <div class="detail-card">
      <h2>Brand</h2>
      <p><strong>{item.brand}</strong> — Altis Technology provides product selection, integration support, and project delivery guidance.</p>
      {item.storeUrl && (
        <a href={item.storeUrl} target="_blank" rel="noopener" class="external-link">
          View in legacy store →
        </a>
      )}
    </div>
  </section>

  {related.length > 0 && (
    <section class="related-section container">
      <h2>Related Products</h2>
      <div class="related-grid">
        {related.map(rel => (
          <a href={`${relatedHrefBase}${rel.slug}/`} class="related-card">
            <img src={rel.image} alt={displayTitle(rel.title)} loading="lazy" width="200" height="150" />
            <div class="related-info">
              <span class="related-brand">{rel.brand}</span>
              <p>{displayTitle(rel.title)}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <section class="bottom-cta">
    <div class="container">
      <h2>Need technical guidance for this product?</h2>
      <p>Our RFID specialists can help you choose the right product and integration approach.</p>
      <div class="bottom-cta-btns">
        <a href={contactHref} class="btn btn-primary">Request Quote</a>
        <a href={listHref} class="btn btn-outline-white">All Products</a>
      </div>
    </div>
  </section>
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Product image viewer" hidden>
    <button class="lb-close" id="lb-close" type="button" aria-label="Close">
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
    <button class="lb-nav lb-prev" id="lb-prev" type="button" aria-label="Previous image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
    </button>
    <button class="lb-nav lb-next" id="lb-next" type="button" aria-label="Next image">
      <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"/></svg>
    </button>
    <div class="lb-stage" id="lb-stage">
      <img class="lb-image" id="lb-image" src="" alt="" />
    </div>
    <div class="lb-toolbar">
      <button class="lb-tool" id="lb-zoom-out" type="button" aria-label="Zoom out">-</button>
      <span class="lb-counter" id="lb-counter">1 / 1</span>
      <button class="lb-tool" id="lb-zoom-in" type="button" aria-label="Zoom in">+</button>
    </div>
  </div>

  <script is:inline define:vars={{ gallery }}>
    (function () {
      const mainImg = document.getElementById('main-img');
      const thumbs = document.querySelectorAll('#gallery-thumbs .thumb-btn');
      const wrap = document.getElementById('product-image-wrap');
      const lightbox = document.getElementById('lightbox');
      const lbImage = document.getElementById('lb-image');
      const lbCounter = document.getElementById('lb-counter');
      const lbClose = document.getElementById('lb-close');
      const lbPrev = document.getElementById('lb-prev');
      const lbNext = document.getElementById('lb-next');
      const lbStage = document.getElementById('lb-stage');
      const lbZoomIn = document.getElementById('lb-zoom-in');
      const lbZoomOut = document.getElementById('lb-zoom-out');
      if (!mainImg) return;
      let currentIndex = 0;
      let zoom = 1;
      let panX = 0;
      let panY = 0;

      function setMain(index) {
        currentIndex = (index + gallery.length) % gallery.length;
        mainImg.src = gallery[currentIndex];
        mainImg.dataset.index = currentIndex;
        thumbs.forEach((item, itemIndex) => item.classList.toggle('active', itemIndex === currentIndex));
      }

      thumbs.forEach((thumb) => {
        thumb.addEventListener('click', () => {
          setMain(parseInt(thumb.dataset.index, 10));
        });
      });

      if (!wrap || !lightbox || !lbImage || !lbCounter || !lbClose || !lbPrev || !lbNext || !lbStage || !lbZoomIn || !lbZoomOut) return;

      function applyTransform() {
        lbImage.style.transform = 'translate(' + panX + 'px, ' + panY + 'px) scale(' + zoom + ')';
      }

      function setZoom(value) {
        zoom = Math.max(1, Math.min(4, value));
        if (zoom === 1) {
          panX = 0;
          panY = 0;
        }
        applyTransform();
      }

      function updateLightbox() {
        lbImage.src = gallery[currentIndex];
        lbImage.alt = 'Product image ' + (currentIndex + 1);
        lbCounter.textContent = (currentIndex + 1) + ' / ' + gallery.length;
        setZoom(1);
      }

      function openLightbox(index) {
        currentIndex = index;
        updateLightbox();
        lightbox.hidden = false;
        document.body.style.overflow = 'hidden';
        requestAnimationFrame(() => lightbox.classList.add('open'));
      }

      function closeLightbox() {
        lightbox.classList.remove('open');
        document.body.style.overflow = '';
        setTimeout(() => {
          lightbox.hidden = true;
        }, 220);
      }

      wrap.addEventListener('click', () => openLightbox(parseInt(mainImg.dataset.index || '0', 10)));
      lbClose.addEventListener('click', closeLightbox);
      lbPrev.addEventListener('click', () => {
        currentIndex = (currentIndex - 1 + gallery.length) % gallery.length;
        updateLightbox();
      });
      lbNext.addEventListener('click', () => {
        currentIndex = (currentIndex + 1) % gallery.length;
        updateLightbox();
      });
      lightbox.addEventListener('click', (event) => {
        if (event.target === lightbox || event.target === lbStage) closeLightbox();
      });
      document.addEventListener('keydown', (event) => {
        if (lightbox.hidden) return;
        if (event.key === 'Escape') closeLightbox();
        if (event.key === 'ArrowLeft') lbPrev.click();
        if (event.key === 'ArrowRight') lbNext.click();
      });
      lbZoomIn.addEventListener('click', () => setZoom(zoom + 0.5));
      lbZoomOut.addEventListener('click', () => setZoom(zoom - 0.5));
      lbImage.addEventListener('click', (event) => {
        event.stopPropagation();
        setZoom(zoom === 1 ? 2 : 1);
      });
    })();
  </script>
</Base>

<style>
.breadcrumb-bar { border-bottom: 1px solid var(--border-soft); background: #fff; }
.breadcrumb-inner { display: flex; align-items: center; gap: 8px; padding: 14px 0; font-size: 13px; color: var(--text-muted); flex-wrap: wrap; }
.breadcrumb-inner a { color: var(--text-muted); }
.breadcrumb-inner a:hover { color: var(--primary); }
.breadcrumb-inner span:last-child { color: var(--primary); font-weight: 600; }
.product-hero { display: grid; grid-template-columns: .85fr 1fr; gap: 60px; padding-top: 56px; padding-bottom: 56px; align-items: start; }
.product-image-col { display: flex; flex-direction: column; gap: 18px; }
.product-image-wrap { background: #f8f9fb; border: 1px solid var(--border); border-radius: 16px; padding: 32px; aspect-ratio: 4/3; display: flex; align-items: center; justify-content: center; overflow: hidden; position: relative; cursor: zoom-in; transition: border-color .2s, box-shadow .2s; }
.product-image-wrap:hover { border-color: rgba(24,183,214,.5); box-shadow: 0 6px 22px rgba(0,18,92,.08); }
.product-image-wrap img { width: 100%; height: 100%; object-fit: contain; transition: transform .35s ease; }
.product-image-wrap:hover img { transform: scale(1.02); }
.zoom-hint { position: absolute; right: 14px; bottom: 14px; display: inline-flex; align-items: center; gap: 6px; background: rgba(0,18,92,.85); color: #fff; font-size: 12px; font-weight: 700; padding: 7px 12px; border: none; border-radius: 999px; opacity: 0; transform: translateY(6px); transition: opacity .2s, transform .2s; }
.product-image-wrap:hover .zoom-hint { opacity: 1; transform: translateY(0); }
.zoom-hint svg { color: var(--cyan); }
.gallery-thumbs { display: flex; gap: 8px; flex-wrap: wrap; }
.thumb-btn { padding: 4px; border: 2px solid var(--border); border-radius: 8px; background: #f8f9fb; cursor: pointer; transition: border-color .2s; overflow: hidden; }
.thumb-btn img { width: 72px; height: 54px; object-fit: contain; display: block; }
.thumb-btn:hover { border-color: var(--primary); }
.thumb-btn.active { border-color: var(--cyan); }
.datasheet-card { display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 14px; color: var(--text); background: linear-gradient(180deg,#fff,#f8fbff); border: 1px solid #d9e3f3; border-radius: 12px; padding: 16px; min-height: 86px; box-shadow: 0 10px 26px rgba(0,18,92,.06); transition: border-color .2s, box-shadow .2s, transform .2s; }
.datasheet-card:hover { border-color: rgba(24,183,214,.45); box-shadow: 0 10px 28px rgba(0,18,92,.08); transform: translateY(-1px); }
.datasheet-icon { width: 52px; height: 52px; border-radius: 10px; color: #e53935; background: #fff4f3; border: 1px solid #ffd7d3; display: inline-flex; align-items: center; justify-content: center; flex-shrink: 0; }
.datasheet-copy { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
.datasheet-eyebrow { font-size: 10.5px; font-weight: 800; letter-spacing: .08em; text-transform: uppercase; color: var(--cyan); }
.datasheet-title { font-size: 14px; font-weight: 700; color: var(--primary); line-height: 1.35; }
.datasheet-action { font-size: 12.5px; font-weight: 800; color: #fff; background: #1479d4; border-radius: 999px; padding: 10px 18px; white-space: nowrap; }
.badges { display: flex; gap: 8px; margin-bottom: 14px; align-items: center; flex-wrap: wrap; }
.brand-badge { font-size: 11px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: #fff; background: var(--cyan); padding: 4px 12px; border-radius: 20px; }
.product-info h1 { font-size: clamp(1.4rem,3vw,2rem); font-weight: 800; color: var(--primary); line-height: 1.2; margin-bottom: 16px; }
.tags-row { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px; }
.tag { font-size: 11.5px; font-weight: 600; color: var(--text-muted); background: var(--bg-soft); border: 1px solid var(--border); padding: 4px 10px; border-radius: 5px; }
.description { font-size: 14.5px; line-height: 1.75; color: var(--text-muted); margin-bottom: 28px; }
.price-block { background: var(--bg-soft); border: 1px solid var(--border); border-radius: 10px; padding: 18px 20px; margin-bottom: 24px; }
.price-label { font-size: 16px; font-weight: 700; color: var(--primary); margin: 0 0 4px; }
.price-sub { font-size: 13px; color: var(--text-muted); margin: 0; }
.cta-group { display: flex; gap: 12px; flex-wrap: wrap; margin-bottom: 24px; }
.btn-lg { padding: 14px 28px; font-size: 15px; }
.btn-outline { background: transparent; border: 1.5px solid var(--primary); color: var(--primary); }
.btn-outline:hover { background: var(--primary); color: #fff; }
.trust-row { display: flex; gap: 20px; flex-wrap: wrap; padding-top: 16px; border-top: 1px solid var(--border-soft); }
.trust-item { display: flex; align-items: center; gap: 7px; font-size: 13px; font-weight: 600; color: var(--text-muted); }
.trust-item svg { color: var(--cyan); flex-shrink: 0; }
.details-section { display: grid; grid-template-columns: 2fr 1fr; gap: 24px; padding-bottom: 60px; }
.detail-card { background: #fff; border: 1px solid var(--border); border-radius: 12px; padding: 28px; }
.detail-card.full { grid-column: 1 / -1; }
.detail-card h2 { font-size: 16px; font-weight: 700; color: var(--primary); margin-bottom: 12px; }
.detail-card p { font-size: 14px; line-height: 1.7; color: var(--text-muted); margin: 0; }
.external-link { display: inline-flex; margin-top: 12px; font-size: 13px; font-weight: 600; color: var(--cyan); transition: opacity .2s; }
.external-link:hover { opacity: .75; }
.related-section { padding-bottom: 60px; }
.related-section h2 { font-size: 1.3rem; font-weight: 700; color: var(--primary); margin-bottom: 20px; }
.related-grid { display: grid; grid-template-columns: repeat(auto-fill,minmax(220px,1fr)); gap: 16px; }
.related-card { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--border); border-radius: 10px; overflow: hidden; transition: box-shadow .2s,border-color .2s; }
.related-card:hover { border-color: var(--primary); box-shadow: 0 4px 16px rgba(0,18,92,.08); }
.related-card img { width: 100%; aspect-ratio: 4/3; object-fit: contain; background: #f8f9fb; padding: 16px; }
.related-info { padding: 14px 16px; }
.related-brand { font-size: 10.5px; font-weight: 700; letter-spacing: .08em; text-transform: uppercase; color: var(--cyan); display: block; margin-bottom: 4px; }
.related-info p { font-size: 13px; font-weight: 600; color: var(--primary); margin: 0; line-height: 1.35; }
.bottom-cta { background: linear-gradient(135deg,var(--primary) 0%,#0a2a8c 100%); padding: 72px 0; text-align: center; }
.bottom-cta h2 { font-size: clamp(1.3rem,3vw,1.8rem); font-weight: 800; color: #fff; margin-bottom: 12px; }
.bottom-cta p { color: rgba(255,255,255,.75); margin-bottom: 32px; }
.bottom-cta-btns { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
.btn-outline-white { background: transparent; border: 1.5px solid rgba(255,255,255,.5); color: #fff; }
.btn-outline-white:hover { background: rgba(255,255,255,.1); }
.lightbox { position: fixed; inset: 0; background: rgba(6,12,32,.88); backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; z-index: 1000; opacity: 0; transition: opacity .22s ease; }
.lightbox.open { opacity: 1; }
.lightbox[hidden] { display: none; }
.lb-stage { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; overflow: hidden; padding: 56px 80px; box-sizing: border-box; }
.lb-image { max-width: 100%; max-height: 100%; object-fit: contain; cursor: zoom-in; transition: transform .25s ease; user-select: none; -webkit-user-drag: none; transform-origin: center center; }
.lb-close, .lb-nav, .lb-tool { background: rgba(255,255,255,.12); color: #fff; border: 1px solid rgba(255,255,255,.18); border-radius: 999px; width: 44px; height: 44px; display: inline-flex; align-items: center; justify-content: center; cursor: pointer; transition: background .15s, transform .15s; backdrop-filter: blur(8px); }
.lb-close:hover, .lb-nav:hover, .lb-tool:hover { background: rgba(255,255,255,.22); transform: scale(1.06); }
.lb-close { position: absolute; top: 22px; right: 22px; z-index: 2; }
.lb-nav { position: absolute; top: 50%; transform: translateY(-50%); z-index: 2; }
.lb-nav:hover { transform: translateY(-50%) scale(1.06); }
.lb-prev { left: 18px; }
.lb-next { right: 18px; }
.lb-toolbar { position: absolute; bottom: 22px; left: 50%; transform: translateX(-50%); display: inline-flex; align-items: center; gap: 10px; background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18); border-radius: 999px; padding: 6px 8px; backdrop-filter: blur(8px); z-index: 2; }
.lb-tool { width: 32px; height: 32px; font-size: 18px; font-weight: 700; border: none; background: transparent; }
.lb-tool:hover { background: rgba(255,255,255,.18); transform: scale(1.08); }
.lb-counter { color: #fff; font-size: 13px; font-weight: 600; padding: 0 8px; letter-spacing: .04em; }
@media (max-width: 768px) {
  .product-hero { grid-template-columns: 1fr; gap: 32px; }
  .details-section { grid-template-columns: 1fr; }
  .detail-card.full { grid-column: auto; }
  .datasheet-card { grid-template-columns: auto 1fr; }
  .datasheet-action { grid-column: 1 / -1; text-align: center; }
  .lb-stage { padding: 60px 16px 80px; }
  .lb-prev { left: 6px; }
  .lb-next { right: 6px; }
}
</style>
