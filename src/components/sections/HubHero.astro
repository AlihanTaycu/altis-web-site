---
interface Props {
  eyebrow: string;
  heading: string;
  description?: string;
}
const { eyebrow, heading, description } = Astro.props;
---

<section class="hub-hero">
  <div class="container">
    <div class="eyebrow hub-eyebrow" set:html={eyebrow} />
    <h1 set:html={heading} />
    {description && <p set:html={description} />}
  </div>
</section>

<style>
  .hub-hero {
    padding: 96px 0 52px;
    background: linear-gradient(180deg, var(--bg-soft) 0%, #fff 100%);
  }
  /* Hub hero eyebrow uses cyan + the shared line (consistent with .eyebrow) */
  .hub-eyebrow { color: var(--cyan); }
  .hub-eyebrow::before { background: var(--cyan); }
  .hub-hero h1 {
    max-width: 900px;
    margin-top: 18px;
    font-size: clamp(38px, 5vw, 62px);
    line-height: 1.08;
  }
  .hub-hero p {
    max-width: 760px;
    margin-top: 20px;
    font-size: 19px;
    color: var(--text-muted);
  }

  @media (max-width: 760px) {
    .hub-hero { padding: 72px 0 40px; overflow: hidden; }
    .hub-hero h1 { font-size: clamp(34px, 10vw, 44px); overflow-wrap: break-word; }
    .hub-hero p { font-size: 17px; overflow-wrap: break-word; }
  }
</style>
