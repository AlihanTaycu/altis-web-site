---
interface Logo {
  name: string;
  src: string;
}

interface Props {
  logos: Logo[];
  label?: string;
}

const { logos, label } = Astro.props;
---

{label && <p class="trust-logos-label">{label}</p>}
<div class="trust-logos">
  {logos.map(logo => (
    <div class="trust-logo">
      <img src={logo.src} alt={`${logo.name} logo`} width="160" height="70" loading="lazy" />
    </div>
  ))}
</div>

<style>
  .trust-logos-label {
    margin-top: 56px;
    font-size: 13px;
    color: var(--text-faint);
    font-family: "JetBrains Mono", monospace;
    text-transform: uppercase;
    letter-spacing: .12em;
  }
  .trust-logos {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
    gap: 18px 22px;
    margin-top: 34px;
    align-items: center;
  }
  .trust-logo {
    height: 74px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #fff;
    border-radius: 8px;
    padding: 18px 20px;
    transition: transform .2s ease, opacity .2s ease;
  }
  .trust-logo:hover { transform: translateY(-2px); }
  .trust-logo img {
    max-width: 100%;
    max-height: 42px;
    width: auto;
    height: auto;
    object-fit: contain;
    filter: saturate(.92);
    opacity: .86;
  }
  .trust-logo:hover img { opacity: 1; filter: saturate(1); }

  @media (max-width: 1100px) {
    .trust-logos { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 720px) {
    .trust-logos { grid-template-columns: repeat(2, 1fr); }
  }
</style>
