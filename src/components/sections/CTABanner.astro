---
interface Props {
  heading: string;
  description?: string;
  eyebrow?: string;
  primaryLabel?: string;
  primaryHref?: string;
  secondaryLabel?: string;
  secondaryHref?: string;
  variant?: 'soft' | 'dark';
}

const {
  heading,
  description,
  eyebrow,
  primaryLabel = 'Demo Talep Et',
  primaryHref = '/iletisim/',
  secondaryLabel,
  secondaryHref,
  variant = 'soft',
} = Astro.props;
---

<section class:list={['cta-banner', `cta-banner--${variant}`]} data-reveal>
  <div class="container cta-inner">
    {eyebrow && <div class:list={['eyebrow', { 'eyebrow--on-dark': variant === 'dark' }]} set:html={eyebrow} />}
    <h2 set:html={heading} />
    {description && <p set:html={description} />}
    <div class="cta-actions">
      <a href={primaryHref} class="btn btn-primary btn-lg">
        {primaryLabel}
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
      {secondaryLabel && secondaryHref && (
        <a href={secondaryHref} class="btn btn-secondary btn-lg">{secondaryLabel}</a>
      )}
    </div>
  </div>
</section>

<style>
  .cta-banner { padding: var(--section-y-tight) 0; position: relative; overflow: hidden; }
  .cta-banner--soft { background: var(--bg-soft); border-top: 1px solid var(--border); }
  .cta-banner--dark { background: var(--primary); }
  .cta-banner--dark::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(700px 400px at 80% 50%, rgba(24, 183, 214, .15), transparent 60%);
    pointer-events: none;
  }

  .cta-inner { position: relative; text-align: center; max-width: 780px; margin: 0 auto; }
  .cta-banner .eyebrow { justify-content: center; margin-bottom: 16px; }
  .cta-banner h2 {
    font-size: clamp(24px, 2.8vw, 40px);
    color: var(--primary);
    margin: 0 0 14px;
  }
  .cta-banner p {
    font-size: 17px;
    color: var(--text-muted);
    max-width: 600px;
    margin: 0 auto 28px;
    line-height: 1.7;
  }
  .cta-actions { display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }

  .cta-banner--dark h2 { color: #fff; }
  .cta-banner--dark p { color: rgba(255, 255, 255, .78); }
  .cta-banner--dark .btn-secondary {
    background: transparent;
    color: #fff;
    border-color: rgba(255, 255, 255, .3);
  }
  .cta-banner--dark .btn-secondary:hover {
    background: rgba(255, 255, 255, .1);
    border-color: rgba(255, 255, 255, .5);
  }
</style>
